   284	    "def get_calls_set(calls):\n",
   285	    "    parsed_list = []\n",
   286	    "    if calls[0] == \"#START#\":\n",
   287	    "        sub_calls = calls[1:-1]\n",
   288	    "        func_name = sub_calls[0]\n",
   289	    "        func_calls = []\n",
   290	    "        sub_calls = calls[1:]\n",
   291	    "        stop = False\n",
   292	    "        f_calls = []\n",
   293	    "        count_start = 0\n",
   294	    "        count_end = 0\n",
   295	    "        for s in sub_calls:\n",
   296	    "            if count_start == 1 and s!= \"#END#\":\n",
   297	    "                func_calls.append(s)\n",
   298	    "            if s == \"#START#\":\n",
   299	    "                count_start += 1\n",
   300	    "                f_calls.append(s)\n",
   301	    "            elif s == \"#END#\":\n",
   302	    "                count_end += 1\n",
   303	    "                f_calls.append(s)\n",
   304	    "            else:\n",
   305	    "                f_calls.append(s)\n",
   306	    "            if count_start == count_end and count_start != 0:\n",
   307	    "                parsed_list.extend(get_calls_set(f_calls))\n",
   308	    "                count_start = 0\n",
   309	    "                count_end = 0\n",
   310	    "                f_calls = []\n",
   311	    "\n",
   312	    "        parsed_list.append((func_name, func_calls))\n",
   313	    "\n",
   314	    "    return parsed_list"
   315	   ]
   316	  },
