import csv
from collections import defaultdict

# Canonical reasons in the order of Table 10
REASONS = [
    "Coding time",
    "Ease of use",
    "Maintainability",
    "Performance",
    "Readability/Understandability",
    "Size",
    "Lack of knowledge",
    "Project constraints",
    "Simplify debugging",
]

CONSTRUCT_FILES = {
    "Lambdas": "/workspace/lambda.csv",
    "Comp.":   "/workspace/comprehension.csv",
    "MRF":     "/workspace/mrf.csv",
    "Proc.":   "/workspace/procedural.csv",
}

def canonical_reason(label: str):
    s = label.strip()
    if not s:
        return None
    low = s.lower()
    # Map specific procedural labels first
    if "debug" in low:
        return "Simplify debugging"
    if "project constraint" in low or "project constraints" in low:
        return "Project constraints"
    if "lack of knowledge" in low:
        return "Lack of knowledge"
    # Common labels
    if "coding time" in low:
        return "Coding time"
    if "ease of use" in low:
        return "Ease of use"
    if "maintain" in low:
        return "Maintainability"
    if "perform" in low:
        return "Performance"
    if "size" in low:
        return "Size"
    if "readability/understandability" in low or "readability" in low or "understandability" in low:
        return "Readability/Understandability"
    # Anything else is not part of Table 10 taxonomy
    return None

def aggregate_construct(path: str):
    """Return (total_participants_with_any_reason, reason_counts_by_participant)"""
    reasons_per_participant = defaultdict(set)
    with open(path, newline='', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        for row in reader:
            pid = (row.get("ID") or "").strip()
            if not pid:
                continue
            raw = (row.get("Final Classification") or "").strip()
            if not raw:
                continue
            canon = canonical_reason(raw)
            if not canon:
                continue
            reasons_per_participant[pid].add(canon)
    total = len(reasons_per_participant)
    counts = {r: 0 for r in REASONS}
    for pid, rset in reasons_per_participant.items():
        for r in rset:
            if r in counts:
                counts[r] += 1
    return total, counts

def format_cell(total, count):
    # Use '—' when the reason does not occur; otherwise integer percentage.
    if total == 0 or count == 0:
        return "—"
    val = round(100.0 * count / total)
    return f"{int(val)}"

# Compute per-construct statistics
totals = {}
counts = {}
for cname, path in CONSTRUCT_FILES.items():
    t, c = aggregate_construct(path)
    totals[cname] = t
    counts[cname] = c

lines = []
lines.append("**Table 10: Reasons for using functional and procedural code**\n")
lines.append("\n")
lines.append("| Reason                        | Lambdas | Comp. | MRF | Proc. |\n")
lines.append("| ----------------------------- | ------: | ----: | --: | ----: |\n")

for reason in REASONS:
    row_vals = {}
    for cname in ["Lambdas", "Comp.", "MRF", "Proc."]:
        c = counts[cname].get(reason, 0)
        t = totals[cname]
        row_vals[cname] = format_cell(t, c)
    # Ensure reason label exactly as in expected.md
    display_reason = reason
    lines.append(f"| {display_reason:<27} | {row_vals['Lambdas']:>6} | {row_vals['Comp.']:>4} | {row_vals['MRF']:>3} | {row_vals['Proc.']:>4} |\n")

with open("/workspace/repro.txt", "w", encoding="utf-8") as out:
    out.writelines(lines)
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_pythonic_table_10.sh
artisan submit /workspace/repro_pythonic_table_10.sh
