def parse_expected_output(file_path):
    with open(file_path, 'r') as f:
        content = f.read()
    
    # Split by "Executing Group" to get each group's output
    groups = re.split(r'Executing Group \d+', content)
    # The first part is before any group, so skip it
    groups = groups[1:]
    
    results = {}
    
    for i, group_text in enumerate(groups, start=1):
        if i not in group_to_project:
            continue
            
        # Extract annotation count
        ann_match = re.search(r'Annotation count: (\d+)', group_text)
        if ann_match:
            ann_count = int(ann_match.group(1))
        else:
            ann_count = 0
            
        # Extract warning count from slither output "X result(s) found"
        warn_match = re.search(r'(\d+) result\(s\) found', group_text)
        if warn_match:
            warn_count = int(warn_match.group(1))
        else:
            warn_count = 0
            
        results[group_to_project[i]] = (ann_count, warn_count)
    
    return results

