import json
import math
from pathlib import Path

nb_path = Path("gh_resource_study_artifact_patched/github-workflow-resource-optimization/paper_analysis_RQ1.ipynb")
if not nb_path.is_file():
    raise SystemExit(f"Notebook not found at {nb_path}")

with nb_path.open() as f:
    nb = json.load(f)

text_block = ""
for cell in nb.get("cells", []):
    if cell.get("cell_type") != "code":
        continue
    for out in cell.get("outputs", []):
        if out.get("output_type") != "stream":
            continue
        txt = "".join(out.get("text", []))
        if "Conclusion                     Paid" in txt:
            text_block = txt
            break
    if text_block:
        break

if not text_block:
    raise SystemExit("Could not locate Table 3 output in the notebook.")

lines = [ln.rstrip("\n") for ln in text_block.splitlines()]

statuses = ["success", "failure", "skipped", "cancelled", "startup_failure", "action_required", "stale"]
label_map = {
    "success": "Success",
    "failure": "Failure",
    "skipped": "Skipped",
    "cancelled": "Canceled",
    "startup_failure": "Startup failure",
    "action_required": "Action required",
    "stale": "Stale",
}

rows = []

for s in statuses:
    matched_line = None
    for ln in lines:
        if ln.strip().startswith(s):
            matched_line = ln
            break
    if matched_line is None:
        raise SystemExit(f"Did not find line for status '{s}' in notebook output.")
    parts = matched_line.split()
    if len(parts) < 5:
        raise SystemExit(f"Unexpected format for status '{s}': {matched_line}")
    paid_run = float(parts[1])
    free_run = float(parts[2])
    paid_vm = float(parts[3])
    free_vm = float(parts[4])

    # Match the paper's convention: for tiny paid run proportions (<0.05),
    # print "< 0.1" instead of "0.0".
    if s in ("action_required", "stale") and math.isclose(paid_run, 0.0):
        paid_run_str = "< 0.1"
    else:
        paid_run_str = f"{paid_run:.1f}"

    row = {
        "Status": label_map[s],
        "RunsPaid": paid_run_str,
        "RunsFree": f"{free_run:.1f}",
        "VmPaid": f"{paid_vm:.1f}",
        "VmFree": f"{free_vm:.1f}",
    }
    rows.append(row)

out_path = Path("/workspace/repro.txt")
with out_path.open("w") as f:
    f.write("**Table 3: Termination status: comparison between free tier and paid tier.**\n\n")
    f.write("| Status          | Runs proportion % (Paid) | Runs proportion % (Free) | VM time proportion % (Paid) | VM time proportion % (Free) |\n")
    f.write("| --------------- | -----------------------: | -----------------------: | --------------------------: | --------------------------: |\n")
    for r in rows:
        f.write(f"| {r['Status']:<14} | {r['RunsPaid']:>23} | {r['RunsFree']:>23} | {r['VmPaid']:>26} | {r['VmFree']:>26} |\n")
PY
