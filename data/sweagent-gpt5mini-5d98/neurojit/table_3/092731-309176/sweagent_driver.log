import pandas as pd
import numpy as np
from scipy.stats import ranksums

def cliffs_delta(x, y):
    x = np.array(x)
    y = np.array(y)
    n1 = len(x)
    n2 = len(y)
    if n1==0 or n2==0:
        return 0.0, 'n'
    greater = 0
    less = 0
    for xi in x:
        greater += np.sum(xi>y)
        less += np.sum(xi<y)
    d = (greater - less) / (n1*n2)
    ad = abs(d)
    if ad < 0.147:
        size='n'
    elif ad < 0.33:
        size='s'
    elif ad < 0.474:
        size='m'
    else:
        size='l'
    return d, size

rf = pd.read_csv('data/output/actionable_random_forest.csv')
xgb = pd.read_csv('data/output/actionable_xgboost.csv')

projects = sorted(rf['project'].unique())
rows = []
for proj in projects:
    rf_df = rf[rf['project']==proj]
    x = rf_df['our_actionable_ratio']
    y = rf_df['baseline_actionable_ratio']
    rf_baseline_mean = y.mean()*100
    rf_our_mean = x.mean()*100
    p = ranksums(x, y).pvalue if len(x)>0 and len(y)>0 else 1.0
    d, size = cliffs_delta(x, y)

    x2 = xgb[xgb['project']==proj]['our_actionable_ratio']
    y2 = xgb[xgb['project']==proj]['baseline_actionable_ratio']
    xgb_baseline_mean = y2.mean()*100
    xgb_our_mean = x2.mean()*100
    p2 = ranksums(x2, y2).pvalue if len(x2)>0 and len(y2)>0 else 1.0
    d2, size2 = cliffs_delta(x2, y2)

    rows.append((proj, rf_baseline_mean, rf_our_mean, size, xgb_baseline_mean, xgb_our_mean, size2))

# compute averages
avg_rf_baseline = np.mean([r[1] for r in rows])
avg_rf_our = np.mean([r[2] for r in rows])
avg_xgb_baseline = np.mean([r[4] for r in rows])
avg_xgb_our = np.mean([r[5] for r in rows])

# print table similar to expected
print('**Table 3: Average Ratios of Actionable Features within Top 5 Contribution Rankings of LIME Explanations**')
print()
print('| Project | Random Forest (%) | | XGBoost (%) |  |')
print('| --- | --- | --- | --- | --- |')
print('| | baseline | combined (δ) | baseline | combined |  |')
for r in rows:
    proj = r[0].capitalize()
    rf_b = f"{r[1]:.1f}"
    rf_o = f"{r[2]:.1f} ({r[3]})"
    xgb_b = f"{r[4]:.1f}"
    xgb_o = f"{r[5]:.1f} ({r[6]})"
    print(f'| {proj} | {rf_b} | {rf_o} | {xgb_b} | {xgb_o} |')
print(f'| Average (%) | {avg_rf_baseline:.1f} | {avg_rf_our:.1f} | {avg_xgb_baseline:.1f} | {avg_xgb_our:.1f} |')
PY

