cd /workspace/zeugma-main && python3 -c "
import csv
import statistics
from collections import defaultdict

data = defaultdict(lambda: defaultdict(list))
hybrid_counts = defaultdict(lambda: defaultdict(int))
total_counts = defaultdict(lambda: defaultdict(int))

with open('data/heritability.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        subject = row['subject']
        crossover = row['crossover_operator']
        ir = float(row['inheritance_rate'])
        hybrid = row['hybrid'].lower() == 'true'
        data[subject][crossover].append(ir)
        total_counts[subject][crossover] += 1
        if hybrid:
            hybrid_counts[subject][crossover] += 1

print('Subject,Crossover,HY,IR')
for subject in sorted(data.keys()):
    for crossover in ['Linked', 'One Point', 'Two Point']:
        if crossover in data[subject]:
            hy = hybrid_counts[subject][crossover] / total_counts[subject][crossover]
            med_ir = statistics.median(data[subject][crossover])
            print(f'{subject},{crossover},{hy:.3f},{med_ir:.3f}')
" 2>&1
