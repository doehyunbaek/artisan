import pandas as pd
import numpy as np

# Load the data from the CSV files
rq1_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv')
rq1paired_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1Paired-RQ2.csv')

# Calculate statistics for RQ1
rq1_correct = rq1_data[rq1_data['Outcome'] == True]

# Calculate means and standard deviations
lambda_mean = rq1_correct[rq1_correct['Construct'] == 'lambda']['Outcome'].mean()
lambda_std = rq1_correct[rq1_correct['Construct'] == 'lambda']['Outcome'].std()

comp_mean = rq1_correct[rq1_correct['Construct'] == 'comp']['Outcome'].mean()
comp_std = rq1_correct[rq1_correct['Construct'] == 'comp']['Outcome'].std()

mrf_mean = rq1_correct[rq1_correct['Construct'] == 'mrf']['Outcome'].mean()
mrf_std = rq1_correct[rq1_correct['Construct'] == 'mrf']['Outcome'].std()

# Calculate statistics for RQ1Paired
rq1paired_correct = rq1paired_data[rq1paired_data['Outcome'] == True]

# Calculate means and standard deviations for paired data
lambda_p_mean = rq1paired_correct['LambdaF'].mean()
lambda_p_std = rq1paired_correct['LambdaF'].std()

comp_p_mean = rq1paired_correct['CompF'].mean()
comp_p_std = rq1paired_correct['CompF'].std()

mrf_p_mean = rq1paired_correct['MrfF'].mean()
mrf_p_std = rq1paired_correct['MrfF'].std()

# Prepare the results table
results_table = pd.DataFrame({
    'Construct': ['Lambda', 'Compr.', 'MRF'],
    'Functional': [lambda_mean, comp_mean, mrf_mean],
    'Functional Std Dev': [lambda_std, comp_std, mrf_std],
    'Procedural': [lambda_p_mean, comp_p_mean, mrf_p_mean],
    'Procedural Std Dev': [lambda_p_std, comp_p_std, mrf_p_std]
})

results_table
