print("| ------------ | --------: | -----: | ---------: | ---------: | ----------: | ----------: | -------: | ---------: | ---------: | ---------: | ---------: | ---------: | --------: | --------: |")

for f in FUZZERS:
    cells = []
    for s in SUBJECTS:
        for time_value, _ in TIME_POINTS:
            cells.append(format_cell(f, s, time_value))
    row = "| {name:<12} | ".format(name=f)
    row += " | ".join(cells) + " |"
    print(row)
