    f.write(table_title + "\n\n")
    f.write("| RUF Impacts       |   Total | Compilation Failure |\n")
    f.write("| ----------------- | ------: | ------------------: |\n")
    f.write(f"| Before Mitigation | {before_total} |              {before_fail} |\n")
    f.write(f"| After Mitigation  | {after_total} |               {after_fail} |\n")
PY

