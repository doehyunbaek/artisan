echo "Container ID: $CONTAINER_ID"

# Function to run analysis for one project
run_analysis() {
    local project_name=$1
    local spec_file=$2
    local bench_dir=$3
    
    echo "Running analysis for $project_name ..."
    
    # Run commands in the container
    docker exec $CONTAINER_ID /bin/bash --noprofile --norc -c "
        cd /home/infer_TempFix
        cp $spec_file spec.c
        cd /home/benchmarks-RQ1N2/$bench_dir
        make clean > /dev/null 2>&1
        /home/infer_TempFix/infer/bin/tempFix 2>&1
    " 2>/dev/null | grep '\[Failed.*Assert\]'
}

# We already know Swoole works, so let's get the number for Swoole first
# Then we'll run the others. However, note that the tool might have state? 
# The artifact evaluation says the experiments cannot be done in parallel, but they are sequential.
# We'll run each in the same container, but we need to reset the state? 
# Actually, the instructions say to run them sequentially and they write to the same outcome file.
# So we should run them one by one in the same container without resetting the container between runs.

# Let's run a script inside the container that does all sequentially.
docker exec $CONTAINER_ID /bin/bash --noprofile --norc -c '
    cd /home/infer_TempFix
    git reset --hard
    git checkout main
    ./compile > /tmp/compile.log 2>&1
    
    # Function to analyze one project
    analyze() {
        name=$1
        spec=$2
        bench=$3
        echo "=== Analyzing $name ==="
        cp "$spec" spec.c
        cd "/home/benchmarks-RQ1N2/$bench"
        make clean > /dev/null 2>&1
        /home/infer_TempFix/infer/bin/tempFix 2>&1 | grep "\[Failed.*Assert\]"
        cd /home/infer_TempFix
    }
    
    analyze "Swoole" "spec_Swoole.c" "swoole-src"
    analyze "lxc" "spec_Lxc.c" "lxc"
    analyze "WavPack" "spec_WavPack.c" "WavPack"
    analyze "flex" "spec_flex.c" "flex"
    analyze "p11-kit" "spec_p11.c" "p11-kit"
    analyze "x264" "spec-x264.c" "x264"
    analyze "recutils-1.8" "spec-recutils.c" "recutils-1.8"
    analyze "inetutils-1.9.4" "spec-inetutils.c" "inetutils-1.9.4"
    analyze "snort-2.9.13" "spec_snort-2.9.13.c" "snort-2.9.13"
    analyze "grub" "spec_Grub.c" "grub"
' 2>&1 | tee /workspace/analysis_output.txt

# Stop and remove container
docker stop $CONTAINER_ID > /dev/null 2>&1
