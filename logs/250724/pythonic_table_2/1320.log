import pandas as pd
import numpy as np

# Load the data from the CSV files
rq1_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv')
rq1paired_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1Paired-RQ2.csv')
construct_usage_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/ConstructUsage.csv')

# Calculate the statistics for RQ1
rq1_correct = rq1_data[rq1_data['Outcome'] == True]

# Count correct and wrong answers for each construct
lambda_correct = rq1_correct[rq1_data['Construct'] == 'lambda'].shape[0]
lambda_wrong = rq1_data[(rq1_data['Construct'] == 'lambda') & (rq1_data['Outcome'] == False)].shape[0]
comp_correct = rq1_correct[rq1_data['Construct'] == 'comp'].shape[0]
comp_wrong = rq1_data[(rq1_data['Construct'] == 'comp') & (rq1_data['Outcome'] == False)].shape[0]
mrf_correct = rq1_correct[rq1_data['Construct'] == 'mrf'].shape[0]
mrf_wrong = rq1_data[(rq1_data['Construct'] == 'mrf') & (rq1_data['Outcome'] == False)].shape[0]

# Calculate percentages
lambda_percent = (lambda_correct / (lambda_correct + lambda_wrong)) * 100
comp_percent = (comp_correct / (comp_correct + comp_wrong)) * 100
mrf_percent = (mrf_correct / (mrf_correct + mrf_wrong)) * 100

# Prepare the results table
results_table = pd.DataFrame({
    'Construct': ['Lambda', 'Compr.', 'MRF'],
    'Functional Corr.': [lambda_correct, comp_correct, mrf_correct],
    'Functional Wrong': [lambda_wrong, comp_wrong, mrf_wrong],
    '% Corr.': [lambda_percent, comp_percent, mrf_percent]
})

# Display the results table
results_table
