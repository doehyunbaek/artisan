library(lme4)
library(lmerTest)
library(MuMIn)
library(lattice)
library(car)
library(gridExtra)
library(plyr)
library(rsq)
library(parameters)
library(tidyverse)
library(dplyr)
library(tidyr)
library(reshape2)

df <- read.csv('ase_data.csv', header=TRUE)

# Model 1: Prompt usage (query_total)
model1 <- glm(query_total ~ 
                  AI_experience +
                  info_style + 
                  learning_style,
                  data = df[df\$tool==1,],
                  family=quasipoisson)
sum1 <- summary(model1)
rsq1 <- rsq(model1)

# Model 2: Followup usage (Query_followup)
model2 <- glm(Query_followup ~ 
                  AI_experience +
                  info_style + 
                  learning_style,
                  data = df[df\$tool==1,],
                  family=quasipoisson)
sum2 <- summary(model2)
rsq2 <- rsq(model2)

# Model 3: All usage (usage_total)
model3 <- glm(usage_total ~ 
                  AI_experience +
                  info_style + 
                  learning_style,
                  data = df[df\$tool==1,],
                  family=quasipoisson)
sum3 <- summary(model3)
rsq3 <- rsq(model3)

# Function to extract coefficients and format
extract_coef <- function(model_sum, rsq_val) {
  coefs <- model_sum\$coefficients
  # Intercept row
  intercept <- coefs['(Intercept)', ]
  ai_exp <- coefs['AI_experience', ]
  info_style <- coefs['info_style', ]
  learning_style <- coefs['learning_style', ]
  
  # Format with significance stars
  format_num <- function(x, p) {
    num <- sprintf('%.2f', x)
    if (p < 0.01) {
      paste0(num, '***')
    } else if (p < 0.05) {
      paste0(num, '**')
    } else if (p < 0.1) {
      paste0(num, '*')
    } else {
      num
    }
  }
  
  list(
    constant = paste0(format_num(intercept['Estimate'], intercept['Pr(>|t|)']), 
                      ' (', sprintf('%.2f', intercept['Std. Error']), ')'),
    ai = paste0(format_num(ai_exp['Estimate'], ai_exp['Pr(>|t|)']), 
                ' (', sprintf('%.2f', ai_exp['Std. Error']), ')'),
    info = paste0(format_num(info_style['Estimate'], info_style['Pr(>|t|)']), 
                  ' (', sprintf('%.2f', info_style['Std. Error']), ')'),
    learning = paste0(format_num(learning_style['Estimate'], learning_style['Pr(>|t|)']), 
                      ' (', sprintf('%.2f', learning_style['Std. Error']), ')'),
    rsq = sprintf('%.3f', rsq_val),
    adj_rsq = sprintf('%.3f', 1 - (1 - rsq_val) * (model_sum\$df.null) / (model_sum\$df.null - model_sum\$df.residual))
  )
}

res1 <- extract_coef(sum1, rsq1)
res2 <- extract_coef(sum2, rsq2)
res3 <- extract_coef(sum3, rsq3)

cat('Table 3 Results:\n')
cat('|                     |     Prompt (1) |  Followup (2) |        All (3) |\n')
cat('| ------------------- | -------------: | ------------: | -------------: |\n')
cat(sprintf('| Constant            | %14s | %13s | %14s |\n', res1\$constant, res2\$constant, res3\$constant))
cat(sprintf('| AI tool familiarity | %14s | %13s | %14s |\n', res1\$ai, res2\$ai, res3\$ai))
cat(sprintf('| Information Comprh. | %14s | %13s | %14s |\n', res1\$info, res2\$info, res3\$info))
cat(sprintf('| Learning Process    | %14s | %13s | %14s |\n', res1\$learning, res2\$learning, res3\$learning))
cat(sprintf('| *R*²                | %14s | %13s | %14s |\n', res1\$rsq, res2\$rsq, res3\$rsq))
cat(sprintf('| Adj. *R*²           | %14s | %13s | %14s |\n', res1\$adj_rsq, res2\$adj_rsq, res3\$adj_rsq))
EOF
Rscript run_table3.R 2>&1"
</mini_swe_agent_bash>
