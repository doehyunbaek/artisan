cat > /workspace/extract_results.py <<'EOF'
import re

def format_number(num_str):
    """Format number with space as thousands separator"""
    num = int(num_str.strip())
    return f"{num:,}".replace(",", " ")

def parse_results():
    with open('Unimocg_Artifact/summaries/immutability_results.txt', 'r') as f:
        content = f.read()
    
    # Pattern to extract algorithm sections
    sections = re.split(r'-{64,}', content)
    
    results = {}
    
    for section in sections:
        if not section.strip():
            continue
            
        # Extract algorithm name
        algo_match = re.search(r'algorithm:\s*(\w+)', section)
        if not algo_match:
            continue
            
        algo = algo_match.group(1)
        
        # Extract numbers
        mutable_match = re.search(r'Mutable Fields:\s*(\d+)', section)
        non_trans_match = re.search(r'Non Transitively Immutable Fields:\s*(\d+)', section)
        depen_match = re.search(r'Dependently Immutable Fields:\s*(\d+)', section)
        trans_match = re.search(r'Transitively Immutable Fields:\s*(\d+)', section)
        
        if all([mutable_match, non_trans_match, depen_match, trans_match]):
            results[algo] = {
                'mutable': format_number(mutable_match.group(1)),
                'non_trans': format_number(non_trans_match.group(1)),
                'depen': format_number(depen_match.group(1)),
                'trans': format_number(trans_match.group(1))
            }
    
    return results

def generate_table(results):
    table = """**Table 4: Field Immutability Results for OpenJDK**

| Algorithm  | mutable | ⊒ non-trans. | ⊒ depen. | ⊒ trans. |
| ---------- | ------: | -----------: | -------: | -------: |\n"""
    
    # Map algorithm names to display names
    algo_display = {
        'AdHocCHA': 'Ad-hoc CHA',
        'CHA': 'CHA',
        'RTA': 'RTA',
        'XTA': 'XTA'
    }
    
    # Order as shown in the expected table
    for algo_key in ['AdHocCHA', 'CHA', 'RTA', 'XTA']:
        if algo_key in results:
            data = results[algo_key]
            table += f"| {algo_display[algo_key]} | {data['mutable']} | {data['non_trans']} | {data['depen']} | {data['trans']} |\n"
    
    table += "\n*depen. = dependently immutable, trans. = transitively immutable. Higher numbers in columns to the right = more precise.*"
    
    return table

if __name__ == "__main__":
    results = parse_results()
    table = generate_table(results)
    print(table)
EOF
</mini_swe_agent_bash>
