import sys, csv
mapping = [
    ('Swoole','swoole-src'),
    ('lxc','lxc'),
    ('WavPack','WavPack'),
    ('flex','flex'),
    ('p11-kit','p11-kit'),
    ('x264','x264'),
    ('recutils-1.8','recutils-1.8'),
    ('inetutils-1.9.4','inetutils-1.9.4'),
    ('snort-2.9.13','snort-2.9.13'),
    ('grub','grub')
]
sums = {k:0 for k,_ in mapping}
reader = csv.reader(sys.stdin)
next(reader, None)
for row in reader:
    if not row: 
        continue
    path = row[0]
    # Failed Assertion is the 7th column (index 6)
    try:
        failed = int(float(row[6])) if len(row) > 6 and row[6].strip() else 0
    except:
        failed = 0
    for k,p in mapping:
        if p in path:
            sums[k] += failed
total = sum(sums.values())
for k,_ in mapping:
    print(f"{k} -> {sums[k]}")
print(f"Total -> {total}")
PY
</mini_swe_agent_bash>
