import numpy as np

# Outputs from the expected results
q1 = 2
q2 = (2, 4, 6)
q3 = ['solt']
q4 = [36, 'Norway', 'John']
q5 = [[2, 3], [3, 4], [4, 5]]
q6 = [-1, 0, 3, 8, 15, 24, 35]

# Prepare data for statistics
q1_data = [q1]
q2_data = list(q2)
q3_data = [len(q3)]  # Count of elements in q3
q4_data = [q4[0]]  # Only the first element is numeric
q5_data = [len(q5)]  # Count of pairs in q5
q6_data = q6

# Combine all data into a single list for processing
all_data = [q1_data, q2_data, q3_data, q4_data, q5_data, q6_data]

# Calculate means and standard deviations
means = [np.mean(data) if data else 0 for data in all_data]
std_devs = [np.std(data) if len(data) > 1 else 0 for data in all_data]

# Calculate confidence intervals (95% CI)
conf_intervals = [(mean - 1.96 * (std / np.sqrt(len(data))) if len(data) > 1 else 0,
                  mean + 1.96 * (std / np.sqrt(len(data))) if len(data) > 1 else 0)
                 for mean, std, data in zip(means, std_devs, all_data)]

means, std_devs, conf_intervals
