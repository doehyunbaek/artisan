str_replace_editor create /workspace/compare_table.py --file_text '#!/usr/bin/env python3
import re
import sys

# Parse expected table from expected.md
with open('"'"'/workspace/expected.md'"'"', '"'"'r'"'"') as f:
    expected = f.read()

# Extract AIC, BIC, logLik, deviance, df.residuals
aic_match = re.search(r'"'"'\*\*AIC\*\*\s*\|\s*([0-9.]+)'"'"', expected)
bic_match = re.search(r'"'"'\*\*BIC\*\*\s*\|\s*([0-9.]+)'"'"', expected)
loglik_match = re.search(r'"'"'\*\*logLik\*\*\s*\|\s*([\-0-9.]+)'"'"', expected)
dev_match = re.search(r'"'"'\*\*deviance\*\*\s*\|\s*([0-9.]+)'"'"', expected)
df_match = re.search(r'"'"'\*\*df.residuals\*\*\s*\|\s*([0-9]+)'"'"', expected)

expected_aic = float(aic_match.group(1))
expected_bic = float(bic_match.group(1))
expected_loglik = float(loglik_match.group(1))
expected_dev = float(dev_match.group(1))
expected_df = int(df_match.group(1))

# Extract scaled residuals
resid_match = re.search(r'"'"'Min ([\-0-9.]+), 1Q ([\-0-9.]+), Median ([\-0-9.]+), 3Q ([\-0-9.]+), Max ([\-0-9.]+)'"'"', expected)
resid_min = float(resid_match.group(1))
resid_1q = float(resid_match.group(2))
resid_median = float(resid_match.group(3))
resid_3q = float(resid_match.group(4))
resid_max = float(resid_match.group(5))

# Extract random effects
random_match = re.search(r'"'"'Number of obs: ([0-9]+), groups: User, ([0-9]+)'"'"', expected)
obs = int(random_match.group(1))
groups = int(random_match.group(2))

# Parse reproduced table from Table-4-RQ1-comp.txt
with open('"'"'/workspace/ICSE2024-funcConstructs-Artifacts/results/Table-4-RQ1-comp.txt'"'"', '"'"'r'"'"') as f:
    reproduced = f.read()

# Extract AIC, BIC etc
repro_aic_match = re.search(r'"'"'AIC\s+([0-9.]+)\s+BIC\s+([0-9.]+)\s+logLik\s+([\-0-9.]+)\s+deviance\s+([0-9.]+)\s+df.resid\s+([0-9]+)'"'"', reproduced, re.MULTILINE)
repro_aic = float(repro_aic_match.group(1))
repro_bic = float(repro_aic_match.group(2))
repro_loglik = float(repro_aic_match.group(3))
repro_dev = float(repro_aic_match.group(4))
repro_df = int(repro_aic_match.group(5))

# Extract scaled residuals
repro_resid_match = re.search(r'"'"'Min\s+([\-0-9.]+)\s+1Q\s+([\-0-9.]+)\s+Median\s+([\-0-9.]+)\s+3Q\s+([\-0-9.]+)\s+Max\s+([\-0-9.]+)'"'"', reproduced)
repro_min = float(repro_resid_match.group(1))
repro_1q = float(repro_resid_match.group(2))
repro_median = float(repro_resid_match.group(3))
repro_3q = float(repro_resid_match.group(4))
repro_max = float(repro_resid_match.group(5))

# Extract random effects
repro_random_match = re.search(r'"'"'Number of obs: ([0-9]+), groups:\s+User, ([0-9]+)'"'"', reproduced)
repro_obs = int(repro_random_match.group(1))
repro_groups = int(repro_random_match.group(2))

# Extract fixed effects from Table-4-RQ1-comp-coeff.txt
with open('"'"'/workspace/ICSE2024-funcConstructs-Artifacts/results/Table-4-RQ1-comp-coeff.txt'"'"', '"'"'r'"'"') as f:
    coeff_lines = f.readlines()

# Skip header
coeffs = []
for line in coeff_lines[1:]:
    parts = line.strip().split('"'"','"'"')
    or_val = float(parts[0])
    estimate = float(parts[1])
    std_err = float(parts[2])
    z_val = float(parts[3])
    p_val = float(parts[4])
    coeffs.append((or_val, estimate, std_err, z_val, p_val))

# Expected coefficients from table (manually)
expected_coeffs = [
    (1.15, 0.14, 0.89, 0.16, 0.88),
    (6.11, 1.81, 0.60, 3.00, 0.02),
    (1.02, 0.02, 0.11, 0.15, 0.88),
    (0.86, -0.15, 0.16, -0.94, 0.61),
    (1.00, -0.00, 0.00, -1.12, 0.61),
    (1.19, 0.18, 0.66, 0.27, 0.88),
    (0.65, -0.43, 0.17, -2.58, 0.03)
]

print("=== COMPARISON ===")
print(f"AIC: expected {expected_aic}, reproduced {repro_aic}, match? {abs(expected_aic - repro_aic) < 0.1}")
print(f"BIC: expected {expected_bic}, reproduced {repro_bic}, match? {abs(expected_bic - repro_bic) < 0.1}")
print(f"logLik: expected {expected_loglik}, reproduced {repro_loglik}, match? {abs(expected_loglik - repro_loglik) < 0.1}")
print(f"deviance: expected {expected_dev}, reproduced {repro_dev}, match? {abs(expected_dev - repro_dev) < 0.1}")
print(f"df.residuals: expected {expected_df}, reproduced {repro_df}, match? {expected_df == repro_df}")
print()
print(f"Scaled residuals:")
print(f"Min: expected {resid_min}, reproduced {repro_min}, diff {abs(resid_min - repro_min)}")
print(f"1Q: expected {resid_1q}, reproduced {repro_1q}, diff {abs(resid_1q - repro_1q)}")
print(f"Median: expected {resid_median}, reproduced {repro_median}, diff {abs(resid_median - repro_median)}")
print(f"3Q: expected {resid_3q}, reproduced {repro_3q}, diff {abs(resid_3q - repro_3q)}")
print(f"Max: expected {resid_max}, reproduced {repro_max}, diff {abs(resid_max - repro_max)}")
print()
print(f"Random effects:")
print(f"Observations: expected {obs}, reproduced {repro_obs}, match? {obs == repro_obs}")
print(f"Groups: expected {groups}, reproduced {repro_groups}, match? {groups == repro_groups}")
print()
print("Fixed effects:")
for i in range(len(expected_coeffs)):
    exp = expected_coeffs[i]
    rep = coeffs[i]
    print(f"Term {i}:")
    print(f"  OR: expected {exp[0]:.2f}, reproduced {rep[0]:.2f}, diff {abs(exp[0] - rep[0])}")
    print(f"  Estimate: expected {exp[1]:.2f}, reproduced {rep[1]:.2f}, diff {abs(exp[1] - rep[1])}")
    print(f"  Std.Error: expected {exp[2]:.2f}, reproduced {rep[2]:.2f}, diff {abs(exp[2] - rep[2])}")
    print(f"  z value: expected {exp[3]:.2f}, reproduced {rep[3]:.2f}, diff {abs(exp[3] - rep[3])}")
    print(f"  Pr(>|z|): expected {exp[4]:.2f}, reproduced {rep[4]:.2f}, diff {abs(exp[4] - rep[4])}")
    print()

# Check if all values match within reasonable tolerance
def approx_eq(a, b, tol=0.02):
    return abs(a - b) < tol

all_match = True
all_match &= approx_eq(expected_aic, repro_aic)
all_match &= approx_eq(expected_bic, repro_bic)
all_match &= approx_eq(expected_loglik, repro_loglik)
all_match &= approx_eq(expected_dev, repro_dev)
all_match &= expected_df == repro_df
all_match &= approx_eq(resid_min, repro_min)
all_match &= approx_eq(resid_1q, repro_1q)
all_match &= approx_eq(resid_median, repro_median)
all_match &= approx_eq(resid_3q, repro_3q)
all_match &= approx_eq(resid_max, repro_max)
all_match &= obs == repro_obs
all_match &= groups == repro_groups

for i in range(len(expected_coeffs)):
    exp = expected_coeffs[i]
    rep = coeffs[i]
    all_match &= approx_eq(exp[0], rep[0], 0.01)
    all_match &= approx_eq(exp[1], rep[1], 0.01)
    all_match &= approx_eq(exp[2], rep[2], 0.01)
    all_match &= approx_eq(exp[3], rep[3], 0.02)
    all_match &= approx_eq(exp[4], rep[4], 0.01)

print(f"All values match within tolerance? {all_match}")
if all_match:
    sys.exit(0)
else:
    sys.exit(1)'
