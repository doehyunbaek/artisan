            if v is None or v == '':
                continue
            data[c].append(float(v))

def quartiles(values):
    vs = sorted(values)
    n = len(vs)
    def median(lst):
        m = len(lst)
        if m == 0:
            return float('nan')
        if m % 2 == 1:
            return lst[m//2]
        return 0.5*(lst[m//2-1] + lst[m//2])
    q2 = median(vs)
    mid = n//2
    if n % 2 == 0:
        lower = vs[:mid]
        upper = vs[mid:]
    else:
        lower = vs[:mid]
        upper = vs[mid+1:]
    q1 = median(lower)
    q3 = median(upper)
    return q1, q2, q3

