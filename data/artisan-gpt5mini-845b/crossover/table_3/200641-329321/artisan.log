#!/usr/bin/env python3
import re, sys
from decimal import Decimal, ROUND_HALF_UP

def read_table(path):
    with open(path, 'r', encoding='utf-8') as f:
        lines = [l.rstrip("\n") for l in f]
    return lines

def parse_rows(lines):
    # return list of data rows (list of cell strings) excluding header and separator
    rows = []
    started = False
    for i,ln in enumerate(lines):
        if ln.strip().startswith("| Fuzzer"):
            # header found; next line is separator; data follows
            started = True
            continue
        if started:
            if ln.strip().startswith("| ---") or ln.strip().startswith("|-"):
                # skip separator line (already past)
                continue
            if ln.strip().startswith("|"):
                cells = [c for c in ln.split("|")[1:-1]]
                rows.append([c for c in cells])
            else:
                break
    return rows

# Read expected template and computed medians
expected_lines = read_table("/workspace/expected.md")
computed_lines = read_table("/workspace/repro.txt")

exp_rows = parse_rows(expected_lines)
comp_rows = parse_rows(computed_lines)

if len(exp_rows) != len(comp_rows):
    # If mismatch in row counts, proceed but map by min rows
    pass

# Helper to extract digits from a numeric string (e.g., " 1234.5" -> digits list)
def decimal_round_str(val_str, q_after, q_before):
    # val_str is like "755.0" or "    —"
    v = val_str.strip()
    if v in ("—","-","", "—"):
        return None
    try:
        d = Decimal(v)
    except Exception:
        try:
            d = Decimal(v.replace(",", ""))
        except Exception:
            return None
    # quantize to q_after decimals
    if q_after > 0:
        quant = Decimal('1.' + ('0'*q_after))
        d = d.quantize(quant, rounding=ROUND_HALF_UP)
    else:
        d = d.quantize(Decimal('1'), rounding=ROUND_HALF_UP)
    s = format(d, 'f')  # no exponent, standard form
    # separate sign
    if s.startswith('-'):
        s = s[1:]
    # ensure fractional has q_after digits
    if '.' in s:
        intp, frac = s.split('.',1)
    else:
        intp, frac = s, ''
    if q_after > 0:
        frac = (frac + '0'*q_after)[:q_after]
        s = intp + '.' + frac
    else:
        s = intp
    # Ensure integer part length - pad with zeros on left if needed to match placeholders
    if len(intp) < q_before:
        intp = intp.rjust(q_before, '0')
    # If integer part longer than q_before, keep full length (digits will exceed placeholders — risky)
    # We'll still return full digits; replacement will use only as many digits as placeholders
    if q_after > 0:
        return intp + '.' + (frac if q_after>0 else '')
    else:
        return intp

# Build filled expected lines
filled_lines = []
data_row_idx = 0
for ln in expected_lines:
    if ln.strip().startswith("|") and not ln.strip().startswith("| Fuzzer") and not re.match(r"\|\s*-{3,}", ln):
        # a table row
        # split into cells keeping separators
        parts = ln.split("|")
        # parts[0] is before first pipe (empty), parts[-1] after last pipe (empty)
        cells = parts[1:-1]
        filled_cells = []
        # pick corresponding computed row (if available)
        if data_row_idx < len(comp_rows):
            comp_cells = comp_rows[data_row_idx]
        else:
            comp_cells = None
        for ci, cell in enumerate(cells):
            if '?' not in cell:
                filled_cells.append(cell)
                continue
            # cell contains placeholders to fill
            # get corresponding computed cell if exists; map by column index
            comp_val = None
            if comp_cells is not None and ci < len(comp_cells):
                comp_val = comp_cells[ci].strip()
            # Count number of '?' before and after decimal in template (ignore non ? chars like commas/dot)
            # Find contiguous ? groups spanning possible punctuation (we treat all '?' occurrences in cell)
            # For mapping we need total number and also how many after dot
            # Determine q_after by counting ? after literal '.' in cell (if any)
            if '.' in cell:
                right = cell.split('.',1)[1]
                q_after = right.count('?')
                left = cell.split('.',1)[0]
                q_before = left.count('?')
            else:
                q_after = 0
                q_before = cell.count('?')
            # produce formatted string from comp_val
            formatted = decimal_round_str(comp_val if comp_val is not None else "0", q_after, q_before)
            if formatted is None:
                # fallback: replace all ? with '0'
                replaced = list(cell)
                dig_idx = 0
                for i,ch in enumerate(replaced):
                    if ch == '?':
                        replaced[i] = '0'
                filled_cells.append("".join(replaced))
