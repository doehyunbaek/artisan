FROM ubuntu:20.04
ENV USER_NAME=axa-evaluation
ENV USER_DIR=/home/${USER_NAME}
##
ENTRYPOINT [ "/bin/bash" ]
##
# INSTALL PRELIMINARY TOOLS
RUN \
apt-get update && \
apt-get -y install apt-transport-https ca-certificates software-properties-common && \
apt-get update && \
apt-get -y install apt-utils && \
apt-get update && \
apt-get -y install git \
curl \
less \
nano \
vim \
zip \
zlib1g-dev \
wget \
cmake \
nodejs \
npm \
python3.5 \
unzip \
jq \
aptitude \
automake \
autoconf \
bison \
build-essential \
clang \
doxygen \
flex \
graphviz \
libffi-dev \
libncurses5-dev \
libopenmpi-dev \
libsqlite3-dev \
libtool \
lsb-release \
mcpp \
nano \
openmpi-bin \
python3-matplotlib \
python3-numpy \
python3-pandas \
zip \
zlib1g-dev \ 
gcc g++ libtinfo5
##
# Install OpenJDK 8 version 342
RUN \ 
cd / && \
mkdir /JDK && \
cd JDK && \
apt-get -y autoremove openjdk* && \ 
apt-get -y purge openjdk* && \
wget https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.12%2B7/OpenJDK17U-jdk_x64_linux_hotspot_17.0.12_7.tar.gz && \
tar xvf /JDK/OpenJDK17U-jdk_x64_linux_hotspot_17.0.12_7.tar.gz -C /opt && \
cd / && \
update-alternatives --install /usr/bin/java java /opt/jdk-17.0.12+7/bin/java 1000 && \
update-alternatives --install /usr/bin/javac javac /opt/jdk-17.0.12+7/bin/javac 1000 && \
update-alternatives --install /usr/bin/jar jar /opt/jdk-17.0.12+7/bin/jar 1000        
#
ENV JAVA_HOME=/opt/jdk-17.0.12+7/
ENV PATH="$JAVA_HOME/bin:$PATH"

# Install Maven
RUN mkdir /maven
RUN cd /maven && wget https://dlcdn.apache.org/maven/maven-3/3.9.8/binaries/apache-maven-3.9.8-bin.tar.gz
RUN cd /maven && tar -xvf apache-maven-3.9.8-bin.tar.gz
RUN cd /maven && mv apache-maven-3.9.8 /opt/
#
ENV M2_HOME='/opt/apache-maven-3.9.8'
ENV PATH="/opt/apache-maven-3.9.8/bin:$PATH"
#
#
# Install dex2jar
RUN \
cd / && \
mkdir dex2jar && \
cd dex2jar && \
wget https://github.com/pxb1988/dex2jar/releases/download/v2.4/dex-tools-v2.4.zip && \
unzip dex-tools-v2.4.zip
#
# Install tokei
RUN \
mkdir /tokei && \
wget https://github.com/XAMPPRocky/tokei/releases/download/v12.1.2/tokei-x86_64-unknown-linux-gnu.tar.gz && \
tar -xf tokei-x86_64-unknown-linux-gnu.tar.gz -C /usr/local/bin/
#
# Install svf-tools
RUN \
cd / && \
npm install svf-lib@1.0.1838 --prefix ~/prefix
ENV PATH="/root/prefix/node_modules/llvm-14.0.0.obj/bin:$PATH"
##
## INSTALL SBT
#COPY container-files /
##
RUN \
echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list && \
echo "deb https://repo.scala-sbt.org/scalasbt/debian /" | tee /etc/apt/sources.list.d/sbt_old.list && \
curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | apt-key add && \
apt-get update && \
apt-get install sbt
#
# install ant
RUN cd / && wget https://dlcdn.apache.org//ant/binaries/apache-ant-1.10.14-bin.zip && \
unzip apache-ant-1.10.14-bin.zip
##
## INSTALL TAJS
## 
ENV TAJS_XL_COMMIT_ID="e79309be0ebd6d603c5a1ad365054dcadc82e8cd"
RUN cd / && \
mkdir tajs && \
cd /tajs && git clone https://github.com/stg-tud/TAJS-xl.git
RUN cd /tajs/TAJS-xl && git checkout ${TAJS_XL_COMMIT_ID}
RUN cd /tajs/TAJS-xl && chmod 777 updatesubmoduleremotes.sh && chmod 777 maveninstall.sh && \
./updatesubmoduleremotes.sh && git submodule update --init --recursive
RUN cd /tajs/TAJS-xl && /apache-ant-1.10.14/bin/ant && ./maveninstall.sh
##
## INSTALL SVF
##
ENV SVF_JAVA_COMMIT_ID="38d3beab1316a511577b4f97aaea24ab66345532"
RUN mkdir /svf && cd /svf && \
        git clone  https://github.com/JuliusNmn/SVF-Java SVF-Java && \
        cd SVF-Java && git checkout ${SVF_JAVA_COMMIT_ID}
RUN cd /root/prefix/node_modules && pwd
RUN cd /svf/SVF-Java && mkdir build && cd build && \
cmake .. \
        -DSVF_DIR="/root/prefix/node_modules/SVF" \
        -DLLVM_DIR="/root/prefix/node_modules/llvm-14.0.0.obj" \
        -DZ3_DIR="/root/prefix/node_modules/z3.obj" \
        -DJAVA_HOME=/opt/jdk-17.0.12+7 && \
        make jarmvn
#      
##
## INSTALL OPAL
ENV OPAL_BRANCH="feature/crosslanguage"
ENV OPAL_COMMIT_ID="3082b68697a214f642b426d879fa13be4ae1f84f"
##
RUN cd / && \
git clone https://github.com/stg-tud/opal.git && \
cd opal && \
git checkout ${OPAL_BRANCH} && \
git reset --hard ${OPAL_COMMIT_ID} 
#
# symlink llvm-objcopy-14 to /root/prefix/node_modules/llvm-14.0.0.obj/bin/llvm-objcopy
RUN ln -s /root/prefix/node_modules/llvm-14.0.0.obj/bin/llvm-objcopy /root/prefix/node_modules/llvm-14.0.0.obj/bin/llvm-objcopy-14
RUN ln -s /root/prefix/node_modules/llvm-14.0.0.obj/bin/llvm-dis /root/prefix/node_modules/llvm-14.0.0.obj/bin/llvm-dis-14
#
# build OPAL & fixtures
RUN cd /opal && sbt "project Validate; test:compile"
#
RUN mkdir runner
COPY runner /runner
COPY /runner /runner
</output>
