    f.write(f"| **Mdn.** |       {out['prm'][1]}      |         {out['event'][1]}        |          {out['path'][1]}         |  **{out['roam_total'][1]}**  |   {out['recdroid'][1]}  |  {out['yakusu'][1]} |\\n")

print('Reproduction file written to /workspace/repro.txt with indices:', indices)
PY

