EOTABLE
# Section 2: Artifact download
artisan get https://zenodo.org/records/10496086
# Section 3: Reproduction commands (populate from reviewed steps)
# Use pre-generated ResearchResults CSVs to reconstruct Table 3 counts.
RR_DIR="Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor/data/Release-20220811/ResearchResults"

# Ensure rawdata is present (idempotent).
if [ ! -d "Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor/data/Release-20220811" ]; then
  docker build -t cargo-ecosystem-monitor Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor >/dev/null 2>&1
  docker run -d --init --entrypoint bash \
    -p 127.0.0.1:12345:5432 \
    -e POSTGRES_PASSWORD="postgres" \
    -w /app \
    --mount type=bind,src="$(pwd)/Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor",target=/app \
    --name cargo-ecosystem-monitor-c1 cargo-ecosystem-monitor -c 'sleep infinity' >/dev/null 2>&1 || true
  docker exec cargo-ecosystem-monitor-c1 /bin/bash --noprofile --norc -c "make postgresql && make download_20220811_rawdata" >/dev/null 2>&1
fi

# Now RR_DIR should exist with all CSV result files.
# Compute distinct-version counts per status for each metric using awk.

# Direct Usage: distinct id per status from Result2_RUFUsage.csv
direct_tmp=$(mktemp)
awk -F',' 'NR>1 {
  gsub(/"/,"",$1); gsub(/"/,"",$4);
  id=$1; status=$4;
  key=status":"id;
  if (!seen[key]++) cnt[status]++
}
END { for (s in cnt) printf "%s %d\n", s, cnt[s] }' "$RR_DIR/Result2_RUFUsage.csv" | sort > "$direct_tmp"

# Uncond Impact: distinct version_from per status from Result3_1UncondImpact.csv
uncond_tmp=$(mktemp)
awk -F',' 'NR>1 {
  gsub(/"/,"",$1); gsub(/"/,"",$3);
  ver=$1; status=$3;
  key=status":"ver;
  if (!seen[key]++) cnt[status]++
}
END { for (s in cnt) printf "%s %d\n", s, cnt[s] }' "$RR_DIR/Result3_1UncondImpact.csv" | sort > "$uncond_tmp"

# Cond Impact: distinct ver per status from Result3_1CondImpact.csv
cond_tmp=$(mktemp)
awk -F',' 'NR>1 {
  gsub(/"/,"",$1); gsub(/"/,"",$3);
  ver=$1; status=$3;
  key=status":"ver;
  if (!seen[key]++) cnt[status]++
}
END { for (s in cnt) printf "%s %d\n", s, cnt[s] }' "$RR_DIR/Result3_1CondImpact.csv" | sort > "$cond_tmp"

# Total Impact: distinct ver per status from Result3_1TotalImpact.csv
total_tmp=$(mktemp)
awk -F',' 'NR>1 {
  gsub(/"/,"",$1); gsub(/"/,"",$3);
  ver=$1; status=$3;
  key=status":"ver;
  if (!seen[key]++) cnt[status]++
}
END { for (s in cnt) printf "%s %d\n", s, cnt[s] }' "$RR_DIR/Result3_1TotalImpact.csv" | sort > "$total_tmp"

# Helper to fetch count for a given status + metric file
get_count () {
  status="$1"; file="$2"
  val=$(awk -v s="$status" '$1==s {print $2}' "$file")
  if [ -z "$val" ]; then val=0; fi
  printf "%s" "$val"
}

# Build the reproduced markdown table.
{
  echo "**Table 3: Summary of RUF impacts. The table shows how package versions are impacted by different types of RUF and through different dependencies.**"
  echo
  echo "| RUF Type   | Direct Usage | Uncond Impact |  Cond Impact |        Total |"
  echo "| ---------- | -----------: | ------------: | -----------: | -----------: |"
  for status in accepted active incomplete removed unknown; do
    case "$status" in
      accepted)  label="Accepted" ;;
      active)    label="Active" ;;
      incomplete)label="Incomplete" ;;
      removed)   label="Removed" ;;
      unknown)   label="Unknown" ;;
    esac
    d=$(get_count "$status" "$direct_tmp")
    u=$(get_count "$status" "$uncond_tmp")
    c=$(get_count "$status" "$cond_tmp")
    t=$(get_count "$status" "$total_tmp")
    # Format with thousands separators using printf and sed.
    fd=$(printf "%'d" "$d" | sed "s/,/,/g")
    fu=$(printf "%'d" "$u" | sed "s/,/,/g")
    fc=$(printf "%'d" "$c" | sed "s/,/,/g")
    ft=$(printf "%'d" "$t" | sed "s/,/,/g")
    printf "| %-9s | %11s | %12s | %11s | %11s |\n" "$label" "$fd" "$fu" "$fc" "$ft"
  done
} > /workspace/repro.txt

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_rust_table_3.sh
artisan submit /workspace/repro_rust_table_3.sh
