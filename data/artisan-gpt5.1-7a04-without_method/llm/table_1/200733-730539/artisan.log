cat(\"| AI tool familiarity | \", ai_prog,         \" | \", ai_time,         \" | \", ai_under,        \" | \", ai_prog_prof,     \" | \", ai_prog_stud,     \" |\\n\", sep = \"\")
cat(\"| Uses GILT           | \", gilt_prog,       \" | \", gilt_time,       \" | \", gilt_under,      \" | \", gilt_prog_prof,   \" | \", gilt_prog_stud,   \" |\\n\", sep = \"\")
