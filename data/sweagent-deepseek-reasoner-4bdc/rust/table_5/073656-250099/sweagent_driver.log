    23	
    24	-- Result 3.1 RUF Impact
    25	-- Direct Usage (See Result 2: RUF Usage)
    26	-- Uncond Impact
    27	WITH uncon_ver AS
    28	  (SELECT id, status FROM version_feature_ori INNER JOIN feature_status
    29	  ON name=feature WHERE conds = '' AND feature is not NULL)
    30	SELECT status, COUNT(DISTINCT version_from) FROM uncon_ver INNER JOIN dep_version ON
    31	version_to=id GROUP BY status;
    32	-- Uncond Impact (Complete)
    33	WITH uncon_ver AS
    34	  (SELECT id, name as ruf, status FROM version_feature_ori INNER JOIN feature_status
    35	  ON name=feature WHERE conds = '' AND feature is not NULL)
    36	SELECT DISTINCT version_from, ruf, status FROM uncon_ver INNER JOIN dep_version ON
    37	version_to=id;
    38	
    39	-- Cond Impact
    40	DROP TABLE IF EXISTS tmp_ruf_impact;
    41	CREATE TABLE tmp_ruf_impact AS (
    42	    SELECT DISTINCT version_from as ver, nightly_feature as ruf, status FROM dep_version_feature 
    43	    INNER JOIN feature_status ON name=nightly_feature 
    44	);
    45	WITH uncon_ver AS
    46	  (SELECT id, name as ruf, status FROM version_feature INNER JOIN feature_status
    47	  ON name=feature WHERE conds = '' AND feature is not NULL)
    48	INSERT INTO tmp_ruf_impact
    49	  SELECT DISTINCT version_from, ruf, status FROM uncon_ver INNER JOIN dep_version ON
    50	  version_to=id;
    51	SELECT status, COUNT(DISTINCT ver) FROM tmp_ruf_impact GROUP BY status;
    52	-- Cond Impact (Complete)
    53	SELECT DISTINCT * FROM tmp_ruf_impact;
    54	
    55	-- Total Impact
    56	DROP TABLE IF EXISTS tmp_ruf_impact;
    57	CREATE TABLE tmp_ruf_impact AS (
    58	    SELECT version_from as ver, nightly_feature as ruf, status FROM dep_version_feature 
    59	    INNER JOIN feature_status ON name=nightly_feature 
    60	);
    61	WITH uncon_ver AS
    62	  (SELECT id, name as ruf, status FROM version_feature INNER JOIN feature_status
    63	  ON name=feature WHERE conds = '' AND feature is not NULL)
    64	INSERT INTO tmp_ruf_impact
    65	  SELECT DISTINCT version_from, ruf, status FROM uncon_ver INNER JOIN dep_version ON
    66	  version_to=id;
    67	INSERT INTO tmp_ruf_impact
    68	  SELECT  DISTINCT id, feature, status FROM version_feature INNER JOIN feature_status 
    69	  ON name=feature WHERE feature IS NOT NULL;
    70	SELECT status, COUNT(DISTINCT ver) FROM tmp_ruf_impact GROUP BY status;
    71	-- Cond Impact (Complete)
