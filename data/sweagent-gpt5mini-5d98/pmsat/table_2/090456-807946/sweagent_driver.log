results = []
for file in (file for file in files if file.name.startswith('pmsatLearned-')):
    results.append(json.load(open(file)))
results.sort(key=lambda x: x['num_states'])

def mean(lst):
    return sum(lst)/len(lst) if lst else 0

def mx(lst):
    return max(lst) if lst else 0

def mn(lst):
    return min(lst) if lst else 0


dominant_delta_freq = list(map(lambda x: x['dominant_delta_freq'], results))
glitched_delta_freq = list(map(lambda x: x['glitched_delta_freq'], results))
glitched_delta_freq = [g if g else [0] for g in glitched_delta_freq]
dominant_reachable_states = list(map(lambda x: x['dominant_reachable_states'], results))
num_states = list(map(lambda x: x['num_states'], results))
costs = list(map(lambda x: x['cost'], results))

bisimilar_to_nstates_label = 'bisimilar_to_pmsat_with_states'
bisimilarity = list(map(lambda x: x[bisimilar_to_nstates_label] if x.get(bisimilar_to_nstates_label) else x['num_states'], results))

