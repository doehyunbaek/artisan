```
mvn -pl :zeugma-evaluation-tools \
  meringue:fuzz meringue:analyze \
  -P<SUBJECT>,<FUZZER> \
  -Dmeringue.outputDirectory=<OUTPUT_DIRECTORY> \
  -Dmeringue.duration=<DURATION>
```

