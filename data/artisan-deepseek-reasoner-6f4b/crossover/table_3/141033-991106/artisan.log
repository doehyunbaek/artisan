import pandas as pd
import numpy as np

df = pd.read_csv('/home/data/coverage.csv')
# Convert time string to seconds
def to_seconds(t):
    # format: "0 days 00:00:00" or "0 days 00:00:00.810810810"
    parts = t.split()
    days = int(parts[0])
    time_part = parts[2]
    h, m, s = time_part.split(':')
    seconds = days*86400 + int(h)*3600 + int(m)*60 + float(s)
    return seconds

df['time_seconds'] = df['time'].apply(to_seconds)

# Define target times
five_min = 300
three_hours = 10800

# Filter rows close to target times (since times might be exactly those)
# We'll group by campaign, fuzzer, subject and find the row with time closest to target.
# Actually, there should be exact matches. Let's check.
# For each campaign, get the row where time_seconds is closest to five_min and three_hours.
campaigns = df.groupby(['campaign_id', 'fuzzer', 'subject'])

def get_value(group, target):
    idx = (group['time_seconds'] - target).abs().idxmin()
    return group.loc[idx, 'covered_branches']

five_min_vals = campaigns.apply(lambda g: get_value(g, five_min)).reset_index()
five_min_vals.rename(columns={0: 'covered_5m'}, inplace=True)
three_hours_vals = campaigns.apply(lambda g: get_value(g, three_hours)).reset_index()
three_hours_vals.rename(columns={0: 'covered_3h'}, inplace=True)

# Merge
merged = pd.merge(five_min_vals, three_hours_vals, on=['campaign_id', 'fuzzer', 'subject'])

# Compute median per fuzzer, subject
medians = merged.groupby(['fuzzer', 'subject'])[['covered_5m', 'covered_3h']].median().reset_index()

# Pivot for table
pivot_5m = medians.pivot(index='fuzzer', columns='subject', values='covered_5m')
pivot_3h = medians.pivot(index='fuzzer', columns='subject', values='covered_3h')

# List fuzzers in order as in table
fuzzers_ordered = ['BeDiv-Simple', 'BeDiv-Struct', 'RLCheck', 'Zest', 'Zeugma-X', 'Zeugma-1PT', 'Zeugma-2PT', 'Zeugma-Link']
subjects_ordered = ['Ant', 'Bcel', 'Closure', 'Maven', 'Nashorn', 'Rhino', 'Tomcat']

# Reindex
pivot_5m = pivot_5m.reindex(index=fuzzers_ordered, columns=subjects_ordered)
pivot_3h = pivot_3h.reindex(index=fuzzers_ordered, columns=subjects_ordered)

print("Median branch coverage at 5 minutes:")
print(pivot_5m)
print("\nMedian branch coverage at 3 hours:")
print(pivot_3h)

# Format as markdown table
def format_number(x):
    if pd.isna(x):
        return '—'
    else:
        return f'{x:.1f}'

# Build rows
rows = []
for fuzzer in fuzzers_ordered:
    row = [fuzzer]
    for subject in subjects_ordered:
        val5 = pivot_5m.loc[fuzzer, subject]
        val3 = pivot_3h.loc[fuzzer, subject]
        row.append(format_number(val5))
        row.append(format_number(val3))
    rows.append(row)

# Header
header = ['Fuzzer']
for sub in subjects_ordered:
    header.append(f'{sub} 5M')
    header.append(f'{sub} 3H')

print("\nTable Markdown:")
print('| ' + ' | '.join(header) + ' |')
print('| ' + ' | '.join(['---']*len(header)) + ' |')
for row in rows:
    print('| ' + ' | '.join(row) + ' |')
EOF
