| Approvals | ${ORs[4]} | ${ESTs[4]} | ${SEs[4]} | ${Zs[4]} | ${Ps[4]} |
| StudentTrue | ${ORs[5]} | ${ESTs[5]} | ${SEs[5]} | ${Zs[5]} | ${Ps[5]} |
| MainFactorProc:Compl. | ${ORs[6]} | ${ESTs[6]} | ${SEs[6]} | ${Zs[6]} | ${Ps[6]} |
EOT

# Format and submit
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF

