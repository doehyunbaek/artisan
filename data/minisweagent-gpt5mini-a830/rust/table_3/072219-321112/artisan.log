<mini_swe_agent_bash>
python3 - <<'PY'
import csv, os
base = "/workspace/TSERelease-20220811/TSERelease-20220811/ResearchResults"
files = {
  "Direct Usage": ("Result2-1_RUFUsage.csv", 0, 3),    # id col index, status col index
  "Uncond Impact": ("Result2-2_1UncondImpact.csv", 0, 2), # version_from, status
  "Cond Impact": ("Result2-2_1CondImpact.csv", 0, 2),  # ver, status
  "Total": ("Result2-2_1TotalImpact.csv", 0, 2)       # ver, status
}
statuses = ["Accepted","Active","Incomplete","Removed","Unknown"]
# initialize sets to collect distinct version ids per status for each metric
agg = {metric: {s:set() for s in statuses} for metric in files}

def norm_status(s):
    if s is None: return "Unknown"
    s = s.strip().lower()
    if s == "accepted": return "Accepted"
    if s == "active": return "Active"
    if s == "incomplete": return "Incomplete"
    if s == "removed": return "Removed"
    return "Unknown"

for metric, (fname, id_idx, status_idx) in files.items():
    path = os.path.join(base, fname)
    if not os.path.exists(path):
        # skip if missing
        continue
    with open(path, newline='', encoding='utf-8') as f:
        reader = csv.reader(f)
        header = next(reader, None)
        for row in reader:
            if not row: continue
            # guard indices
            if len(row) <= max(id_idx, status_idx):
                continue
            vid = row[id_idx].strip().strip('"')
            st = row[status_idx].strip().strip('"')
            stn = norm_status(st)
            try:
                # ensure numeric ids are used as strings (already)
                agg[metric][stn].add(vid)
            except Exception:
                pass

# produce table output
out_lines = []
out_lines.append("Table 3: Summary of RUF impacts (reproduced)\n")
out_lines.append("| RUF Type   | Direct Usage | Uncond Impact |  Cond Impact |        Total |")
out_lines.append("| ---------- | -----------: | ------------: | -----------: | -----------: |")
for s in statuses:
    du = len(agg["Direct Usage"][s])
    ui = len(agg["Uncond Impact"][s])
    ci = len(agg["Cond Impact"][s])
    tot = len(agg["Total"][s])
    out_lines.append(f"| {s:9} | {du:11,} | {ui:12,} | {ci:11,} | {tot:11,} |")
out = "\n".join(out_lines) + "\n"
with open("/workspace/repro_table3.txt","w",encoding="utf-8") as f:
    f.write(out)
print(out)
PY
</mini_swe_agent_bash>
