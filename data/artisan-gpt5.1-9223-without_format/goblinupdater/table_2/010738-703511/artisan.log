    vs = data[c]
    q1 = pandas_percentile(vs, 0.25)
    q2 = pandas_percentile(vs, 0.5)
    q3 = pandas_percentile(vs, 0.75)
    mn, mx = min(vs), max(vs)
    print(f"{c},{q1},{q2},{q3},{mn},{mx}")
