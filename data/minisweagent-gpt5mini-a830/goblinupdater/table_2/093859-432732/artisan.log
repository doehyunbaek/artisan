python3 - <<'PY'
import zipfile, csv, io, sys, math
zip_path = '/workspace/ASE24_data_and_tools.zip'
patterns = 'ASE24_data_and_tools/results_data/execution/'
files = []
with zipfile.ZipFile(zip_path) as z:
    for name in z.namelist():
        if name.startswith(patterns) and name.endswith('executionsData.csv'):
            files.append(name)
    if not files:
        print("ERROR: No executionsData.csv files found", file=sys.stderr)
        sys.exit(1)
    # read and combine rows, dedupe by project name (keep first occurrence)
    rows_by_name = {}
    for f in files:
        with z.open(f) as fh:
            data = fh.read().decode('utf-8', errors='replace')
        rdr = csv.DictReader(io.StringIO(data))
        # normalize header names (strip BOM and whitespace)
        if rdr.fieldnames:
            rdr.fieldnames = [h.strip().lstrip('\ufeff') if h else h for h in rdr.fieldnames]
        for r in rdr:
            # normalize keys similarly
            r = { (k.strip().lstrip('\ufeff') if k else k): v for k,v in r.items() }
            name = r.get('name') or r.get('repoName') or r.get('gitUrl')
            if not name:
                continue
            if name in rows_by_name:
                continue
            rows_by_name[name] = r

rows = list(rows_by_name.values())
if len(rows) == 0:
    print("ERROR: No rows found after combining executionsData.csv files", file=sys.stderr)
    sys.exit(2)

def to_num(x):
    if x is None: return None
    s = str(x).strip().replace(',','')
    if s == '': return None
    try:
        if '.' in s:
            return float(s)
        return int(s)
    except:
        try:
            return float(s)
        except:
            return None

# mapping to required metrics
col_map = {
    "(p)’s direct dependencies": ['directDepNumber','directDep','direct_dep','directDep','directDepNum'],
    "releases ((N_R))": ['releaseSize','release','releases','release_size','releaseSize'],
    "libraries ((N_L))": ['artifactSize','artifactSize','artifact_size','artifact','artifactCount','artifactNumber'],
    "dependency edges ((E_D))": ['dependencySize','dependencySize','dependency_size','dependency','dependencyEdges','depEdge'],
    "versions edges ((E_V))": ['versionSize','versionSize','version_size','version','versionEdges']
}

# detect actual column names present
present_cols = set()
if rows and isinstance(rows[0], dict):
    present_cols = set(rows[0].keys())

resolved = {}
for label, candidates in col_map.items():
    found = None
    for c in candidates:
