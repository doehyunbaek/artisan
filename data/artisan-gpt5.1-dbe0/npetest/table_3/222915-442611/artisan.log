from collections import defaultdict

csv_path = "NPETestArtifact/rq2_result.xlsx"

import subprocess, textwrap, os, sys, tempfile, json, math

# First convert the sheet "npedetection (2)" to a temp CSV
tmp_csv = tempfile.NamedTemporaryFile(delete=False, suffix=".csv")
tmp_csv.close()
subprocess.check_call([
    "uvx", "--from", "csvkit", "in2csv",
    "NPETestArtifact/rq2_result.xlsx",
    "--sheet", "npedetection (2)"
], stdout=open(tmp_csv.name, "w"))

groups = ["NPEX", "BugSwarm", "Defects4J", "Genesis", "Bears"]
tool_cols = {"EvoSuite": "evosuite", "NPETest": "npetest"}

def load_rows():
    with open(tmp_csv.name, newline='') as f:
        r = csv.DictReader(f)
        return [row for row in r]

rows = load_rows()

def count_scheme(key_fn, desc):
    print(f"\n=== Scheme: {desc} ===")
    for tool, col in tool_cols.items():
        seen = set()
        counts = defaultdict(int)
        for row in rows:
            grp = (row.get("a") or "").strip()
            if grp not in groups:
                continue
            val_str = (row.get(col) or "").strip()
            try:
                val = float(val_str)
            except ValueError:
                val = 0.0
            if val <= 0.0:
                continue
            key = key_fn(grp, row)
            if key in seen:
                continue
            seen.add(key)
            counts[grp] += 1
            counts["Total"] += 1
        print(f"{tool}: " + ", ".join(f"{g}={counts[g]}" for g in groups + ["Total"]))

# Scheme 1: count per row (NPE-level if each row is a unique NPE)
count_scheme(lambda grp, row: (grp, row["b"], row["c"]), "per (group, project, class) row")

# Scheme 2: count per (group, project) only
count_scheme(lambda grp, row: (grp, row["b"]), "per (group, project)")

# Scheme 3: count per (group, project, class, evosuite, npetest) to collapse exact duplicates
count_scheme(lambda grp, row: (grp, row["b"], row["c"], row["evosuite"], row["npetest"]), "per full row (collapse exact dups)")
PY
