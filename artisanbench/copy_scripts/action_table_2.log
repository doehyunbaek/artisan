from pathlib import Path

from runs_collector.dataset import RunsDataSet
from runs_analysis.resource_usage import get_tiers
from runs_analysis.name_based_analysis import simplify_and_map

# Load dataset from CSV checkpoints (as in the RQ1 notebook)
data_set = RunsDataSet(None, None, from_checkpoint=True, checkpoint_dir="./")

# Obtain repository lists for paid vs free tiers
repos_list_1, repos_list_2 = get_tiers(data_set)

tasks = ["test", "build", "release", "analyze", "lint",
         "linux", "update", "integration", "deploy", "sync"]

def compute_task_stats(repos_list):
    jobs = simplify_and_map(data_set, repos_list).copy()
    jobs["up_time_min"] = jobs["up_time"] / 60.0
    jobs = jobs[jobs["sub_names"].isin(tasks)].copy()

    total_time = sum(jobs[jobs["sub_names"] == t]["up_time"].sum() for t in tasks)
    total_runs = len(jobs)

    stats = {}
    for t in tasks:
        subset = jobs[jobs["sub_names"] == t]
        if subset.empty:
            stats[t] = {
                "vm_pct": 0.0,
                "runs_pct": 0.0,
                "time_mean": 0.0,
                "time_iqr": 0.0,
            }
            continue

        time_sum = float(subset["up_time"].sum())
        vm_pct = (time_sum / total_time * 100.0) if total_time > 0 else 0.0

        run_count = len(subset)
        runs_pct = (run_count / total_runs * 100.0) if total_runs > 0 else 0.0

        time_mean = float(subset["up_time_min"].mean())
        q75 = float(subset["up_time_min"].quantile(0.75))
        q25 = float(subset["up_time_min"].quantile(0.25))
        time_iqr = q75 - q25

        stats[t] = {
            "vm_pct": vm_pct,
            "runs_pct": runs_pct,
            "time_mean": time_mean,
            "time_iqr": time_iqr,
        }
    return stats

paid_stats = compute_task_stats(repos_list_1)
free_stats = compute_task_stats(repos_list_2)

def calc_cost_per_run_minutes(time_minutes: float) -> float:
    os_factor = 1.52
    return round(time_minutes * os_factor * 0.008, 2)

rows = []
for t in tasks:
    p = paid_stats[t]
    f = free_stats[t]
    rows.append({
        "task": t.capitalize(),
        "vm_paid": f"{p['vm_pct']:.1f}",
        "vm_free": f"{f['vm_pct']:.1f}",
        "runs_paid": f"{p['runs_pct']:.1f}",
        "runs_free": f"{f['runs_pct']:.1f}",
        "time_paid": f"{p['time_mean']:.1f}",
        "iqr_paid": f"{p['time_iqr']:.1f}",
        "time_free": f"{f['time_mean']:.1f}",
        "iqr_free": f"{f['time_iqr']:.1f}",
        "cost_paid": f"{calc_cost_per_run_minutes(p['time_mean']):.2f}",
        "cost_free": f"{calc_cost_per_run_minutes(f['time_mean']):.2f}",
    })

out_lines = []
out_lines.append("**Table 2: Summary of resource consumption by CI/CD tasks.**")
out_lines.append("")
out_lines.append("| Task        | VM time % (Paid) | VM time % (Free) | Runs % (Paid) | Runs % (Free) | VM time per run, min (Paid) | VM time per run, min (Free) | VM cost per run, $ (Paid) | VM cost per run, $ (Free) |")
out_lines.append("| ----------- | ---------------: | ---------------: | ------------: | ------------: | --------------------------: | --------------------------: | ------------------------: | ------------------------: |")

for r in rows:
    out_lines.append(
        f\"| {r['task']:<10} | {r['vm_paid']:>13} | {r['vm_free']:>13} | {r['runs_paid']:>10} | {r['runs_free']:>10} | "
        f\"{r['time_paid']:>9} ({r['iqr_paid']}) | {r['time_free']:>9} ({r['iqr_free']}) | "
        f\"{r['cost_paid']:>22} | {r['cost_free']:>22} |\"
    )

out_lines.append("")
out_lines.append("* mean (inter-quartile range)")

Path("/workspace/repro.txt").write_text("\n".join(out_lines), encoding="utf-8")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF

chmod +x /workspace/repro_action_table_2.sh
artisan submit /workspace/repro_action_table_2.sh
</mini_swe_agent_bash>
