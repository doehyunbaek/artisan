#!/usr/bin/bash
set -euo pipefail

# Section 1: Expected table
# The expected table is already provided at /workspace/expected.md.
# We intentionally do not overwrite it here.

# Section 2: Artifact download
artisan get https://zenodo.org/records/13374578

# Section 3: Reproduction commands (populate from reviewed steps)

# Load the pre-built Docker image shipped with the artifact.
docker load -i axa-artifact-image.tar

# Start the container in detached mode with a long-running bash process.
docker run -d --init --name axa-container --entrypoint bash axaimage -c 'sleep infinity'

# Run the Java/JS precision & recall experiment; capture all output in a log file inside the container.
docker exec axa-container /bin/bash --noprofile --norc -c "/runner/precisionRecallJS.sh > /tmp/precision_js.log 2>&1"

# Run the Java/Native precision & recall experiment; capture all output in a log file inside the container.
docker exec axa-container /bin/bash --noprofile --norc -c "/runner/precisionRecallNative.sh > /tmp/precision_native.log 2>&1"

# Extract metrics for Java/JS (Only Java = OPAL, Java + XL = AXA).
JS_METRICS=$(docker exec axa-container /bin/bash --noprofile --norc -c "awk '/False Positives/ {fp_opal=\$6; fp_axa=\$8} /False Negatives/ {fn_opal=\$6; fn_axa=\$8} /Precision[[:space:]]*\|/ {p_opal=\$6; p_axa=\$8} END {print fp_opal,fp_axa,fn_opal,fn_axa,p_opal,p_axa}' /tmp/precision_js.log")

