from pathlib import Path

lines = Path("ROAM-Artifact/ROAM-Artifact/Evaluation/results.md").read_text().splitlines()

# Find the header group row that starts the big table
hdr_idx = None
for i, line in enumerate(lines):
    if line.startswith("|Col1|Col2|Col3|Col4|"):
        hdr_idx = i
        break

if hdr_idx is None:
    print("Header row not found")
    raise SystemExit(1)

hdr_group = lines[hdr_idx].strip().strip('|').split('|')
hdr_metrics = lines[hdr_idx + 2].strip().strip('|').split('|')

print("Total columns in table:", len(hdr_group))

# Find ROAM's overall running time column, then infer PRM / Event / Path indices
roam_run_idx = None
for idx, (g, m) in enumerate(zip(hdr_group, hdr_metrics)):
    if g.strip() == "ROAM" and "Running<br>Time" in m:
        roam_run_idx = idx
        break

if roam_run_idx is None:
    print("ROAM Running Time column not found")
else:
    prm_idx = roam_run_idx - 3
    event_idx = roam_run_idx - 2
    path_idx = roam_run_idx - 1
    print(f"ROAM PRM Construction idx={prm_idx}")
    print(f"ROAM Event Search idx={event_idx}")
    print(f"ROAM Path Recovery+Exec idx={path_idx}")
    print(f"ROAM Total Running Time idx={roam_run_idx}")

# Find ReCDroid and Yakusu running time columns
for target in ("ReCDroid", "Yakusu"):
    for idx, (g, m) in enumerate(zip(hdr_group, hdr_metrics)):
        if g.strip() == target and "Running<br>Time" in m:
            print(f"{target} Running Time idx={idx}")
            break
