import re, math, pathlib

results_path = pathlib.Path("/workspace/ROAM-Artifact/Evaluation/results.md")
text = results_path.read_text()

lines = [l for l in text.splitlines() if l.strip()]

# Find the multi-level header (first two table rows)
h1_idx = next(i for i,l in enumerate(lines) if l.startswith("|Col1|Col2|Col3"))
h1 = lines[h1_idx].strip()
sep = lines[h1_idx+1].strip()
h2 = lines[h1_idx+2].strip()

def split_row(row):
    row = row.strip()
    if row.startswith("|"): row = row[1:]
    if row.endswith("|"): row = row[:-1]
    return [c.strip() for c in row.split("|")]

h1_cols = split_row(h1)
h2_cols = split_row(h2)
assert len(h1_cols) == len(h2_cols), f"header length mismatch {len(h1_cols)} vs {len(h2_cols)}"

# Map group header to indices where subheader is "Reproduction Result"
def is_repro_result(label):
    # Normalize HTML <br> and spaces
    norm = re.sub(r"\s+", " ", label.replace("<br>", " ")).strip().lower()
    return norm == "reproduction result"

tool_indices = {}
for idx, (g, sub) in enumerate(zip(h1_cols, h2_cols)):
    if is_repro_result(sub):
        tool = g.strip()
        tool_indices.setdefault(tool, []).append(idx)

# We expect exactly one "Reproduction Result" column for each tool of interest
for tool in ["ROAM", "ReCDroid", "Yakusu"]:
    cols = tool_indices.get(tool)
    if not cols:
        raise SystemExit(f"No reproduction-result column found for {tool}")
    if len(cols) != 1:
        raise SystemExit(f"Ambiguous reproduction-result columns for {tool}: {cols}")
tool_rr_idx = {tool: tool_indices[tool][0] for tool in ["ROAM", "ReCDroid", "Yakusu"]}

# Find index for "# Missing Steps"
missing_idx_candidates = [i for i,sub in enumerate(h2_cols) if "Missing<br>Steps" in sub]
if len(missing_idx_candidates) != 1:
    raise SystemExit(f"Expected one Missing Steps column, got {missing_idx_candidates}")
missing_idx = missing_idx_candidates[0]

# Iterate over 72 data rows
data_rows = []
for line in lines[h1_idx+3:]:
    if not line.startswith("|"):
        continue
    # Stop if table ends
    if line.startswith("|---"):
        continue
    cols = split_row(line)
    # Data rows start with an integer index in first column
    try:
        rid = int(cols[0])
    except (ValueError, IndexError):
        continue
    data_rows.append(cols)

assert len(data_rows) == 72, f"Expected 72 reports, found {len(data_rows)}"

def classify_missing(steps_str):
    try:
        n = int(steps_str)
    except ValueError:
        n = 0
    return "no_missing" if n == 0 else "with_missing"

groups = {
    "all": lambda row: True,
    "no_missing": lambda row: classify_missing(row[missing_idx]) == "no_missing",
    "with_missing": lambda row: classify_missing(row[missing_idx]) == "with_missing",
}

results = {tool: {g: {"succ":0, "tot":0} for g in groups} for tool in tool_rr_idx}

for row in data_rows:
    for gname, gpred in groups.items():
        if not gpred(row):
            continue
        for tool, idx in tool_rr_idx.items():
            val = row[idx].lower()
            is_success = (val == "success")
            results[tool][gname]["tot"] += 1
            if is_success:
                results[tool][gname]["succ"] += 1

def pct(succ, tot):
    return 0 if tot == 0 else int(round(100.0 * succ / tot))

print("Computed reproduction rates (%):")
for tool in ["ReCDroid", "Yakusu", "ROAM"]:
    line = [tool]
    for g in ["all", "no_missing", "with_missing"]:
        succ = results[tool][g]["succ"]
        tot = results[tool][g]["tot"]
        line.append(f"{pct(succ, tot)} (succ={succ}, tot={tot})")
    print(" | ".join(line))
