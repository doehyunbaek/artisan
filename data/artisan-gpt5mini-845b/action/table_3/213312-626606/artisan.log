import pandas as pd
import numpy as np
import os, sys

base = "gh_resource_study_artifact_patched/github-workflow-resource-optimization"
runs_path = os.path.join(base, "all_runs.csv")
jobs_path = os.path.join(base, "all_jobs.csv")

# Load necessary columns
runs = pd.read_csv(runs_path, usecols=['id','repo_id','conclusion'])
jobs = pd.read_csv(jobs_path, usecols=['id','run_id','up_time','start_ts'])

# Aggregate jobs per run: total up_time and earliest start_ts
jobs_runs_time = jobs.groupby('run_id', as_index=False).agg({'up_time':'sum','start_ts':'min'})

# Merge into runs to obtain per-run up_time and start_ts
runs_with_time = runs.merge(jobs_runs_time, left_on='id', right_on='run_id', how='left')

# Identify start_ts column name used (after merge it's 'start_ts' here)
start_col = 'start_ts'

# Implement get_tiers logic
month_time = 30 * 24 * 3600
os_factor = 1.52
thresh = 2000 * 60  # threshold from paper code

repos_list_1 = []
for repo_id in runs_with_time['repo_id'].dropna().unique():
    repo_id = int(repo_id)
    repo_rows = runs_with_time[runs_with_time['repo_id']==repo_id]
    # ignore rows with missing or -1 start_ts
    valid_starts = repo_rows[repo_rows[start_col].notna() & (repo_rows[start_col] != -1)]
    if valid_starts.empty:
        continue
    min_start_ts = valid_starts[start_col].min()
    max_start_ts = repo_rows[start_col].max()
    if pd.isna(max_start_ts):
        continue
    current_ts = min_start_ts
    added = False
    while current_ts <= max_start_ts:
        window_mask = (repo_rows[start_col] >= current_ts) & (repo_rows[start_col] < current_ts + month_time)
        vm_time = repo_rows.loc[window_mask, 'up_time'].sum()
        if os_factor * vm_time > thresh:
            repos_list_1.append(repo_id)
            added = True
            break
        current_ts += month_time
    # continue to next repo

all_repo_ids = runs['repo_id'].dropna().unique().tolist()
repos_list_2 = [int(r) for r in all_repo_ids if int(r) not in repos_list_1]

# Now compute Table 3 statistics (mirroring notebook code)
all_runs_1 = runs[runs['repo_id'].isin(repos_list_1)]
all_runs_2 = runs[runs['repo_id'].isin(repos_list_2)]

# Exclude job id 3253494537 as in notebook when constructing jobs per filtered runs
exclude_job_id = 3253494537
all_jobs_1 = jobs[(jobs['run_id'].isin(all_runs_1['id'])) & (jobs['id'] != exclude_job_id)]
all_jobs_2 = jobs[(jobs['run_id'].isin(all_runs_2['id'])) & (jobs['id'] != exclude_job_id)]

# Runs proportion per conclusion
conclusion_1 = all_runs_1.groupby('conclusion').agg({'id':'count'}).reset_index()
conclusion_2 = all_runs_2.groupby('conclusion').agg({'id':'count'}).reset_index()
conclusion_1['prop'] = conclusion_1['id'] * 100.0 / conclusion_1['id'].sum()
conclusion_2['prop'] = conclusion_2['id'] * 100.0 / conclusion_2['id'].sum()

# VM time proportion per conclusion: merge runs with job up_time (per run)
runs_with_time_1 = all_runs_1.merge(all_jobs_1[['run_id','up_time']], left_on='id', right_on='run_id', how='left')
runs_with_time_2 = all_runs_2.merge(all_jobs_2[['run_id','up_time']], left_on='id', right_on='run_id', how='left')

time_per_conclusion_1 = runs_with_time_1.groupby('conclusion').agg({'up_time':'sum'}).reset_index()
time_per_conclusion_2 = runs_with_time_2.groupby('conclusion').agg({'up_time':'sum'}).reset_index()
time_per_conclusion_1['prop'] = time_per_conclusion_1['up_time'] * 100.0 / time_per_conclusion_1['up_time'].sum()
time_per_conclusion_2['prop'] = time_per_conclusion_2['up_time'] * 100.0 / time_per_conclusion_2['up_time'].sum()

# Ordered conclusions
order = ["success", "failure", "skipped", "cancelled", "startup_failure", "action_required", "stale"]

# Build lookup dicts
runs_prop_1 = dict(zip(conclusion_1['conclusion'], conclusion_1['prop']))
runs_prop_2 = dict(zip(conclusion_2['conclusion'], conclusion_2['prop']))
time_prop_1 = dict(zip(time_per_conclusion_1['conclusion'], time_per_conclusion_1['prop']))
time_prop_2 = dict(zip(time_per_conclusion_2['conclusion'], time_per_conclusion_2['prop']))

# Output formatted table (matching notebook)
out_lines = []
out_lines.append("                               Runs proportion %        VM time proportion %")
out_lines.append("                              --------------------------------------------------")
out_lines.append("Conclusion                     Paid         Free         Paid         Free        ")
out_lines.append("--------------------------------------------------------------------------------")
for c in order:
    r1 = round(float(runs_prop_1.get(c, 0.0)), 1)
    r2 = round(float(runs_prop_2.get(c, 0.0)), 1)
    t1 = round(float(time_prop_1.get(c, 0.0)), 1)
    t2 = round(float(time_prop_2.get(c, 0.0)), 1)
    out_lines.append("{:<30} {:<12} {:<12} {:<12} {:<12}".format(c, r1, r2, t1, t2))

sys.stdout.write("\n".join(out_lines))
