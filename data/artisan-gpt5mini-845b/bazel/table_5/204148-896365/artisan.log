import pandas as pd, os,sys
src='/study/study/3.thematic-analysis/bazel-abandonment-labels.xlsx'
if not os.path.exists(src):
    print("MISSING_XLSX", src); sys.exit(1)
# Read the labeled-data sheet
sheet='Labeled data'
xls = pd.ExcelFile(src)
if sheet not in xls.sheet_names:
    print("SHEET_MISSING", sheet); sys.exit(1)
df = pd.read_excel(xls, sheet_name=sheet)
# Attempt to find a column that contains replacement build tool names
rep_col = None
for c in df.columns:
    cl = str(c).lower()
    if 'replac' in cl or 'replaced' in cl or 'replaced-by' in cl or 'replaced by' in cl or 'removal' in cl or 'replacement' in cl or 'replacer' in cl:
        rep_col = c; break
if rep_col is None:
    # heuristic: look for columns whose sample contains known tool names
    for c in df.columns:
        sample = ' '.join(df[c].dropna().astype(str).head(200).str.lower().tolist())
        if any(k in sample for k in ['go build','cmake','gradle','sbt','setuptools','swift','mage','nix','google cloud','cloud build']):
            rep_col = c; break
if rep_col is None:
    open('/workspace/repro.txt','w').write('')
    print("NO_REPLACEMENT_COLUMN_FOUND")
    sys.exit(0)
vals = df[rep_col].fillna('').astype(str).str.strip()
def classify(v):
    s=v.lower()
    if 'go build' in s or ('go' in s and 'build' in s):
        return 'Go Build'
    if 'swift' in s or 'swift pm' in s or s.strip().lower()=='spm':
        return 'SPM'
    if 'mage' in s:
        return 'Mage'
    if 'sbt' in s:
        return 'SBT'
    if 'gradle' in s:
        return 'Gradle'
    if 'setuptools' in s or 'set up' in s or 'setup' in s:
        return 'Setuptools'
    if 'cmake' in s:
        return 'CMake'
    # match 'make' but avoid CMake
    if 'make' in s and 'cmake' not in s:
        return 'Make'
    if 'nix' in s:
        return 'Nix'
    if ('google' in s and 'cloud' in s) or 'cloud build' in s or 'google cloud' in s:
        return 'Google Cloud Build'
    return None
mapped = vals.map(classify)
from collections import Counter
cnt = Counter([m for m in mapped if m])
keys=['Go Build','SPM','Mage','SBT','Gradle','Setuptools','CMake','Make','Nix','Google Cloud Build']
langs = {
 'Go Build':'Go',
 'SPM':'Swift',
 'Mage':'Go',
 'SBT':'Scala',
 'Gradle':'Java',
 'Setuptools':'Python',
 'CMake':'C++, Go, Python, Shell',
 'Make':'Go, JavaScript, C',
 'Nix':'Go, TypeScript, Scala, Haskell',
 'Google Cloud Build':'Go'
}
domains = {k: ('D1' if k in ['Go Build','SPM','Mage','SBT','Gradle','Setuptools'] else ('D2' if k in ['CMake','Make'] else 'D3')) for k in keys}
total = sum(cnt.get(k,0) for k in keys)
with open('/workspace/repro.txt','w') as fo:
    fo.write('**Table 5. Build technologies adopted after Bazel abandonment**\\n\\n')
    fo.write('| Domain    | Build Technology   | # Projects | Language(s)                    |\\n')
    fo.write('| --------- | ------------------ | ---------: | ------------------------------ |\\n')
    for k in keys:
        n = cnt.get(k,0)
        fo.write(f'| {domains[k]:8} | {k:18} | {n:9d} | {langs[k]} |\\n')
    fo.write(f'| **Total** |                    |     **{total}** |                                |\\n')
print("WROTE /workspace/repro.txt")
PY
&& artisan format --expected /workspace/expected.md --repro /workspace/repro.txt && echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT
