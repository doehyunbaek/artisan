rb_recutils=\$(run_proj spec-recutils.c      /home/benchmarks-RQ1N2/recutils-1.8)
rb_inetutils=\$(run_proj spec-inetutils.c    /home/benchmarks-RQ1N2/inetutils-1.9.4)
rb_snort=\$(run_proj   spec_snort-2.9.13.c   /home/benchmarks-RQ1N2/snort-2.9.13)
rb_grub=\$(run_proj    spec_Grub.c           /home/benchmarks-RQ1N2/grub)

total=\$((rb_swoole + rb_lxc + rb_wavpack + rb_flex + rb_p11 + rb_x264 + rb_recutils + rb_inetutils + rb_snort + rb_grub))

cat <<EOT
**Table 3. Experimental results for repairing 10 C projects, comparing with SAVER and FootPatch. Columns marked as # are numbers of the total true positives found by Infer-v1.1.0 and PROVENFIX, summarised from Table 2. The numbers of false positives reported by Infer-v0.9.3 are marked as +n.**

