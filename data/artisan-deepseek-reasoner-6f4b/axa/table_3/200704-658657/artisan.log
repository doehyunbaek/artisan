import re

def extract_values(filepath):
    with open(filepath, 'r') as f:
        content = f.read()
    
    # Find the table
    match = re.search(r'Results of Points-To Analysis.*?\n\+.*?\n\|.*?\n\|.*?\n\|.*?\n\|.*?\n\|.*?\n\|.*?\n\|.*?\n\+', content, re.DOTALL)
    if match:
        table = match.group(0)
        lines = table.strip().split('\n')
        # Extract values from lines
        # Line with False Positives: | False Positives    | 1         | 1         |
        fp_line = [l for l in lines if 'False Positives' in l][0]
        fn_line = [l for l in lines if 'False Negatives' in l][0]
        prec_line = [l for l in lines if 'Precision' in l][0]
        
        # Parse using regex
        fp_vals = re.findall(r'\|\s*(\d+)\s*\|', fp_line)
        fn_vals = re.findall(r'\|\s*(\d+)\s*\|', fn_line)
        prec_vals = re.findall(r'\|\s*([\d.]+)\s*\|', prec_line)
        
        return {
            'only_java': {'fp': fp_vals[0], 'fn': fn_vals[0], 'prec': prec_vals[0]},
            'java_xl': {'fp': fp_vals[1], 'fn': fn_vals[1], 'prec': prec_vals[1]}
        }
    return None

js_vals = extract_values('/workspace/js_output.txt')
native_vals = extract_values('/workspace/native_output.txt')

