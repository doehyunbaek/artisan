import urllib.request, json, os, sys, shutil
api_url = "https://zenodo.org/api/records/10554377"
outdir = "/workspace/artifact"
os.makedirs(outdir, exist_ok=True)
print("Fetching record metadata from:", api_url)
with urllib.request.urlopen(api_url) as resp:
    data = json.load(resp)
files = data.get("files", [])
if not files:
    print("No files listed in record metadata. Exiting.", file=sys.stderr)
    sys.exit(1)
for f in files:
    # filename keys can be 'key' or 'filename'
    fname = f.get("key") or f.get("filename") or f.get("name")
    links = f.get("links", {}) or {}
    link = links.get("download") or links.get("self")
    if not link:
        print(f"Skipping {fname}: no download link found.", file=sys.stderr)
        continue
    outpath = os.path.join(outdir, fname)
    print(f"Downloading {fname} -> {outpath}")
    try:
        with urllib.request.urlopen(link) as r, open(outpath, "wb") as w:
            shutil.copyfileobj(r, w)
    except Exception as e:
        print(f"Failed to download {fname}: {e}", file=sys.stderr)
print("Download complete. Files saved to", outdir)
PY
