    43	echo ""
    44	echo "| Program Name      |         #Failed |         Anomaly | Source-Code Oracle |"
    45	echo "| ----------------- | --------------: | --------------: | -----------------: |"
    46	# Parse each line: we need columns 2-7, ignoring the first total number
    47	cat /workspace/repro.txt | while read line; do
    48	    if [[ $line =~ ^[a-z]+-[a-z]+ ]]; then
    49	        # Use awk to parse fields. The line has format:
    50	        # commons-cli           23,153     13,965 ( 60.32%)      4,216 ( 30.19%)      1,728 ( 40.99%)
    51	        # Fields: $1=project, $2=total, $3=#Failed count, $4=(%%), $5=anomaly count, $6=(%%), $7=source count, $8=(%%)
    52	        # But the parentheses are separate fields.
    53	        # Let's use regex to extract properly.
    54	        if [[ $line =~ ^([a-z-]+)\ +([0-9,]+)\ +([0-9,]+)\ \(([ 0-9.]+%\))\ +([0-9,]+)\ \(([ 0-9.]+%\))\ +([0-9,]+)\ \(([ 0-9.]+%\))$ ]]; then
    55	            proj=${BASH_REMATCH[1]}
    56	            failed_count=${BASH_REMATCH[3]}
    57	            failed_pct=${BASH_REMATCH[4]}
    58	            anomaly_count=${BASH_REMATCH[5]}
    59	            anomaly_pct=${BASH_REMATCH[6]}
    60	            source_count=${BASH_REMATCH[7]}
    61	            source_pct=${BASH_REMATCH[8]}
    62	            # Remove leading spaces from percentages
    63	            failed_pct=$(echo "$failed_pct" | sed 's/^ //')
    64	            anomaly_pct=$(echo "$anomaly_pct" | sed 's/^ //')
    65	            source_pct=$(echo "$source_pct" | sed 's/^ //')
    66	            printf "| %-17s | %s (%s) | %s (%s) | %s (%s) |\n" "$proj" "$failed_count" "$failed_pct" "$anomaly_count" "$anomaly_pct" "$source_count" "$source_pct"
    67	        fi
    68	    fi
    69	done
    70	echo '</artisan_submit>'
