cat > /workspace/repro_sctype_table_3.sh <<'EOF'
#!/usr/bin/bash
set -euo pipefail

# Section 1: Expected table
# The expected table is already provided at /workspace/expected.md by the harness.
# We therefore do not overwrite it here.

# Section 2: Artifact download
artisan get https://zenodo.org/records/10449162

# Section 3: Reproduction commands (populate from reviewed steps)
# Locate a README from the downloaded artifact and perform the required greps.
README_PATH="$(find /workspace -maxdepth 6 -type f -iname 'README.md' | head -n 1 || true)"
if [ -n "${README_PATH}" ]; then
  grep -in docker "${README_PATH}" || true
  grep -in "Table 3" "${README_PATH}" || true
  ARTIFACT_DIR="$(dirname "${README_PATH}")"
else
  # Fallback: assume artifact directory is directly under /workspace
  ARTIFACT_DIR="/workspace"
fi

# Find a spreadsheet that likely contains the evaluation tables.
XLSX_PATH="$(find "${ARTIFACT_DIR}" -maxdepth 8 -type f \( -iname '*.xlsx' -o -iname '*.xlsm' -o -iname '*.ods' \) | head -n 1 || true)"
if [ -z "${XLSX_PATH}" ]; then
  echo "No spreadsheet file found under ${ARTIFACT_DIR}" >&2
  exit 1
fi

# Identify the worksheet that contains 'MarginSwap' (from Table 3).
TARGET_SHEET=""
while IFS= read -r sheet_name; do
  # Skip empty sheet names if any
  [ -z "${sheet_name}" ] && continue
  if uvx --from csvkit in2csv -s "${sheet_name}" "${XLSX_PATH}" | grep -q "MarginSwap"; then
    TARGET_SHEET="${sheet_name}"
    break
  fi
done < <(uvx --from csvkit in2csv -n "${XLSX_PATH}")

if [ -z "${TARGET_SHEET}" ]; then
  echo "Failed to locate a worksheet containing 'MarginSwap' in ${XLSX_PATH}" >&2
  exit 1
fi

# Convert the identified worksheet to CSV.
TMP_CSV="/tmp/table3.csv"
uvx --from csvkit in2csv -s "${TARGET_SHEET}" "${XLSX_PATH}" > "${TMP_CSV}"

# Convert the CSV into a Markdown table and write it to /workspace/repro.txt.
python - <<'PY'
import csv
from pathlib import Path

csv_path = Path("/tmp/table3.csv")
out_path = Path("/workspace/repro.txt")

rows = []
with csv_path.open(newline="", encoding="utf-8") as f:
    reader = csv.reader(f)
    for row in reader:
        # Keep all rows; we'll later locate the proper header.
        if not any(cell.strip() for cell in row):
            continue
        rows.append(row)

if not rows:
    raise SystemExit("No non-empty rows found in CSV.")

# Find header row by matching the first column name 'Project Name'.
header_idx = None
for i, r in enumerate(rows):
    if r and r[0].strip().lower() == "project name":
        header_idx = i
        break

if header_idx is None:
    raise SystemExit("Could not locate 'Project Name' header in CSV.")

# Use rows from header onwards, trimming to the first 4 columns.
trimmed = []
for r in rows[header_idx:]:
    # Stop if we hit some obvious footer with no first cell.
    if not any(cell.strip() for cell in r):
        continue
    trimmed.append(r[:4])

if len(trimmed) <= 1:
    raise SystemExit("Not enough data rows after header to form Table 3.")

header = trimmed[0]
data_rows = trimmed[1:]

def fmt_row(r):
    return "| " + " | ".join((c.strip() if c is not None else "").replace("\n", " ") for c in r) + " |"

# Build a generic separator row (alignment not important for content equality).
separator = "| " + " | ".join("---" for _ in header) + " |"

lines = []
lines.append("**Table 3: Evaluation Results**\n")
lines.append(fmt_row(header))
lines.append(separator)
for r in data_rows:
    # Only include rows that have a project name or 'Total' in first column.
    if not (r and r[0].strip()):
        continue
    lines.append(fmt_row(r))

out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_sctype_table_3.sh && artisan submit /workspace/repro_sctype_table_3.sh && echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT
</mini_swe_agent_bash>
