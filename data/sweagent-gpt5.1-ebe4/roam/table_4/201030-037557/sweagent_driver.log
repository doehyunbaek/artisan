import statistics, math

with open('results.md') as f:
    lines = [l.strip() for l in f if l.strip().startswith('|')]

h1 = [c.strip() for c in lines[0].strip('|').split('|')]
h2 = [c.strip() for c in lines[1].strip('|').split('|')]

labels = []
current = None
for c in h1:
    if c and not c.startswith('Col'):
        current = c
    labels.append(current)

# find indices
idx = {}
for i,(lab,col) in enumerate(zip(labels,h2)):
    if lab == 'ROAM' and col == 'PRM<br>Construction<br>Time':
        idx['roam_prm'] = i
    if lab == 'ROAM' and col == 'Event<br>Search<br>Time':
        idx['roam_event'] = i
    if lab == 'ROAM' and col == 'Path<br>Recovery<br>and<br>Execution<br>Time':
        idx['roam_path'] = i
    if lab == 'ROAM' and col == 'Running<br>Time':
        idx['roam_rt'] = i
    if lab == 'ReCDroid' and col == 'Running<br>Time':
        idx['recdroid_rt'] = i
    if lab == 'Yakusu' and col == 'Running<br>Time':
        idx['yakusu_rt'] = i

print('indices', idx)

values = {k: [] for k in idx}

for line in lines[3:]:  # skip 3 header/alignment lines
    cells = [c.strip() for c in line.strip('|').split('|')]
    for k,i in idx.items():
        if i < len(cells):
            v = cells[i]
            try:
                values[k].append(float(v))
            except ValueError:
                raise SystemExit(f'Non-numeric at row {line}\ncol {k}={v!r}')

for k,vals in values.items():
    print(k, 'n=', len(vals), 'mean=', sum(vals)/len(vals), 'median=', statistics.median(vals))
