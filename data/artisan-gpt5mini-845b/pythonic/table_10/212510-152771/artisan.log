<mini_swe_agent_bash>
cat > /workspace/repro_pythonic_table_10.sh <<'EOF'
#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 10: Reasons for using functional and procedural code**

| Reason                        | Lambdas | Comp. | MRF | Proc. |
| ----------------------------- | ------: | ----: | --: | ----: |
| Coding time                   |      ?? |    ?? |  ?? |     ? |
| Ease of use                   |       ? |    ?? |   ? |     ? |
| Maintainability               |      ?? |     ? |  ?? |     ? |
| Performance                   |       ? |    ?? |  ?? |     ? |
| Readability/Understandability |      ?? |    ?? |  ?? |    ?? |
| Size                          |      ?? |    ?? |  ?? |     — |
| Lack of knowledge             |       — |     — |   — |    ?? |
| Project constraints           |       — |     — |   — |     ? |
| Simplify debugging            |       — |     — |   — |     ? |

EOTABLE

# Section 2: Artifact download
artisan get https://zenodo.org/records/10554377

# Section 3: Reproduction commands (produce /workspace/repro.txt)
# This block finds the manual validation workbook (or falls back to procedural csv),
# then counts occurrences of the expected taxonomy reasons per sheet and emits a markdown table.
set -e
WORKDIR="$(pwd)"
XLSX_PATH=$(find . -type f -iname 'RQ3ManualValidation.xlsx' | head -n 1 || true)
PROC_CSV=$(find . -type f -path '*/working-results/inter-rater-RQ3-files/procedural.csv' | head -n 1 || true)

python3 - <<'PY'
import os, sys, pandas as pd

reasons = [
    ("Coding time", ["coding", "time"]),
    ("Ease of use", ["ease", "easy", "use"]),
    ("Maintainability", ["maintain", "maintainability"]),
    ("Performance", ["perform", "performance", "fast"]),
    ("Readability/Understandability", ["readab", "understand", "understandability"]),
    ("Size", ["size"]),
    ("Lack of knowledge", ["lack", "knowledge", "unknown"]),
    ("Project constraints", ["project", "constraint", "constraints"]),
    ("Simplify debugging", ["debug", "debugging", "simplif"])
]

# initialize counts
counts = {
    "lambda": {r[0]:0 for r in reasons},
    "comprehension": {r[0]:0 for r in reasons},
    "mrf": {r[0]:0 for r in reasons},
    "procedural": {r[0]:0 for r in reasons}
}

def match_reason(text, keywords):
    t = text.lower()
    for kw in keywords:
        if kw in t:
            return True
    return False

# attempt to read XLSX
xlsx_path = os.environ.get('XLSX_PATH')
if not xlsx_path:
    # try to discover in usual locations
    candidates = []
    for root, dirs, files in os.walk('.'):
        for f in files:
            if f.lower() == 'rq3manualvalidation.xlsx':
                candidates.append(os.path.join(root, f))
    xlsx_path = candidates[0] if candidates else None

if xlsx_path and os.path.exists(xlsx_path):
    xls = pd.read_excel(xlsx_path, sheet_name=None)
    for sheet_name, df in xls.items():
        key = sheet_name.strip().lower()
        # find column with "Final" in name
        final_col = None
        for c in df.columns:
            if 'final' in str(c).lower():
                final_col = c
                break
        if final_col is None:
            # try common column names
            for candidate in ['Final Classification','Final classification','Final']:
                if candidate in df.columns:
                    final_col = candidate
                    break
        if final_col is None:
            continue
        vals = df[final_col].dropna().astype(str)
        for v in vals:
            for r, kws in reasons:
                if match_reason(v, kws):
                    if 'lambda' in key:
                        counts['lambda'][r] += 1
                    elif 'comp' in key or 'comprehension' in key:
                        counts['comprehension'][r] += 1
                    elif 'mrf' in key:
                        counts['mrf'][r] += 1
                    elif 'procedural' in key or 'procedural' in sheet_name.lower():
                        counts['procedural'][r] += 1
# fallback: try procedural CSV if present and XLSX not found
else:
    # attempt to find procedural csv in repository
    proc_csv = None
    for root, dirs, files in os.walk('.'):
        for f in files:
            if f.lower() == 'procedural.csv':
                proc_csv = os.path.join(root, f)
                break
        if proc_csv:
            break
    if proc_csv:
        df = pd.read_csv(proc_csv, sep='\t', na_values=['None'])
        # find final classification column
        final_col = None
        for c in df.columns:
            if 'final' in str(c).lower():
                final_col = c
                break
        if final_col is None:
            # try common names
            for candidate in ['Final Classification','Final classification','Final']:
                if candidate in df.columns:
                    final_col = candidate
                    break
        if final_col:
            vals = df[final_col].dropna().astype(str)
            for v in vals:
                for r, kws in reasons:
                    if match_reason(v, kws):
                        counts['procedural'][r] += 1

# Write markdown table to /workspace/repro.txt
out_lines = []
out_lines.append("**Table 10: Reasons for using functional and procedural code (counts)**")
out_lines.append("")
hdr = "| Reason | Lambdas | Comp. | MRF | Proc. |"
sep = "| --- | ---: | ---: | ---: | ---: |"
out_lines.append(hdr)
out_lines.append(sep)
for r, _ in reasons:
    l = "| {} | {} | {} | {} | {} |".format(
        r,
        counts['lambda'].get(r,0),
        counts['comprehension'].get(r,0),
        counts['mrf'].get(r,0),
        counts['procedural'].get(r,0)
    )
    out_lines.append(l)

with open('/workspace/repro.txt','w') as f:
    f.write("\n".join(out_lines))

print("WROTE /workspace/repro.txt")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF

chmod +x /workspace/repro_pythonic_table_10.sh && artisan submit /workspace/repro_pythonic_table_10.sh
</mini_swe_agent_bash>
