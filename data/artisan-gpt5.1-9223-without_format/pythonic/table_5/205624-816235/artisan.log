      } else if (name == "StudentTRUE") {
        outname="StudentTrue";
      } else {
        next;
      }

      printf("| %s | %s | %s | %s | %s | %s |\n", outname, OR, est, se, z, p);
    }
  ' "$mrf_coeff_tex"
} > /workspace/repro.txt

