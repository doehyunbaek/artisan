THOUGHT: I'll write a Python script to compute the Table 2 metrics from heritability.csv. The script will calculate for each subject and crossover operator: proportion of hybrids (HY) and median inheritance rate (IR). Then I'll output the table in the required format.

<mini_swe_agent_bash>
cat > /workspace/compute_table.py << 'EOF'
import pandas as pd
import numpy as np

# Read the CSV
df = pd.read_csv('/workspace/heritability.csv')

# Ensure hybrid column is boolean
df['hybrid'] = df['hybrid'].astype(str).str.lower() == 'true'

# Define subjects and operators
subjects = ['Ant', 'BCEL', 'Closure', 'Maven', 'Nashorn', 'Rhino', 'Tomcat']
operators = ['Linked', 'One Point', 'Two Point']

# Initialize results
results = {}

for subject in subjects:
    results[subject] = {}
    for op in operators:
        subset = df[(df['subject'] == subject) & (df['crossover_operator'] == op)]
        if len(subset) == 0:
            hy = 0.0
            ir = 0.0
        else:
            hy = subset['hybrid'].mean()
            ir = subset['inheritance_rate'].median()
        results[subject][op] = {'HY': hy, 'IR': ir}

# Print table
print("| Subject | Linked HY | Linked IR | One Point HY | One Point IR | Two Point HY | Two Point IR |")
print("| ------- | --------: | --------: | -----------: | -----------: | -----------: | -----------: |")
for subject in subjects:
    row = [subject]
    for op in operators:
        row.append(f"{results[subject][op]['HY']:.3f}")
        row.append(f"{results[subject][op]['IR']:.3f}")
    print("| " + " | ".join(row) + " |")
EOF
</mini_swe_agent_bash>
