        self._runs = runs_df
        self._jobs = jobs_df
    def get_all_runs(self):
        return self._runs
    def get_all_jobs(self):
        return self._jobs

data_set = DataSet(all_runs, all_jobs)

# Determine paid vs free tiers using artifact logic
repos_list_1, repos_list_2 = get_tiers(data_set)

# Recompute termination-status metrics (as in paper_analysis_RQ1.ipynb)
