import csv, subprocess, tempfile
from collections import defaultdict

# Convert the "npedetection (2)" sheet to a temporary CSV
tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".csv")
tmp.close()
with open(tmp.name, "w") as out:
    subprocess.check_call([
        "uvx", "--from", "csvkit", "in2csv",
        "NPETestArtifact/rq2_result.xlsx",
        "--sheet", "npedetection (2)"
    ], stdout=out)

groups = ["NPEX", "BugSwarm", "Defects4J", "Genesis", "Bears"]
tool_cols = {"EvoSuite": "evosuite", "NPETest": "npetest"}

with open(tmp.name, newline='') as f:
    rows = list(csv.DictReader(f))

def run_scheme(name, key_fn):
    print(f"\n=== Scheme: {name} ===")
    for tool, col in tool_cols.items():
        seen = set()
        counts = defaultdict(int)
        for row in rows:
            grp = (row.get("a") or "").strip()
            if grp not in groups:
                continue
            val_str = (row.get(col) or "").strip()
            try:
                val = float(val_str)
            except ValueError:
                val = 0.0
            if val <= 0.0:
                continue
            key = key_fn(grp, row)
            if key in seen:
                continue
            seen.add(key)
            counts[grp] += 1
            counts["Total"] += 1
        print(tool, {g: counts[g] for g in groups + ["Total"]})

# 1) per (group, project, class) row  ~ per distinct NPE
run_scheme("per (group, project, class)", lambda g, r: (g, r.get("b"), r.get("c")))

# 2) per (group, project)
run_scheme("per (group, project)", lambda g, r: (g, r.get("b")))

# 3) per full row (collapse exact duplicates)
run_scheme("per full row", lambda g, r: (g, r.get("b"), r.get("c"), r.get("evosuite"), r.get("npetest")))
PY
