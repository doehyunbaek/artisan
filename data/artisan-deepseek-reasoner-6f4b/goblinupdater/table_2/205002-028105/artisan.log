import pandas as pd
import numpy as np

# Read the CSV file
df = pd.read_csv('./ASE24_data_and_tools/ASE24_data_and_tools/results_data/execution/conf_1_global/executionsData.csv')

# Define the columns we need
# Based on the CSV: directDepNumber, releaseSize, artifactSize, dependencySize, versionSize
metrics = {
    "(p)’s direct dependencies": "directDepNumber",
    "releases ((N_R))": "releaseSize",
    "libraries ((N_L))": "artifactSize",
    "dependency edges ((E_D))": "dependencySize",
    "versions edges ((E_V))": "versionSize"
}

results = []

for name, col in metrics.items():
    data = df[col]
    q1 = np.percentile(data, 25)
    q2 = np.percentile(data, 50)  # median
    q3 = np.percentile(data, 75)
    min_val = data.min()
    max_val = data.max()
    
    # Format based on observed values in the table
    # For direct dependencies: likely 1 decimal for Q1, integers for others
    if name == "(p)’s direct dependencies":
        q1_str = f"{q1:.1f}"
        q2_str = f"{int(q2)}"
        q3_str = f"{int(q3)}"
        min_str = f"{int(min_val)}"
        max_str = f"{int(max_val)}"
    elif name == "libraries ((N_L))":
        q1_str = f"{q1:.1f}"
        q2_str = f"{int(q2)}"
        q3_str = f"{int(q3)}"
        min_str = f"{int(min_val)}"
        max_str = f"{int(max_val)}"
    elif name == "dependency edges ((E_D))":
        q1_str = f"{q1:.1f}"
        q2_str = f"{int(q2)}"
        q3_str = f"{int(q3)}"
        min_str = f"{int(min_val)}"
        max_str = f"{int(max_val)}"
    else:
        q1_str = f"{int(q1)}"
        q2_str = f"{int(q2)}"
        q3_str = f"{int(q3)}"
        min_str = f"{int(min_val)}"
        max_str = f"{int(max_val)}"
    
    results.append((name, q1_str, q2_str, q3_str, min_str, max_str))

# Print table
print("**Table 2: Demographics of our dataset of 107 Java projects**")
print()
print("|                           |    Q1 |  Q2 |   Q3 | min |     max |")
print("| ------------------------- | ----: | --: | ---: | --: | ------: |")
for name, q1, q2, q3, min_v, max_v in results:
    print(f"| {name:25} | {q1:>5} | {q2:>3} | {q3:>4} | {min_v:>3} | {max_v:>7} |")
EOF

