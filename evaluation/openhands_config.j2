[core]
disable_color = true
runtime = "docker"
default_agent = "CodeActAgent"

[llm]
model="{{ model_name }}"
api_key="{{ openai_api_key }}"
#base_url = ""

[sandbox]
timeout=600
volumes = "/var/run/docker.sock:/var/run/docker.sock:rw,{{ workspace_volume }}:/workspace:rw"

[security]
#confirmation_mode = false
#security_analyzer = ""