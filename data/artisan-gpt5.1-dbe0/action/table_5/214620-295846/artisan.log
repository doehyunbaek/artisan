        "saved_subset": wasted_schedule_paid[3] * 100,
        "saved_cost": wasted_schedule_paid[4],
    },
    "free": {
        "all_runs": wasted_schedule_free[0],
        "subset_runs": wasted_schedule_free[1] * 100,
