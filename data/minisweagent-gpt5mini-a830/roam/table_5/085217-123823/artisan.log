    print('Downloading', name, '->', outpath)
    try:
        with urllib.request.urlopen(link) as r, open(outpath, 'wb') as out:
            while True:
                chunk = r.read(8192)
                if not chunk:
                    break
                out.write(chunk)
    except Exception as e:
        print('Failed to download', link, '->', e, file=sys.stderr)
        sys.exit(1)
print('All files downloaded to /workspace/artifact_files')
