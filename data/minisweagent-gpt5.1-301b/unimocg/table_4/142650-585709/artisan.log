*depen. = dependently immutable, trans. = transitively immutable. Higher numbers in columns to the right = more precise.*
EOT

# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
