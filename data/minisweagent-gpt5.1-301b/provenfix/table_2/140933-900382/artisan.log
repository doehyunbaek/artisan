<mini_swe_agent_bash>
cat > /workspace/repro_provenfix_table_2.sh <<'EOF'
#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 2. Experimental results for analyzing 10 C projects, comparing with Infer-v1.1.0. Columns **#NPD**, **#ML**, **#RL** record the numbers of null pointer dereferences, memory leaks, and resource leaks, respectively. The number of false positives found by Infer and more true positives found by PROVENFIX are represented by +n and +n respectively. Colunns in #Time record the analysis time spent.**

| Project         | Failed Assert |
| --------------- | ------------: |
| Swoole          |            98 |
| lxc             |            56 |
| WavPack         |            52 |
| flex            |            24 |
| p11-kit         |            37 |
| x264            |            21 |
| recutils-1.8    |            75 |
| inetutils-1.9.4 |            37 |
| snort-2.9.13    |            98 |
| grub            |            12 |
| **Total**       |       **510** |

EOTABLE

# Section 2: Artifact download
if [ ! -d /workspace/infer_TempFix ]; then
  git clone https://github.com/songyahui/infer_TempFix.git /workspace/infer_TempFix
else
  cd /workspace/infer_TempFix && git fetch && git reset --hard origin/main
fi

# Section 3: Reproduction commands (populate from reviewed steps)
# Use the official Docker artifact environment to run ProveNFix for the 10 C projects
IMAGE=yahuuuuui/fse24-prove_n_fix:ubuntu
CONTAINER=prove_n_fix_table2

# Pull the image as recommended in the artifact docs
docker pull "$IMAGE"

# Remove any stale container with the same name
if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER}\$"; then
  docker rm -f "$CONTAINER" >/dev/null 2>&1
fi

# Start a long-running container using the non-interactive pattern
docker run -d --init --name "$CONTAINER" --entrypoint bash "$IMAGE" -c 'sleep infinity'

# Ensure ProveNFix is built on the main branch inside the container
docker exec "$CONTAINER" /bin/bash --noprofile --norc -c 'cd /home/infer_TempFix && git reset --hard && git checkout main && ./compile'

run_project() {
  local spec_file="$1"
  local bench_dir="$2"
  docker exec "$CONTAINER" /bin/bash --noprofile --norc -c "cd /home/infer_TempFix && cp ${spec_file} spec.c && cd ${bench_dir} && make clean && /home/infer_TempFix/infer/bin/tempFix" \
    | awk '/\[Failed Assert\]/{print $3; exit}'
}

SWOOLE=$(run_project spec_Swoole.c /home/benchmarks-RQ1N2/swoole-src)
LXC=$(run_project spec_Lxc.c /home/benchmarks-RQ1N2/lxc)
WAVPACK=$(run_project spec_WavPack.c /home/benchmarks-RQ1N2/WavPack)
FLEX=$(run_project spec_flex.c /home/benchmarks-RQ1N2/flex)
P11=$(run_project spec_p11.c /home/benchmarks-RQ1N2/p11-kit)
X264=$(run_project spec-x264.c /home/benchmarks-RQ1N2/x264)
RECUTILS=$(run_project spec-recutils.c /home/benchmarks-RQ1N2/recutils-1.8)
INETUTILS=$(run_project spec-inetutils.c /home/benchmarks-RQ1N2/inetutils-1.9.4)
SNORT=$(run_project spec_snort-2.9.13.c /home/benchmarks-RQ1N2/snort-2.9.13)
GRUB=$(run_project spec_Grub.c /home/benchmarks-RQ1N2/grub)

TOTAL=$((SWOOLE + LXC + WAVPACK + FLEX + P11 + X264 + RECUTILS + INETUTILS + SNORT + GRUB))

cat > /workspace/repro.txt <<EOF_TABLE
**Table 2. Experimental results for analyzing 10 C projects, comparing with Infer-v1.1.0. Columns **#NPD**, **#ML**, **#RL** record the numbers of null pointer dereferences, memory leaks, and resource leaks, respectively. The number of false positives found by Infer and more true positives found by PROVENFIX are represented by +n and +n respectively. Colunns in #Time record the analysis time spent.**

| Project         | Failed Assert |
| --------------- | ------------: |
| Swoole          | $SWOOLE |
| lxc             | $LXC |
| WavPack         | $WAVPACK |
| flex            | $FLEX |
| p11-kit         | $P11 |
| x264            | $X264 |
| recutils-1.8    | $RECUTILS |
| inetutils-1.9.4 | $INETUTILS |
| snort-2.9.13    | $SNORT |
| grub            | $GRUB |
| **Total**       |       **$TOTAL** |

EOF_TABLE

# Optionally clean up the container
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
</mini_swe_agent_bash>
