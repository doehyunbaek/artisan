    r"Mutable Fields:\s+(\d+).*?"
    r"Non Transitively Immutable Fields:\s+(\d+).*?"
    r"Dependently Immutable Fields:\s+(\d+).*?"
    r"Transitively Immutable Fields:\s+(\d+)",
    re.S,
)

data = {}
