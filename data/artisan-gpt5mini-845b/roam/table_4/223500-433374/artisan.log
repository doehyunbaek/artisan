import re,statistics,sys
md = open('/workspace/results.md','r',encoding='utf-8').read().splitlines()

# Locate header lines: first line containing "Col1" is h1, separator follows, then h2
h1 = h2 = None
sep_idx = None
for i,l in enumerate(md):
    if l.startswith('|Col1') or l.startswith('| Col1') or l.startswith('|Col1|'):
        h1 = [c.strip() for c in l.split('|')]
        # find separator
        for j in range(i+1, i+8):
            if j < len(md) and md[j].startswith('|---'):
                sep_idx = j
                break
        if sep_idx and sep_idx+1 < len(md):
            h2 = [c.strip() for c in md[sep_idx+1].split('|')]
            data_start = sep_idx+2
        break

if not h1 or not h2:
    # fallback: try to find the header row containing 'Issue id'
    for i,l in enumerate(md):
        if 'Issue id' in l and 'Running' in l:
            h2 = [c.strip() for c in l.split('|')]
            if i-2 >= 0:
                h1 = [c.strip() for c in md[i-2].split('|')]
            data_start = i+1
            break

if not h1 or not h2:
    print("ERROR: headers not found", file=sys.stderr)
    sys.exit(1)

# Normalize headers (replace html <br> with spaces)
h2_norm = [re.sub(r'<[^>]+>', ' ', x).replace('\\n',' ').strip() for x in h2]
h1_norm = [re.sub(r'<[^>]+>', ' ', x).replace('\\n',' ').strip() for x in h1]

# Helper to find first index where a substring appears in h2
def find_first_in_h2(substr, start=0):
    for i in range(start, len(h2_norm)):
        if substr.lower() in h2_norm[i].lower():
            return i
    return None

# Find PRM (first occurrence), then Event and Path after it
idx_prm = find_first_in_h2('PRM')
idx_event = find_first_in_h2('Event', start=(idx_prm+1 if idx_prm is not None else 0))
idx_path = find_first_in_h2('Path', start=(idx_event+1 if idx_event is not None else 0))

# Find ROAM total by searching left of prm for a 'Running' header
idx_roam_total = None
if idx_prm is not None:
    for i in range(idx_prm-1, -1, -1):
        if 'Running' in h2_norm[i] or 'Running Time' in h2_norm[i] or re.search(r'Running', h2_norm[i], re.I):
            idx_roam_total = i
            break

# Find ReCDroid and Yakusu: locate group label in h1 and find nearest 'Running' in h2 to their right
def find_running_for_group(group_name):
    for i,grp in enumerate(h1_norm):
        if grp and group_name.lower() in grp.lower():
            # search right up to next 8 columns for a running time header
            for j in range(i, min(i+10, len(h2_norm))):
                if 'Running' in h2_norm[j] or 'Running Time' in h2_norm[j] or re.search(r'Running', h2_norm[j], re.I):
                    return j
    # fallback: try to find group name in any h2 cell then find running after it
    for i,cell in enumerate(h2_norm):
        if group_name.lower() in cell.lower():
            for j in range(i, min(i+10, len(h2_norm))):
                if 'Running' in h2_norm[j]:
                    return j
    return None

idx_recdroid = find_running_for_group('ReCDroid')
idx_yakusu = find_running_for_group('Yakusu')

# Debug checks (if any index missing, try alternative heuristics)
# If any of the primary ROAM indices are missing, try to locate by context sequence:
if idx_prm is None:
    # try to find sequence 'PRM' anywhere
    idx_prm = find_first_in_h2('PRM')
if idx_event is None and idx_prm is not None:
    idx_event = find_first_in_h2('Event', start=idx_prm+1)
if idx_path is None and idx_event is not None:
    idx_path = find_first_in_h2('Path', start=idx_event+1)
if idx_roam_total is None and idx_prm is not None:
    # try to pick the 'Running' that is just before the PRM index by position
    for i in range(max(0, idx_prm-6), idx_prm):
        if 'Run' in h2_norm[i] or 'Running' in h2_norm[i]:
            idx_roam_total = i
            break

# Ensure we have sensible indices
indices = {
    'prm': idx_prm, 'event': idx_event, 'path': idx_path,
    'roam_total': idx_roam_total, 'recdroid': idx_recdroid, 'yakusu': idx_yakusu
}

# Extract numeric values from data rows
def clean_num(s):
    if s is None: return None
    # remove commas and non-numeric except dot
    s = re.sub(r'[^\d\.]','', s)
    if s == '': return None
    try:
        return float(s)
    except:
        return None

vals = {k:[] for k in indices.keys()}

for l in md[data_start:]:
    if not l.startswith('|'): continue
    cols = [c.strip() for c in l.split('|')]
    if len(cols) < 3: continue
    # second column should be the issue index
    if not re.match(r'^\d+$', cols[1].strip()):
        continue
    for name,idx in indices.items():
        if idx is None: continue
        if idx < len(cols):
            n = clean_num(cols[idx])
            if n is not None:
                vals[name].append(n)

# Compute averages and medians
def fmt(x):
    if x is None:
        return 'NA'
    # integer formatting for whole numbers
    if abs(x - round(x)) < 1e-6:
        return f"{int(round(x)):,}"
    else:
        return f"{x:.1f}"

out = {}
for k,v in vals.items():
    if len(v)==0:
        out[k] = ('NA','NA')
    else:
        avg = sum(v)/len(v)
        med = statistics.median(v)
        out[k] = (fmt(avg), fmt(med))

# Write the reproduction table
