python - << 'PY'
import csv
from collections import Counter

base = "/workspace"

files = {
    "Lambdas": f"{base}/lambda.csv",
    "Comp.": f"{base}/comprehension.csv",
    "MRF": f"{base}/mrf.csv",
    "Proc.": f"{base}/procedural.csv",
}

canonical_map = {
    "coding time": "Coding time",
    "ease of use": "Ease of use",
    "maintainability": "Maintainability",
    "performance": "Performance",
    "readability/understandability": "Readability/Understandability",
    "size": "Size",
    "lack of knowledge": "Lack of knowledge",
    "project constraints": "Project constraints",
    "debugging is easier": "Simplify debugging",
}

order = [
    "Coding time",
    "Ease of use",
    "Maintainability",
    "Performance",
    "Readability/Understandability",
    "Size",
    "Lack of knowledge",
    "Project constraints",
    "Simplify debugging",
]

results = {}

for label, path in files.items():
    counts = Counter()
    with open(path, newline='', encoding="utf-8") as f:
        reader = csv.reader(f)
        header = next(reader)
        if label == "Proc.":
            # Final Classification + extra coding columns from index 4 onwards
            start_idx = 4
        else:
            # Only "Final Classification" column at index 4
            start_idx = 4
        for row in reader:
            # Skip completely empty rows
            if not any(cell.strip() for cell in row):
                continue
            # Collect all coded categories in relevant columns
            cells = row[start_idx:]
            for cell in cells:
                v = cell.strip()
                if not v:
                    continue
                key = v.lower()
                canon = canonical_map.get(key)
                if canon:
                    counts[canon] += 1
    results[label] = counts

# Print a compact summary to inspect
for reason in order:
    row = [reason]
    for col in ["Lambdas", "Comp.", "MRF", "Proc."]:
        row.append(str(results[col].get(reason, 0)))
    print("\t".join(row))
PY
