import pandas as pd
import numpy as np

# Load the data
rq1_file_path = '/workspace/RQ1.csv'
rq1paired_file_path = '/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1Paired-RQ2.csv'

rq1_data = pd.read_csv(rq1_file_path)
rq1paired_data = pd.read_csv(rq1paired_file_path)

# Calculate statistics for RQ1
rq1_results = rq1_data.groupby(['Section', 'Construct']).agg(
    Correct=('Outcome', lambda x: (x == True).sum()),
    Wrong=('Outcome', lambda x: (x == False).sum()),
    Total=('Outcome', 'size')
)
rq1_results['% Correct'] = (rq1_results['Correct'] / rq1_results['Total']) * 100

# Calculate statistics for RQ1Paired
rq1paired_results = rq1paired_data.groupby(['Group']).agg(
    LambdaF_Correct=('LambdaF', lambda x: (x == True).sum()),
    LambdaF_Wrong=('LambdaF', lambda x: (x == False).sum()),
    LambdaP_Correct=('LambdaP', lambda x: (x == True).sum()),
    LambdaP_Wrong=('LambdaP', lambda x: (x == False).sum()),
    CompF_Correct=('CompF', lambda x: (x == True).sum()),
    CompF_Wrong=('CompF', lambda x: (x == False).sum()),
    CompP_Correct=('CompP', lambda x: (x == True).sum()),
    CompP_Wrong=('CompP', lambda x: (x == False).sum()),
    MrfF_Correct=('MrfF', lambda x: (x == True).sum()),
    MrfF_Wrong=('MrfF', lambda x: (x == False).sum()),
    MrfP_Correct=('MrfP', lambda x: (x == True).sum()),
    MrfP_Wrong=('MrfP', lambda x: (x == False).sum())
)

# Prepare the final table
final_table = pd.DataFrame({
    'Construct': ['Lambda', 'Compr.', 'MRF'],
    'Functional Correct': [rq1_results.loc['lambda', 'Correct'], rq1_results.loc['comp', 'Correct'], rq1_results.loc['mrf', 'Correct']],
    'Functional Wrong': [rq1_results.loc['lambda', 'Wrong'], rq1_results.loc['comp', 'Wrong'], rq1_results.loc['mrf', 'Wrong']],
    'Procedural Correct': [rq1paired_results['LambdaP_Correct'].sum(), rq1paired_results['CompP_Correct'].sum(), rq1paired_results['MrfP_Correct'].sum()],
    'Procedural Wrong': [rq1paired_results['LambdaP_Wrong'].sum(), rq1paired_results['CompP_Wrong'].sum(), rq1paired_results['MrfP_Wrong'].sum()]
})

