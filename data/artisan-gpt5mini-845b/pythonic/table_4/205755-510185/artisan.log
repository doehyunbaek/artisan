**Fixed effects**

| Term | OR | Estimate | Std.Error | z value | Pr(>\\|z\\|) |
|---|---:|---:|---:|---:|---:|
| (Intercept) | ?.?? | ?.?? | ?.?? | ?.?? | ?.?? |
| MainFactorProc | ?.?? | ?.?? | ?.?? | ?.?? | ?.?? |
| Compl. | ?.?? | ?.?? | ?.?? | ?.?? | ?.?? |
| Usage Freq. | ?.?? | -?.?? | ?.?? | -?.?? | ?.?? |
| Approvals | ?.?? | -?.?? | ?.?? | -?.?? | ?.?? |
| StudentTrue | ?.?? | ?.?? | ?.?? | ?.?? | ?.?? |
| MainFactorProc:Compl. | ?.?? | -?.?? | ?.?? | -?.?? | ?.?? |

EOTABLE

# Download the artifact (idempotent)
artisan get https://zenodo.org/records/10554377

# Paths
ABS_PATH="$(pwd)/ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts"
RESULTS_DIR="${ABS_PATH}/results"
TXT_FILE="${RESULTS_DIR}/Table-4-RQ1-comp.txt"
COEFF_CSV="${RESULTS_DIR}/Table-4-RQ1-comp-coeff.txt"

# Ensure a clean container name
docker rm -f rexp_repro_container 2>/dev/null || true

# Pull image, run detached container mounting the artifact, execute the R analysis
docker pull mdipenta/rexp:latest
docker run -d --init --entrypoint bash -v "${ABS_PATH}":/data --name rexp_repro_container mdipenta/rexp:latest -c 'sleep infinity'
docker exec rexp_repro_container /bin/bash --noprofile --norc -c "cd /data && R --no-save < FuncConstructs-Statistics.r"
# stop and remove container
docker rm -f rexp_repro_container || true

# Verify result files exist
if [ ! -f "${TXT_FILE}" ] || [ ! -f "${COEFF_CSV}" ]; then
  echo "Expected result files not found. Listing results directory:" >&2
  ls -la "${RESULTS_DIR}" || true
  exit 1
fi

# Parse header metrics from the textual summary (next line after header "AIC ... df.resid")
read -r AIC BIC LOGLik DEVIANCE DFRESID < <(awk '/AIC.*df.resid/{getline; print}' "${TXT_FILE}")

# Read coefficients CSV (skip header). We expect 7 rows in the specific order.
# For each row: OR,Estimate,Std. Error,z value,Pr(>|z|)
mapfile -t rows < <(tail -n +2 "${COEFF_CSV}")
# helper to split CSV line
split_csv() {
  IFS=',' read -r a b c d e <<< "$1"
  printf '%s\n%s\n%s\n%s\n%s\n' "$a" "$b" "$c" "$d" "$e"
}

# Extract and format each row into arrays
declare -a ORs ESTs SEs Zs Ps
for i in "${!rows[@]}"; do
  read -r or est se z p < <(split_csv "${rows[$i]}")
  # Round/format to match expected placeholder precision:
  ORs[$i]=$(printf "%.2f" "${or}")
  ESTs[$i]=$(printf "%.2f" "${est}")
  SEs[$i]=$(printf "%.2f" "${se}")
  Zs[$i]=$(printf "%.2f" "${z}")
  Ps[$i]=$(printf "%.2f" "${p}")
done

# Build repro.txt dynamically from parsed values
cat > /workspace/repro.txt <<EOT
