#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 1: Summaries of regressions estimating the effect of using the prototype. Each column summarizes the model for a different outcome variable. We report the coefficient estimates with the standard errors in parentheses.**

|                     |   Progress (1) |    Time (s) (2) |   Underst. (3) | Progress (Pros) | Progress (Students) |
| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |
| Constant            |    ?.?? (?.??) | ???.?? (???.??) | -?.??** (?.??) |    -?.?? (?.??) |       ?.??** (?.??) |
| Domain experience   |   ?.??* (?.??) |   ??.?? (??.??) | ?.??*** (?.??) |     ?.?? (?.??) |         ?.?? (?.??) |
| Program. experience |   -?.?? (?.??) |  -??.?? (??.??) |    ?.?? (?.??) |     ?.?? (?.??) |       -?.??* (?.??) |
| AI tool familiarity |   -?.?? (?.??) |    ?.?? (??.??) |   -?.?? (?.??) |     ?.?? (?.??) |        -?.?? (?.??) |
| Uses GILT           | ?.??*** (?.??) |   -?.?? (??.??) |    ?.?? (?.??) |   ?.??** (?.??) |         ?.?? (?.??) |
| *R*²                |          ?.??? |           ?.??? |          ?.??? |           ?.??? |               ?.??? |
| Adj. *R*²           |          ?.??? |          -?.??? |          ?.??? |           ?.??? |               ?.??? |

*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*

EOTABLE

# Section 2: Artifact download
artisan get https://zenodo.org/records/10461385

# Section 3: Reproduction commands (populate from reviewed steps)
# Create an R script that reproduces the regressions and outputs Table 1 as Markdown
cat > /workspace/GILT_Artifacts/GILT_Artifacts-main/study/repro_table1.R <<'RSCRIPT'
# Select the appropriate data file (Zenodo archive may use either name)
data_file <- if (file.exists("ase_data.csv")) {
  "ase_data.csv"
} else if (file.exists("study_data.csv")) {
  "study_data.csv"
} else {
  stop("Data file ase_data.csv or study_data.csv not found in working directory.")
}

df <- read.csv(file = data_file, header = TRUE)

# Ensure rsq is available for pseudo-R² on GLMs
if (!requireNamespace("rsq", quietly = TRUE)) {
  install.packages("rsq", repos = "https://cloud.r-project.org")
}
library(rsq)

format_cell <- function(model, term) {
  coefs <- summary(model)$coefficients
  est <- coefs[term, "Estimate"]
  se  <- coefs[term, "Std. Error"]
  # p-value is in the last column of the coefficients matrix
  p   <- coefs[term, ncol(coefs)]
  stars <- if (is.na(p)) {
    ""
  } else if (p < 0.01) {
    "***"
  } else if (p < 0.05) {
    "**"
  } else if (p < 0.1) {
    "*"
  } else {
    ""
  }
  est_str <- sprintf("%.2f%s", est, stars)
  se_str  <- sprintf("%.2f", se)
  paste0(est_str, " (", se_str, ")")
}

## Time (success_time_no_guess)
Q_time <- quantile(df$success_time_no_guess, probs = c(.01, .99), na.rm = FALSE)
elim_time <- subset(df,
                    df$success_time_no_guess >= Q_time[1] &
                    df$success_time_no_guess <= Q_time[2])

time_model <- lm(success_time_no_guess ~
                   tool +
                   experience +
                   recruiting.years +
                   AI_experience,
                 data = elim_time)

## Understanding
Q_under <- quantile(df$understanding, probs = c(.01, .99), na.rm = FALSE)
elim_under <- subset(df,
                     df$understanding >= Q_under[1] &
                     df$understanding <= Q_under[2])

under_model <- glm(understanding ~
                     tool +
                     experience +
                     recruiting.years +
                     AI_experience,
                   data = elim_under,
                   family = quasipoisson)

## Progress (all participants)
Q_prog <- quantile(df$progress_no_guess, probs = c(.01, .99), na.rm = FALSE)
elim_prog <- subset(df,
                    df$progress_no_guess >= Q_prog[1] &
                    df$progress_no_guess <= Q_prog[2])

prog_model_all <- glm(progress_no_guess ~
                        tool +
                        experience +
                        recruiting.years +
                        AI_experience,
                      data = elim_prog,
                      family = quasipoisson)

## Progress - Professionals
prog_model_pros <- glm(progress_no_guess ~
                         tool +
                         experience +
                         recruiting.years +
                         AI_experience,
                       data = elim_prog[elim_prog$is_professional == 1, ],
                       family = quasipoisson)

## Progress - Students
prog_model_students <- glm(progress_no_guess ~
                             tool +
                             experience +
                             recruiting.years +
                             AI_experience,
                           data = elim_prog[elim_prog$is_professional == 0, ],
                           family = quasipoisson)

# Extract R² values
r2_time        <- summary(time_model)$r.squared
adj_r2_time    <- summary(time_model)$adj.r.squared

r2_under       <- as.numeric(rsq(under_model))
adj_r2_under   <- as.numeric(rsq(under_model, adj = TRUE))

r2_prog_all    <- as.numeric(rsq(prog_model_all))
adj_r2_prog_all<- as.numeric(rsq(prog_model_all, adj = TRUE))

r2_prog_pros   <- as.numeric(rsq(prog_model_pros))
adj_r2_prog_pros <- as.numeric(rsq(prog_model_pros, adj = TRUE))

r2_prog_students <- as.numeric(rsq(prog_model_students))
adj_r2_prog_students <- as.numeric(rsq(prog_model_students, adj = TRUE))

# Convenience wrappers for each term across models
cell <- function(term) {
  c(
    Progress           = format_cell(prog_model_all,      term),
    Time               = format_cell(time_model,          term),
    Understanding      = format_cell(under_model,         term),
    Progress_Pros      = format_cell(prog_model_pros,     term),
    Progress_Students  = format_cell(prog_model_students, term)
  )
}

const_cells   <- cell("(Intercept)")
domain_cells  <- cell("experience")        # Domain experience
progexp_cells <- cell("recruiting.years")  # Programming experience
ai_cells      <- cell("AI_experience")     # AI tool familiarity
tool_cells    <- cell("tool")              # Uses GILT

# Output Table 1 as Markdown
cat("**Table 1: Summaries of regressions estimating the effect of using the prototype. Each column summarizes the model for a different outcome variable. We report the coefficient estimates with the standard errors in parentheses.**\n\n")

cat("|                     |   Progress (1) |    Time (s) (2) |   Underst. (3) | Progress (Pros) | Progress (Students) |\n")
cat("| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |\n")

cat(sprintf("| Constant            | %s | %s | %s | %s | %s |\n",
           const_cells["Progress"],
           const_cells["Time"],
           const_cells["Understanding"],
           const_cells["Progress_Pros"],
           const_cells["Progress_Students"]))

cat(sprintf("| Domain experience   | %s | %s | %s | %s | %s |\n",
           domain_cells["Progress"],
           domain_cells["Time"],
           domain_cells["Understanding"],
           domain_cells["Progress_Pros"],
           domain_cells["Progress_Students"]))

cat(sprintf("| Program. experience | %s | %s | %s | %s | %s |\n",
           progexp_cells["Progress"],
           progexp_cells["Time"],
           progexp_cells["Understanding"],
           progexp_cells["Progress_Pros"],
           progexp_cells["Progress_Students"]))

cat(sprintf("| AI tool familiarity | %s | %s | %s | %s | %s |\n",
           ai_cells["Progress"],
           ai_cells["Time"],
           ai_cells["Understanding"],
           ai_cells["Progress_Pros"],
           ai_cells["Progress_Students"]))

cat(sprintf("| Uses GILT           | %s | %s | %s | %s | %s |\n",
           tool_cells["Progress"],
           tool_cells["Time"],
           tool_cells["Understanding"],
           tool_cells["Progress_Pros"],
           tool_cells["Progress_Students"]))

cat(sprintf("| *R*²                | %.3f | %.3f | %.3f | %.3f | %.3f |\n",
           r2_prog_all,
           r2_time,
           r2_under,
           r2_prog_pros,
           r2_prog_students))

cat(sprintf("| Adj. *R*²           | %.3f | %.3f | %.3f | %.3f | %.3f |\n",
           adj_r2_prog_all,
           adj_r2_time,
           adj_r2_under,
           adj_r2_prog_pros,
           adj_r2_prog_students))

cat("\n*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*\n")
RSCRIPT

# Ensure any previous container with this name is removed
docker rm -f gilt_notebook >/dev/null 2>&1 || true

# Pull the recommended R/Jupyter environment
docker pull jupyter/r-notebook

# Launch a long-running container with the study directory mounted
docker run -d --init --name gilt_notebook \
  -v /workspace/GILT_Artifacts/GILT_Artifacts-main/study:/home/jovyan/work \
  --entrypoint bash jupyter/r-notebook -c 'sleep infinity'

# Run the R script inside the container and capture the output as the reproduced table
docker exec gilt_notebook /bin/bash --noprofile --norc -c "cd /home/jovyan/work && Rscript repro_table1.R" > /workspace/repro.txt

# Section 4: Formatting and submission block
echo '<artisan_submit>'
