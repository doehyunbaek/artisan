#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 4: The Running Time Results of Each Approach (Shown in Seconds)**

|          | - **ROAM** - |                  |                      |           | ReCDroid | Yakusu |
| :------: | :----------: | :--------------: | :------------------: | :-------: | :------: | :----: |
|          |    **PRM**   | **Event Search** | **Path Recv & Exec** | **Total** |          |        |
| **Avg.** |      ??      |        ??        |          ???         |  **???**  |   ?,???  |  ?,??? |
| **Mdn.** |       ?      |         ?        |          ???         |  **???**  |   ?,???  |  ?,??? |
EOTABLE

# Section 2: Artifact download
artisan get https://zenodo.org/records/11068809

# Section 3: Reproduction commands (extract running-time numbers from provided results)
# Convert the results PDF to markdown for easier parsing
uvx --from pymupdf4llm python -c 'import sys, pymupdf4llm as p; sys.stdout.write(p.to_markdown(sys.argv[1]))' ROAM-Artifact/ROAM-Artifact/Evaluation/results.pdf > /workspace/results.md

# Parse the markdown table and compute averages/medians, output to /workspace/repro.txt
python3 - <<'PY'
import re,statistics
md = open('/workspace/results.md', 'r', encoding='utf-8').read().splitlines()

# Find header block
h1 = h2 = None
sep_idx = None
for i,l in enumerate(md):
    if l.startswith('|Col1|') or l.startswith('| Col1|'):
        h1 = [c.strip() for c in l.split('|')]
        # find separator line (---)
        for j in range(i+1, i+6):
            if j < len(md) and md[j].startswith('|---'):
                sep_idx = j
                break
        if sep_idx and sep_idx+1 < len(md):
            h2 = [c.strip() for c in md[sep_idx+1].split('|')]
            data_start = sep_idx+2
        break

# fallback heuristics if not found
if not h1 or not h2:
    for i,l in enumerate(md):
        if l.startswith('||Issue id') or 'Issue id' in l and 'Running' in l:
            # try to pick header lines around this
            h2 = [c.strip() for c in l.split('|')]
