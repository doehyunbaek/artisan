<mini_swe_agent_bash>
python3 - <<'PY'
import sys, re
infile = "/tmp/results_md.md"
outpath = "/workspace/repro.txt"
with open(infile, 'r', encoding='utf-8') as f:
    lines = [l.rstrip('\n') for l in f]

# Find header line (the one that contains Col1 and ReCDroid/Yakusu/ROAM)
header_idx = None
for i,l in enumerate(lines):
    if l.startswith('|') and 'Col1' in l and ('ReCDroid' in l or 'ReCDROID' in l):
        header_idx = i
        break
if header_idx is None:
    # fallback: find any line containing ReCDroid and pipes
    for i,l in enumerate(lines):
        if l.startswith('|') and 'ReCDroid' in l:
            header_idx = i
            break
if header_idx is None:
    print("Header not found", file=sys.stderr)
    sys.exit(1)

def toks(line):
    parts = [p.strip() for p in line.split('|')]
    # remove empty leading/trailing if present
    if parts and parts[0]=='':
        parts = parts[1:]
    if parts and parts[-1]=='':
        parts = parts[:-1]
    return parts

header = toks(lines[header_idx])
# locate tool header indices (case-insensitive)
def find_header(name):
    for i,h in enumerate(header):
        if h.strip().lower() == name.lower():
            return i
    return None

tools = {'ReCDroid':'ReCDroid', 'Yakusu':'Yakusu', 'Roam':'ROAM'}  # ROAM might be uppercase in header
idxs = {}
for key, name in tools.items():
    idx = find_header(name)
    if idx is None:
        # try contains
        for i,h in enumerate(header):
            if name.lower() in h.lower():
                idx = i
                break
    idxs[key] = idx

# Prepare counters
total = 0
no_miss = 0
miss = 0
counts = {k: {'all':0, 'no_miss':0, 'miss':0} for k in tools.keys()}

# iterate data rows: lines after header where first token is numeric (issue id)
for l in lines[header_idx+2:]:  # skip divider line too
    if not l.startswith('|'):
        continue
    t = toks(l)
    if not t:
        continue
    # first token should be numeric id
    if not re.match(r'^\d+$', t[0]):
        continue
    total += 1
    # Missing steps at Col6 -> token index 5 (Col1 is t[0])
    missing = None
    for try_idx in (5,4,6,3):
        if try_idx < len(t):
            s = t[try_idx]
            s_clean = s.strip()
            if re.match(r'^\d+$', s_clean):
                missing = int(s_clean)
                break
    if missing is None:
        # fallback: look for the first small integer near start
        for s in t[:8]:
            if re.match(r'^\d+$', s):
                missing = int(s)
                break
    if missing is None:
        missing = 0
    if missing == 0:
        no_miss += 1
        miss_category = 'no_miss'
    else:
        miss += 1
        miss_category = 'miss'
    # For each tool, the reproduction result is usually at header_index+1 (match acc then repro result)
    for key, hidx in idxs.items():
        if hidx is None:
            continue
        repro_idx = hidx + 1
        if repro_idx < len(t):
            val = t[repro_idx].strip().lower()
            if val == 'success':
                counts[key]['all'] += 1
                if miss_category == 'no_miss':
                    counts[key]['no_miss'] += 1
                else:
                    counts[key]['miss'] += 1
        else:
            # no token at expected position; skip
            pass

# compute percentages
def pct(num,den):
    if den == 0:
        return "0.00%"
    return "{:.2f}%".format(num/den*100)

recdroid_all = pct(counts['ReCDroid']['all'], total)
recdroid_no = pct(counts['ReCDroid']['no_miss'], no_miss)
recdroid_m = pct(counts['ReCDroid']['miss'], miss)
yak_all = pct(counts['Yakusu']['all'], total)
yak_no = pct(counts['Yakusu']['no_miss'], no_miss)
yak_m = pct(counts['Yakusu']['miss'], miss)
roam_all = pct(counts['Roam']['all'], total)
roam_no = pct(counts['Roam']['no_miss'], no_miss)
roam_m = pct(counts['Roam']['miss'], miss)

with open(outpath, 'w', encoding='utf-8') as out:
    out.write("**Table 3: Reproduction Rate of Each Approach (Shown as a Percent)**\n\n")
    out.write("|          | All Reports | Reports w/o Missing Steps | Reports w/ Missing Steps |\n")
    out.write("| -------- | :---------: | :-----------------------: | :----------------------: |\n")
    out.write(f"| ReCDroid |   {recdroid_all}   |         {recdroid_no}         |       {recdroid_m}        |\n")
    out.write(f"| Yakusu   |    {yak_all}    |         {yak_no}         |        {yak_m}         |\n")
    out.write(f"| Roam     |    {roam_all}    |         {roam_no}         |        {roam_m}         |\n")
print("Wrote results to", outpath)
PY
