    # If notebook used printing functions, ensure model summaries are printed plainly
    f.write('\\n# If models exist in variables, print summaries for key model names\\n')
    f.write('for (n in c("no_guess_time_model","success_time_no_guess_model","understanding_model","progress_model")) { if (exists(n)) { cat("===== SUMMARY:", n, "\\n"); try(print(summary(get(n))), silent=TRUE) } }\\n')
