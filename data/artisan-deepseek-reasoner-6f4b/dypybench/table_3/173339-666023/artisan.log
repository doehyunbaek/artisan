import json
import os
import sys
sys.path.insert(0, '/DyPyBench/seq2pat')
from sequential.seq2pat import Seq2Pat, Constraints, Attribute
from sequential.backend import Seq2PatCPP
import itertools

# Load all sequences from callgraph_seq JSON files
seq_dir = 'callgraph_seq'
files = [f for f in os.listdir(seq_dir) if f.endswith('.json')]
all_sequences = []
for f in files:
    with open(os.path.join(seq_dir, f), 'r') as inf:
        seq = json.load(inf)
        all_sequences.append(seq)

# Preprocess: flatten? The notebook does splitting by callers.
# Let's replicate the preprocessing from the notebook.
def split_by_callers(calls_sequence):
    counter = 1
    caller = calls_sequence[0].split('##')[-1]
    splitted_sequences = []
    s_temp = []
    s_temp.append(calls_sequence[0])
    i = 1
    while True:
        if i == len(calls_sequence):
            splitted_sequences.append(s_temp)
            break
        c = calls_sequence[i]
        if c.startswith('#START#'):
            if counter == 0 and c.split('##')[-1] != caller:
                splitted_sequences.append(s_temp)
                s_temp = [c]
                if i == len(calls_sequence):
                    splitted_sequences.append(s_temp)
                    break
                else:
                    caller = c
            else:
                s_temp.append(c)
            counter += 1
        elif c.startswith('#END#'):
            counter -= 1
            s_temp.append(c)
        i = i + 1
    return splitted_sequences

# Process each sequence
final_list = []
for seq in all_sequences:
    seq_calls = [seq]
    while True:
        temp_seq = []
        for sc in seq_calls:
            temp_seq.extend(split_by_callers(sc))
        final_list.extend(temp_seq)
        seq_calls = []
        for s in temp_seq:
            if len(s) not in [0, 1, 2]:
                seq_calls.append(s[1:-1])
        if len(seq_calls)==0:
            break

# Simplify: extract only the function names (before ##)
simple_final_list = []
for l in final_list:
    simple_final_list.append([c.split('##')[0] for c in l])

# Filter sequences length > 1 and <= 100 as in notebook
filtered_seqs = [s for s in simple_final_list if 1 < len(s) <= 100]

# Limit sequences per project to avoid bias (as in notebook)
# We'll just use all for now.
# Now use seq2pat to mine patterns
# Convert sequences to list of lists of strings
sequences = filtered_seqs
# Create Seq2Pat object
seq2pat = Seq2Pat(sequences)
# Mine top patterns with min frequency 1
patterns = seq2pat.mining(min_freq=1, max_len=10, top_k=100)
# patterns is a list of (pattern, frequency)
# We need to find patterns that match the ones in Table 3
target_pattern1 = ['builtins.isinstance', 'builtins.isinstance']
target_pattern2 = ['Pattern.match', 'Match.span', 'str.isidentifier']
freq1 = None
freq2 = None
for pattern, freq in patterns:
    if pattern == target_pattern1:
        freq1 = freq
    if pattern == target_pattern2:
        freq2 = freq

print('Pattern 1 frequency:', freq1)
print('Pattern 2 frequency:', freq2)
# If not found, maybe the pattern representation is different.
# Let's also search for subpatterns.
if freq1 is None:
    # search for pattern as subsequence
    for pattern, freq in patterns:
        if len(pattern) >= 2 and pattern[0] == 'builtins.isinstance' and pattern[1] == 'builtins.isinstance':
            freq1 = freq
            break
if freq2 is None:
    for pattern, freq in patterns:
        if len(pattern) >= 3 and pattern[0] == 'Pattern.match' and pattern[1] == 'Match.span' and pattern[2] == 'str.isidentifier':
            freq2 = freq
            break

print('Found frequencies:', freq1, freq2)
EOF
