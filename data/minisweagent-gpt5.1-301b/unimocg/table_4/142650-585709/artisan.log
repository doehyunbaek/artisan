}
/^ Transitively Immutable Fields:/ {
  trans=$NF;
  printf("| %-10s | %7d | %11d | %7d | %7d |\n", alg, mutable, ntrans, depen, trans);
}
' summaries/immutability_results.txt >> /workspace/repro.txt

