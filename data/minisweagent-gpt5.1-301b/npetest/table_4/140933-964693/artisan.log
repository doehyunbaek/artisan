<mini_swe_agent_bash>
python - << 'PY'
import csv
from collections import defaultdict

path = "/workspace/npe_npedetection.csv"

sums = defaultdict(lambda: {"evosuite": 0.0, "evosuite_def": 0.0, "count_evo": 0, "count_def": 0})
total = {"evosuite": 0.0, "evosuite_def": 0.0, "count_evo": 0, "count_def": 0}

with open(path, newline="") as f:
    reader = csv.DictReader(f)
    for row in reader:
        bench = row["a"].strip()
        for key, col in (("evosuite", "evosuite"), ("evosuite_def", "evosuite_def")):
            val = row[col].strip()
            if not val:
                continue
            try:
                v = float(val)
            except ValueError:
                continue
            sums[bench][key] += v
            sums[bench]["count_evo" if key=="evosuite" else "count_def"] += 1
            total[key] += v
            total["count_evo" if key=="evosuite" else "count_def"] += 1

def avg(d, key, cnt_key):
    return d[key] / d[cnt_key] if d[cnt_key] else 0.0

for bench in ["NPEX", "BugSwarm", "Defects4J", "Genesis", "Bears"]:
    e = avg(sums[bench], "evosuite", "count_evo")
    d = avg(sums[bench], "evosuite_def", "count_def")
    print(f"{bench}: EvoSuite={e:.3f}%  EvoSuite_Def={d:.3f}%")

e_total = avg(total, "evosuite", "count_evo")
d_total = avg(total, "evosuite_def", "count_def")
print(f"TOTAL: EvoSuite={e_total:.3f}%  EvoSuite_Def={d_total:.3f}%")
PY
</mini_swe_agent_bash>
