import csv
from collections import defaultdict

path = "/workspace/rq1.csv"

benchmarks = ["NPEX","BugSwarm","Defects4J","Genesis","Bears"]
tools = ["evosuite","npetest"]

# benchmark -> tool -> set of projects with value>0
hits = {b: {t: set() for t in tools} for b in benchmarks}

with open(path, newline='') as f:
    r = csv.DictReader(f)
    for row in r:
        bench = row["a"].strip()
        proj = row["b"].strip()
        if bench not in benchmarks or not proj:
            continue
        for t in tools:
            val = row[t]
            if val is None or val == "":
                continue
            try:
                v = float(val)
            except ValueError:
                continue
            if v > 0:
                hits[bench][t].add(proj)

print("Counts per benchmark:")
totals = {t:0 for t in tools}
for b in benchmarks:
    line = [b]
    for t in tools:
        c = len(hits[b][t])
        totals[t] += c
        line.append(f"{t}={c}")
    print(", ".join(line))
print("Totals:")
for t in tools:
    print(t, totals[t])
