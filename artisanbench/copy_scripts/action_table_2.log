out_lines.append("| ----------- | ---------------: | ---------------: | ------------: | ------------: | --------------------------: | --------------------------: | ------------------------: | ------------------------: |")

for r in rows:
    out_lines.append(
        f"| {r['task']:<10} | {r['vm_paid']:>13} | {r['vm_free']:>13} | {r['runs_paid']:>10} | {r['runs_free']:>10} | "
        f"{r['time_paid']:>9} ({r['iqr_paid']}) | {r['time_free']:>9} ({r['iqr_free']}) | "
        f"{r['cost_paid']:>22} | {r['cost_free']:>22} |"
