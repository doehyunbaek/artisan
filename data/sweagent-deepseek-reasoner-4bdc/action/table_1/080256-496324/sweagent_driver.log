    "    c5 = rest_1[0]\n",
    "    c6 = rest_1[-1]\n",
    "    c7 = rest_2[0]\n",
    "    c8 = rest_2[-1]\n",
    "    return 100- c1, 100 -c2, 100 - c3, 100 - c4, c5, c6, c7, c8   "
