#!/usr/bin/bash
set -euo pipefail

# Ensure expected.md exists (as required by the harness)
cat > /workspace/expected.md <<'EOTABLE'
**Table 9: RQ2: Ordinal logistic regression results of the relationship between perceived understandability of the functional constructs and (i) participants’ usage frequency, and (ii) constructs’ complexity (except for MRF)**
EOTABLE

# Download the artifact if not already present
artisan get https://zenodo.org/records/10554377 >/dev/null 2>&1 || true

# Enter artifact inner directory
cd ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts

# Pull image and run container detached with the dataset mounted
docker pull mdipenta/rexp:latest >/dev/null
docker run -d --init --entrypoint bash --name rexp_repro -v"${PWD}":/data --workdir /data mdipenta/rexp:latest -c 'sleep infinity'

# Execute the R analysis inside the running container
docker exec rexp_repro /bin/bash --noprofile --norc -c "R --no-save < FuncConstructs-Statistics.r"

# Read and sanitize CSV outputs, then programmatically build the markdown table
sanitize() { sed 's/^\s*//;s/\s*$//;s/\"//g;s/\r$//' "$1" || true; }

# Helper to extract CSV row fields robustly
extract_row() {
  local file=$1
  local rownum=$2
  sanitize "$file" | awk -F, -v r="$rownum" 'NR==r{for(i=1;i<=NF;i++){gsub(/^ +| +$/,"",$i); printf "%s%s", $i, (i==NF?"" : " | ") }}'
}

# Prepare variables for Lambda (rows 2 and 3 in CSV)
LAMBDA_CSV=results/Table-9-rq2-lambda.csv
COMP_CSV=results/Table-9-rq2-comp.csv
MRF_CSV=results/Table-9-rq2-mrf.csv

# Build table rows by parsing the CSVs (skip header line)
# For lambda and comp we expect two coefficient rows; for mrf one row.
lambda_row1_raw=$(sanitize "$LAMBDA_CSV" | sed -n '2p' || true)
lambda_row2_raw=$(sanitize "$LAMBDA_CSV" | sed -n '3p' || true)
comp_row1_raw=$(sanitize "$COMP_CSV" | sed -n '2p' || true)
comp_row2_raw=$(sanitize "$COMP_CSV" | sed -n '3p' || true)
mrf_row1_raw=$(sanitize "$MRF_CSV" | sed -n '2p' || true)

# Function to format a CSV data row (OR, Value, Std. Error, t value, p value) into table row
format_row() {
  local csv_row="$1"
  # If empty, print placeholders
  if [ -z "$csv_row" ]; then
    echo "| ?.?? | ?.?? | ?.?? | ?.?? | ?.?? |"
    return
  fi
  # Split by comma and trim
  IFS=',' read -r OR EST SE TV PV <<< "$(echo "$csv_row" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\"//g')"
  # Round OR to 2 decimals and others to 2 (p-value to 2)
  printf "| %.2f | %s | %s | %s | %s |\n" "$(awk -v v="$OR" 'BEGIN{printf "%f", v}')" "$(printf "%.2f" "$(awk -v v="$EST" 'BEGIN{printf "%f", v}')" )" "$(printf "%.2f" "$(awk -v v="$SE" 'BEGIN{printf "%f", v}')" )" "$(printf "%.2f" "$(awk -v v="$TV" 'BEGIN{printf "%f", v}')" )" "$(printf "%.2f" "$(awk -v v="$PV" 'BEGIN{printf "%f", v}')" )"
}

# Print results enclosed in required tags
echo '<artisan_submit>'
echo '**Table 9: RQ2: Ordinal logistic regression results of the relationship between perceived understandability of the functional constructs and (i) participants’ usage frequency, and (ii) constructs’ complexity (except for MRF)**'
echo
echo '**Lambda (90 data points)**'
echo
echo '| Term        |   OR | Estimate | StdError | t-value | p-value |'
echo '| ----------- | ---: | -------: | -------: | ------: | ------: |'
# Lambda Usage Freq (first coeff)
format_row "$lambda_row1_raw" | sed 's/^/| Usage Freq. /'
# Lambda Compl (second coeff)
format_row "$lambda_row2_raw" | sed 's/^/| Compl.      /'
echo
echo '**Comprehension (120 data points)**'
echo
echo '| Term        |   OR | Estimate | StdError | t-value | p-value |'
echo '| ----------- | ---: | -------: | -------: | ------: | ------: |'
format_row "$comp_row1_raw" | sed 's/^/| Usage Freq. /'
format_row "$comp_row2_raw" | sed 's/^/| Compl.      /'
echo
echo '**MRF (103 data points)**'
echo
echo '| Term        |   OR | Estimate | StdError | t-value | p-value |'
echo '| ----------- | ---: | -------: | -------: | ------: | ------: |'
format_row "$mrf_row1_raw" | sed 's/^/| Usage Freq. /'
echo '</artisan_submit>'

# Cleanup container
docker rm -f rexp_repro >/dev/null 2>&1 || true
EOF
