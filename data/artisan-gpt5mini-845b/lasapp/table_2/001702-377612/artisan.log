    if do_constraint:
        print(f"Constraint    Error Count: {error_count_constraint}/{len(filenames)}")
        # print(f"Constraint  Correct Count: {len(filenames)-error_count_constraint}/{len(filenames)}")
    print(f"in {t1-t0:.2f} seconds.")</output>
