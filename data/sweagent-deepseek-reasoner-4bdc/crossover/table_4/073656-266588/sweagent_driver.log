all_match = True
for fuzzer in fuzzers:
    for defect in defects:
        computed_5M = results[fuzzer][defect]['"'"'5M'"'"']['"'"'detected'"'"'] / max(1, results[fuzzer][defect]['"'"'5M'"'"']['"'"'total'"'"'])
        computed_3H = results[fuzzer][defect]['"'"'3H'"'"']['"'"'detected'"'"'] / max(1, results[fuzzer][defect]['"'"'3H'"'"']['"'"'total'"'"'])
        
        expected_5M = expected_table[fuzzer][defect]['"'"'5M'"'"'] if fuzzer in expected_table and defect in expected_table[fuzzer] else None
        expected_3H = expected_table[fuzzer][defect]['"'"'3H'"'"'] if fuzzer in expected_table and defect in expected_table[fuzzer] else None
        
        # Format for comparison
        if expected_5M is None:
            match_5M = "N/A"
        else:
            match_5M = abs(computed_5M - expected_5M) < 0.01
        
        if expected_3H is None:
            match_3H = "N/A"
        else:
            match_3H = abs(computed_3H - expected_3H) < 0.01
        
        if expected_5M is not None and not match_5M:
            all_match = False
        if expected_3H is not None and not match_3H:
            all_match = False
            
        print(f"{fuzzer:15} {defect:5} {computed_5M:7.3f} {computed_3H:7.3f} {str(expected_5M):7} {str(expected_3H):7} {match_5M}/{match_3H}")

print(f"\nAll match: {all_match}")

# Also output in markdown format
print("\n=== Markdown Table ===")
print("| Fuzzer | " + " | ".join([f"{defect} 5M" for defect in defects]) + " | " + " | ".join([f"{defect} 3H" for defect in defects]) + " |")
print("|--------" + "|-----" * len(defects) * 2 + "|")

for fuzzer in fuzzers:
    row = [fuzzer]
    for defect in defects:
        rate_5M = results[fuzzer][defect]['"'"'5M'"'"']['"'"'detected'"'"'] / max(1, results[fuzzer][defect]['"'"'5M'"'"']['"'"'total'"'"'])
        row.append(f"{rate_5M:.2f}")
    for defect in defects:
        rate_3H = results[fuzzer][defect]['"'"'3H'"'"']['"'"'detected'"'"'] / max(1, results[fuzzer][defect]['"'"'3H'"'"']['"'"'total'"'"'])
        row.append(f"{rate_3H:.2f}")
    print("| " + " | ".join(row) + " |")'
