all_runs_2 = all_runs[all_runs["repo_id"].isin(repos_list_2)].copy()

# Exclude the specific job id as in the notebook
all_jobs_1 = all_jobs[(all_jobs["run_id"].isin(all_runs_1["id"])) & (all_jobs["id"] != 3253494537)].copy()
all_jobs_2 = all_jobs[(all_jobs["run_id"].isin(all_runs_2["id"])) & (all_jobs["id"] != 3253494537)].copy()

# Runs proportions by conclusion
conclusion_1 = (
    all_runs_1.groupby("conclusion", as_index=False)
    .agg(id=("id", "count"))
)
conclusion_1["prop"] = conclusion_1["id"] * 100.0 / conclusion_1["id"].sum()

conclusion_2 = (
    all_runs_2.groupby("conclusion", as_index=False)
    .agg(id=("id", "count"))
)
conclusion_2["prop"] = conclusion_2["id"] * 100.0 / conclusion_2["id"].sum()

# VM time proportions by conclusion
runs_with_time_1 = all_runs_1.merge(
    all_jobs_1[["run_id", "up_time"]],
    left_on="id",
