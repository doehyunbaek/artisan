))

# releases ((N_R)) -> 'releases' (integers, show commas)
q1,q2,q3,mn,mx = stats['releases']
lines.append("| releases ((N_R))          | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>7} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

# libraries ((N_L)) -> 'libraries'
q1,q2,q3,mn,mx = stats['libraries']
lines.append("| libraries ((N_L))         | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>5} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

# dependency edges ((E_D)) -> 'dependency_edges'
q1,q2,q3,mn,mx = stats['dependency_edges']
lines.append("| dependency edges ((E_D))  | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>7} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

# versions edges ((E_V)) -> 'version_edges'
q1,q2,q3,mn,mx = stats['version_edges']
lines.append("| versions edges ((E_V))    | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>7} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

print("\n".join(lines))
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
