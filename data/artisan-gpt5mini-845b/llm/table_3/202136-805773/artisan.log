cat > /workspace/repro_llm_table_3.sh <<'EOF'
#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 3: Summaries of regressions testing for associations between the user factors and the feature usage counts. Each column summarizes a regression modeling a different outcome variable. We report the coefficient estimates with their standard errors in parentheses.**

|                     |     Prompt (1) |  Followup (2) |        All (3) |
| ------------------- | -------------: | ------------: | -------------: |
| Constant            | ?.??*** (?.??) |  -?.?? (?.??) | ?.??*** (?.??) |
| AI tool familiarity |  ?.??** (?.??) | ?.??** (?.??) |    ?.?? (?.??) |
| Information Comprh. |   -?.?? (?.??) |   ?.?? (?.??) |   -?.?? (?.??) |
| Learning Process    |    ?.?? (?.??) | ?.??** (?.??) |   -?.?? (?.??) |
| *R*²                |          ?.??? |         ?.??? |          ?.??? |
| Adj. *R*²           |          ?.??? |         ?.??? |          ?.??? |

*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*

EOTABLE

# Section 2: Artifact download
artisan get https://zenodo.org/records/10461385

# Section 3: Reproduction commands
cat > /workspace/run_models.R <<'REOF'
# R script to fit models and write a markdown table to /workspace/repro.txt
df <- read.csv("GILT_Artifacts/GILT_Artifacts-main/study/study_data.csv", stringsAsFactors = FALSE)

# Safe checks for column names
required_cols <- c("AI_experience","info_style","learning_style","query_total","Query_followup","usage_total","tool")
missing_cols <- setdiff(required_cols, names(df))
if(length(missing_cols)>0){
  stop("Missing expected columns in study_data.csv: ", paste(missing_cols, collapse=", "))
}

# Ensure numeric where needed
numcols <- c("AI_experience","info_style","learning_style","query_total","Query_followup","usage_total","tool")
for(cn in numcols) df[[cn]] <- as.numeric(df[[cn]])

# Filter for tool == 1 as in the notebook
dsub <- df[df$tool==1,]

# Fit quasipoisson GLMs to match the notebook
m_prompt <- glm(query_total ~ AI_experience + info_style + learning_style, data=dsub, family=quasipoisson)
m_followup <- glm(Query_followup ~ AI_experience + info_style + learning_style, data=dsub, family=quasipoisson)
m_all <- glm(usage_total ~ AI_experience + info_style + learning_style, data=dsub, family=quasipoisson)

format_coef <- function(m, row){
  s <- summary(m)
  if(!(row %in% rownames(s$coefficients))) return("NA")
  est <- s$coefficients[row,"Estimate"]
  se  <- s$coefficients[row,"Std. Error"]
  p   <- s$coefficients[row,"Pr(>|t|)"]
  stars <- ifelse(p<0.01,"***", ifelse(p<0.05,"**", ifelse(p<0.1,"*","")))
  sprintf("%.2f%s (%.2f)", est, stars, se)
}

# pseudo R2 and adjusted pseudo R2 (based on deviance)
pseudo_r2 <- function(m){
  if(is.null(m$null.deviance) || is.null(deviance(m))) return(NA)
  r2 <- 1 - deviance(m)/m$null.deviance
  adj <- 1 - (deviance(m)/m$df.residual)/(m$null.deviance/m$df.null)
  c(r2, adj)
}

p_prompt <- pseudo_r2(m_prompt)
p_follow <- pseudo_r2(m_followup)
p_all <- pseudo_r2(m_all)

# Build markdown table
sink("/workspace/repro.txt")
cat("**Table 3: Summaries of regressions testing for associations between the user factors and the feature usage counts. Each column summarizes a regression modeling a different outcome variable. We report the coefficient estimates with their standard errors in parentheses.**\n\n")
cat("|                     |     Prompt (1) |  Followup (2) |        All (3) |\n")
cat("| ------------------- | -------------: | ------------: | -------------: |\n")
cat("| Constant            |", format_coef(m_prompt,"(Intercept)"), "|", format_coef(m_followup,"(Intercept)"), "|", format_coef(m_all,"(Intercept)"), "|\n")
cat("| AI tool familiarity |", format_coef(m_prompt,"AI_experience"), "|", format_coef(m_followup,"AI_experience"), "|", format_coef(m_all,"AI_experience"), "|\n")
cat("| Information Comprh. |", format_coef(m_prompt,"info_style"), "|", format_coef(m_followup,"info_style"), "|", format_coef(m_all,"info_style"), "|\n")
cat("| Learning Process    |", format_coef(m_prompt,"learning_style"), "|", format_coef(m_followup,"learning_style"), "|", format_coef(m_all,"learning_style"), "|\n")
cat("| *R*²                |", sprintf("%.3f", ifelse(is.na(p_prompt[1]), NA, p_prompt[1])), "|", sprintf("%.3f", ifelse(is.na(p_follow[1]), NA, p_follow[1])), "|", sprintf("%.3f", ifelse(is.na(p_all[1]), NA, p_all[1])), "|\n")
cat("| Adj. *R*²           |", sprintf("%.3f", ifelse(is.na(p_prompt[2]), NA, p_prompt[2])), "|", sprintf("%.3f", ifelse(is.na(p_follow[2]), NA, p_follow[2])), "|", sprintf("%.3f", ifelse(is.na(p_all[2]), NA, p_all[2])), "|\n\n")
cat("*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*\n")
sink()
REOF

# Run the R script to produce /workspace/repro.txt
Rscript /workspace/run_models.R

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF

