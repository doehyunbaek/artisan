        if c in present_cols:
            found = c
            break
    if not found:
        # try case-insensitive contains match
        clower = [p.lower() for p in present_cols]
        for c in candidates:
            for p in present_cols:
                if c.lower() in p.lower():
                    found = p
                    break
            if found: break
    if not found:
        # last resort: try some likely names
        for p in present_cols:
            low = p.lower()
            if 'direct' in low and 'dep' in low:
                found = p; break
            if 'release' in low:
                found = found or p
            if 'artifact' in low or 'library' in low:
                found = found or p
            if 'dependency' in low and 'size' in low:
                found = found or p
            if 'version' in low and 'size' in low:
                found = found or p
    if found:
        resolved[label] = found
    else:
        print("ERROR: Could not find column for", label, "available columns:", sorted(list(present_cols)), file=sys.stderr)
        sys.exit(3)

def quantile(sorted_list, q):
    n = len(sorted_list)
    if n == 0:
        return None
    pos = q*(n-1)
    lo = int(math.floor(pos))
    hi = int(math.ceil(pos))
    if lo == hi:
        return sorted_list[lo]
    frac = pos - lo
    return sorted_list[lo] + frac*(sorted_list[hi] - sorted_list[lo])

results = []
for label, col in resolved.items():
    vals = []
    for r in rows:
        v = to_num(r.get(col))
        if v is not None:
            vals.append(float(v))
    vals.sort()
    if not vals:
        q1=q2=q3=mn=mx = None
    else:
        q1 = quantile(vals, 0.25)
        q2 = quantile(vals, 0.5)
        q3 = quantile(vals, 0.75)
        mn = min(vals)
        mx = max(vals)
    results.append((label, q1, q2, q3, mn, mx))

def fmt(v):
    if v is None: return ''
    if abs(v - round(v)) < 1e-9:
        return str(int(round(v)))
    s = ('{:.6f}'.format(v)).rstrip('0').rstrip('.')
    # show .5 as single decimal
    if '.' in s:
        frac = s.split('.')[1]
        if len(frac) == 1:
            return s
    return s

