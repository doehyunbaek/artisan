#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 2: Summary of RUF usage**

| Type       | RUF Count | Package Versions | RUF Usage Items |
| ---------- | ---------:| ----------------:| ---------------:|
| Accepted   |       ??? |           ??,??? |          ??,??? |
| Active     |       ??? |           ??,??? |         ???,??? |
| Incomplete |         ? |            ?,??? |           ?,??? |
| Removed    |        ?? |           ??,??? |          ??,??? |
| Unknown    |       ??? |           ??,??? |          ??,??? |

EOTABLE
# Section 2: Artifact download
artisan get https://zenodo.org/records/10496086
# Section 3: Reproduction commands (populate from reviewed steps)
cd /workspace/Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor
make download_20220811_rawdata
awk -F',' '
NR==1 { next }
{
  gsub(/"/,"",$0)
  status=$4
  id=$1
  feature=$3
  keyf=status FS feature
  keyv=status FS id
  if (!(keyf in seenf)) { seenf[keyf]=1; ruf_count[status]++ }
  if (!(keyv in seenv)) { seenv[keyv]=1; pkg_count[status]++ }
  usage[status]++
}
END {
  label["accepted"]="Accepted";   order["accepted"]=1
  label["active"]="Active";       order["active"]=2
  label["incomplete"]="Incomplete"; order["incomplete"]=3
  label["removed"]="Removed";     order["removed"]=4
  label["unknown"]="Unknown";     order["unknown"]=5

  print "**Table 2: Summary of RUF usage**"
  print ""
  print "| Type       | RUF Count | Package Versions | RUF Usage Items |"
  print "| ---------- | ---------:| ----------------:| ---------------:|"

  for (i=1; i<=5; i++) {
    for (s in order) {
      if (order[s]==i) {
        t=label[s]
        rc = (s in ruf_count ? ruf_count[s] : 0)
        pc = (s in pkg_count ? pkg_count[s] : 0)
        uc = (s in usage ? usage[s] : 0)
        printf("| %-9s | %9d | %16d | %15d |\n", t, rc, pc, uc)
      }
    }
  }
}
' data/Release-20220811/ResearchResults/Result2_RUFUsage.csv > /workspace/repro.txt
# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_rust_table_2.sh
artisan submit /workspace/repro_rust_table_2.sh
echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT
