import re, csv
def norm(s): return re.sub(r'[^0-9a-z]', '', s.lower())
def toks(s): return [t for t in re.split(r'[^0-9a-z]+', s.lower()) if t]

# Load CSV data
data=[]
with open('/workspace/rq1_result.csv', newline='') as f:
    reader=csv.reader(f)
    try:
        next(reader)
    except StopIteration:
        pass
    for r in reader:
        if len(r) < 8: continue
        cat=r[0].strip()
        proj=r[1].strip()
        ev=r[6].strip()
        npv=r[7].strip()
        if proj=='':
            continue
        data.append({'cat':cat,'proj':proj,'ev':ev,'np':npv,'norm':norm(proj),'toks':toks(proj),'used':False})

# index by category
by_cat={}
for i,d in enumerate(data):
    by_cat.setdefault(d['cat'], []).append(i)

# Read expected template and fill rows
exp_lines=open('/workspace/expected.md').read().splitlines()
out=[]
current_cat=''
for line in exp_lines:
    if line.strip().startswith('###'):
        # category header line like "### NPEX"
        current_cat = line.strip().lstrip('#').strip()
        out.append(line)
        continue
    if not (line.strip().startswith('|') and '|' in line):
        out.append(line); continue
    parts=[p.strip() for p in line.split('|')[1:-1]]
    # header or separator row detection
    if len(parts) >= 3 and parts[0].lower() != 'project':
        projcell = parts[0]
        base = re.sub(r'\(\d+\)\s*$', '', projcell).strip()
        bnorm = norm(base)
        btoks = toks(base)
        # search candidates in same category first
        candidates = by_cat.get(current_cat, [])
        best_idx = None
        best_score = -1
        for idx in candidates:
            d = data[idx]
            if d['used']: continue
            score = 0
            if bnorm and bnorm in d['norm']: score += 50
            # token overlap
            overlap = len(set(btoks) & set(d['toks']))
            score += overlap
            if score > best_score:
                best_score = score
                best_idx = idx
        # fallback to global if nothing found
        if best_idx is None or best_score == 0:
            for idx,d in enumerate(data):
                if d['used']: continue
                overlap = len(set(btoks) & set(d['toks']))
                if overlap > best_score:
                    best_score = overlap
                    best_idx = idx
        if best_idx is not None:
            d = data[best_idx]
            d['used'] = True
            # Format numeric values: round to integer if possible, emit as plain digits
            def format_val(v):
                if v is None or v == '':
                    return '0'
                try:
                    fv = float(v)
                    iv = int(round(fv))
                    return str(iv)
                except:
                    return v
            evs = format_val(d['ev'])
            nps = format_val(d['np'])
            # Place the values into table row
            out.append(f"| {projcell} | {evs} | {nps} |")
        else:
            out.append(line)
    else:
        out.append(line)

print("\n".join(out))
PY
