cat > /workspace/repro_npetest_table_2.sh <<'EOF'
#!/usr/bin/bash
set -euo pipefail

# Ensure raw sheet converted to CSV
uvx --from csvkit in2csv NPETestArtifact/rq1_result.xlsx > /workspace/rq1_result.csv

# Build repro.txt by matching expected.md rows to CSV entries
python3 - <<'PY' > /workspace/repro.txt
import csv, re, math
from collections import defaultdict

def norm(s): return re.sub(r'[^0-9a-z]', '', s.lower())
def toks(s): return [t for t in re.split(r'[^0-9a-z]+', s.lower()) if t]
def round_away(x):
    # Round half away from zero
    if x >= 0:
        return int(math.floor(x + 0.5))
    else:
        return int(math.ceil(x - 0.5))

# Load CSV rows
csv_rows = []
with open('/workspace/rq1_result.csv', newline='') as f:
    reader = csv.reader(f)
    headers = next(reader, None)
    for r in reader:
        if len(r) < 8:
            continue
        benchmark = r[0].strip()
        project = r[1].strip()
        # columns 6 and 7 are evosuite and npetest per file header
        ev = r[6].strip() if len(r) > 6 else ''
        npv = r[7].strip() if len(r) > 7 else ''
        csv_rows.append({
            'benchmark': benchmark,
            'project': project,
            'ev': ev,
            'np': npv,
            'norm': norm(project),
            'toks': set(toks(project)),
            'used': False
        })

# Index by benchmark for faster lookup
by_bench = defaultdict(list)
for i, r in enumerate(csv_rows):
    by_bench[r['benchmark']].append(i)

# Read expected template
exp = open('/workspace/expected.md').read().splitlines()

out_lines = []
current_bench = None

# helper to find best match for a base project name in a given benchmark
def find_match(base, bench):
    base_norm = norm(base)
    base_toks = set(toks(base))
    candidates = by_bench.get(bench, [])
    best_idx = None
    best_score = -1
    # prefer candidates within same benchmark
    for idx in candidates:
        r = csv_rows[idx]
        if r['used']:
            continue
        score = 0
        if base_norm and base_norm in r['norm']:
            score += 100
        # token overlap
        overlap = len(base_toks & r['toks'])
        score += overlap
        if score > best_score:
            best_score = score
            best_idx = idx
    # fallback: any unused row globally
    if best_idx is None:
        for idx, r in enumerate(csv_rows):
            if r['used']: continue
            overlap = len(base_toks & r['toks'])
            if overlap > best_score:
                best_score = overlap
                best_idx = idx
    return best_idx

for line in exp:
    # update current benchmark section on header lines
    if line.strip().startswith('###'):
        if 'NPEX' in line:
            current_bench = 'NPEX'
        elif 'BugSwarm' in line:
            current_bench = 'BugSwarm'
        elif 'Defects4J' in line:
            current_bench = 'Defects4J'
        elif 'Genesis' in line:
            current_bench = 'Genesis'
        elif 'Bears' in line:
            current_bench = 'Bears'
        out_lines.append(line)
        continue

    # Process table rows only
    if line.strip().startswith('|') and '|' in line:
        parts = [p.strip() for p in line.split('|')[1:-1]]
        # header or separator rows: keep unchanged
        if len(parts) >= 3 and parts[0].lower() not in ('project', '') and not parts[0].startswith(':---'):
            projcell = parts[0]
            # remove trailing parenthesis numbering like (1)
            base = re.sub(r'\(\d+\)\s*$', '', projcell).strip()
            # attempt to find a match
            match_idx = find_match(base, current_bench)
            if match_idx is not None:
                row = csv_rows[match_idx]
                row['used'] = True
                # parse numeric values; treat empty as 0
                def fmt(v):
                    if v == '' or v.lower() == 'nan':
                        return '0'
                    try:
                        fv = float(v)
                        iv = round_away(fv)
                        return str(iv)
                    except:
                        return v
                evs = fmt(row['ev'])
                nps = fmt(row['np'])
                out_lines.append(f"| {projcell} | {evs} | {nps} |")
                continue
    out_lines.append(line)

print("\n".join(out_lines))
PY

# Format and show the comparison
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
EOF

chmod +x /workspace/repro_npetest_table_2.sh && artisan submit /workspace/repro_npetest_table_2.sh
