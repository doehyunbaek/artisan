import json
import io
from contextlib import redirect_stdout
from pathlib import Path

# Path to the RQ1 analysis notebook
base = Path("/workspace/gh_resource_study_artifact_patched/github-workflow-resource-optimization")
nb_path = base / "paper_analysis_RQ1.ipynb"

with nb_path.open("r", encoding="utf-8") as f:
    nb = json.load(f)

# Execute code cells sequentially to recreate the notebook environment
# up to and including cell 23 (where all variables for Table 2 are defined).
ns = {"__name__": "__main__"}
devnull = io.StringIO()

for idx, cell in enumerate(nb.get("cells", [])):
    if cell.get("cell_type") != "code":
        continue
    src = "".join(cell.get("source", []))
    if not src.strip():
        continue
    # Suppress any intermediate prints from the notebook
    with redirect_stdout(devnull):
        exec(src, ns)
    if idx >= 23:
        break

# Extract variables needed for Table 2
tasks = ns["tasks"]
all_jobs_1 = ns["all_jobs_1"]
all_jobs_2 = ns["all_jobs_2"]
sum_t1 = ns["sum_t1"]
sum_t2 = ns["sum_t2"]
total_runs_1 = ns["total_runs_1"]
total_runs_2 = ns["total_runs_2"]
calc_costs_by_task = ns["calc_costs_by_task"]

# Emit Table 2 as Markdown
print("**Table 2: Summary of resource consumption by CI/CD tasks.**\n")
print("| Task        | VM time % (Paid) | VM time % (Free) | Runs % (Paid) | Runs % (Free) | VM time per run, min (Paid) | VM time per run, min (Free) | VM cost per run, $ (Paid) | VM cost per run, $ (Free) |")
print("| ----------- | ---------------: | ---------------: | ------------: | ------------: | --------------------------: | --------------------------: | ------------------------: | ------------------------: |")

for t in tasks:
    j1 = all_jobs_1[all_jobs_1.sub_names == t]
    j2 = all_jobs_2[all_jobs_2.sub_names == t]

    # Overall proportions
    vm_time_paid = j1.up_time.sum() / sum_t1 * 100 if sum_t1 else 0.0
    vm_time_free = j2.up_time.sum() / sum_t2 * 100 if sum_t2 else 0.0
    runs_paid = j1.shape[0] / total_runs_1 * 100 if total_runs_1 else 0.0
    runs_free = j2.shape[0] / total_runs_2 * 100 if total_runs_2 else 0.0

    # Per-run VM time (mean and IQR, in minutes)
    if j1.shape[0]:
        mean_paid = j1.up_time_min.sum() / j1.shape[0]
        iqr_paid = j1.up_time_min.quantile(0.75) - j1.up_time_min.quantile(0.25)
    else:
        mean_paid = 0.0
        iqr_paid = 0.0

    if j2.shape[0]:
        mean_free = j2.up_time_min.sum() / j2.shape[0]
        iqr_free = j2.up_time_min.quantile(0.75) - j2.up_time_min.quantile(0.25)
    else:
        mean_free = 0.0
        iqr_free = 0.0

    # VM cost per run
    cost_paid = calc_costs_by_task(round(mean_paid, 1), t)
    cost_free = calc_costs_by_task(round(mean_free, 1), t)

    # Capitalize task names to match the paper (e.g., "linux" -> "Linux")
    task_label = t.capitalize()

    print(
        f"| {task_label:<10} | "
        f"{vm_time_paid:15.1f} | {vm_time_free:15.1f} | "
        f"{runs_paid:12.1f} | {runs_free:12.1f} | "
        f"{mean_paid:10.1f} ({iqr_paid:4.1f}) | "
        f"{mean_free:10.1f} ({iqr_free:4.1f}) | "
        f"{cost_paid:22.2f} | {cost_free:22.2f} |"
    )

print("\n* mean (inter-quartile range)")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
