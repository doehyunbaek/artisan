# 3.3: Run Docker container (detached) and execute summary_release inside it
CID=$(docker run -d --init --entrypoint bash -p 127.0.0.1:12345:5432 -e POSTGRES_PASSWORD="postgres" -w /app --mount type=bind,src="$(pwd)",target=/app cargo-ecosystem-monitor -c 'sleep infinity')
docker exec "$CID" /bin/bash --noprofile --norc -c "cd /app/Code/accuracy_evaluation && cargo run --bin summary_release" > /workspace/summary_output.txt

# 3.4: Parse summary_release output, round to two decimals, and write reproduced Table 1
awk '
  /^Dataset:/ { ds = $2 }
  /Tree Accuracy/ {
    v = $4; sub(/%$/, "", v); ta[ds] = v + 0
  }
  /Precision/ && !/Tree/ {
    v = $4; sub(/%$/, "", v); pr[ds] = v + 0
  }
  /Recall/ {
    v = $4; sub(/%$/, "", v); rc[ds] = v + 0
  }
  /F1Score/ {
    v = $4; sub(/%$/, "", v); f1[ds] = v + 0
  }
  END {
    print "**Table 1: Resolution accuracy.**"
    print ""
    print "| Dataset Type | Tree Accuracy | Precision | Recall | F1Score |"
    print "| ------------ | ------------: | --------: | -----: | ------: |"
    printf "| Random       | %12.2f%% | %8.2f%% | %6.2f%% | %7.2f%% |\n", ta["random"],  pr["random"],  rc["random"],  f1["random"]
    printf "| Popular      | %12.2f%% | %8.2f%% | %6.2f%% | %7.2f%% |\n", ta["popular"], pr["popular"], rc["popular"], f1["popular"]
    printf "| Mostdep      | %12.2f%% | %8.2f%% | %6.2f%% | %7.2f%% |\n", ta["mostdep"], pr["mostdep"], rc["mostdep"], f1["mostdep"]
  }
' /workspace/summary_output.txt > /workspace/repro.txt

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
