#!/usr/bin/env python3
import os, json, csv, statistics, sys

# Where campaigns are stored (artifact extracted)
candidates = [
    "/workspace/campaigns/campaigns",
    "campaigns/campaigns",
    "/workspace/campaigns",
    "campaigns"
]
base = None
for c in candidates:
    if os.path.isdir(c):
        base = c
        break
if not base:
    print("Campaigns directory not found", file=sys.stderr)
    sys.exit(1)

# Known subjects and fuzzer raw names (from README)
subjects = ["ant","bcel","closure","maven","nashorn","rhino","tomcat"]
fuzzer_raws = [
    "bedivfuzz-simple","bedivfuzz-structure",
    "rlcheck","zest",
    "zeugma-linked","zeugma-none","zeugma-one_point","zeugma-two_point"
]

# Map raw fuzzers to display labels matching expected.md
display_map = {
    "bedivfuzz-simple":"BeDiv-Simple",
    "bedivfuzz-structure":"BeDiv-Struct",
    "rlcheck":"RLCheck",
    "zest":"Zest",
    "zeugma-linked":"Zeugma-Link",
    "zeugma-none":"Zeugma-X",
    "zeugma-one_point":"Zeugma-?PT",
    "zeugma-two_point":"Zeugma-?PT"
}
# Row order as in expected table
row_order = [
    "BeDiv-Simple","BeDiv-Struct","RLCheck","Zest",
    "Zeugma-X","Zeugma-?PT","Zeugma-?PT","Zeugma-Link"
]

# Target times (ms)
targets = {"5M":300000, "3H":10800000}

# Helper: find value in nested json matching any of candidate values
def find_value(obj, candidates):
    if isinstance(obj, dict):
        for k,v in obj.items():
            res = find_value(v, candidates)
            if res is not None:
                return res
    elif isinstance(obj, list):
        for item in obj:
            res = find_value(item, candidates)
            if res is not None:
                return res
    else:
        if isinstance(obj, str) and obj in candidates:
            return obj
    return None

# Iterate campaign directories
data = {}  # (display_label,subject) -> {'5M': [vals], '3H':[vals]}
for entry in os.listdir(base):
    d = os.path.join(base, entry)
    if not os.path.isdir(d):
        continue
    summary_path = os.path.join(d, "summary.json")
    cov_path = os.path.join(d, "coverage.csv")
    if not os.path.isfile(summary_path) or not os.path.isfile(cov_path):
        continue
    try:
        with open(summary_path,'r') as f:
            summary = json.load(f)
    except Exception:
        continue
    # find subject and fuzzer in summary content
    sub = find_value(summary, subjects)
    fuz = find_value(summary, fuzzer_raws)
    if sub is None or fuz is None:
        # try some common keys
        sub = sub or summary.get("subject") or summary.get("configuration",{}).get("subject")
        fuz = fuz or summary.get("fuzzer") or summary.get("configuration",{}).get("fuzzer")
    if sub is None or fuz is None:
        continue
    display = display_map.get(fuz, fuz)
    # read coverage times
    times = []
    try:
        with open(cov_path,'r') as f:
            reader = csv.reader((line.replace('\r','') for line in f))
            for row in reader:
                if not row: continue
                # expect two columns: time, covered_branches
                try:
                    t = int(row[0].strip())
                    v = int(row[1].strip())
                    times.append((t,v))
                except Exception:
                    continue
    except Exception:
        continue
    if not times:
        continue
    times.sort()
    # function to get value at or before target
    def get_at_target(tt):
        val = None
        for t,v in times:
            if t <= tt:
                val = v
            else:
                break
        return val
    v5 = get_at_target(targets["5M"])
    v3 = get_at_target(targets["3H"])
    key = (display, sub)
    if key not in data:
        data[key] = {"5M":[],"3H":[]}
    # Use None to indicate missing for this campaign; we'll skip missing when aggregating
    if v5 is not None:
        data[key]["5M"].append(v5)
    if v3 is not None:
        data[key]["3H"].append(v3)

# For each row (display fuzzer) and subject produce median or '—'
def fmt(val):
    if val is None:
        return "    —"
    else:
        # format with one decimal place
        return "{:8.1f}".format(val)

# Compute medians
medians = {}
for display in row_order:
    medians[display] = {}
    for sub in subjects:
        key = (display, sub)
        arr5 = data.get(key,{}).get("5M",[])
        arr3 = data.get(key,{}).get("3H",[])
        m5 = None
        m3 = None
        if arr5:
            try:
                m5 = statistics.median(arr5)
            except Exception:
                m5 = None
        if arr3:
            try:
                m3 = statistics.median(arr3)
            except Exception:
                m3 = None
        medians[display][sub] = (m5,m3)

# Write markdown table closely matching expected.md layout
header = "| Fuzzer       |    Ant 5M | Ant 3H |    BCEL 5M |    BCEL 3H |  Closure 5M |  Closure 3H | Maven 5M |   Maven 3H | Nashorn 5M | Nashorn 3H |   Rhino 5M |   Rhino 3H | Tomcat 5M | Tomcat 3H |"
sep = "| ------------ | --------: | -----: | ---------: | ---------: | ----------: | ----------: | -------: | ---------: | ---------: | ---------: | ---------: | ---------: | --------: | --------: |"
lines = [header, sep]
for display in row_order:
    cells = [display]
    for sub in subjects:
        m5,m3 = medians[display][sub]
        cells.append(fmt(m5))
        cells.append(fmt(m3))
    # Build row string, ensure spacing similar to expected
    row = "| " + " | ".join(cells) + " |"
    lines.append(row)

out = "\n".join(lines) + "\n"
with open("/workspace/repro.txt",'w') as f:
    f.write(out)

# Also print a short summary to stdout
print("Wrote /workspace/repro.txt with computed medians.")
PY
python3 /workspace/compute_table3.py && sed -n '1,200p' /workspace/repro.txt
