<mini_swe_agent_bash>
python3 - <<'PY'
import os, re, sys

root = "pmsat-inference-and-publication-artifacts/pmsat-inference/benchmarkingset-rc2-results"
if not os.path.isdir(root):
    print("Benchmark root not found:", root, file=sys.stderr)
    sys.exit(1)

counts = {}
totals = {}

for param_dir in sorted(os.listdir(root)):
    if not param_dir.startswith("n_states="):
        continue
    m = re.search(r"n_states=(\d+)", param_dir)
    if not m:
        continue
    n = int(m.group(1))
    param_path = os.path.join(root, param_dir)
    # iterate experiment subdirectories
    for entry in os.listdir(param_path):
        exp_dir = os.path.join(param_path, entry)
        if not os.path.isdir(exp_dir):
            continue
        totals[n] = totals.get(n, 0) + 1
        timed = False
        # Scan all files in experiment dir for timeout indicators or long runtimes
        for fname in os.listdir(exp_dir):
            fpath = os.path.join(exp_dir, fname)
            if not os.path.isfile(fpath):
                continue
            try:
                with open(fpath, "rb") as f:
                    data = f.read().decode("utf-8", errors="ignore")
            except Exception:
                continue
            # textual indicators
            if re.search(r"time\W*out", data, re.I) or re.search(r"timed\W*out", data, re.I):
                timed = True
                break
            # numeric time fields (common keys)
            for key in ("time", "solving_time", "total_time", "runtime", "elapsed"):
                mnum = re.search(r'"' + re.escape(key) + r'"\s*:\s*([0-9]+(?:\.[0-9]+)?)', data)
                if mnum:
                    try:
                        val = float(mnum.group(1))
                        if val >= 3600.0:
                            timed = True
                            break
                    except Exception:
                        pass
            if timed:
                break
        if timed:
            counts[n] = counts.get(n, 0) + 1

# Prepare table for n = 8..17
ns = list(range(8, 18))
lines = []
for n in ns:
    tot = totals.get(n, 0)
    cnt = counts.get(n, 0)
    perc = (cnt / tot * 100.0) if tot > 0 else 0.0
    lines.append((n, tot, cnt, perc))

out_path = "/workspace/repro.txt"
with open(out_path, "w") as out:
    out.write("**Table 3: Percentage of the 400 experiments per number of states that ran into the one hour timeout.**\n\n")
    # header
    out.write("| n         |" + "".join(f" {n:4d} |" for n in ns) + "\n")
    out.write("| --------- |" + "".join(" --: |" for _ in ns) + "\n")
    out.write("| timeout % |" + "".join(f" {perc:4.1f} |" for (_,_,_,perc) in lines) + "\n\n")
    out.write("# details\n")
    for n, tot, cnt, perc in lines:
        out.write(f"n={n}: total={tot}, timeouts={cnt}, percent={perc:.1f}\n")

print("Wrote", out_path)
PY
