import sys
sys.path.insert(0, '/workdir')
from runs_collector.dataset import RunsDataSet
from runs_analysis.name_based_analysis import get_topk_jobs_names, simplify_and_map
import pandas as pd

# Load dataset
data_set = RunsDataSet(None, None, from_checkpoint=True, checkpoint_dir="./")

# Get repositories by tier
repos_list_1 = data_set.get_repositories(by_tier='paid')
repos_list_2 = data_set.get_repositories(by_tier='free')

# Get top k job names
top_k_jobs_1 = get_topk_jobs_names(data_set, repos_list_1, k=10).reset_index()
top_k_jobs_2 = get_topk_jobs_names(data_set, repos_list_2, k=100).reset_index()

# Get all runs and jobs
all_runs = data_set.get_all_runs()
all_runs_1 = all_runs[all_runs.repo_id.isin(repos_list_1)]
all_runs_2 = all_runs[all_runs.repo_id.isin(repos_list_2)]
all_jobs = data_set.get_all_jobs()
all_jobs_1 = all_jobs[all_jobs.run_id.isin(all_runs_1.id)]
all_jobs_2 = all_jobs[all_jobs.run_id.isin(all_runs_2.id)]

# Simplify job names to tasks
top_k_jobs_1['sub_names'] = top_k_jobs_1['job_name'].apply(lambda x: simplify_and_map(x))
top_k_jobs_2['sub_names'] = top_k_jobs_2['job_name'].apply(lambda x: simplify_and_map(x))
all_jobs_1['sub_names'] = all_jobs_1['name'].apply(lambda x: simplify_and_map(x))
all_jobs_2['sub_names'] = all_jobs_2['name'].apply(lambda x: simplify_and_map(x))

# Calculate proportions
total_runs_1 = all_runs_1.shape[0]
total_runs_2 = all_runs_2.shape[0]
sum_t1 = all_jobs_1.up_time.sum()
sum_t2 = all_jobs_2.up_time.sum()

tasks = top_k_jobs_1.sub_names.unique()

# Print table
print("Task,VM_time_%_Paid,VM_time_%_Free,Runs_%_Paid,Runs_%_Free,VM_time_per_run_min_Paid,VM_time_per_run_min_Free,VM_cost_per_run_$_Paid,VM_cost_per_run_$_Free")
for t in tasks:
    vm_time_paid = round(all_jobs_1[all_jobs_1.sub_names==t].up_time.sum()/sum_t1*100, 1)
    vm_time_free = round(all_jobs_2[all_jobs_2.sub_names==t].up_time.sum()/sum_t2*100, 1)
    runs_paid = round(all_jobs_1[all_jobs_1.sub_names==t].shape[0]/total_runs_1*100, 1)
    runs_free = round(all_jobs_2[all_jobs_2.sub_names==t].shape[0]/total_runs_2*100, 1)
    
    # VM time per run (mean and IQR)
    paid_times = all_jobs_1[all_jobs_1.sub_names==t].up_time / 60  # convert to minutes
    free_times = all_jobs_2[all_jobs_2.sub_names==t].up_time / 60
    mean_paid = round(paid_times.mean(), 1) if not paid_times.empty else 0.0
    mean_free = round(free_times.mean(), 1) if not free_times.empty else 0.0
    iqr_paid = round(paid_times.quantile(0.75) - paid_times.quantile(0.25), 1) if not paid_times.empty else 0.0
    iqr_free = round(free_times.quantile(0.75) - free_times.quantile(0.25), 1) if not free_times.empty else 0.0
    
    # VM cost per run (assuming $0.008 per minute for paid, $0 for free)
    cost_paid = round(mean_paid * 0.008, 2)
    cost_free = 0.00  # free tier
    
    print(f"{t},{vm_time_paid},{vm_time_free},{runs_paid},{runs_free},{mean_paid} ({iqr_paid}),{mean_free} ({iqr_free}),{cost_paid},{cost_free}")
EOF
</mini_swe_agent_bash>
