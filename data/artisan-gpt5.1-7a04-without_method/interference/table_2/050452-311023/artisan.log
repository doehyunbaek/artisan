from decimal import Decimal, getcontext, ROUND_HALF_UP
import csv
from pathlib import Path

base = Path("/workspace/artifact_efficient_test_interference_detection_c/artifact_efficient_test_interference_detection_c/data_analysis/testsuite")

projects = ["ezstream", "flex", "imagemagick", "libfastjson", "libiff", "naemon-core", "safeclib"]

getcontext().prec = 50

def fmt_sci(n_str):
    n = Decimal(n_str)
    s = n_str.lstrip("0")
    exp = len(s) - 1
    mant = (n / (Decimal(10) ** exp)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    return f"{mant}×10^{exp}"

for proj in projects:
    path = base / f"{proj}-testsuite-permutation-data.csv"
    with path.open() as f:
        r = csv.DictReader(f)
        row = next(r)
    tsp_max = row["tsp_max"]
    tsp_ofsfdf = row["tsp_ofsfdf"]
    print(f"== {proj} ==")
    print("tsp_max_raw digits:", len(tsp_max))
    print("tsp_max_sci:", fmt_sci(tsp_max))
    if int(tsp_ofsfdf) > 10:
        print("tsp_ofsfdf_raw digits:", len(tsp_ofsfdf))
        print("tsp_ofsfdf_sci:", fmt_sci(tsp_ofsfdf))
    else:
        print("tsp_ofsfdf_raw:", tsp_ofsfdf)
    print()
PY
