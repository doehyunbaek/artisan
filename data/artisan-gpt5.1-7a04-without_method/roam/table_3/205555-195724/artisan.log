import os, math

path = "ROAM-Artifact/ROAM-Artifact/Evaluation/results_converted.md"
with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()

# Collect table lines (those starting with '|')
table_lines = [l.strip("\n") for l in lines if l.lstrip().startswith("|")]
if len(table_lines) < 4:
    raise SystemExit("Table appears incomplete in results_converted.md")

h1 = table_lines[0]  # group/header line with tool names (Col1, Col2, ..., ROAM, ..., Yakusu, ...)
hsep = table_lines[1]
h2 = table_lines[2]  # detailed header with field names like "Reproduction<br>Result"
data_lines = table_lines[3:]

def split_row(row):
    parts = row.strip().split("|")
    return [p.strip() for p in parts[1:-1]]  # drop leading/trailing empty due to edge pipes

h1_cells = split_row(h1)
h2_cells = split_row(h2)

if len(h1_cells) != len(h2_cells):
    raise SystemExit(f"Header length mismatch: {len(h1_cells)} vs {len(h2_cells)}")

# Locate key columns
try:
    idx_missing = h2_cells.index("# <br>Missing<br>Steps")
except ValueError:
    raise SystemExit("Could not find '# <br>Missing<br>Steps' column")

tools = ["ROAM", "ReCDroid", "Yakusu"]
tool_rr_idx = {}

for tool in tools:
    idxs = [i for i, (g, field) in enumerate(zip(h1_cells, h2_cells))
            if g == tool and field == "Reproduction<br>Result"]
    if not idxs:
        raise SystemExit(f"Could not find Reproduction Result column for {tool}")
    tool_rr_idx[tool] = idxs[0]

# Accumulators: {tool: [succ_all, total_all, succ_nomiss, total_nomiss, succ_miss, total_miss]}
stats = {t: [0, 0, 0, 0, 0, 0] for t in tools}

for line in data_lines:
    if line.strip() == "" or line.strip().startswith("|---"):
        continue
    cells = split_row(line)
    if len(cells) != len(h1_cells):
        # Skip malformed lines
        continue

    ms_raw = cells[idx_missing].strip()
    if not ms_raw:
        # Should not happen, but skip if missing
        continue
    try:
        missing_steps = int(float(ms_raw))
    except ValueError:
        continue

    has_missing = missing_steps > 0
    no_missing = missing_steps == 0

    for tool in tools:
        idx_rr = tool_rr_idx[tool]
        rr = cells[idx_rr].strip().lower()
        if rr == "" or rr == "na":
            # Tool not run on this report; exclude from denominator
            continue

        succ_all, tot_all, succ_nomiss, tot_nomiss, succ_miss, tot_miss = stats[tool]

        tot_all += 1
        if rr == "success":
            succ_all += 1

        if no_missing:
            tot_nomiss += 1
            if rr == "success":
                succ_nomiss += 1
        else:
            tot_miss += 1
            if rr == "success":
                succ_miss += 1

        stats[tool] = [succ_all, tot_all, succ_nomiss, tot_nomiss, succ_miss, tot_miss]

def pct(succ, tot):
    if tot == 0:
        return 0.0
    return 100.0 * succ / tot

print("Tool\tSucc/Total (All)\tAll %\tSucc/Total (NoMissing)\tNoMissing %\tSucc/Total (Missing)\tMissing %")
for tool in tools:
    sa, ta, sn, tn, sm, tm = stats[tool]
    print(f"{tool}\t{sa}/{ta}\t{pct(sa,ta):.2f}\t{sn}/{tn}\t{pct(sn,tn):.2f}\t{sm}/{tm}\t{pct(sm,tm):.2f}")
PY
