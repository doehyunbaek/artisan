import csv, datetime, statistics

# Parse time string to seconds
def time_to_seconds(time_str):
    # format: '0 days 00:05:00' or '0 days 00:00:00' or '0 days 00:00:10.810810810'
    parts = time_str.split()
    day_part = parts[0]  # e.g., '0'
    time_part = parts[2]  # e.g., '00:05:00' or '00:00:10.810810810'
    days = int(day_part)
    hms_parts = time_part.split(':')
    hours = int(hms_parts[0])
    minutes = int(hms_parts[1])
    seconds = float(hms_parts[2])
    total_seconds = days*24*3600 + hours*3600 + minutes*60 + seconds
    return total_seconds

# Collect data
data = {}
with open('/home/data/coverage.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        fuzzer = row['fuzzer']
        subject = row['subject']
        campaign_id = row['campaign_id']
        key = (fuzzer, subject, campaign_id)
        if key not in data:
            data[key] = {}
        seconds = time_to_seconds(row['time'])
        covered = float(row['covered_branches'])
        data[key][seconds] = covered

print(f'Total campaigns: {len(data)}')
# Show some keys
for key in list(data.keys())[:5]:
    print(f'Key: {key}, time points: {len(data[key])}')
    # Sort times
    sorted_times = sorted(data[key].keys())
    print(f'First 5 times: {sorted_times[:5]}')
    print(f'Last 5 times: {sorted_times[-5:]}')
"
