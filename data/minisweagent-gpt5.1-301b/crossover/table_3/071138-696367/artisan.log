<mini_swe_agent_bash>
python - << 'PY'
import csv
from collections import defaultdict
from statistics import median

path = "/workspace/coverage.csv"
t5 = "0 days 00:05:00"
t3 = "0 days 03:00:00"

# data[(fuzzer, subject, time_label)] -> list of coverages
data = defaultdict(list)

with open(path, newline="") as f:
    r = csv.DictReader(f)
    for row in r:
        t = row["time"]
        if t not in (t5, t3):
            continue
        cov = float(row["covered_branches"])
        fz = row["fuzzer"]
        subj = row["subject"]
        key = (fz, subj, "5M" if t == t5 else "3H")
        data[key].append(cov)

fuzzers = [
    "BeDiv-Simple",
    "BeDiv-Struct",
    "RLCheck",
    "Zest",
    "Zeugma-X",
    "Zeugma-1PT",
    "Zeugma-2PT",
    "Zeugma-Link",
]
subjects = ["Ant", "Bcel", "Closure", "Maven", "Nashorn", "Rhino", "Tomcat"]

print("Fuzzer,Subject,Time,MedianCoveredBranches,Count")
for fz in fuzzers:
    for subj in subjects:
        for label in ("5M", "3H"):
            vals = data.get((fz, subj, label))
            if not vals:
                continue
            print(f"{fz},{subj},{label},{median(vals)},{len(vals)}")
PY
</mini_swe_agent_bash>
