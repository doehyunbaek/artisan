+     {
+       dep[[typeconstruct]]=c(dep[[typeconstruct]],0)
+     }
+     else if(tpaired[[proc]][i]==TRUE & tpaired[[func]][i]==FALSE)
+     {
+       dep[[typeconstruct]]=c(dep[[typeconstruct]],-1)
+     }
+     else
+     {
+       dep[[typeconstruct]]=c(dep[[typeconstruct]],1)
+     }
+   }
+ }
