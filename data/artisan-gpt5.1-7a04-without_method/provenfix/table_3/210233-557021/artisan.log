snort=$(run_proj "spec_snort-2.9.13.c" "/home/benchmarks-RQ1N2/snort-2.9.13")
grub=$(run_proj "spec_Grub.c" "/home/benchmarks-RQ1N2/grub")

# Compute total repaired bugs
