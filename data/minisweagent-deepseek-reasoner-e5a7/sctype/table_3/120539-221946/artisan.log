import re
import sys

# Project names and summaries from Table 3 (in order as they appear in the table)
projects = [
    ("MarginSwap", "Dex project for margin trading on Uniswap and Sushiswap"),
    ("Vader Protocol", "Yield project for a collateralized stablecoin"),
    ("PoolTogether", "Gaming service on yield interest"),
    ("Tracer", "Derivative project that supports perpetual markets"),
    ("Yield Micro", "Lending project supporting borrowing, lending, and liquidity"),
    ("Sushi Trident", "Dex project for deploying personalized liquidity markets"),
    ("yAxis", "Yield project where users' aggregated funds are used in strategies for yield"),
    ("Badger Dao", "Yield project"),
    ("Wild Credit", "Lending project relying on pairs of assets instead of a pool"),
    ("PoolTogether v4", "Gaming service on yield interest"),
    ("Sushi Trident p2", "Dex project for deploying personalized liquidity markets"),
    ("Swell", "Yield project that uses set orders for Yield claiming"),
    ("Covalent", "Users delegate commissions to a Validators, which stakes the funds for interest"),
    ("yAxis p2", "Yield project where users' aggregated funds are used in strategies for yield"),
    ("Perennial", "Derivative project supporting synthetic token perpetual markets"),
    ("Yeti Finance", "Lending project made against a contract specific token"),
    ("Vader Protocol p3", "Yield project for a collateralized stablecoin"),
    ("InsureDao", "Insurance markets where buyers pay premium for protection against losses"),
    ("Rocket Joe", "Dex project where users exchange funds in return for new project liquidity"),
    ("Concur Finance", "Yield project"),
    ("Biconomy Hyphen", "Cross Chain project where users can deposit and withdraw for pools on different chains"),
    ("Volt", "Dex project which conserves the value of user funds against inflation"),
    ("Badger Dao p3", "Yield project"),
    ("Tigris Trade", "Dex project utilizing off-chain oracles to provide real-time prices")
]

# Group numbers from test_benchmark_final.sh that correspond to the projects above
# Note: Some projects have multiple groups (like Vader Protocol p2/p3) but we only need specific ones
# Based on analysis: Group 1: MarginSwap, Group 2: Vader Protocol, Group 3: PoolTogether, Group 4: Tracer,
# Group 5: Yield Micro, Group 6: Sushi Trident, Group 7: yAxis, Group 8: Badger Dao, Group 9: Wild Credit,
# Group 10: PoolTogether v4, Group 11: Sushi Trident p2, Group 12: Swell, Group 13: Covalent,
# Group 16: yAxis p2 (skip 14,15), Group 18: Perennial (skip 17), Group 20: Yeti Finance (skip 19),
# Group 21: Vader Protocol p3, Group 22: InsureDao, Group 23: Rocket Joe, Group 24: Concur Finance,
# Group 25: Biconomy Hyphen, Group 27: Volt (skip 26), Group 28: Badger Dao p3, Group 29: Tigris Trade
group_to_project = {
    1: 0,   # MarginSwap
    2: 1,   # Vader Protocol
    3: 2,   # PoolTogether
    4: 3,   # Tracer
    5: 4,   # Yield Micro
    6: 5,   # Sushi Trident
    7: 6,   # yAxis
    8: 7,   # Badger Dao
    9: 8,   # Wild Credit
    10: 9,  # PoolTogether v4
    11: 10, # Sushi Trident p2
    12: 11, # Swell
    13: 12, # Covalent
    16: 13, # yAxis p2
    18: 14, # Perennial
    20: 15, # Yeti Finance
    21: 16, # Vader Protocol p3
    22: 17, # InsureDao
    23: 18, # Rocket Joe
    24: 19, # Concur Finance
    25: 20, # Biconomy Hyphen
    27: 21, # Volt
    28: 22, # Badger Dao p3
    29: 23  # Tigris Trade
}

def parse_output(file_path):
    with open(file_path, 'r') as f:
        content = f.read()
    
    # Split by "Executing Group" to get each group's output
    groups = re.split(r'Executing Group \d+', content)
    # The first part is before any group, so skip it
    groups = groups[1:]
    
    results = {}
    
    for i, group_text in enumerate(groups, start=1):
        if i not in group_to_project:
            continue
            
        # Extract annotation count
        ann_match = re.search(r'Annotation count: (\d+)', group_text)
        if ann_match:
            ann_count = int(ann_match.group(1))
        else:
            ann_count = 0
            
        # Extract warning count from slither output "X result(s) found"
        warn_match = re.search(r'(\d+) result\(s\) found', group_text)
        if warn_match:
            warn_count = int(warn_match.group(1))
        else:
            warn_count = 0
            
        results[group_to_project[i]] = (ann_count, warn_count)
    
    return results

def main():
    if len(sys.argv) != 2:
        print("Usage: python parse_table3.py <test_output_file>")
        sys.exit(1)
    
    file_path = sys.argv[1]
    results = parse_output(file_path)
    
    # Print table header
    print("**Table 3: Evaluation Results**")
    print()
    print("| Project Name | Summary | Annotations | Total Warnings |")
    print("| --- | --- | ---: | ---: |")
    
    total_warnings = 0
    total_annotations = 0
    
    # Print each project row
    for i, (project, summary) in enumerate(projects):
        if i in results:
            ann, warn = results[i]
        else:
            ann, warn = 0, 0
            
        # Escape any pipes in summary
        summary_escaped = summary.replace('|', '\\|')
        
        print(f"| {project} | {summary_escaped} | {ann} | {warn} |")
        total_warnings += warn
        total_annotations += ann
    
    # Print total row
    print(f"| **Total** | | | **{total_warnings}** |")
    print()
    print(f"Total annotations: {total_annotations}")

if __name__ == "__main__":
    main()
EOF
</mini_swe_agent_bash>
