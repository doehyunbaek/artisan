# Formatting helpers
def fmt_all_runs(v: float) -> str:
    v = float(v)
    if 0 < abs(v) < 0.1:
        return "<0.1%"
    return f"{round(v, 1):.1f}%"

def fmt_time_all(v: float) -> str:
    v = float(v)
    if 0 < abs(v) < 0.1:
        return "<0.1%"
    return f"{round(v, 1):.1f}%"

def fmt_subset(v: float) -> str:
    v = float(v)
    return f"{round(v, 1):.1f}%"

def fmt_cost(v: float) -> str:
    return f"{float(v):.2f}"

