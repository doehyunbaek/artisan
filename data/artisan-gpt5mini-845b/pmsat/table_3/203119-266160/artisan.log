timeouts = {n:0 for n in ns}

def is_timed_from_json(obj):
    if not isinstance(obj, dict):
        return False
    # common boolean flags
    for k in ["timeout", "timed_out", "timedOut", "timed-out", "timed out"]:
        if k in obj and (obj[k] is True or str(obj[k]).lower() in ("true","timeout","timed_out","timedout")):
            return True
    # status fields
    st = None
    for key in ("status","result","state"):
        if key in obj:
            st = str(obj[key]).lower()
            if "time" in st and "out" in st:
                return True
            if "timeout" in st or "timed_out" in st:
                return True
    # numeric time fields
    for k in ("time","solving_time","solve_time","total_time","runtime","elapsed","wall_time"):
        if k in obj:
            try:
                if float(obj[k]) >= 3600.0:
                    return True
            except Exception:
                pass
    # nested search
    for v in obj.values():
        if isinstance(v, dict):
            if is_timed_from_json(v):
                return True
    return False

time_re = re.compile(r'([0-9]+(?:\.[0-9]+)?)')
def check_file_for_timeout(path):
    try:
        txt = open(path, "rb").read().decode("utf-8", errors="ignore")
    except Exception:
        return False
    # textual indicators
    if re.search(r"timed\s*out|time\s*out|timeout", txt, re.I):
        return True
    # numeric fields in text
    for key in ("time", "solving_time", "solve_time", "total_time", "runtime", "elapsed"):
        for m in re.finditer(r'["\']?'+key+r'["\']?\s*[:=]\s*([0-9]+(?:\.[0-9]+)?)', txt, re.I):
            try:
                if float(m.group(1)) >= 3600.0:
                    return True
            except:
                pass
    return False

for param_dir in sorted(os.listdir(root)):
    if not param_dir.startswith("n_states="):
        continue
    m = re.search(r"n_states=(\d+)", param_dir)
    if not m:
        continue
    n = int(m.group(1))
    if n not in totals:
        continue
    pdir = os.path.join(root, param_dir)
    for entry in sorted(os.listdir(pdir)):
        expdir = os.path.join(pdir, entry)
        if not os.path.isdir(expdir):
            continue
        totals[n] += 1
        timed = False
        for fname in os.listdir(expdir):
            fpath = os.path.join(expdir, fname)
            if not os.path.isfile(fpath):
                continue
