import json, pathlib, re

def search_nb(path, patterns):
    nb = json.load(path.open())
    print(f"\n=== Notebook: {path.name} ===")
    for i, cell in enumerate(nb.get("cells", []), 1):
        for field in ("source",):
            text = "".join(cell.get(field, []))
            if any(p in text for p in patterns):
                print(f"\n--- Cell {i} {field} ---")
                print(text)
        for out in cell.get("outputs", []):
            for key in ("text", "data"):
                if key == "text" and key in out:
                    t = "".join(out["text"])
                    if any(p in t for p in patterns):
                        print(f"\n--- Cell {i} output.text ---")
                        print(t)
                if key == "data" and key in out:
                    for mime, val in out["data"].items():
                        if isinstance(val, list):
                            t = "".join(val)
                        else:
                            t = str(val)
                        if any(p in t for p in patterns):
                            print(f"\n--- Cell {i} output.data[{mime}] ---")
                            print(t)

patterns = ["builtins.isinstance", "Pattern.match", "str.isidentifier"]
for nb_name in ["spec_mine.ipynb", "plots_sec4.3.ipynb"]:
