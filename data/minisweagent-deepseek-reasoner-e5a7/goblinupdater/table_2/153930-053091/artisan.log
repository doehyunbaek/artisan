import csv, sys, math
from statistics import quantiles

def read_column(filepath, col_name):
    with open(filepath, 'r') as f:
        reader = csv.DictReader(f)
        # Check that the column exists
        if col_name not in reader.fieldnames:
            raise ValueError(f"Column {col_name} not in CSV")
        return [float(row[col_name]) for row in reader]

# Path to the executionsData.csv
filepath = '/workspace/artifact/ASE24_data_and_tools/results_data/execution/conf_2_global/executionsData.csv'

# Mapping from CSV column names to Table 2 metric names
mapping = {
    'directDepNumber': "direct dependencies",
    'releaseSize': "releases",
    'artifactSize': "libraries",
    'dependencySize': "dependency edges",
    'versionSize': "version edges"
}

for col, name in mapping.items():
    data = read_column(filepath, col)
    # Sort the data for min, max, and quartiles
    data_sorted = sorted(data)
    n = len(data_sorted)
    # Calculate quartiles using statistics.quantiles (returns [Q1, Q2, Q3] by default for n=4)
    q = quantiles(data_sorted, n=4)
    q1, q2, q3 = q[0], q[1], q[2] if len(q) == 3 else (q[0], q[1], q[1])
    min_val = min(data_sorted)
    max_val = max(data_sorted)
    # Print with formatting to match the paper's precision
    print(f"{name}: Q1={q1:.1f}, Q2={q2:.0f}, Q3={q3:.0f}, min={min_val:.0f}, max={max_val:.0f}")
EOF
</mini_swe_agent_bash>
