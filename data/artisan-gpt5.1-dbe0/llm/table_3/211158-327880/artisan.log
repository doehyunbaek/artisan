        from math import erf, sqrt
        p = 2.0 * (1.0 - 0.5 * (1.0 + erf(abs(z) / math.sqrt(2.0))))
        out.append((b, s, stars(p)))
    return out, r2, r2_adj

prompt_rows = read_rows(DATA_PATH, "query_total")
follow_rows = read_rows(DATA_PATH, "Query_followup")
all_rows = read_rows(DATA_PATH, "usage_total")

