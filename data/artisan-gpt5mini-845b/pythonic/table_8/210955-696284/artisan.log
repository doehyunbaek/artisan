#!/usr/bin/bash
set -euo pipefail

# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 8: RQ1: Logistic regression relating the use of filter with the correctness of the change task (AIC=157)**

| Term | Estimate | Std.Error | z value | Pr(>\|z\|) |
|---|---:|---:|---:|---:|
| (Intercept) | -??.?? | ????.?? | ?.?? | ?.?? |
| MainFactorProc | -?.?? | ?.?? | -?.?? | ?.?? |
| Usage Freq. | -?.?? | ?.?? | -?.?? | ?.?? |
| Approvals | ?.?? | ?.?? | -?.?? | ?.?? |
| StudentTrue | ??.?? | ????.?? | ?.?? | ?.?? |

EOTABLE

# Section 2: Artifact download (required)
artisan get https://zenodo.org/records/10554377 || true

# Section 3: Run analysis inside docker to regenerate results
docker rm -f rexp_container >/dev/null 2>&1 || true
HOST_ARTIFACT_DIR="${HOST}"
docker run -d --init --entrypoint bash -v "${HOST_ARTIFACT_DIR}:/data" --name rexp_container mdipenta/rexp:latest -c 'sleep infinity'
docker exec rexp_container /bin/bash --noprofile --norc -c "cd /data && R --no-save < FuncConstructs-Statistics.r"

# Section 4: Build reproduction table from generated CSV using Python (ROUND HALF AWAY FROM ZERO)
CSV_PATH="\${HOST_ARTIFACT_DIR}/results/Table-8-RQ1-filter.csv"
if [ ! -f "\${CSV_PATH}" ]; then
  echo "ERROR: Table 8 CSV not found" > /workspace/repro.txt
  exit 1
fi

python3 - <<PY > /workspace/repro.txt
from decimal import Decimal, ROUND_HALF_UP
import csv, sys

csv_path = "${CSV_PATH}"
terms = ["(Intercept)","MainFactorProc","Usage Freq.","Approvals","StudentTrue"]

def round_half_away_str(s, nd=2):
    d = Decimal(str(s))
    q = d.quantize(Decimal('1e-{}'.format(nd)), rounding=ROUND_HALF_UP)
    fmt = f"{{0:.{nd}f}}"
    return fmt.format(q)

rows = []
with open(csv_path, newline='') as f:
    reader = csv.reader(f)
    for r in reader:
        if len(r) >= 4:
            rows.append(r[:4])

while len(rows) < len(terms):
    rows.append(["0","0","0","0"])

print("**Table 8: RQ1: Logistic regression relating the use of filter with the correctness of the change task (AIC=157)**")
print()
print("| Term | Estimate | Std.Error | z value | Pr(>\\|z\\|) |")
print("|---|---:|---:|---:|---:|")
for i, term in enumerate(terms):
    est = round_half_away_str(rows[i][0], 2)
    se  = round_half_away_str(rows[i][1], 2)
    z   = round_half_away_str(rows[i][2], 2)
    p   = round_half_away_str(rows[i][3], 2)
    print(f"| {term} | {est} | {se} | {z} | {p} |")
PY

# Section 5: Format and submit
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_pythonic_table_8.sh && artisan submit /workspace/repro_pythonic_table_8.sh
