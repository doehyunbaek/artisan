import csv
from collections import defaultdict
fn='/workspace/RQ1.csv'
counts=defaultdict(lambda: defaultdict(int))
with open(fn,newline='') as f:
    r=csv.DictReader(f)
    for row in r:
        section=row['Section']
        main=row['MainFactor']
        outcome=row['Outcome']
        key=section
        side='Functional' if main=='f' else 'Procedural'
        if outcome.upper()=='TRUE': counts[key][side+'_Corr']+=1
        else: counts[key][side+'_Wrong']+=1
# Map section names to labels in paper: lambda->Lambda, comp->Compr., mrf->MRF
mapping={'lambda':'Lambda','comp':'Compr.','mrf':'MRF'}
print('| Construct | **Functional — Corr.** | **Functional — Wrong** | **Functional — % Corr.** | **Procedural — Corr.** | **Procedural — Wrong** | **Procedural — % Corr.** |')
for s in ['lambda','comp','mrf']:
    c=counts[s]
    f_corr=c.get('Functional_Corr',0)
    f_wrong=c.get('Functional_Wrong',0)
    p_corr=c.get('Procedural_Corr',0)
    p_wrong=c.get('Procedural_Wrong',0)
    def pct(corr,wrong):
        total=corr+wrong
        return f"{(corr/total*100):.2f}" if total>0 else '0.00'
    print(f"| {mapping[s]:<9} | {f_corr:22d} | {f_wrong:22d} | {pct(f_corr,f_wrong):>23} | {p_corr:21d} | {p_wrong:21d} | {pct(p_corr,p_wrong):>23} |")
PY
