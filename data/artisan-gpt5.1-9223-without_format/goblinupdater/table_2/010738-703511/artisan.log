    reader = csv.DictReader(f)
    for row in reader:
        for c in cols:
            v = row.get(c)
            if v:
                data[c].append(float(v))

def pandas_percentile(values, q):
    # Emulate pandas/numpy percentile with method='linear' on [0, n-1]
    vs = sorted(values)
    n = len(vs)
    if n == 1:
        return vs[0]
    pos = (n - 1) * q
    lo = int(math.floor(pos))
    hi = int(math.ceil(pos))
    if lo == hi:
        return vs[lo]
    frac = pos - lo
    return vs[lo] + frac * (vs[hi] - vs[lo])

print("Metric,Q1,Q2,Q3,min,max")
