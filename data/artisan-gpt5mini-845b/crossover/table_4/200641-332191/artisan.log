import csv, re
from collections import defaultdict, OrderedDict
def defect_subject(def):
    if def.startswith('B'): return 'Bcel'
    if def.startswith('C'): return 'Closure'
    if def.startswith('N'): return 'Nashorn'
    if def.startswith('R'): return 'Rhino'
    return None

def parse_time(s):
    if not s: return None
    m = re.match(r'\s*(\d+)\s+days\s+(\d+):(\d+):([\d.]+)', s)
    if not m: return None
    d,h,mi,sx = int(m.group(1)),int(m.group(2)),int(m.group(3)),float(m.group(4))
    return d*86400 + h*3600 + mi*60 + sx

path = '/workspace/detections.csv'
den_counts = defaultdict(lambda: defaultdict(set))
det5 = defaultdict(lambda: defaultdict(set))
det3 = defaultdict(lambda: defaultdict(set))
with open(path,newline='') as f:
    r = csv.DictReader(f)
    for row in r:
        fuz = row['fuzzer'].strip()
        subj = row['subject'].strip()
        defect = row['defect'].strip()
        cid = row['campaign_id'].strip()
        t = parse_time(row['time'].strip())
        den_counts[fuz][subj].add(cid)
        if defect and fuz and subj:
            if t is not None:
                if t <= 300:
                    det5[(fuz,subj)][defect].add(cid)
                    det3[(fuz,subj)][defect].add(cid)
                elif t <= 10800:
                    det3[(fuz,subj)][defect].add(cid)

fuzzers = ["BeDiv-Simple","BeDiv-Struct","RLCheck","Zest","Zeugma-X","Zeugma-1PT","Zeugma-2PT","Zeugma-Link"]
defects = ["B0","B1","C0","C1","N0","N1","N2","R0","R1","R2","R3","R4"]
print("fuzzer,defect,subject,denom_present,unique_campaigns_count,5M_count,3H_count,5M_rate,3H_rate")
for f in fuzzers:
    for d in defects:
        subj = defect_subject(d)
        denom_present = len(den_counts[f].get(subj, set()))>0
        count_unique = len(den_counts[f].get(subj, set()))
        c5 = len(det5[(f,subj)].get(d, set()))
        c3 = len(det3[(f,subj)].get(d, set()))
        if not denom_present:
            r5 = r3 = '-'
        else:
            DEN = 20
            r5 = f"{(c5/DEN)*100:.2f}"
            r3 = f"{(c3/DEN)*100:.2f}"
        print(f"{f},{d},{subj},{'yes' if denom_present else 'no'},{count_unique},{c5},{c3},{r5},{r3}")
