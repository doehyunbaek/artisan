python3 - <<'PY'
import csv, re, statistics, sys
from collections import defaultdict, OrderedDict

def parse_time(s):
    m = re.match(r'(?:(\d+)\s+days\s+)?(\d+):(\d+):(\d+(?:\.\d+)?)', s.strip())
    if not m:
        raise ValueError("unparsed time: "+s)
    days = int(m.group(1) or 0)
    hh = int(m.group(2))
    mm = int(m.group(3))
    ss = float(m.group(4))
    return days*86400 + hh*3600 + mm*60 + ss

infile = "/workspace/coverage.csv"
groups = defaultdict(list)  # key: (fuzzer_norm, subject, campaign_id) -> list of (time_s, covered)
with open(infile, newline='') as f:
    rdr = csv.DictReader(f)
    for r in rdr:
        try:
            t = parse_time(r['time'])
        except Exception:
            continue
        try:
            cov = float(r['covered_branches'])
        except:
            continue
        fuzzer = r['fuzzer'].strip()
        subject = r['subject'].strip()
        camp = r['campaign_id'].strip()
        key = (fuzzer, subject, camp)
        groups[key].append((t, cov))

# target times (seconds)
targets = [('5M', 5*60), ('3H', 3*3600)]

# expected subjects and order
subjects = ['Ant','BCEL','Closure','Maven','Nashorn','Rhino','Tomcat']

# map dataset fuzzer names to expected labels (case-insensitive substring matching)
def norm_label(name):
    s = name.lower()
    if 'bediv' in s and 'simple' in s: return 'BeDiv-Simple'
    if 'bediv' in s and 'struct' in s: return 'BeDiv-Struct'
    if 'rlcheck' in s: return 'RLCheck'
    if 'zest' in s: return 'Zest'
    if 'zeugma' in s or 'zeugma-' in s:
        if 'linked' in s or 'link' in s: return 'Zeugma-Link'
        if 'one' in s or 'one_point' in s or 'one-point' in s: return 'Zeugma-1PT'
        if 'two' in s or 'two_point' in s or 'two-point' in s: return 'Zeugma-2PT'
        # none -> treat as Zeugma-X
        if 'none' in s or 'x' in s: return 'Zeugma-X'
    # fallback try some common tokens
    if 'bediv' in s: 
        return 'BeDiv-Simple'
    if s.strip() == 'none':
        return 'Zeugma-X'
    return name

# collect values per (normalized_fuzzer, subject) per target
vals = {tname: defaultdict(list) for tname,_ in targets}

for (fuzzer, subject, camp), records in groups.items():
    nf = norm_label(fuzzer)
    # for each target, find max covered_branches with time <= target
    for tname, tsec in targets:
        # find records <= tsec
        covs = [cov for (tt,cov) in records if tt <= tsec]
        if covs:
            mx = max(covs)
            vals[tname][(nf, subject)].append(mx)

# Prepare ordered fuzzer list matching expected table
fuzzer_order = ['BeDiv-Simple','BeDiv-Struct','RLCheck','Zest','Zeugma-X','Zeugma-1PT','Zeugma-2PT','Zeugma-Link']

# Build markdown table header
header_cols = []
for subj in subjects:
    header_cols.append(f"{subj} 5M")
    header_cols.append(f"{subj} 3H")

md_lines = []
md_lines.append("**Reproduced Table 3: Branch Coverage (median covered branches)**")
# header
hdr = "| Fuzzer       | " + " | ".join([f"{subj} 5M | {subj} 3H" for subj in subjects]) + " |"
sep = "| ------------ | " + " | ".join([":--------:" for _ in subjects for __ in (0,1)]) + " |"
md_lines.append(hdr)
md_lines.append(sep)

def fmt(x):
    return f"{x:.1f}"

for f in fuzzer_order:
    row = [f]
    for subj in subjects:
        # 5M
        v5 = vals['5M'].get((f,subj), [])
        v3 = vals['3H'].get((f,subj), [])
        if v5:
            med5 = statistics.median(v5)
            cell5 = fmt(med5)
        else:
            cell5 = "—"
        if v3:
            med3 = statistics.median(v3)
            cell3 = fmt(med3)
        else:
            cell3 = "—"
        row.append(cell5)
        row.append(cell3)
    md_lines.append("| " + " | ".join(row) + " |")

out_md = "/workspace/repro_table3.md"
out_txt = "/workspace/repro.txt"
with open(out_md, "w") as f:
    f.write("\n".join(md_lines))
with open(out_txt, "w") as f:
    f.write("\n".join(md_lines))

# Also print a short confirmation and the path to outputs
print("WROTE:", out_md, out_txt)
print("\nPreview:\n")
print("\n".join(md_lines[:20]))
PY
