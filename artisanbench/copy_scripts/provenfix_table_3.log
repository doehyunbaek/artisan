rb_lxc=\$(run_proj    spec_Lxc.c         /home/benchmarks-RQ1N2/lxc)
rb_wavpack=\$(run_proj spec_WavPack.c    /home/benchmarks-RQ1N2/WavPack)
rb_flex=\$(run_proj    spec_flex.c       /home/benchmarks-RQ1N2/flex)
