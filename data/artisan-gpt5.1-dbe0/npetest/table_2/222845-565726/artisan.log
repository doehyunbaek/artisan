# Map numeric reproduction rate to ?, ??, ??? by thresholds.
# The original paper visually encodes low/medium/high reproduction rates.
# We approximate this with: <34% => ?, 34–66% => ??, >66% => ???.
def bucket(pct):
    if pct is None:
        return "?"
    if pct < 34:
        return "?"
    if pct <= 66:
        return "??"
    return "???"

# Load all rows
entries = []
with open(csv_path, newline="") as f:
    r = csv.reader(f)
    header = next(r, None)  # a,b,c,d,e,Randoop,evosuite,npetest
    for row in r:
        if not row or all(not c for c in row):
            continue
        bench = row[0].strip()
        proj = row[1].strip()
        clazz = row[2].strip()
        try:
            ev = float(row[6]) if row[6] else 0.0
            np = float(row[7]) if row[7] else 0.0
        except (IndexError, ValueError):
            continue
        entries.append((bench, proj, clazz, ev, np))

# Build a keyed lookup with ordering as in Table 2
# Special handling for duplicated projects with indexed labels.
def collect_table_rows():
    rows = []

    # NPEX
    npex_rows = []
    http_rows = [e for e in entries if e[0]=="NPEX" and e[1]=="HttpComponents_Client-f6333a50"]
    qpid_rows = [e for e in entries if e[0]=="NPEX" and e[1]=="Qpid_Proton__j-02998b38"]
    # Order appears in CSV already appropriate for Http(1-4) and Qpid(1-2)
    http_labels = ["Http-f633(1)", "Http-f633(2)", "Http-f633(3)", "Http-f633(4)"]
    qpid_labels = ["Qpid-0299 (1)", "Qpid-0299 (2)"]
    # All other NPEX first
    for b, p, c, ev, np_ in entries:
        if b != "NPEX":
            continue
        if p == "HttpComponents_Client-f6333a50" or p == "Qpid_Proton__j-02998b38":
            continue
        lab = short_label(b, p)
        if not lab:
            continue
        npex_rows.append((lab, ev, np_))
    # add in same order as Table 2
    desired_npex_order = [
        "Activiti-c45","Aries_JPA","Avro","Commons_Conf","Commons_DBCP",
        "Commons_Pool","CXF-2094","Directory","Easy_Rules","Fastjson-650a",
        "Feign-9c5a","FOP-10e0d1c2","Hessian_Lite","Hivemall-04fa",
        "Http-f633(1)","Http-f633(2)","Http-f633(3)","Http-f633(4)",
        "IoTDB-9bce","Jest-f34f","jsoup-8b83","jsoup-b841","JSqlParser",
        "Karaf-b92d","Log4j_2-5b7b","Log4j_2-6a23","Log4j_2-7441",
        "Ninja-16aa","Nutz-87a4","OpenNLP-6079","OpenPDF-a89d",
        "PDFBox-5558","Qpid-0299 (1)","Qpid-0299 (2)","Sharding-82b1",
        "Sharding-9833","Sharding-c08f","ZooKeeper",
    ]
    # index dictionaries
    npex_map = {lab:(ev,np_) for (lab,ev,np_) in npex_rows}
    # attach Http and Qpid
    for idx, row in enumerate(http_rows):
        if idx < len(http_labels):
            lab = http_labels[idx]
            npex_map[lab] = (row[3], row[4])
    for idx, row in enumerate(qpid_rows):
        if idx < len(qpid_labels):
            lab = qpid_labels[idx]
            npex_map[lab] = (row[3], row[4])

    rows.append("### NPEX\n")
    rows.append("| Project | EvoSuite | NPETest |\n")
    rows.append("| :--- | ---: | ---: |\n")
    for lab in desired_npex_order:
        ev, np_ = npex_map.get(lab, (0.0, 0.0))
        rows.append(f"| {lab} | {bucket(ev)} | {bucket(np_)} |\n")

    # BugSwarm
    rows.append("\n### BugSwarm\n\n")
    rows.append("| Project | EvoSuite | NPETest |\n")
    rows.append("| :--- | ---: | ---: |\n")
    bugs = [e for e in entries if e[0]=="BugSwarm"]
    # order and multiplicity
    order_bs = [
        "ACS_Commons","Artemis_odb","BungeeCord-1303","Byte-1405","Byte_Buddy-9579",
        "Dubbo-4166","OkHttp-9361(1)","OkHttp-9361(2)","Petergeneric",
        "REST-1546(1)","REST-1546(2)","REST-1546(3)","REST-1546(4)","REST-1546(5)",
        "REST-2078","Universal-1724(1)","Universal-1724(2)","Universal-6766","Yamcs-1863"
    ]
    # group by raw project
    proj_groups = {}
    for b,p,c,ev,np_ in bugs:
        key = short_label(b,p)
        if key is None:
            continue
        proj_groups.setdefault(key, []).append((c,ev,np_))
    # helpers for multi-rows: determine consistent order by CSV
    def take_with_suffix(base, idx, data):
        # data is list of (clazz,ev,np)
        if idx < len(data):
            return data[idx][1], data[idx][2]
        return 0.0, 0.0

    # manual map to (ev,np) keyed by output label
    bs_map = {}
    for key, data in proj_groups.items():
        if key=="OkHttp-9361":
            # two entries in CSV
            for i in range(2):
                ev,np_ = take_with_suffix(key,i,data)
                bs_map[f"OkHttp-9361({i+1})"] = (ev,np_)
        elif key=="REST-1546":
            for i in range(5):
                ev,np_ = take_with_suffix(key,i,data)
                bs_map[f"REST-1546({i+1})"] = (ev,np_)
        elif key=="Universal-1724":
            for i in range(2):
                ev,np_ = take_with_suffix(key,i,data)
                bs_map[f"Universal-1724({i+1})"] = (ev,np_)
        else:
            # single entry
            ev,np_ = data[0][1], data[0][2]
            bs_map[key] = (ev,np_)

    for lab in order_bs:
        ev,np_ = bs_map.get(lab, (0.0,0.0))
        rows.append(f"| {lab} | {bucket(ev)} | {bucket(np_)} |\n")

    # Defects4J
    rows.append("\n### Defects4J\n\n")
    rows.append("| Project | EvoSuite | NPETest |\n")
    rows.append("| :--- | ---: | ---: |\n")
    d4j = [e for e in entries if e[0]=="Defects4J"]
    # group by project
    dmap = {}
    for b,p,c,ev,np_ in d4j:
        key = short_label(b,p)
        dmap.setdefault(key, []).append((c,ev,np_))
    order_d4j = ["Cli-30(0)","Cli-30(1)","Csv-11","Csv-9","Math-70","Math-79"]
    dvals = {}
    for key,data in dmap.items():
        if key=="Cli-30":
            for i in range(2):
                if i < len(data):
                    dvals[f"Cli-30({i})"] = (data[i][1], data[i][2])
        else:
            dvals[key] = (data[0][1], data[0][2])
    for lab in order_d4j:
        ev,np_ = dvals.get(lab,(0.0,0.0))
        rows.append(f"| {lab} | {bucket(ev)} | {bucket(np_)} |\n")

    # Genesis
    rows.append("\n### Genesis\n\n")
    rows.append("| Project | EvoSuite | NPETest |\n")
    rows.append("| :--- | ---: | ---: |\n")
    gen = [e for e in entries if e[0]=="Genesis"]
    gmap = {}
    for b,p,c,ev,np_ in gen:
        lab = short_label(b,p)
        if lab:
            gmap[lab] = (ev,np_)
    order_gen = ["Activiti-31c8","Checkstyle-be8","DataflowJavaSDK","JavaPoet-aee5","Javaslang-0dab","Jongo-9743"]
    for lab in order_gen:
        ev,np_ = gmap.get(lab,(0.0,0.0))
        rows.append(f"| {lab} | {bucket(ev)} | {bucket(np_)} |\n")

    # Bears
    rows.append("\n### Bears\n\n")
    rows.append("| Project | EvoSuite | NPETest |\n")
    rows.append("| :--- | ---: | ---: |\n")
    bears = [e for e in entries if e[0]=="Bears"]
    bmap = {}
    for b,p,c,ev,np_ in bears:
        lab = short_label(b,p)
        if lab:
            bmap[lab] = (ev,np_)
    order_bears = ["Bears-189","Bears-222","Bears-56","Bears-70","Bears-88"]
    for lab in order_bears:
        ev,np_ = bmap.get(lab,(0.0,0.0))
        rows.append(f"| {lab} | {bucket(ev)} | {bucket(np_)} |\n")

    return rows

out_lines = ["**Table 2: The reproduction rate results for 25 trials on benchmark projects gathered from the prior studies [3, 21–24]. The projects where all three tools failed to detect NPEs are excluded from this table. Project: The name of the buggy project with its abbreviated NPE-labeling ID (if necessary). The number in a parenthesis represents each unique NPE in the same project.**\n\n"]
out_lines.extend(collect_table_rows())
out_path = pathlib.Path("/workspace/repro.txt")
out_path.write_text("".join(out_lines))
