import re
with open('/workspace/results.md', 'r') as f:
    content = f.read()
# Find all tables in markdown (lines starting with |)
lines = content.split('\n')
table_lines = []
in_table = False
for line in lines:
    if line.strip().startswith('|'):
        table_lines.append(line)
    elif table_lines:
        # we've left the table
        break
# Now join and search for the specific columns
full_table = '\n'.join(table_lines)
# Look for the pattern of Table 4
pattern = r'(\|.*PRM.*Event Search.*Path Recv & Exec.*Total.*ReCDroid.*Yakusu.*\n)(\|[ :\-]+\|.*\n)(\|.*Avg\..*\n)(\|.*Mdn\..*\n)'
match = re.search(pattern, full_table, re.IGNORECASE)
if match:
    print("Found Table 4:")
    print(match.group(0))
else:
    # Try another pattern: look for rows with Avg. and Mdn.
    for i, line in enumerate(table_lines):
        if 'Avg.' in line and any(x in line for x in ['19','16','470','505','2674','3354']):
            print("Potential Table 4 row (Avg.):", line)
            if i+1 < len(table_lines):
                print("Next row (Mdn.):", table_lines[i+1])
            # Print previous lines for context
            for j in range(max(0,i-5), i):
                print(table_lines[j])
            break
EOF
