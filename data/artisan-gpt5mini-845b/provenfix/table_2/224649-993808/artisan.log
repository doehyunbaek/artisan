<mini_swe_agent_bash>
docker exec prove_n_fix /bin/bash -lc "python3 - <<'PY'
import csv
inpath = '/home/infer_TempFix/TempFix-out/report.csv'
mapping = [
    ('Swoole','swoole-src'),
    ('lxc','lxc'),
    ('WavPack','WavPack'),
    ('flex','flex'),
    ('p11-kit','p11-kit'),
    ('x264','x264'),
    ('recutils-1.8','recutils-1.8'),
    ('inetutils-1.9.4','inetutils-1.9.4'),
    ('snort-2.9.13','snort-2.9.13'),
    ('grub','grub')
]
sums = {k:0 for k,_ in mapping}
try:
    with open(inpath, newline='', errors='ignore') as f:
        reader = csv.reader(f)
        header = next(reader, None)
        for row in reader:
            if not row: continue
            path = row[0].strip()
            # column 7 is index 6 (Failed Assertion); try robust conversion
            failed = 0
            if len(row) > 6 and row[6].strip():
                try:
                    failed = int(float(row[6].strip()))
                except:
                    try:
                        failed = int(row[6].strip())
                    except:
                        failed = 0
            low = path.lower()
            for name,pat in mapping:
                if pat.lower() in low:
                    sums[name] += failed
except FileNotFoundError:
    pass

total = sum(sums.values())

# Emit a markdown table similar to expected.md
print('**Table 2. Experimental results for analyzing 10 C projects, comparing with Infer-v1.1.0. Columns **#NPD**, **#ML**, **#RL** record the numbers of null pointer dereferences, memory leaks, and resource leaks, respectively. The number of false positives found by Infer and more true positives found by PROVENFIX are represented by +n and +n respectively. Colunns in #Time record the analysis time spent.**\\n')
print('| Project         | Failed Assert |')
print('| --------------- | ------------: |')
for proj,_ in mapping:
    print(f'| {proj:<15} | {sums[proj]:12d} |')
print('| **Total**       |{:12d} |'.format(total))
PY" > /workspace/repro.txt
