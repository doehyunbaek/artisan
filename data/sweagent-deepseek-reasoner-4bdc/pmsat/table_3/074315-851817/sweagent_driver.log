    72	        file=sys.stderr,
    73	    )
    74	    all_ns = sorted(set(n for n in acc.keys()))
    75	    sums = [np.sum(acc[n]) for n in all_ns]
    76	    aj = lambda x: (f"{x:.3}" if isinstance(x, float) else str(x)).ljust(7)
    77	    print(*list(map(aj, ["n"] + all_ns)), sep=",")
    78	    print(*list(map(aj, ["# t.o."] + sums)), sep=",")
    79	    print(*list(map(aj, ["% t.o."] + [s / sum(sums) for s in sums])), sep=",")
