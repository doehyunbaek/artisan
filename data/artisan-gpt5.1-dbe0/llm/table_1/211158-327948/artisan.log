#!/usr/bin/env Rscript

## Read data
df <- read.csv("study_data.csv", header = TRUE)

## Helper: trim 1–99% and fit quasi-Poisson GLM
trim_and_fit_glm <- function(df, response) {
  Q <- quantile(df[[response]], probs = c(.01, .99), na.rm = FALSE)
  eliminated <- subset(df, df[[response]] >= Q[1] & df[[response]] <= Q[2])
  model <- glm(
    as.formula(paste(response, "~ tool + experience + recruiting.years + AI_experience")),
    data = eliminated,
    family = quasipoisson
  )
  list(model = model, data = eliminated)
}

## Time model (lm)
Q_time <- quantile(df$success_time_no_guess, probs = c(.01, .99), na.rm = FALSE)
elim_time <- subset(df, df$success_time_no_guess >= Q_time[1] & df$success_time_no_guess <= Q_time[2])
time_model <- lm(
  success_time_no_guess ~ tool + experience + recruiting.years + AI_experience,
  data = elim_time
)
time_sm <- summary(time_model)

## Understanding model (glm)
tmp_under <- trim_and_fit_glm(df, "understanding")
under_model <- tmp_under$model
under_sm <- summary(under_model)

## Progress (all)
tmp_prog <- trim_and_fit_glm(df, "progress_no_guess")
prog_model <- tmp_prog$model
prog_sm <- summary(prog_model)
elim_prog <- tmp_prog$data

## Progress (professionals)
prof_df <- elim_prog[elim_prog$is_professional == TRUE, ]
prog_prof_model <- glm(
  progress_no_guess ~ tool + experience + recruiting.years + AI_experience,
  data = prof_df,
  family = quasipoisson
)
prog_prof_sm <- summary(prog_prof_model)

## Progress (students)
stud_df <- elim_prog[elim_prog$is_professional == FALSE, ]
prog_stud_model <- glm(
  progress_no_guess ~ tool + experience + recruiting.years + AI_experience,
  data = stud_df,
  family = quasipoisson
)
prog_stud_sm <- summary(prog_stud_model)

## Coefficient formatter using pattern matching on term names
coef_entry <- function(sm, term_pattern) {
  coefs <- sm$coefficients
  rn <- rownames(coefs)
  if (term_pattern == "(Intercept)") {
    idx <- which(rn == "(Intercept)")
  } else {
    idx <- grep(term_pattern, rn, fixed = TRUE)
  }
  if (length(idx) == 0) return("NA (NA)")
  idx <- idx[1]
  est <- coefs[idx, "Estimate"]
  se  <- coefs[idx, "Std. Error"]
  p   <- coefs[idx, ncol(coefs)]
  stars <- if (is.na(p)) {
    ""
  } else if (p < 0.01) {
    "***"
  } else if (p < 0.05) {
    "**"
  } else if (p < 0.1) {
    "*"
  } else {
    ""
  }
  sprintf("%.2f%s (%.2f)", est, stars, se)
}

## R² for lm
r2_lm <- function(sm) {
  c(r2 = sm$r.squared, adj = sm$adj.r.squared)
}

## Pseudo-R² for glm from deviance and null deviance
r2_glm <- function(model) {
  dev <- deviance(model)
  nulldev <- model$null.deviance
  n <- length(model$y)
  p <- length(coef(model))     # includes intercept
  if (is.null(nulldev) || is.na(nulldev) || nulldev == 0) {
    return(c(r2 = NA_real_, adj = NA_real_))
  }
  r2 <- 1 - dev / nulldev
  adj <- 1 - ( (n - 1) / (n - p) * (1 - r2) )
  c(r2 = r2, adj = adj)
}

terms <- c("(Intercept)", "experience", "recruiting.years", "AI_experience", "tool")

## Collect coefficients
prog_coefs  <- sapply(terms, function(t) coef_entry(prog_sm, t))
time_coefs  <- sapply(terms, function(t) coef_entry(time_sm, t))
under_coefs <- sapply(terms, function(t) coef_entry(under_sm, t))
prof_coefs  <- sapply(terms, function(t) coef_entry(prog_prof_sm, t))
stud_coefs  <- sapply(terms, function(t) coef_entry(prog_stud_sm, t))

## Collect R²
prog_r2  <- r2_glm(prog_model)
time_r2  <- r2_lm(time_sm)
under_r2 <- r2_glm(under_model)
prof_r2  <- r2_glm(prog_prof_model)
stud_r2  <- r2_glm(prog_stud_model)

fmt_r2 <- function(x) if (is.na(x)) "NA" else sprintf("%.3f", x)

## Print markdown table
cat("**Table 1: Summaries of regressions estimating the effect of using the prototype. Each column summarizes the model for a different outcome variable. We report the coefficient estimates with the standard errors in parentheses.**\n\n")

cat("|                     |   Progress (1) |    Time (s) (2) |   Underst. (3) | Progress (Pros) | Progress (Students) |\n")
cat("| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |\n")

row_out <- function(label, term_pattern) {
  cat(sprintf("| %-19s | %14s | %15s | %14s | %14s | %18s |\n",
              label,
              prog_coefs[term_pattern],
              time_coefs[term_pattern],
              under_coefs[term_pattern],
              prof_coefs[term_pattern],
              stud_coefs[term_pattern]))
}

row_out("Constant", "(Intercept)")
row_out("Domain experience", "experience")
row_out("Program. experience", "recruiting.years")
row_out("AI tool familiarity", "AI_experience")
row_out("Uses GILT", "tool")

cat(sprintf("| *R*²                | %13s | %14s | %11s | %11s | %15s |\n",
            fmt_r2(prog_r2["r2"]),
            fmt_r2(time_r2["r2"]),
            fmt_r2(under_r2["r2"]),
            fmt_r2(prof_r2["r2"]),
            fmt_r2(stud_r2["r2"])))

cat(sprintf("| Adj. *R*²           | %13s | %14s | %11s | %11s | %15s |\n",
            fmt_r2(prog_r2["adj"]),
            fmt_r2(time_r2["adj"]),
            fmt_r2(under_r2["adj"]),
            fmt_r2(prof_r2["adj"]),
            fmt_r2(stud_r2["adj"])))

cat("\n\n*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*\n")
EOR
docker exec notebook /bin/bash --noprofile --norc -c "cd /home/jovyan/work && Rscript repro_table1.R" > /workspace/repro.txt
# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_llm_table_1.sh
artisan submit /workspace/repro_llm_table_1.sh
</mini_swe_agent_bash>
