import math

path = "ROAM-Artifact/ROAM-Artifact/Evaluation/results_table.md"

roam_vals = []
prm_vals = []
euler_vals = []

with open(path, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if not line.startswith("|"):
            continue
        parts = line.split("|")
        if len(parts) < 5:
            continue
        cells = parts[1:-1]  # drop leading/trailing empties
        # data rows have a numeric index in first cell
        if not cells[0].strip().isdigit():
            continue
        # indices: 0=row#, 1=issue id, 2=link, 3=#actual, 4=#provided, 5=#missing
        # 6=ROAM match acc, 18=PRM-Enumeration match acc, 20=Euler match acc
        def get_float(idx):
            if idx >= len(cells):
                return None
            s = cells[idx].strip()
            if not s:
                return None
            try:
                return float(s)
            except ValueError:
                return None

        r = get_float(6)
        p = get_float(18)
        e = get_float(20)

        if r is not None:
            roam_vals.append(r)
        if p is not None:
            prm_vals.append(p)
        if e is not None:
            euler_vals.append(e)

def summarize(name, vals):
    n = len(vals)
    mean = sum(vals) / n
    perfect = sum(1 for v in vals if abs(v - 1.0) < 1e-9) / n
    zero = sum(1 for v in vals if abs(v) < 1e-9) / n
    print(f"{name}: n={n}")
    print(f"  Avg match accuracy: {mean*100:.2f}")
    print(f"  Perfect cases (%): {perfect*100:.2f}")
    print(f"  Zero cases (%): {zero*100:.2f}")

summarize("ROAM", roam_vals)
summarize("PRM-Enumeration", prm_vals)
summarize("Euler", euler_vals)
