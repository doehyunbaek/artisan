for file in os.listdir('callgraph_seq'):
    try:
        with open(os.path.join('callgraph_seq', file)) as dseq:
            seq_calls = json.load(dseq)
        
        # Function to split by callers
        def split_by_callers(calls_sequence):
            counter = 1
            caller = calls_sequence[0].split('##')[-1]
            splitted_sequences = []
            s_temp = []
            s_temp.append(calls_sequence[0])
            i = 1
            while True:
                if i == len(calls_sequence):
                    splitted_sequences.append(s_temp)
                    break
                c = calls_sequence[i]
                if c.startswith('#START#'):
                    if counter == 0 and c.split('##')[-1] != caller:
                        splitted_sequences.append(s_temp)
                        s_temp = [c]
                        if i == len(calls_sequence):
                            splitted_sequences.append(s_temp)
                            break
                        else:
                            caller = c
                    else:
                        s_temp.append(c)
                    counter += 1
                elif c.startswith('#END#'):
                    counter -= 1
                    s_temp.append(c)
                i = i + 1
            return splitted_sequences
        
        # Generate filtered sequences
        splitted_seqs = split_by_callers(seq_calls)
        final_list = []
        seq_calls_temp = [seq_calls]
        while True:
            temp_seq = []
            for sc in seq_calls_temp:
                temp_seq.extend(split_by_callers(sc))
            final_list.extend(temp_seq)
            seq_calls_temp = []
            for s in temp_seq:
                if len(s) not in [0, 1, 2]:
                    seq_calls_temp.append(s[1:-1])
            if len(seq_calls_temp) == 0:
                break
        
        simple_final_list = []
        for l in final_list:
            simple_final_list.append([c.split('##')[0] for c in l])
        
        filtered_list = []
        for l in simple_final_list:
            new_l = []
            if l[0].startswith('#END#'):
                continue
            if len(l) == 0:
                continue
            try:
                c_old = l[0].split('#')[2]
                for c in l[1:]:
                    if c.split('#')[2] == c_old:
                        new_l.append(c_old)
                    c_old = c.split('#')[2]
                filtered_list.append(new_l)
            except:
                continue
        
        filtered_list = [f for f in filtered_list if len(f) >= 2]
        # Remove sequences with too many builtins.isinstance (filtering out long sequences)
        n_a_s = [e for e in filtered_list if e.count('builtins.isinstance') <= 5]
        n_a_s = [s for s in n_a_s if len(s) < 100]
        if len(n_a_s) > 1893:
            random.shuffle(n_a_s)
            random.shuffle(n_a_s)
            all_sequences.extend(n_a_s[:1893])
        else:
            all_sequences.extend(n_a_s)
    except Exception as e:
        continue

# Apply additional filtering
new_all_sequences = [e for e in all_sequences if e.count('builtins.isinstance') <= 5]
new_all_sequences = [s for s in new_all_sequences if len(s) < 100]

print(f'Total sequences: {len(new_all_sequences)}')

# Mine top 100 patterns
ps = PrefixSpan(new_all_sequences)
top_k = ps.topk(100)

print('Top 100 patterns:')
for pattern, count in top_k[:10]:  # Print first 10 to see
    print(f'Pattern: {pattern}, Count: {count}')

# Look for specific patterns from Table 3
print('\nSearching for patterns from Table 3:')
for pattern, count in top_k:
    pattern_str = ' · '.join(pattern)
    if 'builtins.isinstance' in pattern_str:
        print(f'Pattern: {pattern_str}, Frequency: {count}')
"
