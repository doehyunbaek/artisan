import csv, collections, pathlib

base = pathlib.Path("Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor/data/Release-20220811/ResearchResults")

# 1) RUF Count per status from Result2_UsedRUF.csv
ruf_counts = collections.Counter()
with (base / "Result2_UsedRUF.csv").open() as f:
    reader = csv.DictReader(f)
    for row in reader:
        ruf_counts[row["status"]] += 1

# 2) Package Versions and RUF Usage Items per status from Result2_RUFUsage.csv
pkg_versions = collections.defaultdict(set)
usage_items = collections.Counter()
with (base / "Result2_RUFUsage.csv").open() as f:
    reader = csv.DictReader(f)
    for row in reader:
        status = row["status"]
        vid = row["id"]
        pkg_versions[status].add(vid)
        usage_items[status] += 1

statuses = ["accepted", "active", "incomplete", "removed", "unknown"]
print("Status\tRUF_Count\tPackage_Versions\tRUF_Usage_Items")
for s in statuses:
    print(f"{s}\t{ruf_counts.get(s,0)}\t{len(pkg_versions.get(s,set()))}\t{usage_items.get(s,0)}")
PY
