import re, sys
logfile = '/workspace/repro.txt'
with open(logfile) as f:
    text = f.read()

# Parse results: find blocks like "Running test <id> prepatch" followed by "Result: ..." and "Result: patch is present" lines.
entries = {}
pat_run = re.compile(r'Running test\s+(\d+)\s+(prepatch|postpatch)', re.IGNORECASE)
lines = text.splitlines()
i = 0
while i < len(lines):
    m = pat_run.search(lines[i])
    if m:
        tid = int(m.group(1))
        phase = m.group(2).lower()
        # look ahead for "Result:" numeric and "Result: patch is present" lines, capture presence string and numeric result if any
        numeric = None
        presence = None
        j = i+1
        while j < len(lines) and lines[j].strip()=='':
            j+=1
        # scan a few lines ahead
        for k in range(j, min(j+8, len(lines))):
            if 'Result:' in lines[k]:
                # numeric result
                mnum = re.search(r'Result:\s*([0-9.+\-NaNinfnanInfinity]+)', lines[k])
                if mnum:
                    val = mnum.group(1)
                    numeric = val
                if 'patch is present' in lines[k].lower():
                    presence = True
                if 'patch is not present' in lines[k].lower():
                    presence = False
        entries.setdefault(tid, {})[phase] = {'numeric': numeric, 'presence': presence}
        i = j
    else:
        i += 1

# Define datasets: D1 = 1..25, D2 = 26..116 excluding exclude list from scripts/test.py
exclude = {62,63,67,72,73,74}
D1 = set(range(1,26))
D2 = set(i for i in range(26,117) if i not in exclude)

def compute_metrics(idset):
    TP=TN=FP=FN=0
    counted = 0
    for tid in sorted(idset):
        r = entries.get(tid, {})
        pre = r.get('prepatch')
        post = r.get('postpatch')
        # skip if missing or NaN in numeric field
        if not pre or not post:
            continue
        if (pre.get('numeric') and pre['numeric'].lower()=='nan') or (post.get('numeric') and post['numeric'].lower()=='nan'):
            continue
        # prepatch: ground truth = unpatched (negative)
        pred_pre = pre.get('presence')
        # postpatch: ground truth = patched (positive)
        pred_post = post.get('presence')
        if pred_pre is None or pred_post is None:
            continue
        counted += 2
        # evaluate prepatch (negative)
        if pred_pre:
            FP += 1
        else:
            TN += 1
        # evaluate postpatch (positive)
        if pred_post:
            TP += 1
        else:
            FN += 1
    # compute metrics
    total = TP+TN+FP+FN
    if total==0:
        return None
    accuracy = (TP+TN)/total if total>0 else 0.0
    precision = TP/(TP+FP) if (TP+FP)>0 else 0.0
    recall = TP/(TP+FN) if (TP+FN)>0 else 0.0
    f1 = (2*precision*recall)/(precision+recall) if (precision+recall)>0 else 0.0
    return {'TP':TP,'TN':TN,'FP':FP,'FN':FN,'Acc':accuracy,'Prec':precision,'Rec':recall,'F1':f1,'samples':total}

res1 = compute_metrics(D1)
res2 = compute_metrics(D2)

def pct(x): return f"{x*100:.1f}%"
print("**Table 2: Test results on the dataset**\n")
