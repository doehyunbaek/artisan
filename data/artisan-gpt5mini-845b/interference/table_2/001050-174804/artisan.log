import re,sys
exp="/workspace/expected.md"
out="/workspace/final_table2.md"
def parse_table(path):
    rows=[]
    with open(path,encoding='utf-8') as f:
        lines=f.readlines()
    # Find start of table header (first line starting with "|     Project")
    start=None
    for i,l in enumerate(lines):
        if l.strip().startswith("|") and "Project" in l and "P_\\text{max}" in l:
            start=i
            break
    if start is None:
        return []
    # header at start, separator at start+1, rows follow until blank or non-table
    hdr = [c.strip() for c in lines[start].strip().split("|")[1:-1]]
    data=[]
    for l in lines[start+2:]:
        if not l.strip().startswith("|"): break
        cells=[c.strip() for c in l.strip().split("|")[1:-1]]
        if len(cells)!=len(hdr):
            # try to pad/truncate
            if len(cells)<len(hdr):
                cells += [""]*(len(hdr)-len(cells))
            else:
                cells=cells[:len(hdr)]
        row=dict(zip(hdr,cells))
        data.append(row)
    return hdr,data

hdr_e,rows_e = parse_table(exp) or (None,[])
hdr_o,rows_o = parse_table(out) or (None,[])
if not rows_e:
    print("Could not parse expected table", file=sys.stderr); sys.exit(1)
if not rows_o:
    print("Could not parse produced table", file=sys.stderr); sys.exit(1)

# Index produced rows by Project
idx_o = { r['Project']: r for r in rows_o }

mismatches=[]
for rexp in rows_e:
    proj = rexp['Project']
    ract = idx_o.get(proj)
    if not ract:
        mismatches.append((proj,"<ROW_MISSING>","", ""))
        continue
    for col in hdr_e[1:]:  # skip Project
        expected = rexp.get(col,"")
        actual = ract.get(col,"")
        # Normalize whitespace
        if expected != actual:
            mismatches.append((proj,col,expected,actual))

# Print summary
if not mismatches:
    print("No mismatches found: produced table matches expected template.")
    sys.exit(0)

print("Project,Column,Expected,Actual")
for m in mismatches:
    # escape commas in cells
    proj,col,expv,actv = m
    expv=expv.replace(",",";")
    actv=actv.replace(",",";")
    print(f"{proj},{col},{expv},{actv}")
PY
