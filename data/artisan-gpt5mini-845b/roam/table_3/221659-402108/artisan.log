import re, sys
lines = open("/tmp/results_md.md", encoding="utf-8").read().splitlines()
def toks(line):
    parts = [p.strip() for p in line.split('|')]
    if parts and parts[0]=='':
        parts = parts[1:]
    if parts and parts[-1]=='':
        parts = parts[:-1]
    return parts

header_idx = None
for i,l in enumerate(lines):
    if l.startswith('|') and 'Col1' in l and ('ReCDroid' in l or 'ROAM' in l):
        header_idx = i
        break
if header_idx is None:
    for i,l in enumerate(lines):
        if l.startswith('|') and 'ReCDroid' in l:
            header_idx = i
            break
if header_idx is None:
    print("Header not found", file=sys.stderr)
    sys.exit(1)

header = toks(lines[header_idx])
def find_header(name):
    for i,h in enumerate(header):
        if h.strip().lower() == name.lower():
            return i
    for i,h in enumerate(header):
        if name.lower() in h.lower():
            return i
    return None

idxs = {}
idxs['ReCDroid'] = find_header('ReCDroid')
idxs['Yakusu'] = find_header('Yakusu')
idxs['Roam'] = find_header('ROAM')

total = 0
no_miss = 0
miss = 0
counts = {k: {'all':0, 'no_miss':0, 'miss':0} for k in idxs.keys()}

for l in lines[header_idx+2:]:
    if not l.startswith('|'):
        continue
    t = toks(l)
    if not t:
        continue
    if not re.match(r'^\d+$', t[0]):
        continue
    total += 1
    # attempt to get missing steps (Col6 -> index 5)
    missing = None
    for try_idx in (5,4,6,3,7):
        if try_idx < len(t):
            s = t[try_idx].strip()
            if re.match(r'^\d+$', s):
                missing = int(s); break
    if missing is None:
        missing = 0
    if missing == 0:
        no_miss += 1
        miss_cat = 'no_miss'
    else:
        miss += 1
        miss_cat = 'miss'
    for tool, hidx in idxs.items():
        if hidx is None:
            continue
        repro_idx = hidx + 1
        if repro_idx < len(t):
            val = t[repro_idx].strip().lower()
            if val == 'success':
                counts[tool]['all'] += 1
                if miss_cat == 'no_miss':
                    counts[tool]['no_miss'] += 1
                else:
                    counts[tool]['miss'] += 1

def ipct(num, den):
    if den == 0:
        return "0"
    return str(int(round(num/den*100.0)))

recdroid_all = ipct(counts['ReCDroid']['all'], total)
recdroid_no = ipct(counts['ReCDroid']['no_miss'], no_miss)
recdroid_m = ipct(counts['ReCDroid']['miss'], miss)
yak_all = ipct(counts['Yakusu']['all'], total)
yak_no = ipct(counts['Yakusu']['no_miss'], no_miss)
yak_m = ipct(counts['Yakusu']['miss'], miss)
roam_all = ipct(counts['Roam']['all'], total)
roam_no = ipct(counts['Roam']['no_miss'], no_miss)
roam_m = ipct(counts['Roam']['miss'], miss)

with open("/workspace/repro.txt","w",encoding="utf-8") as out:
    out.write("**Table 3: Reproduction Rate of Each Approach (Shown as a Percent)**\n\n")
    out.write("|          | All Reports | Reports w/o Missing Steps | Reports w/ Missing Steps |\n")
    out.write("| -------- | :---------: | :-----------------------: | :----------------------: |\n")
    out.write(f"| ReCDroid |   {recdroid_all}   |         {recdroid_no}         |       {recdroid_m}        |\n")
    out.write(f"| Yakusu   |    {yak_all}    |         {yak_no}         |        {yak_m}         |\n")
    out.write(f"| Roam     |    {roam_all}    |         {roam_no}         |        {roam_m}         |\n")
print("WROTE /workspace/repro.txt")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt || true
echo '</artisan_submit>'
EOF
