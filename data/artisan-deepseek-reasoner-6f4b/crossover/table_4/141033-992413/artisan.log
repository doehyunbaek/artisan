import pandas as pd
import numpy as np

# Load data
data = pd.read_csv('/workspace/detections.csv')

# Convert time string to milliseconds
def time_to_ms(t):
    if pd.isna(t):
        return float('inf')
    # Format: '0 days 00:42:48.816000'
    parts = t.split()
    if len(parts) != 3:
        return float('inf')
    days = int(parts[0])
    time_parts = parts[2].split(':')
    hours = int(time_parts[0])
    minutes = int(time_parts[1])
    seconds = float(time_parts[2])
    total_seconds = days * 86400 + hours * 3600 + minutes * 60 + seconds
    return total_seconds * 1000

data['time_ms'] = data['time'].apply(time_to_ms)

# Define thresholds in milliseconds
FIVE_MIN = 5 * 60 * 1000
THREE_HOUR = 3 * 60 * 60 * 1000

# Define fuzzers and defects
fuzzers = ['BeDiv-Simple', 'BeDiv-Struct', 'RLCheck', 'Zest', 'Zeugma-X', 'Zeugma-1PT', 'Zeugma-2PT', 'Zeugma-Link']
defects = ['B0', 'B1', 'C0', 'C1', 'N0', 'N1', 'N2', 'R0', 'R1', 'R2', 'R3', 'R4']

# Assume 20 campaigns per fuzzer per defect
total_campaigns = 20

# Create result dictionary
results = {}
for fuzzer in fuzzers:
    results[fuzzer] = {}
    for defect in defects:
        results[fuzzer][defect] = {'5M': 0, '3H': 0}

# For each fuzzer and defect, count detections before thresholds
for _, row in data.iterrows():
    fuzzer = row['fuzzer']
    defect = row['defect']
    time_ms = row['time_ms']
    
    if fuzzer not in fuzzers or defect not in defects:
        continue
    
    if time_ms <= FIVE_MIN:
        results[fuzzer][defect]['5M'] += 1
    if time_ms <= THREE_HOUR:
        results[fuzzer][defect]['3H'] += 1

# Convert counts to rates (out of 20)
for fuzzer in fuzzers:
    for defect in defects:
        for time_key in ['5M', '3H']:
            count = results[fuzzer][defect][time_key]
            rate = count / total_campaigns
            # Format as string with 2 decimal places
            results[fuzzer][defect][time_key] = f"{rate:.2f}"

# Handle RLCheck: '-' for B0 and B1
results['RLCheck']['B0']['5M'] = '-'
results['RLCheck']['B0']['3H'] = '-'
results['RLCheck']['B1']['5M'] = '-'
results['RLCheck']['B1']['3H'] = '-'

# Generate markdown table
header = "| Fuzzer       | B0 [2] 5M | B0 [2] 3H | B1 [3] 5M | B1 [3] 3H | C0 [11] 5M | C0 [11] 3H | C1 [12] 5M | C1 [12] 3H | N0 [42] 5M | N0 [42] 3H | N1 [40] 5M | N1 [40] 3H | N2 [41] 5M | N2 [41] 3H | R0 [31] 5M | R0 [31] 3H | R1 [30] 5M | R1 [30] 3H | R2 [28] 5M | R2 [28] 3H | R3 [29] 5M | R3 [29] 3H | R4 [32] 5M | R4 [32] 3H |"
separator = "| ------------ | --------: | --------: | --------: | --------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: | ---------: |"

lines = [header, separator]

for fuzzer in fuzzers:
    row = f"| {fuzzer:13}"
    for defect in defects:
        for time_key in ['5M', '3H']:
            value = results[fuzzer][defect][time_key]
            if value == '-':
                formatted = f"      {value}"
            else:
                formatted = f"      {value}"
            row += f" |{formatted:>9}"
    row += " |"
    lines.append(row)

# Write to file
with open('/workspace/repro.txt', 'w') as f:
    f.write('\n'.join(lines))
EOF
