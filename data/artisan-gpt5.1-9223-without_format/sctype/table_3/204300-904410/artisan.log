    summary = summaries.get(proj, "")
    lines.append(f"| {proj:<20} | {summary:<86} | {a:10d} | {w:13d} |")

lines.append(f"| **Total**             |                                                                                        | {total_ann:11d} | {total_warn:13d} |")

repro_path.write_text("\n".join(lines) + "\n")
