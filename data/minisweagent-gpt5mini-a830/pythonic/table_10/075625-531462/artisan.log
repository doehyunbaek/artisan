import csv, os, re, collections

base = "/workspace/ICSE2024/ICSE2024-funcConstructs-Artifacts/working-results/inter-rater-RQ3-files"
files = {
    "Lambdas": os.path.join(base, "lambda.csv"),
    "Comp.": os.path.join(base, "comprehension.csv"),
    "MRF": os.path.join(base, "mrf.csv"),
    "Proc.": os.path.join(base, "procedural.csv"),
}

reasons = ["Coding time","Ease of use","Maintainability","Performance","Readability/Understandability","Size","Lack of knowledge","Project constraints","Simplify debugging"]

def normalize(s):
    if s is None:
        return ""
    s = str(s).strip()
    s = re.sub(r'\s+', ' ', s)
    s = re.sub(r'\(.*?\)', '', s)  # remove parenthetical notes
    return s.strip()

counts = {k: collections.Counter() for k in files.keys()}

for key, path in files.items():
    if not os.path.exists(path):
        continue
    try:
        with open(path, newline='', encoding='utf-8') as fh:
            # these files are tab-separated according to the R script; try \t then fallback to comma
            sample = fh.read(2048)
            fh.seek(0)
            delim = '\t' if '\t' in sample else ','
            reader = csv.reader(fh, delimiter=delim)
            rows = list(reader)
            if not rows:
                continue
            # if first row looks like header (contains non-category words), skip it heuristically
            header = rows[0]
            # heuristic: if any header cell contains 'ID' or 'Prolific' or 'Group' treat as header
            skip_header = any(re.search(r'id|prolific|group|final|classification', str(h).lower()) for h in header)
            start = 1 if skip_header else 0
            for r in rows[start:]:
                for cell in r:
                    cell = normalize(cell)
                    if not cell or cell.lower() in ('none','na','n/a'):
                        continue
                    # split multiple annotations
                    parts = re.split(r'[;/\|,]+', cell)
                    for p in parts:
                        p = normalize(p)
                        if not p:
                            continue
                        matched = False
                        for reason in reasons:
                            if p.lower() == reason.lower() or reason.lower() in p.lower() or p.lower() in reason.lower():
                                counts[key][reason] += 1
                                matched = True
                                break
                        if not matched:
                            # also try matching common synonyms
                            low = p.lower()
                            if 'time' in low and 'cod' in low:
                                counts[key]['Coding time'] += 1
                            elif 'ease' in low or 'easy' in low:
                                counts[key]['Ease of use'] += 1
                            elif 'maintain' in low or 'refactor' in low:
                                counts[key]['Maintainability'] += 1
                            elif 'perform' in low or 'fast' in low or 'speed' in low:
                                counts[key]['Performance'] += 1
                            elif 'read' in low or 'understand' in low or 'comprehens' in low:
                                counts[key]['Readability/Understandability'] += 1
                            elif 'size' in low or 'short' in low or 'lines' in low:
                                counts[key]['Size'] += 1
                            elif 'lack' in low or 'know' in low or 'unfamiliar' in low:
                                counts[key]['Lack of knowledge'] += 1
                            elif 'project' in low or 'constraint' in low or 'requirement' in low:
                                counts[key]['Project constraints'] += 1
                            elif 'debug' in low or 'bug' in low or 'trace' in low:
                                counts[key]['Simplify debugging'] += 1
                            else:
                                # record as other (not used)
                                counts[key][p] += 1
    except Exception as e:
        # if file parse fails, skip
        continue

# Write repro.txt
out = ["Reason,Lambdas,Comp.,MRF,Proc."]
for reason in reasons:
    l = counts['Lambdas'].get(reason,0)
    c = counts['Comp.'].get(reason,0)
    m = counts['MRF'].get(reason,0)
    p = counts['Proc.'].get(reason,0)
    out.append(f"{reason},{l},{c},{m},{p}")

with open("/workspace/repro.txt","w",encoding="utf-8") as of:
    of.write("\n".join(out))

print("\n".join(out))
