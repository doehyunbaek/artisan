<mini_swe_agent_bash>
cd /workspace/artifact/ROAM-Artifact/Evaluation && python - << 'PY'
def parse_table(path):
    rows = []
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.startswith("|"):
                continue
            cells = [c.strip() for c in line.split("|")]
            rows.append(cells)
    # first data row index: 3 (0 header names,1 separator,2 header labels,3.. data)
    return rows

rows = parse_table("results.md")
data_rows = rows[3:]  # skip two header lines + separator

def agg(tool_name, idx_ma, idx_rr):
    ma_vals = []
    rr_vals = []
    total_rr = 0
    total_rr_den = 0
    for r in data_rows:
        # pad row if short
        if len(r) <= max(idx_ma, idx_rr):
            continue
        ma = r[idx_ma].strip()
        rr = r[idx_rr].strip().lower()
        if ma not in ("",):
            try:
                ma_vals.append(float(ma))
            except ValueError:
                pass
        if rr not in ("",):
            total_rr_den += 1
            rr_vals.append(1 if rr == "success" else 0)
    avg_ma = sum(ma_vals) / len(ma_vals)
    repro_rate = sum(rr_vals) / total_rr_den
    print(f"{tool_name}: avg_ma={avg_ma*100:.2f}, repro_rate={repro_rate*100:.2f}, n={len(ma_vals)}, n_rr={total_rr_den}")

agg("Roam", 7, 8)
agg("Roam-Sim", 13, 14)
agg("Roam-Dist", 16, 17)
PY
