<mini_swe_agent_bash>
docker exec ppt4j /bin/bash --noprofile --norc -c "python - << 'PY'
import csv, math

exclude = {62, 63, 67, 72, 73, 74}
D1_RANGE = {2, 6, 7, 11, 42, 59, 60, *range(80, 117)}

def classify(gt_type, score):
    if math.isnan(score):
        score = 0
    if gt_type == 'prepatch':
        return 1 if score >= 0.6 else 2
    else:
        return 0 if score >= 0.6 else 3

def acc(tp, fp, tn, fn): return (tp + tn) / (tp + fp + tn + fn)
def prec(tp, fp, tn, fn): return tp / (tp + fp) if tp + fp else float('nan')
def recall(tp, fp, tn, fn): return tp / (tp + fn) if tp + fn else float('nan')
def f1(tp, fp, tn, fn):
    p, r = prec(tp, fp, tn, fn), recall(tp, fp, tn, fn)
    return 2 * p * r / (p + r) if p + r else float('nan')

def compute(path, label):
    counts = [0,0,0,0]  # tp, fp, tn, fn
    with open(path) as f:
        reader = csv.DictReader(f)
        for row in reader:
            vid = int(row['id'])
            if vid in exclude: 
                continue
            t = row['type']
            s = float(row['score']) if row['score'] != 'nan' else float('nan')
            cls = classify(t, s)
            counts[cls] += 1
    print(label, 'tp,fp,tn,fn =', counts)
    print(label, 'ACC={:.4f} PREC={:.4f} RECALL={:.4f} F1={:.4f}'.format(
        acc(*counts), prec(*counts), recall(*counts), f1(*counts)))

compute('rqs/ppt4j_d1.csv', 'D1')
compute('rqs/ppt4j_d2.csv', 'D2')
PY"
