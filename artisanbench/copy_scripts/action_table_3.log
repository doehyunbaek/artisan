import math
from pathlib import Path

import pandas as pd

base = Path("gh_resource_study_artifact_patched/github-workflow-resource-optimization")

runs_csv = base / "all_runs.csv"
jobs_csv = base / "all_jobs.csv"
res_usage_py = base / "src" / "runs_analysis" / "resource_usage.py"

if not runs_csv.is_file() or not jobs_csv.is_file():
    raise SystemExit("Required CSV files not found in the artifact.")

# Load raw data
all_runs = pd.read_csv(runs_csv)
all_jobs = pd.read_csv(jobs_csv)

# Execute the authors' resource_usage.py to obtain get_tiers (and helpers)
ns = {}
code_text = res_usage_py.read_text()
exec(code_text, ns)
get_tiers = ns["get_tiers"]

# Minimal DataSet wrapper providing the interface expected by get_tiers
class DataSet:
    def __init__(self, runs_df, jobs_df):
        self._runs = runs_df
        self._jobs = jobs_df
    def get_all_runs(self):
        return self._runs
    def get_all_jobs(self):
        return self._jobs

data_set = DataSet(all_runs, all_jobs)

# Derive paid (repos_list_1) vs free (repos_list_2) tiers using the artifact logic
repos_list_1, repos_list_2 = get_tiers(data_set)

# Recompute the termination-status table as in the RQ1 notebook
