<mini_swe_agent_bash>
cat > /workspace/roam_artifact/ROAM-Artifact/BuildEnvironment/Dockerfile <<'EOF'
FROM androidsdk/android-30:latest

# Install tools, JDK and prepare for Python 3.10 (deadsnakes)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       wget \
       unzip \
       software-properties-common \
       openjdk-8-jdk \
       ffmpeg \
       python3-pip \
       python3-venv \
       git \
       graphviz \
       ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3.10 python3.10-venv python3.10-distutils \
    && rm -rf /var/lib/apt/lists/*

# Ensure pip for python3.10 is available
RUN wget --quiet https://bootstrap.pypa.io/get-pip.py -O /tmp/get-pip.py \
    && python3.10 /tmp/get-pip.py \
    && rm /tmp/get-pip.py

# Use python3.10's pip to install project requirements
WORKDIR /Roam-Artifact/BuildEnvironment
COPY requirements.txt /tmp/requirements.txt
RUN python3.10 -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && python3.10 -m spacy download en_core_web_lg

# Default working dir for container when running reproduction commands
WORKDIR /Roam-Artifact/ReproductionTool

SHELL ["/bin/bash", "-lc"]
CMD echo "Environment is ready"
EOF
</mini_swe_agent_bash>
