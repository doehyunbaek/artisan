bash -lc 'cat > /workspace/repro_pythonic_table_7.sh <<'"'"'EOF'"'"'
#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'"'"'EOTABLE'"'"'
**Table 7: RQ1: Logistic regression relating the use of reduce with the correctness of the change task (AIC=118)**

| Term | Estimate | Std.Error | z value | Pr(>\|z\|) |
|---|---:|---:|---:|---:|
| (Intercept) | -13.20 | 1696.36 | -0.01 | 0.99 |
| MainFactorProc | -0.26 | 0.47 | -0.56 | 0.99 |
| Usage Freq. | -0.83 | 0.44 | -1.87 | 0.30 |
| Approvals | 0.00 | 0.00 | -0.36 | 0.99 |
| StudentTrue | 14.38 | 1696.36 | 0.01 | 0.99 |
EOTABLE

# Section 2: Artifact download
artisan get https://zenodo.org/records/10554377

# Section 3: Reproduction commands (recompute regression from raw data)
cd ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts || exit 1

# Run R inside the official Docker image to fit the reduce logistic regression from RQ1.csv
docker run -v"${PWD}":/data --rm mdipenta/rexp:latest R --no-save <<'EOR'
setwd("/data")
t <- read.csv("working-results//RQ1-RQ2-files-for-statistical-analysis/RQ1.csv")
tMrf <- subset(t, Section=="mrf" & Construct=="reduce" & UsageFrequency>1)
tMrf <- droplevels(tMrf)
model <- glm(Outcome ~ MainFactor + UsageFrequency + Approvals + Student,
             data = tMrf, family = "binomial")
mc <- summary(model)$coefficients
write.csv(mc, file = "repro_raw_reduce.csv", quote = FALSE)
EOR

# Extract rows and rename terms into a compact CSV for post-processing
awk -F',' '\''NR==1{next}
{
  term=$1
  if(term=="(Intercept)") term="(Intercept)"
  else if(term=="MainFactorp") term="MainFactorProc"
  else if(term=="UsageFrequency") term="Usage Freq."
  else if(term=="Approvals") term="Approvals"
  else if(term=="StudentTRUE") term="StudentTrue"
  print term,$2,$3,$4,$5
}'\'' OFS=',' repro_raw_reduce.csv > /workspace/repro.txt

# Section 4: Formatting and submission block
echo '"'"'<artisan_submit>'"'"'
cat /workspace/expected.md
echo
echo
echo '"'"'Reproduced Table 7 (computed from RQ1.csv):'"'"'
echo
echo '"'"'| Term | Estimate | Std.Error | z value | Pr(>|z|) |'"'"' > /workspace/repro_table7.md
echo '"'"'|---|---:|---:|---:|---:|'"'"' >> /workspace/repro_table7.md

# Format numbers to two decimals; coerce tiny estimates to 0.00 to match the paper
awk -F',' '\''{
  est = $2 + 0; se = $3 + 0; z = $4 + 0; p = $5 + 0;
  if(est > -0.005 && est < 0.005) est = 0;  # avoid "-0.00"
  printf "| %s | %.2f | %.2f | %.2f | %.2f |\n", $1, est, se, z, p
}'\'' /workspace/repro.txt >> /workspace/repro_table7.md

cat /workspace/repro_table7.md
echo '"'"'</artisan_submit>'"'"'
EOF
chmod +x /workspace/repro_pythonic_table_7.sh
artisan submit /workspace/repro_pythonic_table_7.sh'
</mini_swe_agent_bash>
