import csv, sys
with open('table_lines.csv', 'r') as f:
    lines = f.readlines()
reader = csv.reader(lines, delimiter='|')
data = []
for row in reader:
    if len(row) < 10:
        continue
    # Keep only columns relevant to our analysis
    # We want: row[0] index, row[6] ROAM match accuracy, row[7] ROAM reproduction result,
    # row[12] ROAM-Sim match accuracy, row[13] ROAM-Sim reproduction result,
    # row[15] ROAM-Dist match accuracy, row[16] ROAM-Dist reproduction result
    try:
        idx = row[0].strip()
        roam_match = float(row[6].strip()) if row[6].strip() else 0.0
        roam_reprod = row[7].strip()
        sim_match = float(row[12].strip()) if row[12].strip() else 0.0
        sim_reprod = row[13].strip()
        dist_match = float(row[15].strip()) if row[15].strip() else 0.0
        dist_reprod = row[16].strip()
        if idx and idx.isdigit():
            data.append((int(idx), roam_match, roam_reprod, sim_match, sim_reprod, dist_match, dist_reprod))
    except (IndexError, ValueError):
        continue

total = len(data)
roam_match_avg = sum(d[1] for d in data) / total * 100
sim_match_avg = sum(d[3] for d in data) / total * 100
dist_match_avg = sum(d[5] for d in data) / total * 100
roam_reprod_rate = sum(1 for d in data if d[2] == 'success') / total * 100
sim_reprod_rate = sum(1 for d in data if d[4] == 'success') / total * 100
dist_reprod_rate = sum(1 for d in data if d[6] == 'success') / total * 100

print('Roam match accuracy: {:.1f}%'.format(roam_match_avg))
print('Roam reproduction rate: {:.1f}%'.format(roam_reprod_rate))
print('Roam-Sim match accuracy: {:.1f}%'.format(sim_match_avg))
print('Roam-Sim reproduction rate: {:.1f}%'.format(sim_reprod_rate))
print('Roam-Dist match accuracy: {:.1f}%'.format(dist_match_avg))
print('Roam-Dist reproduction rate: {:.1f}%'.format(dist_reprod_rate))
"
