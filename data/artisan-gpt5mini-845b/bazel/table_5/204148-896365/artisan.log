# Run the cloning and analysis steps inside the python-pandas container (detached-run pattern)
container=$(docker run -d --init --entrypoint bash -w /study/1.quantitative-analysis/ -v "${PWD}/study":/study/:ro -v "${PWD}/study-input":/study-input/:ro -v "${PWD}/study-output":/study-output/:rw malfadel/python-pandas -c 'sleep infinity')
