<output>
# Research Questions

## RQ2 & RQ3

Here we supply some raw data on RQ2 and RQ3:

- `time.txt` refers to the time consumption for each patch in the dataset
- `ppt4j_*.txt` refer to the prediction results of different variants.

## RQ4

Due to copyright issues, we do not include the binaries related to Jetbrains IntelliJ IDEA.
Here we provide a brief guideline on how to extract third party libraries from IntelliJ and use PPT4J.

First, locate third party libraries.

- Download the `tar.gz` archive from https://www.jetbrains.com/idea/download/?section=linux and extract it to a temporary folder, e.g., `IDEA`. After that, go to `IDEA/lib`
- An alternative for macOS users: right click the `IntelliJ IDEA.app` (in "Finder -> Applications" or a mounted dmg archive) and select "Show Package Contents", and then go to `Contents/lib`.

Next, merge all jars in `lib` into one file.

- Create a temporary folder, e.g., `classes`.
- Unzip the jar files to `classes` with `unzip`: `unzip -d classes *.jar`. The actual command may vary, depending on the directory name and the shell.
- Delete the `META-INF` folder in `classes` after extracting all jars.
- In `classes` folder, create a new jar file with `jar`: `jar -cvf lib.jar .` Now we've created a `lib.jar` file, and it can be moved out of this temporary folder.

Finally, use PPT4J to test the presence of a patch.

Here we provide a demo `IDEATest.java` that tests patches in the dataset. The actual paths in this file may vary. To test other patches, please refer to `misc/src/main/java/ppt4j/Demo.java`.

```java
package ppt4j;

import ppt4j.analysis.patch.PatchAnalyzer;
import ppt4j.database.Vulnerability;
import ppt4j.factory.DatabaseFactory;
import ppt4j.factory.ExtractorFactory;
import ppt4j.util.ExecDriver;
import ppt4j.util.PropertyUtils;
import ppt4j.util.ResourceUtils;
import com.sun.tools.attach.VirtualMachine;

import java.io.IOException;

// Example: java -cp <path/to/classes>:framework/target/classes:lib/* IDEATest <id>
// Be sure lib/*.jar is accessible from `pwd`
public class IDEATest {

    // Assume the location of `lib.jar` is:
    // DB_ROOT/IntelliJ_IDEA/VERSION/lib.jar
    private static final String VERSION = "IU-231.8109.175";

    // Always load classes from our libs first
    // This is to avoid loading PPT4J's dependencies from target `lib.jar`
    private static final String LIBS =
            "lib/asm-9.4.jar:" +
                    "lib/asm-analysis-9.4.jar:" +
                    "lib/asm-commons-9.4.jar:" +
                    "lib/asm-tree-9.4.jar:" +
                    "lib/asm-util-9.4.jar:" +
                    "lib/slf4j-api-2.0.5.jar:" +
                    "lib/slf4j-reload4j-2.0.5.jar:" +
                    "lib/log4j-1.2.12.jar:";

    // Load classes from target `lib.jar` after the above libs,
    // but before the rest of the classpath to use the correct version
    private static final String VM_OPTIONS =
            "-Djdk.attach.allowAttachSelf=true " +
                    "--add-opens java.base/java.lang=ALL-UNNAMED " +
                    "--add-opens java.base/java.lang.reflect=ALL-UNNAMED " +
                    "-cp " + LIBS + "/Users/panzhiyuan/database/IntelliJ_IDEA/" + VERSION + "/lib.jar"
                    + ":misc/target/classes:framework/target/classes:lib/*";

    static {
        if (System.getenv("IDEA_TEST") != null) {
            PropertyUtils.load(ResourceUtils.readProperties());
            PropertyUtils.init();
            // Not necessary, if full log data is not required
            try {
                VirtualMachine vm = VirtualMachine.attach("" + ProcessHandle.current().pid());
                vm.loadAgent(PropertyUtils.getProperty("org.aspectj.weaver.path"));
                vm.detach();
            } catch (Exception e) {
                System.err.println("Error: " + e.getMessage());
                System.exit(1);
            }
        }
    }

    private static final String DB_ROOT =
            System.getenv("IDEA_TEST") == null ? "" :
                    PropertyUtils.getProperty("ppt4j.database.root");

    private static final String PREPATCH_PREFIX =
            System.getenv("IDEA_TEST") == null ? "" :
                    PropertyUtils.getProperty("ppt4j.database.prepatch.name");

    private static final String POSTPATCH_PREFIX =
            System.getenv("IDEA_TEST") == null ? "" :
                    PropertyUtils.getProperty("ppt4j.database.postpatch.name");


    public static void main(String[] args) {
        boolean fork = System.getenv("IDEA_TEST") == null;
        int id = Integer.parseInt(args[0]);
        if (fork) {
            System.out.println("Creating new VM process in fork mode");
            ExecDriver driver = ExecDriver.getInstance();
            driver.execute(String.format(
                    "IDEA_TEST=1 java %s %s %d", VM_OPTIONS, IDEATest.class.getName(), id));
            System.out.println("Process exited with code: " + driver.exitValue());
        } else {
            runTest(id);
        }
    }

    private static void runTest(int id) {
        ExtractorFactory factory = ExtractorFactory.get(
                DB_ROOT + "/" + PREPATCH_PREFIX + "/" + id,
                DB_ROOT + "/" + POSTPATCH_PREFIX + "/" + id,
                DB_ROOT + "/IntelliJ_IDEA/" + VERSION + "/lib.jar");
        try {
            Vulnerability vul = DatabaseFactory.makeDataset(
                    ResourceUtils.readDatabaseById(id));
            PatchAnalyzer analyzer = new PatchAnalyzer(vul, factory);
            factory.setVuln(vul);
            analyzer.analyze();
        } catch (IOException e) {
            e.printStackTrace();
            System.exit(1);
        }
    }

}
```
