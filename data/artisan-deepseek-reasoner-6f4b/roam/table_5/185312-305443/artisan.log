<mini_swe_agent_bash>
cat > /tmp/compute_table5.py << 'EOF'
import sys
import re

# Read the markdown table from stdin
lines = sys.stdin.read().splitlines()

# Find the start of the table (line with the first row of data)
# The table header is the first line after the column headers (which have |---|)
# In the markdown, the data starts after the header row and the separator row.
# We'll skip lines until we see a line that starts with '|' and contains numbers.
data_rows = []
in_table = False
for line in lines:
    line = line.strip()
    if line.startswith('|') and '|' in line:
        # Remove leading/trailing '|' and split
        parts = [p.strip() for p in line.split('|') if p.strip() != '']
        # The first row of data has the first column as a number (1)
        if len(parts) > 0 and parts[0].isdigit():
            in_table = True
        if in_table:
            data_rows.append(parts)

# We expect 72 rows
print(f"Found {len(data_rows)} data rows", file=sys.stderr)

# Indices for columns (0-based after removing empty cells)
# From the markdown header:
# Col1, Col2, Col3, Col4, Col5, Col6, ROAM, Col8, Col9, Col10, Col11, Col12, ROAM-Sim, Col14, Col15, ROAM-Dist, Col17, Col18, ...
# So:
# ROAM Match Accuracy is at index 6 (since Col1 is index 0)
# ROAM Reproduction Result is at index 7
# ROAM-Sim Match Accuracy is at index 12
# ROAM-Sim Reproduction Result is at index 13
# ROAM-Dist Match Accuracy is at index 15
# ROAM-Dist Reproduction Result is at index 16

roam_match_acc = []
roam_repro_success = []
roam_sim_match_acc = []
roam_sim_repro_success = []
roam_dist_match_acc = []
roam_dist_repro_success = []

for row in data_rows:
    if len(row) < 17:
        continue
    # Match accuracy columns: convert to float if possible
    try:
        roam_match = float(row[6]) if row[6] else 0.0
        roam_sim_match = float(row[12]) if row[12] else 0.0
        roam_dist_match = float(row[15]) if row[15] else 0.0
    except ValueError:
        continue
    
    roam_match_acc.append(roam_match)
    roam_sim_match_acc.append(roam_sim_match)
    roam_dist_match_acc.append(roam_dist_match)
    
    # Reproduction result: 'success' counts as success, others (failure, false positive) as failure
    roam_repro = 1 if row[7].strip().lower() == 'success' else 0
    roam_sim_repro = 1 if row[13].strip().lower() == 'success' else 0
    roam_dist_repro = 1 if row[16].strip().lower() == 'success' else 0
    
    roam_repro_success.append(roam_repro)
    roam_sim_repro_success.append(roam_sim_repro)
    roam_dist_repro_success.append(roam_dist_repro)

# Compute averages
def avg(lst):
    return sum(lst) / len(lst) if lst else 0.0

roam_avg_match = avg(roam_match_acc) * 100  # to percentage
roam_avg_repro = avg(roam_repro_success) * 100

roam_sim_avg_match = avg(roam_sim_match_acc) * 100
roam_sim_avg_repro = avg(roam_sim_repro_success) * 100

roam_dist_avg_match = avg(roam_dist_match_acc) * 100
roam_dist_avg_repro = avg(roam_dist_repro_success) * 100

print("Table 5 Results:")
print(f"Roam: Avg. Match Accuracy = {roam_avg_match:.1f}%, Reproduction Rate = {roam_avg_repro:.1f}%")
print(f"Roam-Sim: Avg. Match Accuracy = {roam_sim_avg_match:.1f}%, Reproduction Rate = {roam_sim_avg_repro:.1f}%")
print(f"Roam-Dist: Avg. Match Accuracy = {roam_dist_avg_match:.1f}%, Reproduction Rate = {roam_dist_avg_repro:.1f}%")

# Output in the format expected for the table
print("\nFormatted table:")
print("|           | Avg. Match Accuracy (%) | Reproduction Rate (%) |")
print("| --------- | :---------------------: | :-------------------: |")
print(f"| Roam-Sim  |           {roam_sim_avg_match:.0f}           |          {roam_sim_avg_repro:.0f}          |")
print(f"| Roam-Dist |           {roam_dist_avg_match:.0f}           |          {roam_dist_avg_repro:.0f}          |")
print(f"| Roam      |           {roam_avg_match:.0f}           |          {roam_avg_repro:.0f}          |")
EOF
</mini_swe_agent_bash>
