_links": "https://zenodo.org/api/records/10496086/access/links", "access_request": "https://zenodo.org/api/records/10496086/access/request", "access_users": "https://zenodo.org/api/records/10496086/access/users", "archive": "https://zenodo.org/api/records/10496086/files-archive", "archive_media": "https://zenodo.org/api/records/10496086/media-files-archive", "communities": "https://zenodo.org/api/records/10496086/communities", "communities-suggestions": "https://zenodo.org/api/records/10496086/communities-suggestions", "doi": "https://doi.org/10.5281/zenodo.10496086", "draft": "https://zenodo.org/api/records/10496086/draft", "file_modification": "https://zenodo.org/api/records/10496086/file-modification", "files": "https://zenodo.org/api/records/10496086/files", "latest": "https://zenodo.org/api/records/10496086/versions/latest", "latest_html": "https://zenodo.org/records/10496086/latest", "media_files": "https://zenodo.org/api/records/10496086/media-files", "parent": "https://zenodo.org/api/records/8289375", "parent_doi": "https://doi.org/10.5281/zenodo.8289375", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.8289375", "parent_html": "https://zenodo.org/records/8289375", "preview_html": "https://zenodo.org/records/10496086?preview=1", "request_deletion": "https://zenodo.org/api/records/10496086/request-deletion", "requests": "https://zenodo.org/api/records/10496086/requests", "reserve_doi": "https://zenodo.org/api/records/10496086/draft/pids/doi", "self": "https://zenodo.org/api/records/10496086", "self_doi": "https://doi.org/10.5281/zenodo.10496086", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10496086", "self_html": "https://zenodo.org/records/10496086", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:10496086/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:10496086/sequence/default", "versions": "https://zenodo.org/api/records/10496086/versions"}, "media_files": {"count": 0, "enabled": false, "entries": {}, "order": [], "total_bytes": 0}, "metadata": {"creators": [{"affiliations": [{"name": "Zhejiang University"}], "person_or_org": {"family_name": "Li", "given_name": "Chenghao", "identifiers": [{"identifier": "0009-0009-2920-0552", "scheme": "orcid"}], "name": "Li, Chenghao", "type": "personal"}}, {"affiliations": [{"name": "Zhejiang University"}], "person_or_org": {"family_name": "Wu", "given_name": "Yifei", "name": "Wu, Yifei", "type": "personal"}}], "description": "\u003cp\u003eSee \u003ca href=\"https://github.com/ZJU-SEC/Cargo-Ecosystem-Monitor\"\u003eZJU-SEC/Cargo-Ecosystem-Monitor (github.com)\u003c/a\u003e for latest update. This repo includes entire Cargo ecosystem analysis, not limited to Rust Unstable Features.\u003c/p\u003e\n\u003cp\u003eRust programming language is gaining popularity rapidly in building reliable and secure systems due to its security guarantees and outstanding performance. To provide extra functionalities, the Rust compiler introduces Rust unstable features (RUF) to extend compiler functionality, syntax, and standard library support. However, these features are unstable and may get removed, introducing compilation failures to dependent packages. Even worse, their impacts propagate through transitive dependencies, causing large-scale failures in the whole ecosystem. Although RUF is widely used in Rust, previous research has primarily concentrated on Rust code safety, with the usage and impacts of RUF from the Rust compiler remaining unexplored.\u003c/p\u003e\n\u003cp\u003eTherefore, we aim to bridge this gap by systematically analyzing the RUF usage and impacts in the Rust ecosystem. We propose novel techniques for extracting RUF precisely, and to assess its impact on the entire ecosystem quantitatively, we accurately resolve package dependencies. We have analyzed the whole Rust ecosystem with 590K package versions and 140M transitive dependencies. Our study shows that the Rust ecosystem uses 1000 different RUF, and at most 44% of package versions are affected by RUF, causing compiling failures for at most 12%. To mitigate wide RUF impacts, we further design and implement a RUF compilation failure recovery tool that can recover up to 90% of the failure. We believe our techniques, findings, and tools can help to stabilize the Rust compiler, ultimately enhancing the security and reliability of the Rust ecosystem.\u003c/p\u003e\n\u003cp\u003eIn this repository, we describe how we use our tools to collect, generate, and analyze data to support our RUF research. We also provide complete data behind the paper, give guidance to reproduce the data, and validate our tools. The data we used are from another repository.\u003c/p\u003e", "publication_date": "2024-01", "publisher": "Zenodo", "related_identifiers": [{"identifier": "10.5281/zenodo.8289279", "relation_type": {"id": "requires", "title": {"de": "Setzt voraus", "en": "Requires"}}, "resource_type": {"id": "dataset", "title": {"de": "Datensatz", "en": "Dataset"}}, "scheme": "doi"}, {"identifier": "https://sites.google.com/view/ruf-study/home", "relation_type": {"id": "isdescribedby", "title": {"de": "Wird beschrieben von", "en": "Is described by"}}, "resource_type": {"id": "other", "title": {"de": "Sonstige", "en": "Other"}}, "scheme": "url"}, {"identifier": "https://github.com/ZJU-SEC/Cargo-Ecosystem-Monitor", "relation_type": {"id": "ispartof", "title": {"de": "Ist Teil von", "en": "Is part of"}}, "resource_type": {"id": "software", "title": {"de": "Software", "en": "Software"}}, "scheme": "url"}], "resource_type": {"id": "software", "title": {"de": "Software", "en": "Software"}}, "rights": [{"description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title": {"en": "Creative Commons Attribution 4.0 International"}}], "subjects": [{"subject": "Rust programming language"}, {"subject": "Rust ecosystem"}, {"subject": "Rust unstable feature"}, {"subject": "Dependency graph"}], "title": "Demystifying Rust Unstable Features (Usage, Impacts, and Others) in the Rust Ecosystem", "version": "v0.0.2"}, "parent": {"access": {"owned_by": {"user": "602613"}, "settings": {"accept_conditions_text": null, "allow_guest_requests": false, "allow_user_requests": false, "secret_link_expiration": 0}}, "communities": {}, "id": "8289375", "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.8289375", "provider": "datacite"}}}, "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.10496086", "provider": "datacite"}, "oai": {"identifier": "oai:zenodo.org:10496086", "provider": "oai"}}, "revision_id": 6, "stats": {"all_versions": {"data_volume": 37638174420.0, "downloads": 110, "unique_downloads": 88, "unique_views": 311, "views": 338}, "this_version": {"data_volume": 3128638800.0, "downloads": 75, "unique_downloads": 59, "unique_views": 202, "views": 214}}, "status": "published", "swh": {}, "ui": {"access_status": {"description_l10n": "The record and files are publicly accessible.", "embargo_date_l10n": null, "icon": "unlock", "id": "open", "message_class": "", "title_l10n": "Open"}, "conference": {"acronym": "ICSE", "dates": "April 14-20 2024", "place": "Lisbon, Portugal", "title": "International Conference on Software Engineering", "url": "https://conf.researchr.org/home/icse-2024"}, "created_date_l10n_long": "January 12, 2024", "creators": {"affiliations": [[1, "Zhejiang University", null]], "creators": [{"affiliations": [[1, "Zhejiang University"]], "person_or_org": {"family_name": "Li", "given_name": "Chenghao", "identifiers": [{"identifier": "0009-0009-2920-0552", "scheme": "orcid"}], "name": "Li, Chenghao", "type": "personal"}}, {"affiliations": [[1, "Zhejiang University"]], "person_or_org": {"family_name": "Wu", "given_name": "Yifei", "name": "Wu, Yifei", "type": "personal"}}]}, "custom_fields": {"code:codeRepository": "https://github.com/ZJU-SEC/Cargo-Ecosystem-Monitor", "code:developmentStatus": {"id": "active", "title_l10n": "Active"}, "code:programmingLanguage": [{"id": "rust", "title_l10n": "Rust"}], "meeting:meeting": {"acronym": "ICSE", "dates": "April 14-20 2024", "place": "Lisbon, Portugal", "title": "International Conference on Software Engineering", "url": "https://conf.researchr.org/home/icse-2024"}}, "description_stripped": "See ZJU-SEC/Cargo-Ecosystem-Monitor (github.com) for latest update. This repo includes entire Cargo ecosystem analysis, not limited to Rust Unstable Features.\n\nRust programming language is gaining popularity rapidly in building reliable and secure systems due to its security guarantees and outstanding performance. To provide extra functionalities, the Rust compiler introduces Rust unstable features (RUF) to extend compiler functionality, syntax, and standard library support. However, these features are unstable and may get removed, introducing compilation failures to dependent packages. Even worse, their impacts propagate through transitive dependencies, causing large-scale failures in the whole ecosystem. Although RUF is widely used in Rust, previous research has primarily concentrated on Rust code safety, with the usage and impacts of RUF from the Rust compiler remaining unexplored.\n\nTherefore, we aim to bridge this gap by systematically analyzing the RUF usage and impacts in the Rust ecosystem. We propose novel techniques for extracting RUF precisely, and to assess its impact on the entire ecosystem quantitatively, we accurately resolve package dependencies. We have analyzed the whole Rust ecosystem with 590K package versions and 140M transitive dependencies. Our study shows that the Rust ecosystem uses 1000 different RUF, and at most 44% of package versions are affected by RUF, causing compiling failures for at most 12%. To mitigate wide RUF impacts, we further design and implement a RUF compilation failure recovery tool that can recover up to 90% of the failure. We believe our techniques, findings, and tools can help to stabilize the Rust compiler, ultimately enhancing the security and reliability of the Rust ecosystem.\n\nIn this repository, we describe how we use our tools to collect, generate, and analyze data to support our RUF research. We also provide complete data behind the paper, give guidance to reproduce the data, and validate our tools. The data we used are from another repository.", "is_draft": false, "publication_date_l10n_long": "January 2024", "publication_date_l10n_medium": "Jan 2024", "related_identifiers": [{"identifier": "10.5281/zenodo.8289279", "relation_type": {"id": "requires", "title_l10n": "Requires"}, "resource_type": {"id": "dataset", "title_l10n": "Dataset"}, "scheme": "doi"}, {"identifier": "https://sites.google.com/view/ruf-study/home", "relation_type": {"id": "isdescribedby", "title_l10n": "Is described by"}, "resource_type": {"id": "other", "title_l10n": "Other"}, "scheme": "url"}, {"identifier": "https://github.com/ZJU-SEC/Cargo-Ecosystem-Monitor", "relation_type": {"id": "ispartof", "title_l10n": "Is part of"}, "resource_type": {"id": "software", "title_l10n": "Software"}, "scheme": "url"}], "resource_type": {"id": "software", "title_l10n": "Software"}, "rights": [{"description_l10n": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.", "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title_l10n": "Creative Commons Attribution 4.0 International"}], "updated_date_l10n_long": "June 23, 2024", "version": "v0.0.2"}, "updated": "2024-06-23T05:22:29.308686+00:00", "versions": {"index": 2, "is_latest": true}}' data-preview='false'>
