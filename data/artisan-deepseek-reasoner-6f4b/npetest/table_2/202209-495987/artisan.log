import pandas as pd
import re

def parse_expected_table(expected_md_path):
    """Parse expected.md and return dict: category -> list of (project_name, maybe_suffix)"""
    with open(expected_md_path, 'r') as f:
        content = f.read()
    # Split by category headers
    categories = ['NPEX', 'BugSwarm', 'Defects4J', 'Genesis', 'Bears']
    result = {}
    for cat in categories:
        # Find section between "### NPEX" and next "###" or end
        pattern = rf'### {cat}\s*\n\s*\n(.*?)(?=\n###|\Z)'
        match = re.search(pattern, content, re.DOTALL)
        if not match:
            continue
        table_text = match.group(1).strip()
        # Parse markdown table rows
        lines = table_text.split('\n')
        projects = []
        for line in lines:
            # Match line like "| Activiti-c45 | ? | ?? |"
            m = re.match(r'^\| ([^|]+) \|', line)
            if m:
                proj = m.group(1).strip()
                if proj == 'Project' or proj.startswith(':---'):
                    continue
                projects.append(proj)
        result[cat] = projects
    return result

def percent_to_symbol(pct):
    if pd.isna(pct):
        return '?'
    if pct <= 33:
        return '?'
    elif pct <= 66:
        return '??'
    else:
        return '???'

def main():
    # Load raw data
    df = pd.read_excel('NPETestArtifact/rq1_result.xlsx', header=0)
    df.columns = ['benchmark', 'project_id', 'class_name', 'col3', 'col4', 'Randoop', 'evosuite', 'npetest']
    
    # Parse expected projects
    expected = parse_expected_table('/workspace/expected.md')
    
    # Prepare output lines
    output_lines = []
    output_lines.append("**Table 2: The reproduction rate results for 25 trials on benchmark projects gathered from the prior studies [3, 21–24]. The projects where all three tools failed to detect NPEs are excluded from this table. Project: The name of the buggy project with its abbreviated NPE-labeling ID (if necessary). The number in a parenthesis represents each unique NPE in the same project.**")
    output_lines.append("")
    
    for cat, proj_list in expected.items():
        output_lines.append(f"### {cat}")
        output_lines.append("")
        output_lines.append("| Project | EvoSuite | NPETest |")
        output_lines.append("| :--- | ---: | ---: |")
        
        # Filter raw data for this category
        cat_df = df[df['benchmark'] == cat].copy()
        
        # For each expected project name, we need to find matching rows.
        # Expected project names may have parentheses, e.g., "Http-f633(1)".
        # We'll split base name and suffix.
        for proj in proj_list:
            # Determine if there's a parenthesis suffix
            m = re.match(r'^(.*?)(?:\((\d+)\))?$', proj)
            base = m.group(1).strip()
            suffix = int(m.group(2)) if m.group(2) else None
            
            # Now find raw rows that match this base.
            # We need to map base like "Activiti-c45" to raw project_id "Activiti-c45d6c3c".
            # Heuristic: raw project_id starts with base, or base without dash part?
            # Let's try matching by prefix.
            possible = cat_df[cat_df['project_id'].str.startswith(base)]
            if possible.empty:
                # Maybe base includes dash but raw has longer commit hash.
                # Try matching without the dash part? Actually base may have dash.
                # For example base = "Activiti-c45", raw = "Activiti-c45d6c3c".
                # So raw starts with base.
                # For "Aries_JPA", raw = "Aries_JPA-97cb979d". So raw starts with base + '-'.
                # So we can check if raw project_id starts with base) or (base + '-')
                possible = cat_df[cat_df['project_id'].str.startswith(base + '-')]
                if possible.empty:
                    possible = cat_df[cat_df['project_id'] == base]
            # If still empty, maybe base is abbreviated differently.
            # We'll do a fuzzy match: take the part before dash in raw and compare with base before dash.
            if possible.empty:
                # Extract raw base (before dash) and compare with base (before dash if any)
                raw_base = cat_df['project_id'].str.split('-').str[0]
                # Compare with base split by '-'
                base_prefix = base.split('-')[0]
                possible = cat_df[raw_base == base_prefix]
            
            # If multiple rows, we need to select by suffix (1-indexed)
            if len(possible) > 1 and suffix is not None:
                # Assume rows are in the order they appear in raw data for that project_id.
                # We'll group by project_id and then index.
                # For simplicity, sort by index and pick the (suffix-1)-th row.
                possible = possible.sort_index()
                if suffix <= len(possible):
                    row = possible.iloc[suffix-1]
                else:
                    row = possible.iloc[0]
            elif len(possible) >= 1:
                # If suffix is None, there should be only one row. If multiple, take first.
                row = possible.iloc[0]
            else:
                # No match, use placeholder
                evo_sym = '?'
                npe_sym = '??'
                output_lines.append(f"| {proj} | {evo_sym} | {npe_sym} |")
                continue
            
            evo_sym = percent_to_symbol(row['evosuite'])
            npe_sym = percent_to_symbol(row['npetest'])
            output_lines.append(f"| {proj} | {evo_sym} | {npe_sym} |")
        
        output_lines.append("")
    
    # Write output
    with open('/workspace/repro.txt', 'w') as f:
        f.write('\n'.join(output_lines))
    print("Generated /workspace/repro.txt")

if __name__ == '__main__':
    main()
EOF
