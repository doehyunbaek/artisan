import os, math

path = "ROAM-Artifact/ROAM-Artifact/Evaluation/results.md"
with open(path, encoding="utf-8") as f:
    lines = [l.rstrip("\n") for l in f]

# Locate header with column names
name_idx = None
for i, l in enumerate(lines):
    if l.startswith("|Col1|Col2|Col3|"):
        name_idx = i
        break
if name_idx is None:
    raise SystemExit("Header row not found")

names = [c.strip() for c in lines[name_idx].strip("|").split("|")]
labels = [c.strip() for c in lines[name_idx+2].strip("|").split("|")]

def match_col(tool):
    for i, n in enumerate(names):
        if n == tool and "Match" in labels[i]:
            return i
    raise KeyError(tool)

cols = {
    "ROAM": match_col("ROAM"),
    "PRM-Enumeration": match_col("PRM-Enumeration"),
    "Euler": match_col("Euler"),
}

results = {k: {"sum":0.0,"cnt":0,"perfect":0,"zero":0} for k in cols}

for l in lines:
    if not l.startswith("|"):
        continue
    cells = l.strip("|").split("|")
    if not cells or not cells[0].strip().isdigit():
        continue
    for tool, idx in cols.items():
        if idx >= len(cells):
            continue
        v = cells[idx].strip()
        if not v:
            continue
        try:
            x = float(v)
        except ValueError:
            continue
        r = results[tool]
        r["sum"] += x
        r["cnt"] += 1
        if abs(x-1.0) < 1e-9:
            r["perfect"] += 1
        if abs(x-0.0) < 1e-9:
            r["zero"] += 1

for tool, r in results.items():
    mean = r["sum"]/r["cnt"] if r["cnt"] else float("nan")
    print(f"{tool}: mean_match={mean*100:.2f}%, perfect={r['perfect']}, zero={r['zero']}, n={r['cnt']}")
PY
