FROM androidsdk/android-30:latest

# Install tools and JDK
RUN apt-get update \
	&& apt-get install -y \
	libgl1-mesa-dev \
	wget \
	unzip \
	openjdk-8-jdk \
	ffmpeg \
	python3-pip \
	python3-venv \
	git \
	graphviz \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /Roam-Artifact/BuildEnvironment

# Use system python/pip to install python dependencies (avoid conda due to GLIBC mismatch)
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt && python3 -m spacy download en_core_web_lg

# Default working dir for container when running reproduction commands
WORKDIR /Roam-Artifact/ReproductionTool

SHELL ["/bin/bash", "-lc"]
CMD echo "Environment is ready"
EOF
</mini_swe_agent_bash>
