import csv, math, pathlib

def read_rows(path, outcome_col):
    rows = []
    with path.open() as f:
        r = csv.DictReader(f)
        for row in r:
            if row["tool"] == "1":
                try:
                    yv = float(row[outcome_col])
                except ValueError:
                    continue
                x1 = float(row["AI_experience"])
                x2 = float(row["info_style"])
                x3 = float(row["learning_style"])
                rows.append((yv, [1.0, x1, x2, x3]))
    return rows

def mat_transpose(M):
    return [list(col) for col in zip(*M)]

def mat_mul(A, B):
    # A: m x n, B: n x p
    m, n = len(A), len(A[0])
    n2, p = len(B), len(B[0])
    assert n == n2
    out = [[0.0]*p for _ in range(m)]
    for i in range(m):
        Ai = A[i]
        for k in range(p):
            s = 0.0
            for j in range(n):
                s += Ai[j] * B[j][k]
            out[i][k] = s
    return out

def mat_vec_mul(A, v):
    m, n = len(A), len(A[0])
    assert len(v) == n
    out = [0.0]*m
    for i in range(m):
        s = 0.0
        Ai = A[i]
        for j in range(n):
            s += Ai[j]*v[j]
        out[i] = s
    return out

def solve_linear(A, b):
    # Gaussian elimination with partial pivoting, A is modified copy
    n = len(A)
    M = [row[:] for row in A]
    x = list(b)
    for k in range(n):
        # pivot
        pivot = max(range(k, n), key=lambda i: abs(M[i][k]))
        if abs(M[pivot][k]) < 1e-12:
            raise RuntimeError("Singular matrix")
        if pivot != k:
            M[k], M[pivot] = M[pivot], M[k]
            x[k], x[pivot] = x[pivot], x[k]
        # eliminate
        for i in range(k+1, n):
            factor = M[i][k] / M[k][k]
            if factor == 0.0:
                continue
            for j in range(k, n):
                M[i][j] -= factor * M[k][j]
            x[i] -= factor * x[k]
    # back substitution
    for i in range(n-1, -1, -1):
        s = x[i]
        for j in range(i+1, n):
            s -= M[i][j]*x[j]
        x[i] = s / M[i][i]
    return x

def invert_matrix(A):
    n = len(A)
    M = [row[:] for row in A]
    inv = [[float(i==j) for j in range(n)] for i in range(n)]
    for k in range(n):
        pivot = max(range(k, n), key=lambda i: abs(M[i][k]))
        if abs(M[pivot][k]) < 1e-12:
            raise RuntimeError("Singular matrix in invert")
        if pivot != k:
            M[k], M[pivot] = M[pivot], M[k]
            inv[k], inv[pivot] = inv[pivot], inv[k]
        diag = M[k][k]
        for j in range(n):
            M[k][j] /= diag
            inv[k][j] /= diag
        for i in range(n):
            if i == k:
                continue
            factor = M[i][k]
            if factor == 0.0:
                continue
            for j in range(n):
                M[i][j] -= factor * M[k][j]
                inv[i][j] -= factor * inv[k][j]
    return inv

def glm_poisson_IRLS(rows, max_iter=50, tol=1e-10):
    y = [r[0] for r in rows]
    X = [r[1] for r in rows]
    n = len(y)
    p = len(X[0])
    beta = [0.0]*p
    for it in range(max_iter):
        eta = mat_vec_mul(X, beta)
        mu = [math.exp(e) for e in eta]
        # weights
        W = mu[:]  # for Poisson with log link
        # z working response
        z = []
        for i in range(n):
            if mu[i] <= 0:
                z.append(eta[i])
            else:
                z.append(eta[i] + (y[i] - mu[i]) / mu[i])
        # compute X^T W X and X^T W z
        XT = mat_transpose(X)
        XT_WX = [[0.0]*p for _ in range(p)]
        XT_Wz = [0.0]*p
        for j in range(p):
            for k in range(p):
                s = 0.0
                for i in range(n):
                    s += XT[j][i] * W[i] * X[i][k]
                XT_WX[j][k] = s
            sz = 0.0
            for i in range(n):
                sz += XT[j][i] * W[i] * z[i]
            XT_Wz[j] = sz
        beta_new = solve_linear(XT_WX, XT_Wz)
        diff = max(abs(beta_new[j] - beta[j]) for j in range(p))
        beta = beta_new
        if diff < tol:
            break
    # final mu, eta, dispersion phi via Pearson
    eta = mat_vec_mul(X, beta)
    mu = [math.exp(e) for e in eta]
    pearson = 0.0
    for i in range(n):
        if mu[i] > 0:
            pearson += (y[i] - mu[i])**2 / mu[i]
    phi = pearson / (n - p)
    # recompute XT_WX and invert for covariance
    XT = mat_transpose(X)
    XT_WX = [[0.0]*p for _ in range(p)]
    for j in range(p):
        for k in range(p):
            s = 0.0
            for i in range(n):
                s += XT[j][i] * W[i] * X[i][k]
            XT_WX[j][k] = s
    XT_WX_inv = invert_matrix(XT_WX)
    se = [math.sqrt(phi * XT_WX_inv[j][j]) for j in range(p)]
    # log-likelihoods for McFadden R^2
    def loglik(counts, means):
        s = 0.0
        for yi, mi in zip(counts, means):
            if mi <= 0:
                mi = 1e-12
            s += yi * math.log(mi) - mi - math.lgamma(yi + 1)
