def count_annotations_in_dir(d: pathlib.Path) -> int:
    total = 0
    if not d.exists():
        return 0
    # consider type files used by tcheck_parser: *_types*.txt and *_ftypes*.txt
    for path in d.rglob("*types*.txt"):
        # include both types and ftypes; rglob pattern already matches
        with path.open() as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                total += 1
    for path in d.rglob("*ftypes*.txt"):
        with path.open() as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                total += 1
    return total

