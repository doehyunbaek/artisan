import sys
import re

def parse_markdown_table(md_text):
    lines = md_text.strip().split('\n')
    # Find the table rows (lines containing '|')
    table_rows = [line.strip() for line in lines if line.strip().startswith('|')]
    if len(table_rows) < 2:
        return None
    # Remove the separator line (second row usually contains dashes)
    # We'll keep only rows that have data (not just separators)
    data_rows = []
    for row in table_rows:
        # Skip rows that are all dashes and pipes (separators)
        if re.match(r'^\|[-:\s|]+\|$', row):
            continue
        data_rows.append(row)
    # Now parse each row by splitting on '|' and removing empty cells at start/end
    parsed = []
    for row in data_rows:
        cells = [cell.strip() for cell in row.split('|') if cell.strip() != '']
        parsed.append(cells)
    return parsed

def compute_averages(table_data):
    # Determine column indices for Roam, Roam-Sim, Roam-Dist
    # The header is the first row (after removing separators)
    header = table_data[0]
    # Find indices by scanning header for column names
    roam_match_idx = -1
    roam_repro_idx = -1
    sim_match_idx = -1
    sim_repro_idx = -1
    dist_match_idx = -1
    dist_repro_idx = -1
    
    for i, col in enumerate(header):
        if 'ROAM' in col and 'Match' in col:
            roam_match_idx = i
        if 'ROAM' in col and 'Reproduction' in col:
            roam_repro_idx = i
        if 'ROAM-Sim' in col and 'Match' in col:
            sim_match_idx = i
        if 'ROAM-Sim' in col and 'Reproduction' in col:
            sim_repro_idx = i
        if 'ROAM-Dist' in col and 'Match' in col:
            dist_match_idx = i
        if 'ROAM-Dist' in col and 'Reproduction' in col:
            dist_repro_idx = i
    
    # Alternative: use column positions based on known structure from the markdown output
    # From the markdown preview, columns are:
    # Col1,Col2,...,Col6,ROAM (match),ROAM (repro),Col9,Col10,Col11,Col12,ROAM-Sim (match),Col14,Col15,ROAM-Dist (match),Col17,Col18,...
    # Actually the header row has column names: "Match Accuracy" under ROAM column, etc.
    # Let's fallback to indices based on the first data row length.
