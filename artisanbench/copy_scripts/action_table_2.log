import json
from pathlib import Path

nb_path = Path("executed_RQ1.ipynb")
nb = json.loads(nb_path.read_text(encoding="utf-8"))

# Collect all stdout text from the notebook
texts = []
for cell in nb.get("cells", []):
    for out in cell.get("outputs", []):
        if out.get("output_type") == "stream" and out.get("name") == "stdout":
            text = out.get("text", "")
            if isinstance(text, list):
                texts.extend(text)
            else:
                texts.append(text)

lines = "".join(texts).splitlines()

tasks_order = ["test", "build", "release", "analyze", "lint",
               "linux", "update", "integration", "deploy", "sync"]
task_rows = {}

for line in lines:
    stripped = line.strip()
    if not stripped:
        continue
    first = stripped.split()[0].lower()
    if first in tasks_order:
        task_rows[first] = stripped

data = {}
for name in tasks_order:
    line = task_rows[name]
    tokens = line.split()
    # Expected layout:
    # task, vm_paid, vm_free, runs_paid, runs_free,
    # time_paid, (iqr=..), ), time_free, (iqr=..), ), cost_paid, cost_free
    vm_paid = tokens[1]
    vm_free = tokens[2]
    runs_paid = tokens[3]
    runs_free = tokens[4]
    time_paid = tokens[5]
    iqr_paid = tokens[6].split("=")[1]
    time_free = tokens[8]
    iqr_free = tokens[9].split("=")[1]
    cost_paid = f"{float(tokens[-2]):.2f}"
    cost_free = f"{float(tokens[-1]):.2f}"
    data[name] = {
        "vm_paid": vm_paid,
        "vm_free": vm_free,
        "runs_paid": runs_paid,
        "runs_free": runs_free,
        "time_paid": time_paid,
        "iqr_paid": iqr_paid,
        "time_free": time_free,
        "iqr_free": iqr_free,
        "cost_paid": cost_paid,
        "cost_free": cost_free,
    }

lines_out = []
lines_out.append("**Table 2: Summary of resource consumption by CI/CD tasks.**")
lines_out.append("")
lines_out.append("| Task        | VM time % (Paid) | VM time % (Free) | Runs % (Paid) | Runs % (Free) | VM time per run, min (Paid) | VM time per run, min (Free) | VM cost per run, $ (Paid) | VM cost per run, $ (Free) |")
lines_out.append("| ----------- | ---------------: | ---------------: | ------------: | ------------: | --------------------------: | --------------------------: | ------------------------: | ------------------------: |")

for key in tasks_order:
    d = data[key]
    task_label = key.capitalize()
    # Keep numeric strings as-is except costs, which we already formatted to 2 decimals
    lines_out.append(
        f"| {task_label:<10} | {d['vm_paid']:>13} | {d['vm_free']:>13} | {d['runs_paid']:>10} | {d['runs_free']:>10} | "
        f"{d['time_paid']:>9} ({d['iqr_paid']}) | {d['time_free']:>9} ({d['iqr_free']}) | "
        f"{d['cost_paid']:>22} | {d['cost_free']:>22} |"
    )

lines_out.append("")
lines_out.append("* mean (inter-quartile range)")

out_path = Path("/workspace/repro.txt")
out_path.write_text("\n".join(lines_out), encoding="utf-8")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
