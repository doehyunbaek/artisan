import json
import re
from pathlib import Path

ipynb_path = Path("/workspace/gh_resource_study_artifact_patched/github-workflow-resource-optimization/paper_analysis_RQ3.ipynb")
nb = json.loads(ipynb_path.read_text(encoding="utf-8"))

text_block = None
for cell in nb.get("cells", []):
    for out in cell.get("outputs", []):
        if out.get("output_type") == "stream" and out.get("name") == "stdout":
            txt = "".join(out.get("text", []))
            if "Optimization heuristic" in txt and "Annual cost delta $" in txt:
                text_block = txt
                break
    if text_block:
        break

if text_block is None:
    raise SystemExit("Failed to locate Table 5 output in RQ3 notebook.")

lines = [ln.rstrip() for ln in text_block.splitlines() if ln.strip()]
data_lines = [ln for ln in lines if not ln.startswith("Optimization heuristic") and not set(ln.strip()) == {"-"}]

if len(data_lines) != 7:
    raise SystemExit(f"Unexpected number of data lines for Table 5: {len(data_lines)}")

def get_percents(line: str):
    return re.findall(r'[\d.]+% \([\d.]+%\) of [^0-9]+?(?:runs|runs time)', line)

def get_cost(line: str):
    m = re.search(r'-\d+\.\d+\s+\(-\d+\.\d+\)', line)
    return m.group(0) if m else ""

# Heuristic 1: Deactivate scheduled workflows after k consecutive failures (k=3)
