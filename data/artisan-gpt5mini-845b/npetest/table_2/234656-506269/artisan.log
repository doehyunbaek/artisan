- Parses /workspace/expected.md to find the project rows in each section,
- Matches each expected project (by normalized substring matching) to rows in /workspace/rq1_result.csv (consuming repeated matches in order for duplicate entries),
- Rounds percentages to integers and writes a filled reproduction table to /workspace/repro.txt,
then run artisan format to render the final comparison using the expected and reproduced files.

<mini_swe_agent_bash>
python3 - <<'PY' > /workspace/repro.txt
import re, csv, sys
from collections import defaultdict

# Load CSV data produced earlier
csv_path = '/workspace/rq1_result.csv'
data = []
with open(csv_path, newline='') as f:
    reader = csv.reader(f)
    headers = next(reader)
    for r in reader:
        # expect columns: a,b,c,d,e,Randoop,evosuite,npetest
        if len(r) < 8:
            continue
        cat = r[0].strip()
        proj = r[1].strip()
        ev = r[6].strip()
        npv = r[7].strip()
        if proj == '':
            continue
        data.append({'cat':cat, 'proj':proj, 'ev':ev, 'np':npv})

def norm(s):
    return re.sub(r'[^0-9a-zA-Z]', '', s.lower())

# Precompute normalized project strings for matching
for d in data:
    d['nproj'] = norm(d['proj'])

used_indices = set()

# Read expected.md and produce output with numeric values
exp = open('/workspace/expected.md').read().splitlines()
out_lines = []
for line in exp:
    # Match table rows of form: | Project | EvoSuite | NPETest |
    if line.strip().startswith('|') and '|' in line:
        # Split into cells
        parts = [p.strip() for p in line.split('|')[1:-1]]
        if len(parts) >= 3 and parts[0].lower() not in ('project', 'project '):
            projcell = parts[0]
            # attempt to match project name to CSV entries
            # remove trailing parenthesis numbering like (1)
            base = re.sub(r'\(\d+\)\s*$', '', projcell).strip()
            bnorm = norm(base)
            match_idx = None
            for idx,d in enumerate(data):
                if idx in used_indices:
                    continue
                if bnorm != '' and bnorm in d['nproj']:
                    match_idx = idx
                    break
            if match_idx is None:
                # fallback: try matching by first token (before hyphen) or contains shorter tokens
                tokens = re.split(r'[_\-\s]+', base)
                for idx,d in enumerate(data):
                    if idx in used_indices:
                        continue
                    for t in tokens:
                        if t and t.lower() in d['proj'].lower():
                            match_idx = idx
                            break
                    if match_idx is not None:
                        break
            if match_idx is not None:
                used_indices.add(match_idx)
                ev = data[match_idx]['ev']
                npv = data[match_idx]['np']
                try:
                    evf = round(float(ev))
                except:
                    evf = ev if ev!='' else '?'
                try:
                    npf = round(float(npv))
                except:
                    npf = npv if npv!='' else '?'
                # rebuild the table row with numeric values
                out_lines.append(f"| {projcell} | {evf} | {npf} |")
                continue
    # default: copy line unchanged
    out_lines.append(line)

# Write output
print("\n".join(out_lines))
PY
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
</mini_swe_agent_bash>
