bash run-analysis.sh

# Section 4: Formatting and submission block
echo '<artisan_submit>'

tbl="/workspace/ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts/results/Table-4-RQ1-comp.txt"

# Extract model diagnostics (AIC, BIC, logLik, deviance, df.resid)
read AIC BIC LOGLIK DEV DFRES <<< "$(awk '/AIC/{getline; print $1, $2, $3, $4, $5}' "$tbl")"

# Extract scaled residuals and round to two decimals
read RMIN RQ RMED R3Q RMAX <<< "$(awk '/Scaled residuals:/{getline; getline; printf "%.2f %.2f %.2f %.2f %.2f\n",$1,$2,$3,$4,$5}' "$tbl")"

# Extract random-effects summary
read NOBS NGROUPS <<< "$(awk '/Number of obs:/{gsub(",",""); print $4, $7}' "$tbl")"
read VAR SD <<< "$(awk '/User   \(Intercept\)/{print $3, $4}' "$tbl")"

# Write header, diagnostics, and random effects to repro.txt
cat > /workspace/repro.txt <<EOT
**Table 4: RQ1: Mixed-effect logistic regression relating the use of comprehensions with the correctness of the change task**

|                  |        |
| ---------------- | ------ |
| **AIC**          | $AIC |
| **BIC**          | $BIC |
| **logLik**       | $LOGLIK |
| **deviance**     | $DEV |
| **df.residuals** | $DFRES |

**Scaled residuals:** Min $RMIN, 1Q $RQ, Median $RMED, 3Q $R3Q, Max $RMAX

**Random effects (Groups)** — User (Intercept): Variance $VAR, Std.Dev. $SD; Number of obs: $NOBS, groups: User, $NGROUPS

**Fixed effects**

| Term | OR | Estimate | Std.Error | z value | Pr(>\|z\|) |
|---|---:|---:|---:|---:|---:|
EOT

# Append fixed-effects rows with computed ORs and mapped term names, rounded to three decimals
awk '
  /Fixed effects:/ {reading=1; getline; getline; next}
  reading && /^---/ {next}
  reading && /^Signif\./ {reading=0; next}
  reading {
    term=$1; est=$2; se=$3; z=$4; p=$5;
    OR=exp(est);
    label=term;
    if (term=="MainFactorp") label="MainFactorProc";
    else if (term=="Complexity") label="Compl.";
    else if (term=="UsageFrequency") label="Usage Freq.";
    else if (term=="StudentTRUE") label="StudentTrue";
    else if (term=="MainFactorp:Complexity") label="MainFactorProc:Compl.";
    printf("| %s | %.3f | %.3f | %.3f | %.3f | %.3f |\n", label, OR, est, se, z, p);
  }' "$tbl" >> /workspace/repro.txt

echo '</artisan_submit>'
</output>
