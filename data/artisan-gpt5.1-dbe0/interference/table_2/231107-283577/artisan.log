#!/bin/bash
if [ $# -lt 1 ]; then
        echo 'no project name given, usage: runBenchmarkForProject.sh <project name>'
        exit 1
fi

project=$(echo "${1}" | sed 's/\//_/g')

function scinot() {
  local x=$1
  echo $(python3 -c "print('{:2e}'.format($1))")
}

function fac() {
  local x=$1
  echo $(python3 -c "import math; print(math.factorial($x))")
}

function add() {
  local x=$1
  local y=$2
  echo $(python3 -c "import math; print($y+$x)")
}

function get_victims() {
  echo "$(cat $1 | awk -F ',' '{ print $2 }' | sort | uniq)"
}

function get_polluters_for_victim() {
  cat $1 | sort | uniq | grep ",$2" | wc -l
}

total_polluters=0
total_tests=$(cat ~/paper_autoflakies/data/permutation_data.csv | grep $project | awk -F ',' '{ print $3 }')
TSP_max=$(fac $total_tests)

total_polluters=0
victims=$(get_victims "results_export/$project/$project-permutations-final.csv" | sed "/^$/d" | sed "/^,$/d")
no_victims=$(echo -n "$victims" | wc -l)
polluters=0
for victim in $victims
do
  if [[ -z $victim ]]; then
        continue;
  fi
  temp_polluter=$(get_polluters_for_victim "results_export/$project/$project-permutations-final.csv" "$victim")
  i="$polluters"
  j="$total_polluters"
  total_polluters="$(add $j $temp_polluter)"
  polluters="$(add $i $(fac $temp_polluter))"
done

fd_permutation_polluters=$polluters
fd_victims=$no_victims
if [[ $fd_victims -eq 0 ]]; then
  fd_polluters=0
else
  fd_polluters=$(($total_polluters/$no_victims))
fi

total_polluters=0
victims=$(get_victims "results_export/$project/$project-permutations-final-fdf.csv" | sed "/^$/d" | sed "/^,$/d")
no_victims=$(echo -n "$victims" | wc -l)
polluters=0
for victim in $victims
do
  if [[ -z $victim ]]; then
	continue;
  fi
  temp_polluter=$(get_polluters_for_victim "results_export/$project/$project-permutations-final-fdf.csv" "$victim")
  i="$polluters"
  j="$total_polluters"
  total_polluters="$(add $j $temp_polluter)"
  polluters="$(add $i $(fac $temp_polluter))"
done

fdf_permutation_polluters=$polluters
fdf_victims=$no_victims
if [[ $fdf_victims -eq 0 ]]; then
  fdf_polluters=0
else
  fdf_polluters=$(($total_polluters/$no_victims))
fi

total_polluters=0
victims=$(get_victims "results_export/$project/$project-permutations-final-ofs.csv" | sed "/^$/d" | sed "/^,$/d")
no_victims=$(echo -n "$victims" | wc -l)
polluters=0
for victim in $victims
do
  if [[ -z $victim ]]; then
        continue;
  fi
  temp_polluter=$(get_polluters_for_victim "results_export/$project/$project-permutations-final-ofs.csv" "$victim")
  i="$polluters"
  j="$total_polluters"
  total_polluters="$(add $j $temp_polluter)"
  polluters="$(add $i $(fac $temp_polluter))"
done

ofs_permutation_polluters=$polluters
ofs_victims=$no_victims
if [[ $ofs_victims -eq 0 ]]; then
  ofs_polluters=0
else
  ofs_polluters=$(($total_polluters/$no_victims))
fi

total_polluters=0
victims=$(get_victims "results_export/$project/$project-permutations-final-ofs-fdf.csv" | sed "/^$/d" | sed "/^,$/d")
no_victims=$(echo -n "$victims" | wc -l)
polluters=0
for victim in $victims
do
  if [[ -z $victim ]]; then
        continue;
  fi
  temp_polluter=$(get_polluters_for_victim "results_export/$project/$project-permutations-final-ofs-fdf.csv" "$victim")
  i="$polluters"
  j="$total_polluters"
</output>
