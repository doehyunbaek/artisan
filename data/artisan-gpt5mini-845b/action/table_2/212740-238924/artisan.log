    joined="\\n".join(b)
    if "VM time" in joined or "| Task" in joined or "Resource usage by task" in joined:
        chosen=b
        break
if chosen is None and blocks:
    # pick longest block
    chosen=max(blocks,key=lambda b:len(b))
if chosen:
    open(outpath,"w").write("\\n".join(chosen)+"\\n")
else:
    open(outpath,"w").write("")
