                values[method].append(None)
# Compute statistics
def compute_stats(vals):
    valid = [v for v in vals if v is not None]
    if not valid:
        return 0.0, 0, 0
    avg = sum(valid) / len(valid)
    perfect = sum(1 for v in valid if v == 1.0)
