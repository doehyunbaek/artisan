<mini_swe_agent_bash>
python3 - <<'PY'
import json,os,re
from collections import defaultdict

p='/workspace/artifact/gdrosos-bloat-study-artifact-0fe2fe5/data/results/qualitative_results.json'
if not os.path.exists(p):
    print("Missing qualitative_results.json at",p); raise SystemExit(1)
data=json.load(open(p,encoding='utf-8'))

def norm_status(s):
    if not s: return 'Pending'
    s=str(s).strip().lower()
    if 'merge' in s or s=='merged': return 'Merged'
    if 'approve' in s or 'accepted' in s: return 'Approved'
    if 'reject' in s or 'denied' in s or 'deny' in s: return 'Rejected'
    if 'pending' in s or s in ('open','in review','under review'): return 'Pending'
    if s=='closed':
        return 'Rejected'
    return 'Pending'

pr_map = {}
for project, deps in data.items():
    if not isinstance(deps, dict): continue
    for dep_name, info in deps.items():
        if not isinstance(info, dict): continue
        pr_url = info.get('PR URL') or info.get('PR_URL') or info.get('PRUrl') or info.get('PRUrl') or info.get('PR') or info.get('PR link')
        status = info.get('PR Status') or info.get('PR_Status') or info.get('Status') or info.get('Discussion Status') or info.get('PRStatus')
        key = pr_url if pr_url else f"{project}::{dep_name}"
        if key not in pr_map:
            pr_map[key] = {'status': status or '', 'count': 0}
        pr_map[key]['count'] += 1

agg_prs = defaultdict(int)
agg_bd = defaultdict(int)
for key, v in pr_map.items():
    s = norm_status(v.get('status',''))
    agg_prs[s] += 1
    agg_bd[s] += v.get('count',0)

for k in ('Merged','Approved','Rejected','Pending'):
    agg_prs.setdefault(k,0)
    agg_bd.setdefault(k,0)

total_prs = sum(agg_prs.values())
total_bd = sum(agg_bd.values())

out = f"""**Table 3: The status of our pull requests, proposing the removal of bloated dependencies (BD)**

| PR status | # of PRs | # of BD removed |
| --------- | -------: | --------------: |
| Merged    |       {agg_prs['Merged']} |              {agg_bd['Merged']} |
| Approved  |        {agg_prs['Approved']} |               {agg_bd['Approved']} |
| Rejected  |        {agg_prs['Rejected']} |               {agg_bd['Rejected']} |
| Pending   |        {agg_prs['Pending']} |               {agg_bd['Pending']} |
| **Total** |   **{total_prs}** |          **{total_bd}** |
"""
open('/workspace/repro.txt','w',encoding='utf-8').write(out)
print(out)
PY
