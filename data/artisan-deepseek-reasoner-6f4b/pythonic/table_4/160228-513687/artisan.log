    z = c['z value']
    p = c['Pr(>|z|)']
    # Format estimates: for negative values, ensure minus sign is present
    est_str = fmt2(est)
    se_str = fmt2(se)
    z_str = fmt2(z)
    p_str = fmt_pval(p)
    output.append(f"| {term} | {fmt2(or_val)} | {est_str} | {se_str} | {z_str} | {p_str} |")

