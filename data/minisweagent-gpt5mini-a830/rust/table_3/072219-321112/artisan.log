<mini_swe_agent_bash>
python3 - <<'PY'
import csv, os, sys
base = "/workspace/TSERelease-20220811/TSERelease-20220811/ResearchResults"
files = {
    "Direct Usage": "Result2-1_RUFUsage.csv",
    "Uncond Impact": "Result2-2_1UncondImpact.csv",
    "Cond Impact": "Result2-2_1CondImpact.csv",
    "Total": "Result2-2_1TotalImpact.csv"
}
# normalize status keys
statuses = ["Accepted","Active","Incomplete","Removed","Unknown"]
data = {s:{"Direct Usage":"0","Uncond Impact":"0","Cond Impact":"0","Total":"0"} for s in statuses}

def read_csv(path, col_map_name):
    p = os.path.join(base, path)
    if not os.path.exists(p):
        print(f"Missing file: {p}", file=sys.stderr)
        return
    with open(p, newline='', encoding='utf-8') as f:
        reader = csv.reader(f)
        header = next(reader, None)
        for row in reader:
            if not row: 
                continue
            # Try to find status and numeric value in row
            # Common formats: status,count  OR status,COUNT OR name,status etc.
            # We'll scan for first field that matches known statuses (case insensitive)
            status = None
            val = None
            for i,cell in enumerate(row):
                if cell is None: continue
                c = cell.strip().strip('"').strip("'")
                for s in statuses:
                    if c.lower() == s.lower():
                        status = s
                        # look for a numeric field in remaining columns
                        for j in range(i+1, len(row)):
                            cj = row[j].strip().strip('"').strip("'")
                            try:
                                val = int(cj.replace(',',''))
                                break
                            except:
                                try:
                                    val = int(float(cj))
                                    break
                                except:
                                    val = None
                        break
                if status:
                    break
            # fallback: sometimes header is status,count and rows are like "accepted,24681"
            if status is None:
                # assume first col is status and second is value
                try:
                    s0 = row[0].strip().strip('"').strip("'")
                    for s in statuses:
                        if s0.lower() == s.lower():
                            status = s
                            break
                except:
                    status = None
                if status and len(row) > 1:
                    try:
                        val = int(row[1].strip().strip('"').strip("'").replace(',',''))
                    except:
                        try:
                            val = int(float(row[1].strip().strip('"').strip("'")))
                        except:
                            val = None
            if status and val is not None:
                data[status][col_map_name] = str(val)

for colname, fname in files.items():
    read_csv(fname, colname)

# write repro output
out_path = "/workspace/repro.txt"
with open(out_path, "w", encoding="utf-8") as out:
    out.write("Table 3: Summary of RUF impacts (reproduced)\n\n")
    out.write("| RUF Type   | Direct Usage | Uncond Impact |  Cond Impact |        Total |\n")
    out.write("| ---------- | -----------: | ------------: | -----------: | -----------: |\n")
    for s in statuses:
        du = int(data[s]["Direct Usage"])
        ui = int(data[s]["Uncond Impact"])
        ci = int(data[s]["Cond Impact"])
        tot = int(data[s]["Total"])
        out.write(f"| {s:9} | {du:11,} | {ui:12,} | {ci:11,} | {tot:11,} |\n")
print(f"Wrote reproduction output to {out_path}")
PY
</mini_swe_agent_bash>
