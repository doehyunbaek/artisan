import pandas as pd
import numpy as np

# Load the data
file_path = '/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv'
data = pd.read_csv(file_path)

# Calculate statistics
results = data.groupby(['Section', 'Construct']).agg(
    Correct=('Outcome', lambda x: (x == True).sum()),
    Wrong=('Outcome', lambda x: (x == False).sum()),
    Total=('Outcome', 'size')
)
results['% Correct'] = (results['Correct'] / results['Total']) * 100

# Prepare the final table
final_table = results.reset_index()[['Construct', 'Correct', 'Wrong', '% Correct']]
final_table

