library(lmtest)
library(lme4)
library(lmerTest)
library(MuMIn)
library(lattice)
library(car)
library(gridExtra)
library(plyr)
library(rsq)
library(parameters)
library(tidyverse)
library(dplyr)
library(tidyr)
library(reshape2)

# Read the data
df <- read.csv("/home/jovyan/work/study_data.csv")

# Function to format coefficients with stars
format_coef <- function(estimate, std_error, p_value) {
  stars <- ifelse(p_value < 0.01, "***", ifelse(p_value < 0.05, "**", ifelse(p_value < 0.1, "*", "")))
  return(paste0(sprintf("%.2f", estimate), stars, " (", sprintf("%.2f", std_error), ")"))
}

# Function to extract model results
extract_results <- function(model, model_type = "lm") {
  # Extract coefficients
  coef_summary <- coef(summary(model))
  
  # For GLM quasipoisson, the summary returns a different structure
  if (model_type == "glm") {
    estimates <- coef_summary[, "Estimate"]
    std_errors <- coef_summary[, "Std. Error"]
    p_values <- coef_summary[, "Pr(>|t|)"]
  } else {
    estimates <- coef_summary[, "Estimate"]
    std_errors <- coef_summary[, "Std. Error"]
    p_values <- coef_summary[, "Pr(>|t|)"]
  }
  
  # Get R-squared
  if (model_type == "lm") {
    rsq_val <- summary(model)$r.squared
    adj_rsq_val <- summary(model)$adj.r.squared
  } else if (model_type == "glm") {
    rsq_val <- rsq(model)
    adj_rsq_val <- rsq(model, adj = TRUE)
  } else {
    rsq_val <- NA
    adj_rsq_val <- NA
  }
  
  return(list(
    coefficients = data.frame(
      term = rownames(coef_summary),
      estimate = estimates,
      std_error = std_errors,
      p_value = p_values,
      stringsAsFactors = FALSE
    ),
    rsq = rsq_val,
    adj_rsq = adj_rsq_val
  ))
}

# Initialize results data frame
results <- list()

# Model 1: Time (s) - linear model
Q <- quantile(df$success_time_no_guess, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$success_time_no_guess >= Q[1] & df$success_time_no_guess <= Q[2])
time_model <- lm(success_time_no_guess ~ tool + experience + recruiting.years + AI_experience, data = eliminated)
results$time <- extract_results(time_model, "lm")

# Model 2: Understanding - quasipoisson GLM
Q <- quantile(df$understanding, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$understanding >= Q[1] & df$understanding <= Q[2])
understanding_model <- glm(understanding ~ tool + experience + recruiting.years + AI_experience, 
                          data = eliminated, family = quasipoisson)
results$understanding <- extract_results(understanding_model, "glm")

# Model 3: Progress (overall) - quasipoisson GLM
Q <- quantile(df$progress_no_guess, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$progress_no_guess >= Q[1] & df$progress_no_guess <= Q[2])
progress_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience, 
                     data = eliminated, family = quasipoisson)
results$progress <- extract_results(progress_model, "glm")

# Model 4: Progress (Pros only) - quasipoisson GLM
progress_pro_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience, 
                         data = eliminated[eliminated$is_professional == 1,], family = quasipoisson)
results$progress_pro <- extract_results(progress_pro_model, "glm")

# Model 5: Progress (Students only) - quasipoisson GLM
progress_student_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience, 
                             data = eliminated[eliminated$is_professional == 0,], family = quasipoisson)
results$progress_student <- extract_results(progress_student_model, "glm")

# Create table
terms_of_interest <- c("(Intercept)", "recruiting.years", "experience", "AI_experience", "tool")
term_labels <- c("Constant", "Domain experience", "Program. experience", "AI tool familiarity", "Uses GILT")

# Initialize output matrix
output <- matrix("", nrow = length(terms_of_interest) + 2, ncol = 5)
colnames(output) <- c("Progress (1)", "Time (s) (2)", "Underst. (3)", "Progress (Pros)", "Progress (Students)")
rownames(output) <- c(term_labels, "R²", "Adj. R²")

# Fill in coefficients
for (i in 1:length(terms_of_interest)) {
  term <- terms_of_interest[i]
  for (j in 1:5) {
    model_name <- c("progress", "time", "understanding", "progress_pro", "progress_student")[j]
    model_results <- results[[model_name]]
    
    # Find the coefficient for this term
    coef_row <- model_results$coefficients[model_results$coefficients$term == term, ]
    if (nrow(coef_row) > 0) {
      output[i, j] <- format_coef(coef_row$estimate, coef_row$std_error, coef_row$p_value)
    } else {
      output[i, j] <- "N/A"
    }
  }
}

# Fill in R-squared values
for (j in 1:5) {
  model_name <- c("progress", "time", "understanding", "progress_pro", "progress_student")[j]
  model_results <- results[[model_name]]
  output[length(terms_of_interest) + 1, j] <- sprintf("%.3f", model_results$rsq)
  output[length(terms_of_interest) + 2, j] <- sprintf("%.3f", model_results$adj_rsq)
}

# Print table
cat("Table 1: Summaries of regressions estimating the effect of using the prototype.\n")
cat("Each column summarizes the model for a different outcome variable.\n")
cat("We report the coefficient estimates with the standard errors in parentheses.\n\n")

# Print the table in markdown format
cat("|                     |   Progress (1) |    Time (s) (2) |   Underst. (3) | Progress (Pros) | Progress (Students) |\n")
cat("| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |\n")

for (i in 1:nrow(output)) {
  row_name <- rownames(output)[i]
  if (row_name == "Constant") {
    cat(sprintf("| %-20s | %14s | %15s | %14s | %15s | %19s |\n", 
                row_name, output[i,1], output[i,2], output[i,3], output[i,4], output[i,5]))
  } else {
    cat(sprintf("| %-20s | %14s | %15s | %14s | %15s | %19s |\n", 
                row_name, output[i,1], output[i,2], output[i,3], output[i,4], output[i,5]))
  }
}

cat("\nNote: * p < 0.1; ** p < 0.05; *** p < 0.01.\n")

# Also write to file for later use
write.csv(output, "/tmp/table1_results.csv", row.names = TRUE)
cat("\nResults also saved to /tmp/table1_results.csv\n")
EOF'
</mini_swe_agent_bash>
