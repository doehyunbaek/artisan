from pathlib import Path

import pandas as pd
from runs_collector.dataset import RunsDataSet
from runs_analysis.resource_usage import get_tiers
from runs_analysis.name_based_analysis import simplify_and_map

# Load dataset
data_set = RunsDataSet(".")

# Obtain repository lists for paid vs free tiers
tiers = get_tiers(data_set)
if not isinstance(tiers, (list, tuple)) or len(tiers) < 2:
    raise RuntimeError("get_tiers did not return the expected (paid, free) repo lists")
repos_list_1, repos_list_2 = tiers[0], tiers[1]

tasks = ["test", "build", "release", "analyze", "lint",
         "linux", "update", "integration", "deploy", "sync"]

def compute_task_stats(repos_list):
    jobs = simplify_and_map(data_set, repos_list).copy()
    # Convert execution time from seconds to minutes
    jobs["up_time_min"] = jobs["up_time"] / 60.0
    # Focus on the standardized task names
    jobs = jobs[jobs["sub_names"].isin(tasks)].copy()

    # Total VM time (seconds) across all selected tasks
    total_time = sum(jobs[jobs["sub_names"] == t]["up_time"].sum() for t in tasks)
    total_runs = len(jobs)

    stats = {}
    for t in tasks:
        subset = jobs[jobs["sub_names"] == t]
        if subset.empty:
            # Should not happen for these tasks, but guard just in case
            stats[t] = {
                "vm_pct": 0.0,
                "runs_pct": 0.0,
                "time_mean": 0.0,
                "time_iqr": 0.0,
            }
            continue

        time_sum = float(subset["up_time"].sum())
        vm_pct = (time_sum / total_time * 100.0) if total_time > 0 else 0.0

        run_count = len(subset)
        runs_pct = (run_count / total_runs * 100.0) if total_runs > 0 else 0.0

        # Average VM time per run in minutes
        time_mean = float(subset["up_time_min"].mean())
        # IQR in minutes
        q75 = float(subset["up_time_min"].quantile(0.75))
        q25 = float(subset["up_time_min"].quantile(0.25))
        time_iqr = q75 - q25

        stats[t] = {
            "vm_pct": vm_pct,
            "runs_pct": runs_pct,
            "time_mean": time_mean,
            "time_iqr": time_iqr,
        }
    return stats

paid_stats = compute_task_stats(repos_list_1)
free_stats = compute_task_stats(repos_list_2)

def calc_cost_per_run_minutes(time_minutes: float) -> float:
    # Same formula as in the notebook's calc_costs_by_task:
    # os_factor = 1.52; cost_per_minute = 0.008
    os_factor = 1.52
    return round(time_minutes * os_factor * 0.008, 2)

rows = []
for t in tasks:
    p = paid_stats[t]
    f = free_stats[t]
    vm_paid = f"{p['vm_pct']:.1f}"
    vm_free = f"{f['vm_pct']:.1f}"
    runs_paid = f"{p['runs_pct']:.1f}"
    runs_free = f"{f['runs_pct']:.1f}"
    time_paid = f"{p['time_mean']:.1f}"
    iqr_paid = f"{p['time_iqr']:.1f}"
    time_free = f"{f['time_mean']:.1f}"
    iqr_free = f"{f['time_iqr']:.1f}"
    cost_paid = f"{calc_cost_per_run_minutes(p['time_mean']):.2f}"
    cost_free = f"{calc_cost_per_run_minutes(f['time_mean']):.2f}"
    rows.append({
        "task": t.capitalize(),
        "vm_paid": vm_paid,
        "vm_free": vm_free,
        "runs_paid": runs_paid,
        "runs_free": runs_free,
        "time_paid": time_paid,
        "iqr_paid": iqr_paid,
        "time_free": time_free,
        "iqr_free": iqr_free,
        "cost_paid": cost_paid,
        "cost_free": cost_free,
