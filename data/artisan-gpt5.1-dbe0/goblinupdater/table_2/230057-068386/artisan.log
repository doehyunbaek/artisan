import pandas as pd

path = "ASE24_data_and_tools/ASE24_data_and_tools/results_data/execution/conf_1_global/executionsData.csv"
df = pd.read_csv(path)

mapping = {
    "(p)’s direct dependencies": "directDepNumber",
    "releases ((N_R))": "releaseSize",
    "libraries ((N_L))": "artifactSize",
    "dependency edges ((E_D))": "dependencySize",
    "versions edges ((E_V))": "versionSize",
}

print("**Table 2: Demographics of our dataset of 107 Java projects**\n")
print("|                           |    Q1 |  Q2 |   Q3 | min |     max |")
print("| ------------------------- | ----: | --: | ---: | --: | ------: |")

for label, col in mapping.items():
    s = df[col]
    q1 = s.quantile(0.25)
    q2 = s.quantile(0.5)
    q3 = s.quantile(0.75)
    mn = s.min()
    mx = s.max()

    def fmt(value, decimals=1, thousands=False):
        if thousands:
            return f"{value:,.0f}"
        if float(value).is_integer():
            return f"{int(value)}"
        return f"{value:.{decimals}f}"

    if col == "directDepNumber":
        q1_f, q2_f, q3_f = fmt(q1, 1), fmt(q2), fmt(q3)
        mn_f, mx_f = fmt(mn), fmt(mx)
    elif col == "artifactSize":
        q1_f, q2_f, q3_f = fmt(q1, 1), fmt(q2), fmt(q3)
        mn_f, mx_f = fmt(mn), fmt(mx)
    else:
        q1_f, q2_f, q3_f = fmt(q1, 0, True), fmt(q2, 0, True), fmt(q3, 0, True)
        mn_f, mx_f = fmt(mn, 0, True), fmt(mx, 0, True)

    print(f"| {label:<25} | {q1_f:>4} | {q2_f:>3} | {q3_f:>3} | {mn_f:>3} | {mx_f:>6} |")
