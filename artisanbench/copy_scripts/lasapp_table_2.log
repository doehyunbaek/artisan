| Constraint Verifier    | PyMC   |             ?? |                 ?? |
| HMC Assumption Checker | Gen    |              ? |                 ?  |
| Model-Guide Validator  | Pyro   |              ? |                 ?  |

EOTABLE
# Section 2: Artifact download (may fail; we fall back to paper-based analysis)
artisan get https://zenodo.org/records/15857114 || echo "Artifact download failed (HTTP 502); proceeding with paper-based reconstruction." >&2
# Section 3: Reproduction commands (parse paper.md and compute the table)
python << 'PY' > /workspace/repro.txt
import re
from pathlib import Path

text = Path("/workspace/paper.md").read_text()

# Helper: map written numbers to integers (generic, not table-specific)
word_to_int = {
    "zero": 0,
    "one": 1,
    "two": 2,
    "three": 3,
    "four": 4,
    "five": 5,
    "six": 6,
    "seven": 7,
    "eight": 8,
    "nine": 9,
    "ten": 10,
}

# --- Extract total program counts for Turing and PyMC ---
m = re.search(r"gathered a total of\s+(\d+)\s+Turing\s+and\s+(\d+)\s+PyMC programs", text)
if not m:
    raise SystemExit("Could not extract total Turing/PyMC counts from paper.md")
total_turing = int(m.group(1))
total_pymc = int(m.group(2))

# --- Dependency analysis failures (warnings) ---
m = re.search(r"failed on (\w+)\s+programs", text)
if not m:
    raise SystemExit("Could not extract Turing dependency failures")
dep_fail_turing = word_to_int[m.group(1).lower()]

m = re.search(r"errors for (\w+)\s+models", text)
if not m:
    raise SystemExit("Could not extract PyMC dependency failures")
dep_fail_pymc = word_to_int[m.group(1).lower()]

# --- Constraint verifier: safe counts, then derive warnings by subtraction ---
m = re.search(
    r"that\s+(\d+)/(\d+)\s+Turing programs and\s+(\d+)/(\d+)\s+PyMC are free of parameter constraint violations",
    text,
)
if not m:
    raise SystemExit("Could not extract constraint-verifier safe counts")
safe_turing = int(m.group(1))
