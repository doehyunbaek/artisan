cat("| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |\n")
cat("| Constant            | ", const_prog,      " | ", const_time,      " | ", const_under,     " | ", const_prog_prof, " | ", const_prog_stud, " |\n", sep = "")
