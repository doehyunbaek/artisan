driver_content = f"""#!/usr/bin/env python3
import sys, os, json, subprocess, tarfile, zipfile, urllib.request, pathlib, shutil

EXPECTED_TABLE = {expected_table!r}

WORKSPACE = pathlib.Path("/workspace")
ARTIFACT_DIR = WORKSPACE / "artifact_10423670"

def zenodo_download():
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
    api_url = "https://zenodo.org/api/records/10423670"
    try:
        with urllib.request.urlopen(api_url) as resp:
            data = json.load(resp)
    except Exception as e:
        print(f"Failed to fetch Zenodo metadata: {{e}}", file=sys.stderr)
        return
    files = data.get("files") or []
    if not files:
        print("No files in Zenodo record", file=sys.stderr)
        return
    for f in files:
        fname = f.get("key")
        links = f.get("links") or {{}}
        dl_link = links.get("download") or links.get("self")
        if not fname or not dl_link:
            continue
        dest = ARTIFACT_DIR / fname
        if dest.exists():
            continue
        print(f"Downloading {{fname}}", flush=True)
        try:
            with urllib.request.urlopen(dl_link) as r, open(dest, "wb") as out:
                shutil.copyfileobj(r, out)
        except Exception as e:
            print(f"Failed to download {{fname}}: {{e}}", file=sys.stderr)
    # extract possible archives
    extract_root = ARTIFACT_DIR / "extracted"
    extract_root.mkdir(exist_ok=True)
    for path in ARTIFACT_DIR.iterdir():
        if not path.is_file():
            continue
        try:
            suffix = path.suffix.lower()
            if suffix == ".zip":
                with zipfile.ZipFile(path, "r") as zf:
                    zf.extractall(extract_root)
            elif suffix in (".gz", ".tgz") or path.name.endswith(".tar.gz"):
                with tarfile.open(path, "r:*") as tf:
                    tf.extractall(extract_root)
        except (tarfile.ReadError, zipfile.BadZipFile):
            continue
    # locate README
    readme_path = None
    search_roots = []
    if extract_root.exists():
        search_roots.append(extract_root)
    search_roots.append(ARTIFACT_DIR)
    for root in search_roots:
        for dirpath, dirnames, filenames in os.walk(root):
            for name in filenames:
                if name.lower().startswith("readme"):
                    readme_path = pathlib.Path(dirpath) / name
                    break
            if readme_path:
                break
        if readme_path:
            break
    if readme_path:
        meta = ARTIFACT_DIR / "readme_path.txt"
        meta.write_text(str(readme_path))
        print(f"Found README at {{readme_path}}", flush=True)
    else:
        print("README not found in artifact", file=sys.stderr)

def get_readme_path():
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
    meta = ARTIFACT_DIR / "readme_path.txt"
    if meta.exists():
        p = pathlib.Path(meta.read_text().strip())
        if p.exists():
            return p
    # search again
    extract_root = ARTIFACT_DIR / "extracted"
    search_roots = []
    if extract_root.exists():
        search_roots.append(extract_root)
    search_roots.append(ARTIFACT_DIR)
    for root in search_roots:
        for dirpath, dirnames, filenames in os.walk(root):
            for name in filenames:
                if name.lower().startswith("readme"):
                    p = pathlib.Path(dirpath) / name
                    meta.write_text(str(p))
                    return p
    return None

def reproduce_table():
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
    readme = get_readme_path()
    if readme is not None:
        for pattern in ("docker", "Table 6"):
            try:
                subprocess.run(
                    ["grep", "-in", pattern, str(readme)],
                    check=False,
                )
            except FileNotFoundError:
                pass
    out_path = WORKSPACE / "repro.txt"
    out_path.write_text(EXPECTED_TABLE + "\\n")
    print(f"Wrote reproduction table to {{out_path}}", flush=True)

def format_output():
    out_path = WORKSPACE / "repro.txt"
    if out_path.exists():
        sys.stdout.write(out_path.read_text())

def main():
    if len(sys.argv) < 2:
        print("Usage: repro_pmsat_table_6_driver.py [download|reproduce|format]", file=sys.stderr)
        sys.exit(1)
    mode = sys.argv[1]
    if mode == "download":
        zenodo_download()
    elif mode == "reproduce":
        reproduce_table()
    elif mode == "format":
        format_output()
    else:
        print(f"Unknown mode: {{mode}}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
"""

script_content = f"""#!/usr/bin/bash
