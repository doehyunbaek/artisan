from runs_collector.dataset import RunsDataSet
from runs_analysis.resource_usage import (
    triggering_events_proportion,
    triggering_events_time_proportion,
    get_avg_runtime_by_event,
    get_avg_runtime_rest,
    get_tiers,
    calc_costs_by_event,
)

# Load dataset from checkpoint CSVs at root (all_*.csv already present)
data_set = RunsDataSet(
    repositories_list=[],
    tables_dir="",
    from_checkpoint=True,
    checkpoint_dir="/",
)

# Determine paid (list_1) and free (list_2) tiers
paid_repos, free_repos = get_tiers(data_set)

def compute_metrics(repos_list):
    run_prop = triggering_events_proportion(data_set, repos_list)
    time_prop = triggering_events_time_proportion(data_set, repos_list)
    avg_stats = get_avg_runtime_by_event(data_set, repos_list)

    base_events = [
        "pull_request",
        "push",
        "schedule",
        "pull_request_target",
        "workflow_dispatch",
        "workflow_run",
        "release",
    ]

    rest_mean, rest_median, rest_mad, rest_iqr = get_avg_runtime_rest(
        data_set, repos_list, base_events
    )

    rows = {}
    mapping = [
        ("pull_request", "Pull Request"),
        ("push", "Push"),
        ("schedule", "Schedule"),
        ("pull_request_target", "PR target"),
        ("workflow_dispatch", "Dispatch"),
        ("workflow_run", "Workflow run"),
        ("release", "Release"),
    ]

    for ev_key, label in mapping:
        mean, median, mad, iqr = avg_stats.get(ev_key, (0.0, 0.0, 0.0, 0.0))
        vm_pct = time_prop.get(ev_key, 0.0)
        runs_pct = run_prop.get(ev_key, 0.0)
        cost = calc_costs_by_event(mean, ev_key) if mean > 0 else 0.0
        rows[label] = {
            "vm_time_pct": vm_pct,
            "runs_pct": runs_pct,
            "mean": mean,
            "iqr": iqr,
            "cost": cost,
        }

    vm_others = 100.0 - sum(r["vm_time_pct"] for r in rows.values())
    runs_others = 100.0 - sum(r["runs_pct"] for r in rows.values())
    cost_others = calc_costs_by_event(rest_mean, "others") if rest_mean > 0 else 0.0
    rows["Others"] = {
        "vm_time_pct": vm_others,
        "runs_pct": runs_others,
        "mean": rest_mean,
        "iqr": rest_iqr,
        "cost": cost_others,
    }
    return rows

paid_rows = compute_metrics(paid_repos)
free_rows = compute_metrics(free_repos)

events_order = [
    "Pull Request",
    "Push",
    "Schedule",
    "PR target",
    "Dispatch",
    "Workflow run",
    "Release",
    "Others",
]

def fmt(v, digits=1):
    return f"{v:.{digits}f}"

out_path = "/tmp/repro_table1.txt"
with open(out_path, "w") as f:
    f.write("**Table 1: Summary of resource usage by triggering event.**\n\n")
    f.write("| Event        | VM time % (Paid) | VM time % (Free) | Runs % (Paid) | Runs % (Free) | VM time per run, min (Paid) | VM time per run, min (Free) | VM cost per run, $ (Paid) | VM cost per run, $ (Free) |\n")
    f.write("| ------------ | ---------------: | ---------------: | ------------: | ------------: | --------------------------: | --------------------------: | ------------------------: | ------------------------: |\n")
    for ev in events_order:
        pr = paid_rows[ev]
        fr = free_rows[ev]
        paid_time = fmt(pr["vm_time_pct"])
        free_time = fmt(fr["vm_time_pct"])
        paid_runs = fmt(pr["runs_pct"])
        free_runs = fmt(fr["runs_pct"])
        paid_vm = f"{fmt(pr['mean'])} ({fmt(pr['iqr'])})"
        free_vm = f"{fmt(fr['mean'])} ({fmt(fr['iqr'])})"
        paid_cost = f"{pr['cost']:.2f}"
        free_cost = f"{fr['cost']:.2f}"
        f.write(
            f"| {ev} | {paid_time} | {free_time} | {paid_runs} | {free_runs} | {paid_vm} | {free_vm} | {paid_cost} | {free_cost} |\n"
        )
    f.write("\n* mean (inter-quartile range)\n")
PYCODE
# Copy Python script into container and run it from root so checkpoint_dir='/' is correct
docker cp /tmp/table1_extract.py github-study:/tmp/table1_extract.py || exit 1
docker exec github-study /bin/bash --noprofile --norc -c "cd / && python /tmp/table1_extract.py" || exit 1
# Copy resulting table back to host as /workspace/repro.txt
docker cp github-study:/tmp/repro_table1.txt /workspace/repro.txt || exit 1
# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_action_table_1.sh
artisan submit /workspace/repro_action_table_1.sh
