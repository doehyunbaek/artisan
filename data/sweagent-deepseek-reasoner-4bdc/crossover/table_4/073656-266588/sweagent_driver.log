import csv
import datetime

# Load detections
detections = []
with open('/workspace/artifact/zeugma-main/data/detections.csv') as f:
    reader = csv.DictReader(f)
    for row in reader:
        detections.append(row)

print('Total detections:', len(detections))
print('Unique fuzzers:', set(d['fuzzer'] for d in detections))
print('Unique subjects:', set(d['subject'] for d in detections))
print('Unique defects:', set(d['defect'] for d in detections))

# Count detection times
defects_per_fuzzer = {}
for d in detections:
    key = (d['fuzzer'], d['defect'])
    if key not in defects_per_fuzzer:
        defects_per_fuzzer[key] = []
    if d['time']:
        # parse time
        # format: 0 days 00:42:48.816000
        if 'days' in d['time']:
            days, rest = d['time'].split(' days ')
            hms = rest.split(':')
        else:
            days = '0'
            hms = d['time'].split(':')
        days = int(days)
        hours = int(hms[0])
        minutes = int(hms[1])
        seconds = float(hms[2])
        total_seconds = days*24*3600 + hours*3600 + minutes*60 + seconds
        defects_per_fuzzer[key].append(total_seconds)
    else:
        defects_per_fuzzer[key].append(None)

# Print summary
for (fuzzer, defect), times in defects_per_fuzzer.items():
    detected = sum(1 for t in times if t is not None)
    total = len(times)
    print(f'{fuzzer} {defect}: {detected}/{total}')
"
