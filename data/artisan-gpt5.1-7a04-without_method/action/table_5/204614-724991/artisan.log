years2 = total_start_ts2 / (12 * 30 * 24 * 3600)
delta_cost2 = calculate_costs(all_jobs[all_jobs.id.isin(inlined_ids2)].up_time.sum() / 60 / years2)

optimizations['failed_jobs'] = {
    'paid': {
