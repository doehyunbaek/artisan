/Unknown[[:space:]]*\([0-9,]+/ { if(match($0,/Unknown[[:space:]]*\(([0-9,]+)\)/,a)) ruf["Unknown"]=a[1] }
# capture Table 3 direct-usage first numeric field after status name lines like: "Accepted 24,681 17,085 21,477 38,448 (6%)"
$1=="Accepted" && $2 ~ /[0-9,]/ {du["Accepted"]=$2; gsub(/,/,"",du["Accepted"])}
$1=="Active" && $2 ~ /[0-9,]/ {du["Active"]=$2; gsub(/,/,"",du["Active"])}
$1=="Incomplete" && $2 ~ /[0-9,]/ {du["Incomplete"]=$2; gsub(/,/,"",du["Incomplete"])}
$1=="Removed" && $2 ~ /[0-9,]/ {du["Removed"]=$2; gsub(/,/,"",du["Removed"])}
$1=="Unknown" && $2 ~ /[0-9,]/ {du["Unknown"]=$2; gsub(/,/,"",du["Unknown"])}
function comm(x,    s, r, i, rem, len) { s = sprintf("%d", x); r=""; while(length(s) > 3){ rem = substr(s, length(s)-2, 3); r = "," rem r; s = substr(s, 1, length(s)-3) } return s r }
END{
  # fallback defaults if something missing
  order[1]="Accepted";order[2]="Active";order[3]="Incomplete";order[4]="Removed";order[5]="Unknown";
  for(i=1;i<=5;i++){ if(!(order[i] in ruf)) ruf[order[i]]="0"; if(!(order[i] in du)) du[order[i]]=0 }
  sum=0; for(i in du) sum+=du[i];
