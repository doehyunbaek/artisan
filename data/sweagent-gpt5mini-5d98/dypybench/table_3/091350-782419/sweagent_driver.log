import json
from prefixspan import PrefixSpan

# replicate the generate_patterns on the precomputed new_all_sequences
# load callgraph_seq files and run generate_filtered_sequences as defined in evaluation/spec_mine.ipynb
import os

def split_by_callers(calls_sequence):
    counter = 1
    caller = calls_sequence[0].split("##")[-1]
    splitted_sequences = []
    s_temp = []
    s_temp.append(calls_sequence[0])
    i = 1
    while True:
        if i == len(calls_sequence):
            splitted_sequences.append(s_temp)
            break
        c = calls_sequence[i]
        if c.startswith("#START#"):
            if counter == 0 and c.split("##")[-1] != caller:
                splitted_sequences.append(s_temp)
                s_temp = [c]
                if i == len(calls_sequence):
                    splitted_sequences.append(s_temp)
                    break
                else:
                    caller = c
            else:
                s_temp.append(c)
            counter += 1
        elif c.startswith("#END#"):
            counter -= 1
            s_temp.append(c)
        i = i + 1
    return splitted_sequences


def generate_filtered_sequences(calls_seq):
    splitted_seqs = split_by_callers(calls_seq)
    final_list = []
    seq_calls = [calls_seq]
    while True:
        temp_seq = []
        for sc in seq_calls:
            temp_seq.extend(split_by_callers(sc))
        final_list.extend(temp_seq)
        seq_calls = []
        for s in temp_seq:
            if len(s) not in [0, 1, 2]:
                seq_calls.append(s[1:-1])

        if len(seq_calls)==0:
            break

    simple_final_list = []
    for l in final_list:
        simple_final_list.append([c.split("##")[0] for c in l])

    filtered_list = []
    for l in simple_final_list:
        new_l = []
        if l[0].startswith("#END#"):
            continue
        if len(l) == 0:
            continue
        c_old = l[0].split("#")[2]
        for c in l[1:]:
            if c.split("#")[2] == c_old:
                new_l.append(c_old)
            c_old = c.split("#")[2]
        filtered_list.append(new_l)

    filtered_list = [f for f in filtered_list if len(f) >= 2]

    return filtered_list

# load callgraph_seq directory
all_sequences = []
traces_dir = '/workspace/DyPyBench/experiments/callgraph_seq/callgraph_seq'
files = sorted(os.listdir(traces_dir))
for file in files:
    path = os.path.join(traces_dir, file)
    print('READING', file)
    with open(path) as f:
        seq_calls = json.load(f)
    fs = generate_filtered_sequences(seq_calls)
    n_a_s = [e for e in fs if e.count('builtins.isinstance')<=5]
    n_a_s = [s for s in n_a_s if len(s)<100]
    all_sequences.extend(n_a_s)

print('TOTAL', len(all_sequences))
ps = PrefixSpan(all_sequences)
all_topk = ps.topk(100)
for a in all_topk[:20]:
    print(a)

