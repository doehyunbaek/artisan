import os, json, csv, re, hashlib
from collections import defaultdict

artifact_root = '/workspace/artifact/gdrosos-bloat-study-artifact-0fe2fe5'
files = [
    os.path.join(artifact_root,'data','results','qualitative_results.json'),
    os.path.join(artifact_root,'data','results','rq2a.csv'),
    os.path.join(artifact_root,'data','results','rq2b.csv'),
    os.path.join(artifact_root,'data','results','rq1a.csv'),
    os.path.join(artifact_root,'data','results','rq1b.csv'),
]

def norm_status(s):
    if s is None: return ''
    s = str(s).strip().lower()
    if not s: return ''
    if 'merge' in s or s=='merged': return 'Merged'
    if 'approve' in s or 'accepted' in s: return 'Approved'
    if 'reject' in s or 'denied' in s or 'deny' in s: return 'Rejected'
    if 'pending' in s or s=='open' or s=='in progress' or s=='in review': return 'Pending'
    if s=='closed':
        # closed but not merged -> Rejected
        return 'Rejected'
    return 'Pending'

def guess_bd_count(v):
    if v is None: return None
    if isinstance(v,int): return v
    if isinstance(v,list): return len(v)
    if isinstance(v,dict): return len(v)
    s = str(v).strip()
    # if comma-separated list
    if ',' in s and not re.search(r'\d+\s*-\s*\d+', s):
        parts = [p.strip() for p in s.split(',') if p.strip()]
        # if parts look like package names, count them
        return len(parts)
    # numeric?
    if re.fullmatch(r'\d+', s): return int(s)
    if re.fullmatch(r'\d+\.\d+', s):
        try: return int(float(s))
        except: return None
    return None

def candidate_keys(d):
    # return potential id-like strings to deduplicate
    keys=[]
    for k in d:
        lk=k.lower()
        if any(x in lk for x in ('pr','pull','url','link','issue','repo','project','id','gh')):
            v=d.get(k)
            if isinstance(v,(str,int)): keys.append(str(v))
    return keys

records = {}

# parse JSON
jf = files[0]
if os.path.exists(jf):
    try:
        j = json.load(open(jf))
    except Exception as e:
        j = None
    def walk(o):
        if isinstance(o,dict):
            # attempt to extract status and bd info
            status=None; bd=None
            for k,v in o.items():
                lk=k.lower()
                if 'status'==lk or lk.endswith('_status') or 'state' in lk:
                    status = v if status is None else status
                if any(x in lk for x in ('bd','bloat','removed','remove','num_removed','num_bloat')):
                    bd = v if bd is None else bd
            # collect id keys
            ids = candidate_keys(o)
            # if there's something meaningful, register
            if status or bd is not None or ids:
                key = None
                if ids:
                    key = ids[0]
                else:
                    # fallback to hash of object
                    h = hashlib.sha1(json.dumps(o, sort_keys=True).encode()).hexdigest()
                    key = 'hash-'+h
                records.setdefault(key, {}).update({'status':status, 'bd':bd, 'raw':o})
            # recurse
            for v in o.values():
                walk(v)
        elif isinstance(o,list):
            for e in o:
                walk(e)
    if j is not None:
        walk(j)

# parse CSVs
for cf in files[1:]:
    if not os.path.exists(cf): continue
    try:
        with open(cf, newline='', encoding='utf-8') as f:
            reader = csv.DictReader(f)
            headers = [h.lower() for h in reader.fieldnames or []]
            # find likely columns
            status_cols=[h for h in headers if 'status' in h or h in ('state','pr_state')]
            bd_cols=[h for h in headers if any(x in h for x in ('bd','bloat','removed','num_removed','num_bloat','removed_bd','removed_dependencies'))]
            id_cols=[h for h in headers if any(x in h for x in ('pr','pull','url','link','id','issue','repo','project'))]
            for row in reader:
                status=None; bd=None; key=None
                for c in status_cols:
                    v=row.get(c)
                    if v and v.strip():
                        status=v; break
                for c in bd_cols:
                    v=row.get(c)
                    if v and v.strip():
                        bd=v; break
                for c in id_cols:
                    v=row.get(c)
                    if v and v.strip():
                        key=v; break
                # if not found, try generic heuristics
                if status is None:
                    for v in row.values():
                        if isinstance(v,str) and v.strip().lower() in ('merged','approved','rejected','pending','open','closed','accepted','denied'):
                            status=v; break
                if bd is None:
                    # try values that look numeric
                    for v in row.values():
                        if isinstance(v,str) and re.fullmatch(r'\d+', v.strip()):
                            # but avoid picking up things like stars, counts unrelated; heuristic: column name contains 'bd' better
                            bd=v; break
                if key is None:
                    # build key from repo/url/title if present
                    parts=[]
                    for c in ('repo','project','package','package_name','name'):
                        if c in headers:
                            v=row.get(c)
                            if v: parts.append(v)
                    if parts:
                        key='|'.join(parts)
                    else:
                        # fallback to hash of row
                        key='hash-'+hashlib.sha1(json.dumps(row, sort_keys=True).encode()).hexdigest()
                # merge into records
                rec = records.setdefault(key, {'raw': row})
                if status and not rec.get('status'):
                    rec['status']=status
                if bd and rec.get('bd') is None:
                    rec['bd']=bd
    except Exception:
        continue

# aggregate
agg_status = defaultdict(int)
agg_bd = defaultdict(int)
for k,v in records.items():
    s = v.get('status')
    b = v.get('bd')
    s_norm = norm_status(s)
    if not s_norm:
        s_norm = 'Pending'
    b_count = guess_bd_count(b)
    if b_count is None:
        # try to infer from raw content: check for fields that look like lists in raw
        raw=v.get('raw')
        if isinstance(raw,dict):
            for val in raw.values():
                if isinstance(val,list):
                    # heuristic: if list contains strings like package names, count
                    if val and all(isinstance(x,str) for x in val):
                        b_count = len(val); break
    if b_count is None:
        # leave as 0 if unknown (paper provides numbers in dataset; if absent here, count as 0)
        b_count = 0
    agg_status[s_norm] += 1
    agg_bd[s_norm] += b_count

# Ensure keys for all status categories
for k in ('Merged','Approved','Rejected','Pending'):
    agg_status.setdefault(k,0)
    agg_bd.setdefault(k,0)

total_prs = sum(agg_status.values())
total_bd = sum(agg_bd.values())

out = f"""**Table 3: The status of our pull requests, proposing the removal of bloated dependencies (BD)**

| PR status | # of PRs | # of BD removed |
| --------- | -------: | --------------: |
| Merged    |       {agg_status['Merged']} |              {agg_bd['Merged']} |
| Approved  |        {agg_status['Approved']} |               {agg_bd['Approved']} |
| Rejected  |        {agg_status['Rejected']} |               {agg_bd['Rejected']} |
| Pending   |        {agg_status['Pending']} |               {agg_bd['Pending']} |
| **Total** |   **{total_prs}** |          **{total_bd}** |
"""
open('/workspace/repro.txt','w', encoding='utf-8').write(out)
print(out)
PY
