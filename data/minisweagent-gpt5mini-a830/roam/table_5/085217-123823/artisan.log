FROM androidsdk/android-30:latest

# Install tools and JDK
RUN apt-get update \
	&& apt-get install -y \
	libgl1-mesa-dev \
	wget \
	unzip \
	openjdk-8-jdk \
	ffmpeg\
	python3-pip\
	git\
	graphviz

# Install conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /anaconda.sh \
	&& bash /anaconda.sh -b -p /opt/conda \
    && rm /anaconda.sh
ENV PATH=$PATH:/opt/conda/bin
RUN conda create -n ReproduceUsingGUIModel python==3.10

# Use conda to build python environment
ADD requirements.txt requirements.txt
RUN conda run --no-capture-output -n ReproduceUsingGUIModel pip install -r requirements.txt
RUN conda run --no-capture-output -n ReproduceUsingGUIModel python -m spacy download en_core_web_lg

ENV PATH /opt/conda/envs/ReproduceUsingGUIModel/bin:$PATH
RUN echo "source activate ReproduceUsingGUIModel" > ~/.bashrc
SHELL ["/bin/bash", "--login", "-c"]

CMD echo "Environment is ready"</output>
