import sys
import pathlib
import pandas as pd

# Make artifact scripts importable
scripts_dir = pathlib.Path('zeugma-main/zeugma-main/scripts').resolve()
sys.path.insert(0, str(scripts_dir))

import report_util  # from artifact
import tables       # from artifact

# Load coverage data with proper timedelta parsing
coverage = report_util.read_timedelta_csv('coverage.csv')

# Exact times for 5 minutes and 3 hours
times = [pd.to_timedelta('0 days 00:05:00'),
         pd.to_timedelta('0 days 03:00:00')]

# Recreate the statistics table exactly as in tables.create_coverage_table,
# but keep a plain DataFrame of medians (no styling).
stat_table = tables.create_stat_table(
    coverage[coverage['time'].isin(times)],
    x='fuzzer',
    baseline_x=tables.BASELINE_FUZZER,
    y='covered_branches',
    columns=['time', 'subject'],
)
stats = tables.pivot(stat_table, 'subject', 'fuzzer', 'stat').reindex(tables.FUZZER_ORDER)

subjects = ['Ant', 'Bcel', 'Closure', 'Maven', 'Nashorn', 'Rhino', 'Tomcat']
time_labels = ['5M', '3H']  # produced by report_util.format_time_delta

# Compute maxima per (subject, time) column for bolding
max_by_col = {}
for subj in subjects:
    for t_lbl in time_labels:
        col = (subj, t_lbl)
        if col in stats.columns:
            col_vals = stats[col]
            max_by_col[col] = col_vals.max() if col_vals.notna().any() else None
        else:
            max_by_col[col] = None

lines = []
lines.append("**Table 3: Branch Coverage. For each fuzzer, we report the median branch coverage in application classes for each subject across 20 fuzzing campaigns after five minutes (5M) and three hours (3H). The largest median or medians (in the case of a tie) for each time and subject is highlighted in blue. Branch coverage values that differ significantly from Zeugma-Link’s are colored red.**")
lines.append("")
# Header row
header_cells = [f"{subj} {lbl}" for subj in subjects for lbl in time_labels]
lines.append("| Fuzzer       | " + " | ".join(header_cells) + " |")
lines.append("| ------------ | " + " | ".join("--------:" for _ in header_cells) + " |")

for fuzzer in tables.FUZZER_ORDER:
    row_cells = []
    for subj in subjects:
        for t_lbl in time_labels:
            col = (subj, t_lbl)
            if col not in stats.columns:
                val = float('nan')
            else:
                val = stats.loc[fuzzer, col]
            if pd.isna(val):
                cell = '—'
            else:
                text = f"{val:.1f}"
                max_val = max_by_col.get(col)
                if max_val is not None and abs(val - max_val) < 1e-9:
                    text = f"**{text}**"
                cell = text
            row_cells.append(cell)
    lines.append(f"| {fuzzer:<12} | " + " | ".join(row_cells) + " |")

print("\n".join(lines))
PY
# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
</mini_swe_agent_bash>
