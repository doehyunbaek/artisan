lambda\', \'Wrong\'], rq1_results.loc[\'comp\', \'Wrong\'], rq1_results.loc[\'mrf\', \'Wrong\']],\\n    \'Procedural Correct\': [rq1paired_results[\'LambdaP_Correct\'].sum(), rq1paired_results[\'CompP_Correct\'].sum(), rq1paired_results[\'MrfP_Correct\'].sum()],\\n    \'Procedural Wrong\': [rq1paired_results[\'LambdaP_Wrong\'].sum(), rq1paired_results[\'CompP_Wrong\'].sum(), rq1paired_results[\'MrfP_Wrong\'].sum()]\\n})\\n\\nfinal_table[\'% Corr.\'] = (final_table[\'Functional Correct\'] / (final_table[\'Functional Correct\'] + final_table[\'Functional Wrong\'])) * 100\\nfinal_table[\'% Corr\'] = (final_table[\'Procedural Correct\'] / (final_table[\'Procedural Correct\'] + final_table[\'Procedural Wrong\'])) * 100\\n\\n# Format the final table\\nfinal_table = final_table[[\'Construct\', \'Functional Correct\', \'Functional Wrong\', \'% Corr.\', \'Procedural Correct\', \'Procedural Wrong\', \'% Corr\']]\\nfinal_table\\n"}', name='execute_ipython_cell'), id='call_eZ0Z63qjjVEJ9ULedQJOQqPV', type='function')]
