import pandas as pd
import numpy as np

# Load the data
df = pd.read_csv('/home/data/coverage.csv')

# Convert time string to seconds
def to_seconds(t):
    parts = t.split()
    days = int(parts[0])
    time_part = parts[2]
    h, m, s = time_part.split(':')
    seconds = days*86400 + int(h)*3600 + int(m)*60 + float(s)
    return seconds

df['time_seconds'] = df['time'].apply(to_seconds)

# Target times
five_min = 300  # 5 minutes in seconds
three_hours = 10800  # 3 hours in seconds

# For each campaign, get the coverage at the closest time to target
campaign_groups = df.groupby(['campaign_id', 'fuzzer', 'subject'])

def get_closest_value(group, target):
    idx = (group['time_seconds'] - target).abs().idxmin()
    return group.loc[idx, 'covered_branches']

five_min_data = []
three_hours_data = []

for (campaign_id, fuzzer, subject), group in campaign_groups:
    # 5 minutes
    val_5m = get_closest_value(group, five_min)
    five_min_data.append({
        'campaign_id': campaign_id,
        'fuzzer': fuzzer,
        'subject': subject,
        'covered_5m': val_5m
    })
    # 3 hours
    val_3h = get_closest_value(group, three_hours)
    three_hours_data.append({
        'campaign_id': campaign_id,
        'fuzzer': fuzzer,
        'subject': subject,
        'covered_3h': val_3h
    })

df_5m = pd.DataFrame(five_min_data)
df_3h = pd.DataFrame(three_hours_data)

# Merge the two dataframes
merged = pd.merge(df_5m, df_3h, on=['campaign_id', 'fuzzer', 'subject'])

# Compute median per fuzzer and subject
medians = merged.groupby(['fuzzer', 'subject']).agg({
    'covered_5m': 'median',
    'covered_3h': 'median'
}).reset_index()

# Pivot for table format
pivot_5m = medians.pivot(index='fuzzer', columns='subject', values='covered_5m')
pivot_3h = medians.pivot(index='fuzzer', columns='subject', values='covered_3h')

# Order of fuzzers and subjects as in Table 3
fuzzers_ordered = [
    'BeDiv-Simple',
    'BeDiv-Struct',
    'RLCheck',
    'Zest',
    'Zeugma-X',
    'Zeugma-1PT',
    'Zeugma-2PT',
    'Zeugma-Link'
]

subjects_ordered = [
    'Ant',
    'Bcel',
    'Closure',
    'Maven',
    'Nashorn',
    'Rhino',
    'Tomcat'
]

# Reindex to ensure correct order
pivot_5m = pivot_5m.reindex(index=fuzzers_ordered, columns=subjects_ordered)
pivot_3h = pivot_3h.reindex(index=fuzzers_ordered, columns=subjects_ordered)

# Function to format numbers
def format_number(x):
    if pd.isna(x):
        return '—'
    else:
        return f'{x:.1f}'

# Build the table rows
rows = []
for fuzzer in fuzzers_ordered:
    row = [fuzzer]
    for subject in subjects_ordered:
        val_5m = pivot_5m.loc[fuzzer, subject]
        val_3h = pivot_3h.loc[fuzzer, subject]
        row.append(format_number(val_5m))
        row.append(format_number(val_3h))
    rows.append(row)

# Header
header = ['Fuzzer']
for subject in subjects_ordered:
    header.append(f'{subject} 5M')
    header.append(f'{subject} 3H')

# Output as markdown table
output_lines = []
output_lines.append('| ' + ' | '.join(header) + ' |')
output_lines.append('| ' + ' | '.join(['---'] * len(header)) + ' |')
for row in rows:
    output_lines.append('| ' + ' | '.join(row) + ' |')

output = '\n'.join(output_lines)
print(output)
EOF
