import re,glob,sys,os
from collections import defaultdict, Counter

def parse_lifetime_files():
    files = glob.glob('**/lifetime.rs', recursive=True)
    feat_status = {}
    arr_re = re.compile(r'lifetime\.insert\(\s*"([^"]+)"\s*,\s*\[([^\]]*)\]\s*\)', re.S)
    token_re = re.compile(r'"([^"]+)"|None')
    for fn in files:
        try:
            txt = open(fn,'r',errors='ignore').read()
        except:
            continue
        for m in arr_re.finditer(txt):
            name = m.group(1)
            arrtxt = m.group(2)
            tokens = token_re.findall(arrtxt)
            # token_re.findall returns list of tuples when groups; but with our pattern it yields list of strings for group1 and '' for None; handle differently:
            # Instead, extract all quoted or None tokens via another approach:
            toks = []
            for part in re.finditer(r'"([^"]+)"|None', arrtxt):
                if part.group(1) is not None:
                    toks.append(part.group(1).strip())
                else:
                    toks.append('None')
            if not toks:
                continue
            # choose last token that is not empty
            last = toks[-1]
            # normalize to status names
            st = last.lower()
            if st == 'accepted' or st == 'accept' or st == 'acceptd':
                stn = 'Accepted'
            elif st == 'active':
                stn = 'Active'
            elif st == 'incomplete':
                stn = 'Incomplete'
            elif st == 'removed':
                stn = 'Removed'
            elif st == 'none':
                stn = 'None'
            else:
                # if it's e.g., 'accepted' variants or other, try map
                if st in ('accepted','active','incomplete','removed','unknown'):
                    stn = st.capitalize()
                else:
                    stn = 'Unknown'
            feat_status[name] = stn
    return feat_status

def parse_version_feature_inserts():
    # Search SQL/other files for INSERT INTO version_feature_ori patterns
    inserts = []
    for fn in glob.glob('**/*', recursive=True):
        if os.path.isfile(fn):
            try:
                with open(fn,'r',errors='ignore') as f:
                    for ln in f:
                        if 'INSERT INTO version_feature_ori' in ln or 'INSERT INTO version_feature' in ln:
                            inserts.append((fn,ln.strip()))
            except:
                continue
    # Additionally search for CSV files that might be named version_feature*
    csv_rows = []
    for fn in glob.glob('**/*version_feature*.csv', recursive=True):
        try:
            with open(fn,'r',errors='ignore') as f:
                for ln in f:
                    csv_rows.append((fn,ln.strip()))
        except:
            continue
    return inserts, csv_rows

def extract_rows_from_inserts(inserts):
    # naive extraction: find tuples in parentheses following VALUES or in VALUES (...) lines
    rows = []
    pat_values = re.compile(r'VALUES\s*(\(.*\));?', re.I|re.S)
    tuple_re = re.compile(r'\(([^)]*)\)')
    for fn,ln in inserts:
        # accumulate multi-line inserts by reading file around the line
        try:
            txt = open(fn,'r',errors='ignore').read()
        except:
            continue
        for m in tuple_re.finditer(txt):
            content = m.group(1)
            # split top-level commas (naive)
            parts = []
            cur = ''
            depth = 0
            i = 0
            while i < len(content):
                c = content[i]
                if c == "'" :
                    # consume quoted string
                    j = i+1
                    while j < len(content):
                        if content[j] == "'" and content[j-1] != '\\':
                            break
                        j +=1
                    parts.append(content[i+1:j].replace("\\'","'"))
                    i = j+1
                    # skip possible comma
                    while i < len(content) and content[i] in ' \t':
                        i+=1
                    if i < len(content) and content[i]==',':
                        i+=1
                    continue
                elif c == ',':
                    # separate unquoted
                    parts.append(cur.strip())
                    cur = ''
                    i +=1
                    continue
                else:
                    cur += c
                    i +=1
            if cur.strip():
                parts.append(cur.strip())
            rows.append(parts)
    return rows

def extract_rows_from_csv(csv_rows):
    rows = []
    for fn,ln in csv_rows:
        # assume CSV header present; collect later
        rows.append((fn,ln))
    return rows

feat_status = parse_lifetime_files()
# produce RUF counts
cnt = Counter(feat_status.values())
# Normalize counts to the five statuses
statuses = ['Accepted','Active','Incomplete','Removed','Unknown']
ruf_counts = {s: cnt.get(s,0) for s in statuses}

# Try to extract version_feature_ori rows
inserts, csv_rows = parse_version_feature_inserts()
rows = extract_rows_from_inserts(inserts)

# If we found parsed rows as lists, assume schema includes id and feature; try to guess which column is feature (contains letters)
usage_counts = Counter()
pkg_versions = defaultdict(set)
if rows:
    for parts in rows:
        # find numeric id column and feature name (alpha) column
        idcol = None; featcol = None
        for i,p in enumerate(parts):
            if re.match(r'^\s*\d+\s*$', p):
                idcol = i if idcol is None else idcol
            if re.search(r'[A-Za-z_]', p):
                # choose this as feature if contains letters and not long SQL bits
                if featcol is None:
                    featcol = i
        if featcol is None:
            continue
        for parts in rows:
            if idcol is None:
                # try first col as id
                pkgid = parts[0]
            else:
                pkgid = parts[idcol]
            feat = parts[featcol].strip().strip("'\"")
            # map feature to status
            st = feat_status.get(feat, 'Unknown')
            usage_counts[st] += 1
            try:
                pid = int(re.sub(r'[^0-9]','',pkgid))
            except:
                pid = pkgid
            pkg_versions[st].add(pid)
else:
    # no inserts found; fallback to search for any files listing features per version as CSV lines
    pass

# compute final per-status package version counts and usage items
pkg_counts = {s: len(pkg_versions.get(s,set())) for s in statuses}
usage_items = {s: usage_counts.get(s,0) for s in statuses}

# If we found no rows, set pkg_counts and usage_items to zeros but keep ruf_counts from lifetime
if not rows:
    for s in statuses:
        pkg_counts[s] = 0
        usage_items[s] = 0

# Write output table
out = []
out.append("**Table 2: Summary of RUF usage**\n")
out.append("| Type       | RUF Count | Package Versions | RUF Usage Items |")
out.append("| ---------- | ---------:| ----------------:| ---------------:|")
for s in statuses:
    out.append("| {:<9} | {:9d} | {:13d} | {:13d} |".format(s, ruf_counts.get(s,0), pkg_counts.get(s,0), usage_items.get(s,0)))
open('/workspace/repro.txt','w').write("\n".join(out)+"\n")
print("Wrote /workspace/repro.txt with derived counts. RUF counts from lifetime files:")
for s in statuses:
    print(s, ruf_counts.get(s,0))
if rows:
    print("\nDerived package-version counts (distinct ids) and usage items from parsed INSERTs.")
else:
    print("\nNo version_feature_ori INSERTs found; package versions and usage items set to 0. Searched files for INSERT INTO version_feature_ori.")

