        filled_lines.append(newln)
        data_row_idx += 1
    else:
        # non-data line: copy as-is
        filled_lines.append(ln)

# Write filled file
with open("/workspace/repro_filled.txt", "w", encoding='utf-8') as out:
    out.write("\n".join(filled_lines) + "\n")

print("Wrote /workspace/repro_filled.txt")
