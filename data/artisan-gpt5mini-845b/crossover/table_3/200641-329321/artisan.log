#!/usr/bin/env python3
import os, json, csv, statistics, sys, re

# Locate campaigns base
candidates = [
    "/workspace/campaigns/campaigns",
    "/workspace/campaigns",
    "campaigns/campaigns",
    "campaigns"
]
base = next((c for c in candidates if os.path.isdir(c)), None)
if not base:
    print("No campaigns directory found among candidates; exiting.", file=sys.stderr)
    sys.exit(0)

# Subjects and output order
subjects = ["ant","bcel","closure","maven","nashorn","rhino","tomcat"]
row_order = [
    "BeDiv-Simple","BeDiv-Struct","RLCheck","Zest",
    "Zeugma-X","Zeugma-?PT","Zeugma-?PT","Zeugma-Link"
]

def map_subject(testClassName):
    if not testClassName: return None
    m = re.search(r'Fuzz([A-Za-z]+)$', testClassName)
    if not m: return None
    sub = m.group(1).lower()
    # normalize bcel casing
    if sub == "bcel": return "bcel"
    return sub

def map_fuzzer(summary):
    fw = summary.get("frameworkClassName","")
    cfg = summary.get("configuration",{}) or {}
    opts = cfg.get("javaOptions",[]) or []
    if fw == "de.hub.se.jqf.fuzz.BeDivFuzzFramework":
        # presence of SAVE_ONLY_NEW_STRUCTURES=true indicates structure variant
        for o in opts:
            if o.strip().startswith("-Djqf.div.SAVE_ONLY_NEW_STRUCTURES="):
                if o.strip().endswith("true"):
                    return "BeDiv-Struct"
        return "BeDiv-Simple"
    if fw == "edu.neu.ccs.prl.meringue.ZestFramework":
        return "Zest"
    if fw == "edu.berkeley.cs.jqf.fuzz.rl.RLCheckFramework":
        return "RLCheck"
    if fw == "edu.neu.ccs.prl.zeugma.framework.ZeugmaFramework":
        # find crossover option
        for o in opts:
            if o.strip().startswith("-Dzeugma.crossover="):
                val = o.strip().split("=",1)[1]
                if val == "linked":
                    return "Zeugma-Link"
                if val == "none":
                    return "Zeugma-X"
                if val in ("one_point","two_point"):
                    return "Zeugma-?PT"
        return "Zeugma-X"
    # fallback: unknown
    return None

# targets in ms
t5 = 300000
t3 = 10800000

# aggregate data
data = {}  # (fuzzer_display, subject) -> {'5M':[], '3H':[]}
for entry in os.listdir(base):
    d = os.path.join(base, entry)
    if not os.path.isdir(d): continue
    sfn = os.path.join(d, "summary.json")
    cfn = os.path.join(d, "coverage.csv")
    if not (os.path.isfile(sfn) and os.path.isfile(cfn)): continue
    try:
        s = json.load(open(sfn))
    except Exception:
        continue
    subj = map_subject(s.get("configuration",{}).get("testClassName","") or s.get("testClassName",""))
    fuz = map_fuzzer(s)
    if subj is None or fuz is None: 
        continue
    # read coverage.csv
    times = []
    try:
        with open(cfn, 'r') as f:
            reader = csv.reader((line.replace('\r','') for line in f))
            for row in reader:
                if not row: continue
                try:
                    t = int(row[0].strip())
                    v = int(row[1].strip())
                    times.append((t,v))
                except Exception:
                    continue
    except Exception:
        continue
    if not times: continue
    times.sort()
    def val_at(target):
        val = None
        for tt, vv in times:
            if tt <= target:
                val = vv
            else:
                break
        return val
    v5 = val_at(t5)
    v3 = val_at(t3)
    key = (fuz, subj)
    if key not in data:
        data[key] = {'5M':[], '3H':[]}
    if v5 is not None:
        data[key]['5M'].append(v5)
    if v3 is not None:
        data[key]['3H'].append(v3)

# compute medians and format table
def fmt(val):
    if val is None:
        return "    —"
    return "{:8.1f}".format(val)

lines = []
lines.append("| Fuzzer       |    Ant 5M | Ant 3H |    BCEL 5M |    BCEL 3H |  Closure 5M |  Closure 3H | Maven 5M |   Maven 3H | Nashorn 5M | Nashorn 3H |   Rhino 5M |   Rhino 3H | Tomcat 5M | Tomcat 3H |")
lines.append("| ------------ | --------: | -----: | ---------: | ---------: | ----------: | ----------: | -------: | ---------: | ---------: | ---------: | ---------: | ---------: | --------: | --------: |")

for fuz in row_order:
    row = [fuz]
    for subj in subjects:
        arr5 = data.get((fuz,subj),{}).get('5M',[])
        arr3 = data.get((fuz,subj),{}).get('3H',[])
        m5 = statistics.median(arr5) if arr5 else None
        m3 = statistics.median(arr3) if arr3 else None
        row.append(fmt(m5))
        row.append(fmt(m3))
    lines.append("| " + " | ".join(row) + " |")

with open("/workspace/repro.txt","w") as out:
    out.write("\n".join(lines)+"\n")

print("Wrote /workspace/repro.txt (computed medians).")
PY
