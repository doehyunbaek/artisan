import csv
from collections import Counter
from pathlib import Path

base = Path("/workspace")

files = {
    "Lambdas": base / "lambda.csv",
    "Comp.": base / "comprehension.csv",
    "MRF": base / "mrf.csv",
    "Proc.": base / "procedural.csv",
}

# Map lowercase raw codes to canonical Table 10 labels
canonical_map = {
    "coding time": "Coding time",
    "ease of use": "Ease of use",
    "maintainability": "Maintainability",
    "performance": "Performance",
    "readability/understandability": "Readability/Understandability",
    "size": "Size",
    "lack of knowledge": "Lack of knowledge",
    "project constraints": "Project constraints",
    "debugging is easier": "Simplify debugging",
}

order = [
    "Coding time",
    "Ease of use",
    "Maintainability",
    "Performance",
    "Readability/Understandability",
    "Size",
    "Lack of knowledge",
    "Project constraints",
    "Simplify debugging",
]

results = {}

for label, path in files.items():
    counts = Counter()
    with path.open(newline='', encoding="utf-8") as f:
        reader = csv.reader(f)
        header = next(reader)
        # For all sheets, coding starts at column 4 (0-based index)
        for row in reader:
            if not any(cell.strip() for cell in row):
                continue
            for cell in row[4:]:
                v = cell.strip()
                if not v:
                    continue
                key = v.lower()
                canon = canonical_map.get(key)
                if canon:
                    counts[canon] += 1
    results[label] = counts

# Write a simple tab-separated summary to inspect
out_path = base / "rq3_table10_counts.tsv"
with out_path.open("w", encoding="utf-8", newline="") as out:
    out.write("Reason\tLambdas\tComp.\tMRF\tProc.\n")
    for reason in order:
        row = [reason]
        for col in ["Lambdas", "Comp.", "MRF", "Proc."]:
            row.append(str(results[col].get(reason, 0)))
        out.write("\t".join(row) + "\n")

print(out_path)
PY
</mini_swe_agent_bash>
