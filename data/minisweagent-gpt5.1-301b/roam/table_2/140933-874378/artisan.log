    'Euler': 20,
}
for name, idx in methods.items():
    vals = extract_col(idx)
    avg = mean(vals)*100 if vals else float('nan')
    perfect = sum(1 for v in vals if abs(v-1.0) < 1e-9)
    zero = sum(1 for v in vals if abs(v) < 1e-9)
    print(f"{name}: n={len(vals)}, MatchAccuracy={avg:.2f}, PerfectCases={perfect}, ZeroCases={zero}")
PY
