===== CELL 0 (markdown) =====

# Using an LLM to Help With Code Understanding

===== CELL 1 (code) =====

library(lme4)
library(lmerTest)
library(MuMIn)
library(lattice)
library(car)
library(gridExtra)
library(plyr)
library(rsq)
library(parameters)
library(tidyverse) # for all-things workflow
library(dplyr)
library(tidyr)
library("reshape2")

===== CELL 2 (code) =====

df <- read.csv(file="ase_data.csv", header=TRUE)

===== CELL 3 (markdown) =====

## Time

===== CELL 4 (code) =====

Q <- quantile(df$success_time_no_guess, probs=c(.01, .99), na.rm = FALSE)
eliminated<- subset(df, df$success_time_no_guess >= Q[1] & df$success_time_no_guess <= Q[2])

===== CELL 5 (code) =====

no_guess_time_model = lm(success_time_no_guess ~ 
                  tool +
                  experience +
                  recruiting.years +
                  AI_experience,
                data = eliminated)
summary(no_guess_time_model)

===== CELL 6 (code) =====

vif(no_guess_time_model)

===== CELL 7 (markdown) =====

## Understanding

===== CELL 8 (code) =====

Q <- quantile(df$understanding, probs=c(.01, .99), na.rm = FALSE)
eliminated<- subset(df, df$understanding >= Q[1] & df$understanding <= Q[2])

===== CELL 9 (code) =====

understanding_model =glm(understanding ~ 
                  tool +
                  experience +
                  recruiting.years +
                  AI_experience,
                data = eliminated,
                family=quasipoisson)
summary(understanding_model)

===== CELL 10 (code) =====

vif(understanding_model)
rsq(understanding_model)
rsq(understanding_model, adj=TRUE)

===== CELL 11 (markdown) =====

## Progress

===== CELL 12 (code) =====

Q <- quantile(df$progress_no_guess, probs=c(.01, .99), na.rm = FALSE)
eliminated<- subset(df, df$progress_no_guess >= Q[1] & df$progress_no_guess <= Q[2])

===== CELL 13 (code) =====

progress_model= glm(progress_no_guess ~ 
                  tool +
                  experience +
                  recruiting.years +
                  AI_experience,
                data = eliminated,
                family=quasipoisson)
summary(progress_model)

===== CELL 14 (code) =====

vif(progress_model)
rsq(progress_model)
rsq(progress_model, adj=TRUE)

===== CELL 15 (markdown) =====

## Progress - Professionals

===== CELL 16 (code) =====

progress_model= glm(progress_no_guess ~ 
                  tool +
                  experience +
                  recruiting.years +
                  AI_experience,
                data = eliminated[eliminated$is_professional==1,],
                family=quasipoisson)
summary(progress_model)

===== CELL 17 (code) =====

vif(progress_model)
rsq(progress_model)
rsq(progress_model, adj=TRUE)

===== CELL 18 (markdown) =====

## Progress - Students

