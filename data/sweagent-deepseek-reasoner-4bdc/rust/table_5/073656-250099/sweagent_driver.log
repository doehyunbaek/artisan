    73	
    74	-- Result 3.2 Super Spreaders
    75	WITH deps AS (
    76	    SELECT version_to, COUNT(DISTINCT version_from) as dependents
    77	    FROM dep_version
    78	    WHERE version_to IN(
    79	        SELECT id FROM version_feature INNER JOIN feature_status 
