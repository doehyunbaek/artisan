import sys

lines = open('table_lines.csv').readlines()
data = []
for line in lines:
    parts = line.strip().split('|')
    # Remove empty strings from split
    parts = [p.strip() for p in parts if p.strip() != '']
    if len(parts) < 20:
        continue
    try:
        idx = int(parts[0])
        # mapping: based on visual inspection of columns
        # parts[0] index, parts[1] Issue id, parts[2] link, parts[3] #Actual, parts[4] #Provided, parts[5] #Missing
        # parts[6] ROAM match accuracy, parts[7] ROAM reproduction, parts[8] ROAM time, ...
        # parts[12] ROAM-Sim match accuracy, parts[13] ROAM-Sim reproduction, parts[14] ROAM-Sim time, ...
        # parts[15] ROAM-Dist match accuracy, parts[16] ROAM-Dist reproduction, parts[17] ROAM-Dist time
        roam_match = float(parts[6]) if parts[6] else 0.0
        roam_reprod = parts[7]
        sim_match = float(parts[12]) if parts[12] else 0.0
        sim_reprod = parts[13]
        dist_match = float(parts[15]) if parts[15] else 0.0
        dist_reprod = parts[16]
        data.append((idx, roam_match, roam_reprod, sim_match, sim_reprod, dist_match, dist_reprod))
    except (IndexError, ValueError) as e:
        # print('Skipping line:', line[:50], 'error:', e)
        continue

print('Parsed', len(data), 'rows')
if data:
    total = len(data)
    roam_match_avg = sum(d[1] for d in data) / total * 100
    sim_match_avg = sum(d[3] for d in data) / total * 100
    dist_match_avg = sum(d[5] for d in data) / total * 100
    roam_reprod_rate = sum(1 for d in data if d[2] == 'success') / total * 100
    sim_reprod_rate = sum(1 for d in data if d[4] == 'success') / total * 100
    dist_reprod_rate = sum(1 for d in data if d[6] == 'success') / total * 100

    print('Roam match accuracy: {:.1f}%'.format(roam_match_avg))
    print('Roam reproduction rate: {:.1f}%'.format(roam_reprod_rate))
    print('Roam-Sim match accuracy: {:.1f}%'.format(sim_match_avg))
    print('Roam-Sim reproduction rate: {:.1f}%'.format(sim_reprod_rate))
    print('Roam-Dist match accuracy: {:.1f}%'.format(dist_match_avg))
    print('Roam-Dist reproduction rate: {:.1f}%'.format(dist_reprod_rate))
"
