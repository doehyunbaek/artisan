N_REACH=$(echo "$LINE" | awk -F',' '{gsub(/ /, "", $2); print $2}')
GLITCHES=$(echo "$LINE" | awk -F',' '{gsub(/ /, "", $3); print $3}')
MEAN=$(echo "$LINE" | awk -F',' '{gsub(/ /, "", $4); print $4}')
