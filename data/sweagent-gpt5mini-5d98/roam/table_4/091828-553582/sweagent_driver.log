Observation: import multiprocessing
from os.path import join
import signal
import time
from typing import List
from gui_model_builder.gui_model import Edge, GUIModel, ModelNotExist
from reproducer.match_finder import match_finder_main
from reproducer.match_reproducer import Reproducer
from reproducer.s2r import load_s2rs
from reproduction_utils.emulator_helper import Emulator
from reproduction_utils.logger_utils import get_logger
from reproduction_utils.os_utils import clear_folder, load_text_file
from utils.cmd_args import CmdArgs
logger = get_logger('main', CmdArgs.logger_level)

emu = None

def abnormal_exit_handler(signal_type, frame):
    logger.info(f"Received signal: {signal_type}")
    if emu is not None:
        emu.__exit__(None, None, None)
    exit(1)


signal.signal(signal.SIGINT, abnormal_exit_handler)
signal.signal(signal.SIGTERM, abnormal_exit_handler)
signal.signal(signal.SIGQUIT, abnormal_exit_handler)


def analyze_app():
    logger.info("**************** TOOL Started ****************")
    logger.info(f"App ID: {CmdArgs.app_id}")
    logger.info(f"S2R Path: {CmdArgs.s2rs_path}")
    logger.info(f"APK Path: {CmdArgs.apk_path}")
    logger.info(f"Crash Msg Path: {CmdArgs.crash_msg_path}")
    logger.info(f"Report Type: {'Non-Crash' if CmdArgs.is_non_crash_report else 'Crash'}")
    logger.info(f"Max Emulator Limit: {CmdArgs.max_emulator}")
    logger.info(f"Output Dir: {CmdArgs.output_dir}")
    logger.info(f"Random Seed: {CmdArgs.random_seed}")
    # extract s2rs
    steps = load_s2rs(CmdArgs.s2rs_path)

    # construct GUI model
    try:
        gui_model_output = join(CmdArgs.output_dir, "gui_model")
        if CmdArgs.utg_path is not None:
            gui_model_output = CmdArgs.utg_path
        if CmdArgs.is_non_crash_report:
            gui_model = GUIModel(CmdArgs.app_id, output_dir=gui_model_output, treat_input_as_click=True)
        else:
            gui_model = GUIModel(CmdArgs.app_id, output_dir=gui_model_output)
        gui_model.to_dot(CmdArgs.crawler_output_dirs, join(gui_model_output, "GUIModel.pdf"))
    except ModelNotExist as e:
        logger.error("Model doesn't exist in Neo4j database. Please pre-load model into Neo4j.")
        return

    # compute matches and reproducing paths
    reproducing_paths = match_finder_main(steps, gui_model, output_dir=join(CmdArgs.output_dir, 'match_result'), infer_path=True)
    if CmdArgs.only_match:
        logger.info(f'**************** TOOL Ended. Only Match. ****************')
        return

    # execute computed UI events on the target app
    output_folder = join(CmdArgs.output_dir, 'reproduction_result')
    
    # schedule threads to run paths in parallelism 
    results = []
    success =  False
    proc_count = min(len(reproducing_paths),CmdArgs.max_emulator)
    if proc_count == 1:
        logger.info("Combining paths from all matches into one batch since only allowing one emulator.")
        reproducing_paths = [[path for paths in reproducing_paths for path in paths]]
    with multiprocessing.Pool(processes=proc_count) as pool:
        logger.info(f"Executing paths on {proc_count} emulators/threads in parallelism.")
        # Call the target function on each set of arguments in parallel
        for match_idx, paths in enumerate(reproducing_paths):
            result = pool.apply_async(execute_paths, args=(match_idx, paths))
            results.append(result)

        # Monitor the progress of the computation
        total_tasks = len(results)
        number_ready = -1
        while number_ready!=total_tasks:
            new_ready = sum([1 for result in results if result.ready()])
            if new_ready != number_ready:
                if (any([result.get() for result in results if result.ready()])):
                    success = True
                    break
                number_ready = new_ready
                logger.info(f"Finished executing {number_ready}/{total_tasks} match ...")
            # Sleep for a short while to avoid printing too frequently
            
    if not CmdArgs.is_non_crash_report:
        logger.info(f'**************** TOOL Ended. Result: {"Success" if success else "Failed"}. ****************')
    else:
        logger.info(f'**************** TOOL Ended. Please manually determine if the bug report is reproduced or not. ****************')

def execute_paths(match_idx, paths:List[List[Edge]]):
    output_folder = join(CmdArgs.output_dir, 'reproduction_result')
    success_path_output_file = join(output_folder, 'success_events.json')
    crash_msg = load_text_file(CmdArgs.crash_msg_path).strip() if not CmdArgs.is_non_crash_report else None
    finished_executing = False
    
    last_path_idx = 0
    retry_time = 3
    
    while retry_time>0:
        try:
            with Emulator(android_version=CmdArgs.android_version, show_window=CmdArgs.show_window, create_new_emulator=CmdArgs.create_new_emulator, logger=get_logger(f'emulator-match-{match_idx}',CmdArgs.logger_level), clean_3rd_apps=False, show_keyboard= CmdArgs.show_keyboard, isARM=CmdArgs.isARM) as emulator:
                starting_path_idx = last_path_idx
                logger.info("Emulator started. Start to executing UI event paths.")
                reproducer = Reproducer(CmdArgs.apk_path, emulator_id=emulator.get_cur_emulator_id())
                for i, path in enumerate(paths[starting_path_idx:]):
                    real_index = i + starting_path_idx
                    last_path_idx = real_index
                    logger.info(f"Executing path number {real_index} from match {match_idx}.")
                    result = reproducer.reproduce_path(path, crash_msg, match_idx, real_index, join(output_folder,"screenshots"))
                    if result:
                        logger.info(f"Successfully Reproduced when executing match {match_idx}, path number {real_index}.")
                        reproducer.dump_success_path(path, success_path_output_file)
                        return True     
            finished_executing = True
            break
        except Exception as e:
            logger.warning(f"Thread for match {match_idx} threw exception: {e}. Retrying.")
            retry_time -= 1
    if not finished_executing:
        raise Exception(f"Didn't finish executing match {match_idx} because exceptions being thrown.")
    return False
    

if __name__ == '__main__':
    analyze_app() # by default use ground truth to run the example input
