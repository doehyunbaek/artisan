import csv, math, pathlib

path = pathlib.Path("GILT_Artifacts/GILT_Artifacts-main/study/study_data.csv")
rows = []
with path.open() as f:
    r = csv.DictReader(f)
    for row in r:
        if row["tool"] == "1":
            rows.append(row)

def to_float(row, key):
    v = row[key]
    return float(v) if v not in ("", "NA", "NaN", None) else float("nan")

y = [to_float(r, "query_total") for r in rows]
x1 = [to_float(r, "AI_experience") for r in rows]
x2 = [to_float(r, "info_style") for r in rows]
x3 = [to_float(r, "learning_style") for r in rows]

import numpy as np
X = np.column_stack([np.ones(len(y)), x1, x2, x3])
y = np.array(y, dtype=float)
n, p = X.shape

beta = np.zeros(p)
for it in range(50):
    eta = X @ beta
    mu = np.exp(eta)
    # Avoid zeros
    mu = np.clip(mu, 1e-8, None)
    z = eta + (y - mu) / mu
    W = mu
    WX = X * W[:, None]
    XT_W_X = X.T @ WX
    XT_W_z = (X.T * W) @ z
    beta_new = np.linalg.solve(XT_W_X, XT_W_z)
    if np.max(np.abs(beta_new - beta)) < 1e-8:
        beta = beta_new
        break
    beta = beta_new

print("beta:", beta)

# dispersion (quasi-poisson)
eta = X @ beta
mu = np.exp(eta)
phi = np.sum((y - mu)**2 / mu) / (n - p)
cov_beta = phi * np.linalg.inv(XT_W_X)
se = np.sqrt(np.diag(cov_beta))
print("se:", se)

# log-likelihoods for R^2 (Poisson)
def loglik(y, mu):
    return float(np.sum(y * np.log(mu) - mu - [math.lgamma(yi + 1) for yi in y]))

ll_model = loglik(y, mu)
mu_null = np.full_like(y, y.mean())
ll_null = loglik(y, mu_null)
r2_mcf = 1 - ll_model / ll_null
print("McF R2:", r2_mcf)

# Adjusted version similar to rsq's adjusted McFadden: 1 - ( (ll_model - p)/ll_null )
r2_mcf_adj = 1 - ((ll_model - p) / ll_null)
print("Adj McF (guess):", r2_mcf_adj)
