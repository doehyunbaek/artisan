    "Performance",
    "Readability/Understandability",
    "Size",
    "Lack of knowledge",
    "Project constraints",
    "Simplify debugging"
]

# simple keyword mapping to detect reasons in free text
keywords = {
    "Coding time": ["coding time", "coding", "faster to write", "save time", "faster", "faster to"],
    "Ease of use": ["ease", "easy", "easy to", "allow us to", "allow", "easily", "simple"],
    "Maintainability": ["maintain", "maintainability", "modular", "modularity"],
    "Performance": ["perform", "performance", "optimi", "optimize", "faster", "speed"],
    "Readability/Understandability": ["readab", "understand", "understandability", "readable", "readability"],
    "Size": ["size", "less lines", "lines of code", "compact", "shorten", "occupy less", "less ines"],
    "Lack of knowledge": ["lack", "haven't really", "new to coding", "don't know", "not learned", "haven't"],
    "Project constraints": ["project", "constraint", "constraints"],
    "Simplify debugging": ["debug", "debugging", "simplif"]
}

# initialize counts
counts = {col: {r: 0 for r in reasons} for col in files.keys()}

for col, path in files.items():
    if not os.path.exists(path):
        continue
    with open(path, newline='', encoding='utf-8') as fh:
        # dialect: some are comma CSV, some tab-style outputs; use csv.reader with comma
        reader = csv.reader(fh)
        try:
            header = next(reader)
        except StopIteration:
            continue
        # find "Final Classification" column index (case-insensitive)
        final_idx = None
        for i, h in enumerate(header):
            if h and 'final' in h.lower():
                final_idx = i
                break
        # If not found, attempt to use last column
        if final_idx is None:
            final_idx = len(header) - 1
        # iterate rows
        for row in reader:
            if final_idx >= len(row):
                continue
            cell = row[final_idx]
            if not cell:
                continue
            text = cell.strip().lower()
            # if cell contains multiple labels separated by commas, split and test each
            parts = [p.strip() for p in text.replace(';',',').split(',') if p.strip()]
            if not parts:
                parts = [text]
            for part in parts:
                for r in reasons:
                    for kw in keywords[r]:
                        if kw in part:
