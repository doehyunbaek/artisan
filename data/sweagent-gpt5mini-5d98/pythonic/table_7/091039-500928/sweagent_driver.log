import pandas as pd
import statsmodels.api as sm
from patsy import dmatrices

df=pd.read_csv('/workspace/artifact/ICSE2024-funcConstructs-Artifacts/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv')
print('Dataset rows:', len(df))
sub=df[(df.Section=='mrf') & (df.Construct=='reduce') & (df.UsageFrequency>1)].copy()
print('Subset rows:', len(sub))
# normalize Outcome
sub['Outcome'] = sub['Outcome'].astype(str).str.upper().map({'TRUE':1,'FALSE':0})
# Some entries might be NA; drop rows with NA in Outcome
sub=sub.dropna(subset=['Outcome'])
# Build formula
# Ensure categorical variables are treated as such
sub['MainFactor'] = sub['MainFactor'].astype('category')
sub['Student'] = sub['Student'].astype('category')
# patsy design
y, X = dmatrices('Outcome ~ MainFactor + UsageFrequency + Approvals + Student', data=sub, return_type='dataframe')
model = sm.GLM(y, X, family=sm.families.Binomial()).fit()
print('AIC', model.aic)
params = model.params
bse = model.bse
z = params / bse
pvalues = model.pvalues
out = pd.DataFrame({'Estimate':params, 'Std.Error':bse, 'z value':z, 'Pr(>|z|)':pvalues})
print(out)
out.to_csv('/workspace/repro_reduce_python.csv')
PY
