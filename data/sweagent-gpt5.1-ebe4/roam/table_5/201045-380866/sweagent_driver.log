import csv
from statistics import mean

rows = []
with open('results.md', 'r') as f:
    for line in f:
        if not line.startswith('|'):
            continue
        parts = [p.strip() for p in line.strip().split('|')[1:-1]]
        if not parts or parts[0] == '':
            continue
        if parts[0] == '---' or parts[0] == 'Col1':
            continue
        if parts[0].isdigit():
            rows.append(parts)

# indices from inspection
idx_roam_match = 6
idx_roam_repro = 7
idx_roamsim_match = 12
idx_roamsim_repro = 13
idx_roamdist_match = 15
idx_roamdist_repro = 16

n = len(rows)
print('Total rows', n)

def avg_match(idx):
    vals = []
    for r in rows:
        v = r[idx]
        if v == '':
            continue
        try:
            vals.append(float(v))
        except ValueError:
            pass
    return mean(vals)


def repro_rate(idx):
    succ = 0
    total = 0
    for r in rows:
        v = r[idx]
        if v in ('success', 'failure', 'false positive'):
            total += 1
            if v == 'success':
                succ += 1
    return succ / total * 100

print('Roam match', avg_match(idx_roam_match)*100)
