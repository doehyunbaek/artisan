#!/usr/bin/env bash
set -euo pipefail

cd /home/infer_TempFix
git reset --hard
git checkout main
./compile

run_proj() {
  local spec_file=\"\$1\" proj_dir=\"\$2\"
  cd /home/infer_TempFix
  cp \"\$spec_file\" spec.c
  cd \"\$proj_dir\"
  make clean || true
  /home/infer_TempFix/infer/bin/tempFix 2>&1 | tee /tmp/tempfix.log
  awk '/^\\[Repaired Bugs\\]/ {val=\$3} END { if (val == \"\") { exit 1 } else { print val+0 } }' /tmp/tempfix.log
}

