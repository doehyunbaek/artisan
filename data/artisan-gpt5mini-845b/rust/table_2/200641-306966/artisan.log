import re,glob,sys
pattern = re.compile(r'\(\s*"([A-Za-z0-9_@./\-:+]+)"\s*,[^)]*?(?:Status::)?\b(Accepted|Active|Incomplete|Removed|Unknown)\b', re.S)
files = glob.glob('**/lifetime.rs', recursive=True)
if not files:
    print("No lifetime.rs files found", file=sys.stderr); sys.exit(1)
ruf_status = {}
for fn in files:
    try:
        text = open(fn, 'r', errors='ignore').read()
    except Exception as e:
        continue
    for m in pattern.finditer(text):
        name = m.group(1)
        status = m.group(2)
        # If a RUF appears multiple times, prefer the first seen (assumes unique listing)
        if name not in ruf_status:
            ruf_status[name] = status
from collections import Counter
cnt = Counter(ruf_status.values())
for s in ['Accepted','Active','Incomplete','Removed','Unknown']:
    print(f"{s}: {cnt.get(s,0)}")
PY
</mini_swe_agent_bash>
