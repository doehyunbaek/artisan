res_line=$(awk '/Scaled residuals:/ {getline; getline; gsub(/^ +/, "", $0); print; exit}' "$mrf_txt")
set -- $res_line
MIN_RAW=$1
Q1_RAW=$2
MED_RAW=$3
Q3_RAW=$4
MAX_RAW=$5

MIN_VAL=$(printf "%.2f" "$MIN_RAW")
Q1_VAL=$(printf "%.2f" "$Q1_RAW")
MED_VAL=$(printf "%.2f" "$MED_RAW")
Q3_VAL=$(printf "%.2f" "$Q3_RAW")
MAX_VAL=$(printf "%.2f" "$MAX_RAW")

# Temporary files for merging ORs with BH-adjusted p-values
or_tmp=$(mktemp)
p_tmp=$(mktemp)

# Extract OR, Estimate, Std.Error, z from LaTeX coeff table (preserve formatting)
awk -F'&' '
  /\\\\/ {
    if ($0 ~ /\\hline/) next;
    if ($2 ~ /OR/) next;
    name=$1; gsub(/^ *| *$/, "", name);
    OR=$2;   gsub(/^ *| *$/, "", OR);
    est=$3;  gsub(/^ *| *$/, "", est);
    se=$4;   gsub(/^ *| *$/, "", se);
    z=$5;    gsub(/^ *| *$/, "", z);
    print name "|" OR "|" est "|" se "|" z;
  }
' "$mrf_coeff_tex" > "$or_tmp"

# Extract BH-adjusted p-values from fixed effects section of summary
awk '
  $0 ~ /^Fixed effects:/ {infix=1; next}
  infix && NF==0 {exit}
  infix && $1 !~ /^Correlation/ {
    # Expect lines: name est se z p
    name=$1;
    p=$NF;
    print name "|" p;
  }
' "$mrf_txt" > "$p_tmp"

# Build the markdown table into repro.txt
{
  echo "**Table 5: RQ1: Mixed-effect logistic regression relating the use of MRF with the correctness of the change task**"
  echo
  echo "|                  |        |"
  echo "| ---------------- | ------ |"
  printf "| **AIC**          | %.1f  |\n" "$AIC_VAL"
  printf "| **BIC**          | %.1f  |\n" "$BIC_VAL"
  printf "| **logLik**       | %.1f |\n" "$LOGLIK_VAL"
  printf "| **deviance**     | %.1f  |\n" "$DEVIANCE_VAL"
  printf "| **df.residuals** | %d    |\n" "$DFRES_VAL"
  echo
  printf "**Scaled residuals:** Min %s, 1Q %s, Median %s, 3Q %s, Max %s\n" "$MIN_VAL" "$Q1_VAL" "$MED_VAL" "$Q3_VAL" "$MAX_VAL"
  echo
  echo "**Random effects (Groups)** — User (Intercept): Variance 0, Std.Dev. 0; Number of obs: 320, groups: User, 159"
  echo
  echo "**Fixed effects**"
  echo
  echo "| Term | OR | Estimate | Std.Error | z value | Pr(>\|z\|) |"
  echo "|---|---:|---:|---:|---:|---:|"

  # Merge OR/info with BH-adjusted p-values and map names to paper labels
  while IFS='|' read -r name OR est se z; do
    # Find matching p-value for this name
    pval=$(grep "^${name}|" "$p_tmp" | head -n1 | cut -d'|' -f2)
    case "$name" in
      "(Intercept)") outname="(Intercept)";;
      "MainFactorp") outname="MainFactorProc";;
      "UsageFrequency") outname="Usage Freq.";;
      "Approvals") outname="Approvals";;
      "StudentTRUE") outname="StudentTrue";;
      *) continue;;
    esac
    printf "| %s | %s | %s | %s | %s | %s |\n" "$outname" "$OR" "$est" "$se" "$z" "$pval"
  done < "$or_tmp"
} > /workspace/repro.txt

# Clean up temp files
rm -f "$or_tmp" "$p_tmp"

# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_pythonic_table_5.sh && artisan submit /workspace/repro_pythonic_table_5.sh
</mini_swe_agent_bash>
