import math
from decimal import Decimal, getcontext

n = 256
fact = math.factorial(n)
s = str(fact)
exp = len(s) - 1
getcontext().prec = 50
mant = Decimal(fact) / (Decimal(10) ** exp)
print("256! =", fact)
print("Scientific:", f"{mant:.2f}×10^{exp}")
