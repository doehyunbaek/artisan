    for r in reader:
        rows.append({
            'subject': r['subject'],
            'crossover_operator': r['crossover_operator'],
            'inheritance_rate': float(r['inheritance_rate']),
            # hybrid column is "true"/"false"
            'hybrid': r['hybrid'].strip().lower() == 'true',
        })

subjects_order = ['Ant', 'BCEL', 'Closure', 'Maven', 'Nashorn', 'Rhino', 'Tomcat']
op_map = {
    'Linked': 'Linked',
    'One Point': 'One Point',
    'Two Point': 'Two Point',
}

# Group data by (subject, crossover_operator)
from collections import defaultdict
groups = defaultdict(list)
for r in rows:
    subj = r['subject']
    op = r['crossover_operator']
    if op not in op_map:
        continue
    groups[(subj, op)].append(r)

def stat_inheritance(subj, op):
    vals = [r['inheritance_rate'] for r in groups.get((subj, op), [])]
