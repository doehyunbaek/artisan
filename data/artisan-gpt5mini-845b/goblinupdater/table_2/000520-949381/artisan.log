import csv, math
path = "ASE24_data_and_tools/ASE24_data_and_tools/results_data/execution/conf_4_local/executionsData.csv"
projects = {}
with open(path, newline='', encoding='utf-8') as fh:
    reader = csv.DictReader(fh)
    for row in reader:
        name = row.get('name') or row.get('repoName')
        if not name or name in projects:
            continue
        try:
            projects[name] = {
                'direct': int(row.get('directDepNumber',0) or 0),
                'releases': int(row.get('releaseSize',0) or 0),
                'libraries': int(row.get('artifactSize',0) or 0),
                'dependency_edges': int(row.get('dependencySize',0) or 0),
                'version_edges': int(row.get('versionSize',0) or 0)
            }
        except:
            continue

def percentile(sorted_list, p):
    n = len(sorted_list)
    if n == 0:
        return 0.0
    if n == 1:
        return float(sorted_list[0])
    pos = p * (n - 1)
    lo = int(math.floor(pos))
    hi = int(math.ceil(pos))
    if lo == hi:
        return float(sorted_list[int(pos)])
    frac = pos - lo
    return sorted_list[lo] * (1 - frac) + sorted_list[hi] * frac

def fmt_q(x):
    if abs(x - round(x)) < 1e-9:
        return f"{int(round(x))}"
    return f"{x:.1f}"

def fmt_int_commas(x):
    return f"{int(x):,}"

vals = {k: sorted([v[k] for v in projects.values()]) for k in ['direct','releases','libraries','dependency_edges','version_edges']}

stats = {}
for k,l in vals.items():
    if not l:
        stats[k] = (0,0,0,0,0)
    else:
        q1 = percentile(l, 0.25)
        q2 = percentile(l, 0.5)
        q3 = percentile(l, 0.75)
        mn = min(l)
        mx = max(l)
        stats[k] = (q1,q2,q3,mn,mx)

out = []
