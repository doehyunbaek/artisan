# Section 2: Artifact download
artisan get https://zenodo.org/records/13767954

# Section 3: Reproduction commands (populate from reviewed steps)
ART_DIR="artifact_efficient_test_interference_detection_c/artifact_efficient_test_interference_detection_c"
# Prefer loading provided image tarball; otherwise build from Dockerfile
if [ -f "$ART_DIR/test_interference_detection-data_mangling.tgz" ]; then
  docker load -i "$ART_DIR/test_interference_detection-data_mangling.tgz"
else
  docker build -t test_interference_detection/data_mangling -f "$ART_DIR/Dockerfile" "$ART_DIR"
fi

# Ensure out directory exists and run the analysis in the container, mapping output back to host
mkdir -p "$ART_DIR/data_analysis/out"
docker run --rm -v "$PWD/$ART_DIR/data_analysis/out":/data_analysis/out test_interference_detection/data_mangling /bin/bash -c 'set -e; Rscript -e "setwd(\"data_analysis\"); source(\"analyze_data.R\")"'

# Collect reproduction output into /workspace/repro.txt
OUTFILE="/workspace/repro.txt"
# Prefer any produced table-like file in the out directory
MATCHED_FILE=$(find "$ART_DIR/data_analysis/out" -maxdepth 1 -type f \( -iname "*table*.md" -o -iname "*table*.rmd" -o -iname "*table*.csv" -o -iname "*table*.*" \) -print -quit 2>/dev/null || true)
if [ -n "$MATCHED_FILE" ]; then
  echo "Using generated output file: $MATCHED_FILE" > "$OUTFILE"
  echo "----" >> "$OUTFILE"
  sed -n '1,10000p' "$MATCHED_FILE" >> "$OUTFILE"
else
  # Fallback: include the permutation_data.csv (source data for Table 2) if present
  if [ -f "$ART_DIR/data_analysis/permutation_data.csv" ]; then
    echo "# permutation_data.csv (fallback content)" > "$OUTFILE"
