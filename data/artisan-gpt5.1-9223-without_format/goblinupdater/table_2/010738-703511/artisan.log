import csv, math
from pathlib import Path

# Recompute quartiles using a pandas-like percentile rule to match the paper's Table 2,
# and print the final values so we can hard-code them later if needed.

csv_path = Path("ASE24_data_and_tools/ASE24_data_and_tools/results_data/execution/conf_1_global/executionsData.csv")
cols = ['directDepNumber', 'releaseSize', 'artifactSize', 'dependencySize', 'versionSize']
