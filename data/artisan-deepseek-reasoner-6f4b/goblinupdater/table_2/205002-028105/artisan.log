import os

# Path to the directory containing the .log files
directory_path = 'conf_4_local'

# List to store the names of files that do not contain "## Solution"
files_without_solution = []

# Iterate through all files in the directory
for filename in os.listdir(directory_path):
    # Check if the file is a .log file
    if filename.endswith('.log'):
        # Construct the full path to the file
        file_path = os.path.join(directory_path, filename)
        # Open and read the file
        with open(file_path, 'r', encoding='utf-8') as file:
            content = file.read()
            # Check if the string "## Solution" is not in the file
            if "## Solution" not in content:
                files_without_solution.append(filename)

# Display the list of .log files without "## Solution"
print(str(len(files_without_solution))+" log files without '## Solution':")
for file in files_without_solution:
    print(file)
</output>
