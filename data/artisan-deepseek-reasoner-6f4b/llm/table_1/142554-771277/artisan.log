<mini_swe_agent_bash>
docker exec notebook sh -c 'cat > /tmp/reproduce_table.R << "EOF"
# Install required packages if needed
required_packages <- c("car", "rsq", "lmtest")
installed_packages <- rownames(installed.packages())
to_install <- required_packages[!required_packages %in% installed_packages]
if (length(to_install) > 0) {
    install.packages(to_install, repos = "https://cloud.r-project.org", quiet = TRUE)
}

# Load libraries
library(car)
library(rsq)
library(lmtest)

# Read the data
df <- read.csv("/home/jovyan/work/study_data.csv")

# Function to extract coefficients and format them
format_result <- function(model, model_type = "lm") {
    smry <- summary(model)
    if (model_type == "lm") {
        coefs <- coef(smry)
        est <- coefs[, "Estimate"]
        se <- coefs[, "Std. Error"]
        p <- coefs[, "Pr(>|t|)"]
        r2 <- smry$r.squared
        adj_r2 <- smry$adj.r.squared
    } else if (model_type == "glm") {
        coefs <- coef(smry)
        est <- coefs[, "Estimate"]
        se <- coefs[, "Std. Error"]
        p <- coefs[, "Pr(>|t|)"]
        r2 <- rsq(model)
        adj_r2 <- rsq(model, adj = TRUE)
    }
    stars <- ifelse(p < 0.01, "***", ifelse(p < 0.05, "**", ifelse(p < 0.1, "*", "")))
    formatted <- sprintf("%.2f%s (%.2f)", est, stars, se)
    names(formatted) <- rownames(coefs)
    return(list(coefs = formatted, r2 = r2, adj_r2 = adj_r2))
}

# Model 1: Progress (overall) - quasipoisson GLM
Q <- quantile(df$progress_no_guess, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$progress_no_guess >= Q[1] & df$progress_no_guess <= Q[2])
progress_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience,
                      data = eliminated, family = quasipoisson)
progress_results <- format_result(progress_model, "glm")

# Model 2: Time (s) - linear model
Q <- quantile(df$success_time_no_guess, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$success_time_no_guess >= Q[1] & df$success_time_no_guess <= Q[2])
time_model <- lm(success_time_no_guess ~ tool + experience + recruiting.years + AI_experience,
                 data = eliminated)
time_results <- format_result(time_model, "lm")

# Model 3: Understanding - quasipoisson GLM
Q <- quantile(df$understanding, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$understanding >= Q[1] & df$understanding <= Q[2])
understanding_model <- glm(understanding ~ tool + experience + recruiting.years + AI_experience,
                           data = eliminated, family = quasipoisson)
understanding_results <- format_result(understanding_model, "glm")

# Model 4: Progress (Pros only) - quasipoisson GLM
Q <- quantile(df$progress_no_guess, probs = c(.01, .99), na.rm = FALSE)
eliminated <- subset(df, df$progress_no_guess >= Q[1] & df$progress_no_guess <= Q[2])
progress_pro_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience,
                          data = eliminated[eliminated$is_professional == 1,], family = quasipoisson)
progress_pro_results <- format_result(progress_pro_model, "glm")

# Model 5: Progress (Students only) - quasipoisson GLM
progress_student_model <- glm(progress_no_guess ~ tool + experience + recruiting.years + AI_experience,
                              data = eliminated[eliminated$is_professional == 0,], family = quasipoisson)
progress_student_results <- format_result(progress_student_model, "glm")

# Prepare table rows
rows <- c("(Intercept)", "recruiting.years", "experience", "AI_experience", "tool")
row_names <- c("Constant", "Domain experience", "Program. experience", "AI tool familiarity", "Uses GILT")

# Collect coefficients
coeff_matrix <- matrix("", nrow = length(rows), ncol = 5)
for (i in seq_along(rows)) {
    term <- rows[i]
    coeff_matrix[i, 1] <- ifelse(term %in% names(progress_results$coefs), progress_results$coefs[term], "N/A")
    coeff_matrix[i, 2] <- ifelse(term %in% names(time_results$coefs), time_results$coefs[term], "N/A")
    coeff_matrix[i, 3] <- ifelse(term %in% names(understanding_results$coefs), understanding_results$coefs[term], "N/A")
    coeff_matrix[i, 4] <- ifelse(term %in% names(progress_pro_results$coefs), progress_pro_results$coefs[term], "N/A")
    coeff_matrix[i, 5] <- ifelse(term %in% names(progress_student_results$coefs), progress_student_results$coefs[term], "N/A")
}

# R-squared rows
r2_row <- c(sprintf("%.3f", progress_results$r2),
            sprintf("%.3f", time_results$r2),
            sprintf("%.3f", understanding_results$r2),
            sprintf("%.3f", progress_pro_results$r2),
            sprintf("%.3f", progress_student_results$r2))

adj_r2_row <- c(sprintf("%.3f", progress_results$adj_r2),
                sprintf("%.3f", time_results$adj_r2),
                sprintf("%.3f", understanding_results$adj_r2),
                sprintf("%.3f", progress_pro_results$adj_r2),
                sprintf("%.3f", progress_student_results$adj_r2))

# Output table in markdown format
cat("**Table 1: Summaries of regressions estimating the effect of using the prototype. Each column summarizes the model for a different outcome variable. We report the coefficient estimates with the standard errors in parentheses.**\n\n")
cat("|                     |   Progress (1) |    Time (s) (2) |   Underst. (3) | Progress (Pros) | Progress (Students) |\n")
cat("| ------------------- | -------------: | --------------: | -------------: | --------------: | ------------------: |\n")
for (i in seq_along(row_names)) {
    cat(sprintf("| %-20s | %14s | %15s | %14s | %15s | %19s |\n",
                row_names[i],
                coeff_matrix[i, 1],
                coeff_matrix[i, 2],
                coeff_matrix[i, 3],
                coeff_matrix[i, 4],
                coeff_matrix[i, 5]))
}
cat(sprintf("| %-20s | %14s | %15s | %14s | %15s | %19s |\n", "*R*²", r2_row[1], r2_row[2], r2_row[3], r2_row[4], r2_row[5]))
cat(sprintf("| %-20s | %14s | %15s | %14s | %15s | %19s |\n", "Adj. *R*²", adj_r2_row[1], adj_r2_row[2], adj_r2_row[3], adj_r2_row[4], adj_r2_row[5]))
cat("\n*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*\n")
EOF'
</mini_swe_agent_bash>
