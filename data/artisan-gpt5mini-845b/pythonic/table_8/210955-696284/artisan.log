from decimal import Decimal, ROUND_HALF_UP
import csv, sys

csv_path = "${CSV_PATH}"
terms = ["(Intercept)","MainFactorProc","Usage Freq.","Approvals","StudentTrue"]

def round_half_away_str(s, nd=2):
    # Use Decimal to round half away from zero (ROUND_HALF_UP)
    d = Decimal(str(s))
    q = d.quantize(Decimal('1e-{}'.format(nd)), rounding=ROUND_HALF_UP)
    # format with fixed-point to preserve trailing zeros
    return format(q, 'f')

# Read CSV rows
rows = []
with open(csv_path, newline='') as f:
    reader = csv.reader(f)
    for r in reader:
        if len(r) >= 4:
            rows.append(r[:4])

# Safety: if fewer rows than terms, error
if len(rows) < len(terms):
    print("ERROR: unexpected CSV format or missing rows", file=sys.stderr)
