Observation: version: '3.7'
services:
    reproduction-gui-model:
      privileged: true
      image: "reproduction-gui-model"
      build:
        context: ./
        dockerfile: Dockerfile
      depends_on:
        - neo4j
      volumes:
        - ${ROOT_PROJECT}:/Roam-Artifact
        # - ${AVD_DIR}:/avd
      working_dir: /Roam-Artifact/ReproductionTool
      devices:
        - /dev/kvm:/dev/kvm
      stdin_open: true # docker run -i
      tty: true        # docker run -t
      command: "emulator -list-avds"
      environment:
        - ANDROID_AVD_HOME=/avd
    
    neo4j:
      image: neo4j:5.16.0
      ports: 
        - 7474:7474
        - 7687:7687
      volumes:
        - ${ROOT_PROJECT}/Evaluation/dataset/neo4j/data:/data
        - ${ROOT_PROJECT}/Evaluation/dataset/neo4j/logs:/logs
        - ${ROOT_PROJECT}/Evaluation/dataset/neo4j/import:/var/lib/neo4j/import
        - ${ROOT_PROJECT}/Evaluation/dataset/neo4j/plugins:/plugins
      environment:
        - NEO4J_AUTH=neo4j/password
      healthcheck:
        test: "cypher-shell -u neo4j -p password \"CALL dbms.components()\" || exit 1"
        start_period: 10s
        retries: 3
        interval: 30s
        timeout: 10s


