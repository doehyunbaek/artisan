    "WALA-0-CFA.profile",
    "Soot-CHA.profile",
    "Soot-RTA.profile",
    "Soot-SPARK.profile",
]

row_to_category = {
    "Non-virtual Calls": "Non-virtual Calls",
    "Virtual Calls": "Virtual Calls",
    "Types": "Types",
    "Static Initializer": "Static Initializer",
    "Java ? Interfaces": "Java 8 Interfaces",
    "Unsafe": "Unsafe",
    "Class.forName": "Class.forName",
    "Sign. Polymorph.": "Signature Polymorphic Methods",
    "Java ?+": "Java 9+",
    "Non-Java": "Non-Java",
    "MethodHandle": "MethodHandle",
    "Invokedynamic": "Invokedynamic",
    "Reflection": "Reflection",
    "JVM Calls": "JVM Calls",
    "Serialization": "Serialization",
    "Library Analysis": "Library Analysis",
    "Class Loading": "Class Loading",
    "DynamicProxy": "DynamicProxy",
}

stats = {p: {} for p in profiles}
sum_totals = {}
sum_passed = {}

current = None
cat_re = re.compile(r'^(.+?):\s+(\d+)/(\d+)$')
sum_re = re.compile(r'^Sum \(out of (\d+)\): (\d+) \(([^)]+)\)')

with summary_path.open() as f:
    for raw in f:
        line = raw.strip()
        if not line:
            continue
        if line in profiles:
            current = line
            continue
        if current is None:
            continue
        m_cat = cat_re.match(line)
        if m_cat:
            cat_name = m_cat.group(1)
            passed = int(m_cat.group(2))
            total = int(m_cat.group(3))
            stats[current][cat_name] = (passed, total)
            continue
        m_sum = sum_re.match(line)
        if m_sum:
            total = int(m_sum.group(1))
            passed = int(m_sum.group(2))
            sum_totals[current] = total
            sum_passed[current] = passed
            continue

for p in profiles:
    if p not in sum_totals:
        raise SystemExit(f"Missing sum for profile {p}")
    for cat in row_to_category.values():
        if cat not in stats[p]:
            raise SystemExit(f"Missing category '{cat}' for profile {p}")

lines_out = []
with expected_path.open() as f:
    for raw in f:
        line = raw
        stripped = line.lstrip()
        if not stripped.startswith("|"):
            lines_out.append(line)
            continue

        stripped_line = line.strip()
        if stripped_line.startswith("| -"):
            lines_out.append(line)
            continue

        cells = [c.strip() for c in stripped_line.strip("|").split("|")]
        if not cells:
            lines_out.append(line)
            continue

        label = cells[0]

        if label == "Feature":
            lines_out.append(line)
            continue

        if "Sum (out of" in label:
            any_profile = profiles[0]
            total_all = sum_totals[any_profile]
            cells[0] = f"**Sum (out of {total_all})**"
            for idx, prof in enumerate(profiles, start=1):
                total = sum_totals[prof]
                passed = sum_passed[prof]
                percent = int(100.0 * passed / total) if total else 0  # truncate
                cells[idx] = f"**{passed} ({percent}%)**"
            new_line = "| " + " | ".join(cells) + " |\n"
            lines_out.append(new_line)
            continue

        if label not in row_to_category:
            lines_out.append(line)
            continue

        category_name = row_to_category[label]
        for idx, prof in enumerate(profiles, start=1):
            passed, total = stats[prof][category_name]
            cells[idx] = f"{passed}/{total}"
        new_line = "| " + " | ".join(cells) + " |\n"
        lines_out.append(new_line)

