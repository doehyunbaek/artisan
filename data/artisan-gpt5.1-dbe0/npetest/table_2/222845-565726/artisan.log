text = Path("/workspace/expected.md").read_text()
out_lines = []

for line in text.splitlines(keepends=True):
    if line.lstrip().startswith("|"):
        parts = line.split("|")
        new_parts = []
        for i, part in enumerate(parts):
            if i == 0 or i == len(parts) - 1:
                new_parts.append(part)
            else:
                stripped = part.strip()
                if stripped in mapping:
                    part = part.replace(stripped, mapping[stripped])
                new_parts.append(part)
        line = "|".join(new_parts)
    out_lines.append(line)

Path("/workspace/repro.txt").write_text("".join(out_lines))
PYCODE

