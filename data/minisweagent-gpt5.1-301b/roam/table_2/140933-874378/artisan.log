def split_row(row): return [c.strip() for c in row.strip().split('|')[1:-1]]

lines = [l.rstrip('\n') for l in open('results.md', encoding='utf-8')]
# Find the header row with "Issue id"
start_idx = next(i for i,l in enumerate(lines) if l.startswith('|') and 'Issue id' in l)
# Skip header, separator, then data
data_lines = []
for l in lines[start_idx+2:]:
    if not l.strip().startswith('|') or l.strip().startswith('|---'):
