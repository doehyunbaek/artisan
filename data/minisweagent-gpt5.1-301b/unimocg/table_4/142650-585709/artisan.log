# Section 2: Artifact download
cd /workspace
if [ ! -f Unimocg_Artifact.zip ]; then
  curl -L -o Unimocg_Artifact.zip "https://zenodo.org/api/records/10890011/files/Unimocg_Artifact.zip/content"
