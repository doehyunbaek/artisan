out.append("| dependency edges ((E_D))  | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>7} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

q1,q2,q3,mn,mx = stats['version_edges']
out.append("| versions edges ((E_V))    | {q1:>5} | {q2:>3} | {q3:>4} | {mn:>3} | {mx:>7} |".format(
    q1=fmt_q(q1), q2=fmt_q(q2), q3=fmt_q(q3), mn=fmt_int_commas(mn), mx=fmt_int_commas(mx)
))

print("\n".join(out))
