<mini_swe_agent_bash>
cat > /workspace/repro_npetest_table_4.sh <<'EOF'
#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 4: Bug-finding ability of EvoSuite with different settings. EvoSuite_{Def}: EvoSuite with no fine-tuned options.**

| Tool           |  NPEX | BugSwarm | Defects4J | Genesis | Bears | Total |
| -------------- | ----: | -------: | --------: | ------: | ----: | ----: |
| EvoSuite       | ??.?% |    ??.?% |     ??.?% |   ??.?% | ??.?% | ??.?% |
| EvoSuite_{Def} | ??.?% |    ??.?% |     ??.?% |   ??.?% | ??.?% | ??.?% |

EOTABLE
# Section 2: Artifact download
artisan get https://github.com/kupl/NPETestArtifact
# Section 3: Reproduction commands (populate from reviewed steps)
cd /workspace/NPETestArtifact
uvx --from csvkit in2csv rq2_result.xlsx --write-sheets - --use-sheet-names | python - << 'PY'
import sys, csv

rows = list(csv.reader(sys.stdin))

# Extract rows for EvoSuite and EvoSuite_Def
targets = ['EvoSuite', 'EvoSuite_Def']
data = {r[0]: r for r in rows if r and r[0] in targets}

def fmt(x: str) -> str:
    return f"{float(x):.1f}%"

# Column indices in the CSV:
# 1:NPEX, 2:BugSwarm, 3:Genesis, 4:Bears, 5:Defects4J, 6:Total
# Reorder to: NPEX, BugSwarm, Defects4J, Genesis, Bears, Total
order_indices = [1, 2, 5, 3, 4, 6]

lines = []
for key, label in [('EvoSuite', 'EvoSuite'), ('EvoSuite_Def', 'EvoSuite_{Def}')]:
    row = data[key]
    vals = [fmt(row[i]) for i in order_indices]
    lines.append(f"| {label:<13} | " + " | ".join(f"{v:>6}" for v in vals) + " |")

header = """**Table 4: Bug-finding ability of EvoSuite with different settings. EvoSuite_{Def}: EvoSuite with no fine-tuned options.**

| Tool           |  NPEX | BugSwarm | Defects4J | Genesis | Bears | Total |
| -------------- | ----: | -------: | --------: | ------: | ----: | ----: |"""

content = header + "\n" + "\n".join(lines) + "\n"

with open("/workspace/repro.txt", "w", encoding="utf-8") as f:
    f.write(content)
PY
# Section 4: Formatting and submission block
echo '<artisan_submit>'
cat /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_npetest_table_4.sh && artisan submit /workspace/repro_npetest_table_4.sh
</mini_swe_agent_bash>
