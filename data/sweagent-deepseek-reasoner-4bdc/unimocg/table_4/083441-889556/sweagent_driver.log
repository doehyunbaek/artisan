    49	RUN \ 
    50	cd / && \
    51	mkdir /JDK && \
    52	cd JDK && \
    53	apt-get -y autoremove openjdk* && \ 
    54	apt-get -y purge openjdk* && \
    55	wget https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u342-b07/OpenJDK8U-jdk_x64_linux_hotspot_8u342b07.tar.gz && \
    56	tar xvf /JDK/OpenJDK8U-jdk_x64_linux_hotspot_8u342b07.tar.gz -C /opt && \
    57	cd / && \
    58	update-alternatives --install /usr/bin/java java /opt/jdk8u342-b07/bin/java 1000 && \
    59	update-alternatives --install /usr/bin/javac javac /opt/jdk8u342-b07/bin/javac 1000 && \
    60	update-alternatives --install /usr/bin/jar jar /opt/jdk8u342-b07/bin/jar 1000        
    61	#
    62	#
    63	RUN \
    64	cd / && \
    65	mkdir evaluation
    66	COPY evaluation /evaluation
    67	## Copy Runner
    68	RUN mkdir runner
    69	COPY runner /runner
    70	COPY corpora /corpora
    71	RUN cd /corpora/files && \
    72	git clone https://bitbucket.org/jensdietrich/xcorpus.git
    73	RUN for d in /corpora/files/xcorpus/data/qualitas_corpus_20130901/* ; do unzip $d/project/bin.zip -d $d/project/bin; done
    74	##
    75	## INSTALL SBT
    76	COPY container-files /
    77	##
    78	RUN \
    79	echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list && \
    80	echo "deb https://repo.scala-sbt.org/scalasbt/debian /" | tee /etc/apt/sources.list.d/sbt_old.list && \
    81	curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | apt-key add && \
    82	apt-get update && \
    83	apt-get install sbt
    84	#
    85	RUN \
    86	cd / && \
    87	mkdir /evaluation/results && \
    88	mkdir /evaluation/results/immutability && \
    89	mkdir /evaluation/results/immutability/AdHocCHA && \
    90	mkdir /evaluation/results/immutability/CHA && \
    91	mkdir /evaluation/results/immutability/RTA && \
    92	mkdir /evaluation/results/immutability/XTA && \
    93	mkdir /evaluation/testcases && \
    94	mkdir /evaluation/fingerprints && \
    95	mkdir /evaluation/results/xcorpus
    96	##
    97	## INSTALL OPAL
    98	ARG OPAL_BRANCH="develop"
    99	ARG OPAL_COMMIT_ID="95eafb2fc2f0ae72895d9dd75e26a514663595e3"
   100	##
   101	RUN cd / && \
   102	git clone https://github.com/stg-tud/opal.git && \
   103	cd opal && \
   104	git checkout ${OPAL_BRANCH} && \
   105	git reset --hard ${OPAL_COMMIT_ID} && \
   106	sbt publishLocal
   107	#
   108	## INSTALL JCG 
   109	RUN cd / && \ 
   110	mkdir JCG && \
   111	cd /JCG && \
   112	git clone https://github.com/opalj/JCG.git && \
   113	cd /JCG/JCG && \
   114	sbt compile && \
   115	sbt "project jcg_testcases ; runMain TestCaseExtractor --rsrcDir jcg_testcases/src/main/resources"
   116	RUN cp -r /JCG/JCG/testcaseJars/* /evaluation/testcases
   117	RUN cp -r /JCG/JCG/infrastructure_incompatible_testcases/compiled_jars_and_configs/* /evaluation/testcases
   118	COPY /jre.conf /JCG/JCG/jre.conf
   119	##
   120	### preparing immutability analysis
   121	COPY immutability/Immutability_Adhoc.scala /opal/DEVELOPING_OPAL/tools/src/main/scala/org/opalj/support/info/Immutability_Adhoc.scala
   122	COPY immutability/AdHocCHAFieldImmutabilityAnalysis.scala /opal/OPAL/tac/src/main/scala/org/opalj/tac/fpcf/analyses/AdHocCHAFieldImmutabilityAnalysis.scala
   123	### 
   124	##
   125	###
   126	RUN chmod +x /runner/createFingerprint.sh
   127	RUN chmod +x /runner/createFingerprintsAll.sh
   128	RUN chmod +x /runner/*.sh
   129	RUN chmod +x /runner/runJCG.sh
   130	RUN chmod +x /runner/runJCGAll.sh
   131	RUN chmod +x /runner/opalImmutability.sh
   132	RUN chmod +x /evaluation/opal/scripts/OPALImmutability.sh
