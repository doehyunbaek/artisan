    "P3": "——",
    "P4": "〜∿",
    "P5": "〜∿",
    "P6": "——",
    "P7": "〜∼",
    "P8": "——",
    "P9": "〜∿",
    "P10": "〜∿",
    "Overall": "〜∿",
}

def format_spearman(proj, rho, p):
    alpha = 0.05
    # Special obfuscated formatting for P8: keep only the sign and p-category, hide digits
    if proj == "P8":
        return "\u2212?.??? *(p = ?.?? > α)*"

    sign = "+" if rho >= 0 else "\u2212"
    rho_abs = f"{abs(rho):.3f}"

    if p >= alpha:
        p_str = f"p = {p:.2f} > α"
    elif p < 1e-10:
        p_str = "p ≪ α"
    else:
        p_str = "p < α"

    return f"{sign}{rho_abs} *({p_str})*"

