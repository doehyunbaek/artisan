#!/usr/bin/bash
# Script to run ProveNFix on all 10 projects and extract repaired bugs count

CONTAINER_ID=8a42368e6075ece47d00aa0c09fd0c21be0b7d78d6b62a5551cddd4d4ceec233

# Define projects and their spec files
projects=("swoole-src" "lxc" "WavPack" "flex" "p11-kit" "x264" "recutils-1.8" "inetutils-1.9.4" "snort-2.9.13" "grub")
specs=("spec_Swoole.c" "spec_Lxc.c" "spec_WavPack.c" "spec_flex.c" "spec_p11.c" "spec-x264.c" "spec-recutils.c" "spec-inetutils.c" "spec_snort-2.9.13.c" "spec_Grub.c")

# Results array
declare -a results
total=0

for i in "${!projects[@]}"; do
    project="${projects[$i]}"
    spec="${specs[$i]}"
    echo "Processing $project with spec $spec"
    
    # Copy spec file
    docker exec $CONTAINER_ID bash -c "cd /home/infer_TempFix && cp $spec spec.c" 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "Warning: Failed to copy spec for $project"
        results[$i]="??"
        continue
    fi
    
    # Run make clean in project directory
    docker exec $CONTAINER_ID bash -c "cd /home/benchmarks-RQ1N2/$project && make clean > /dev/null 2>&1 || true" 2>/dev/null
    
    # Run tempFix and capture output
    output=$(docker exec $CONTAINER_ID bash -c "cd /home/benchmarks-RQ1N2/$project && timeout 300 /home/infer_TempFix/infer/bin/tempFix 2>&1" 2>/dev/null)
    
    # Extract repaired bugs count
    repaired=$(echo "$output" | grep -o '\[Repaired Bugs\][[:space:]]*[0-9]*' | grep -o '[0-9]*' | head -1)
    
    if [ -n "$repaired" ]; then
        results[$i]="$repaired"
        total=$((total + repaired))
        echo "  Repaired Bugs: $repaired"
    else
        results[$i]="??"
        echo "  Could not extract repaired bugs count"
    fi
done

# Write results to repro.txt
echo "Project,Repaired Bugs" > /workspace/repro.txt
for i in "${!projects[@]}"; do
    echo "${projects[$i]},${results[$i]}" >> /workspace/repro.txt
done
echo "Total,$total" >> /workspace/repro.txt

echo "Results written to /workspace/repro.txt"
cat /workspace/repro.txt
EOF
chmod +x /workspace/run_experiments.sh
</mini_swe_agent_bash>
