<mini_swe_agent_bash>
docker exec dypybench /bin/bash --noprofile --norc -c "python3 - <<'PY'
import json,glob,sys
from sequential.seq2pat import Seq2Pat

def split_by_callers(calls_sequence):
    counter = 1
    caller = calls_sequence[0].split('##')[-1]
    splitted_sequences = []
    s_temp = []
    s_temp.append(calls_sequence[0])
    i = 1
    while True:
        if i == len(calls_sequence):
            splitted_sequences.append(s_temp)
            break
        c = calls_sequence[i]
        if c.startswith('#START#'):
            if counter == 0 and c.split('##')[-1] != caller:
                splitted_sequences.append(s_temp)
                s_temp = [c]
                if i == len(calls_sequence):
                    splitted_sequences.append(s_temp)
                    break
                else:
                    caller = c
            else:
                s_temp.append(c)
            counter += 1
        elif c.startswith('#END#'):
            counter -= 1
            s_temp.append(c)
        i = i + 1
    return splitted_sequences

def preprocess_sequences(seq_calls):
    final_list = []
    seq_calls = [seq_calls]
    while True:
        temp_seq = []
        for sc in seq_calls:
            temp_seq.extend(split_by_callers(sc))
        final_list.extend(temp_seq)
        seq_calls = []
        for s in temp_seq:
            if len(s) not in [0,1,2]:
                seq_calls.append(s[1:-1])
        if len(seq_calls) == 0:
            break
    simple_final_list = []
    for l in final_list:
        simple_final_list.append([c.split('##')[0] for c in l])
    # filter interrupted sequences
    filtered_list = []
    for l in simple_final_list:
        try:
            new_l = []
            while l and l[0].startswith('#END#'):
                l = l[1:]
            if not l:
                continue
            c_old = l[0].split('#')[2]
            for c in l[1:]:
                if c.split('#')[2] == c_old:
                    new_l.append(c_old)
                c_old = c.split('#')[2]
            if new_l:
                filtered_list.append(new_l)
        except Exception:
            continue
    filtered_list = [f for f in filtered_list if len(f) != 0]
    return filtered_list

all_filtered = []
files = sorted(glob.glob('/DyPyBench/experiments/callgraph_seq/*.json'))
for fn in files:
    try:
        with open(fn) as f:
            seq_calls = json.load(f)
        fl = preprocess_sequences(seq_calls)
        all_filtered.extend(fl)
        print(f'Processed {fn}: sequences={len(fl)}', file=sys.stderr)
    except Exception as e:
        print('Error processing', fn, e, file=sys.stderr)

print('Total aggregated sequences:', len(all_filtered), file=sys.stderr)
if not all_filtered:
    print('NO_SEQUENCES', file=sys.stdout)
    sys.exit(0)

# Run Seq2Pat on aggregated sequences (may take time)
seq2pat = Seq2Pat(sequences=all_filtered)
patterns = seq2pat.get_patterns(min_frequency=3)

# Output patterns and also show ones matching key examples
import re
print('PATTERN_COUNT', len(patterns))
for p in patterns:
    print(p)

print('\\n--- FILTERED FOR KEY EXAMPLES ---')
for p in patterns:
    names = [str(x) for x in p[:-1]]
    if any(re.search(r'isinstance', n) for n in names) or any(re.search(r'Match\.span|Pattern\.match|isidentifier', n) for n in names):
        print(p)
PY" > /workspace/repro_all_patterns.txt
</mini_swe_agent_bash>
