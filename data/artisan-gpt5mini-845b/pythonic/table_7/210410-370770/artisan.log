<mini_swe_agent_bash>
Rscript -e 'df <- read.csv("ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv", stringsAsFactors=FALSE); sub <- df[tolower(df$Construct) == "reduce", , drop=FALSE]; sub$Outcome <- as.logical(sub$Outcome); sub$MainFactorProc <- ifelse(sub$MainFactor == "p", 1, 0); sub$UsageFrequency <- as.numeric(sub$UsageFrequency); sub$Approvals <- as.numeric(sub$Approvals); sub$StudentTrue <- ifelse(tolower(as.character(sub$Student)) == "true", 1, 0); if(nrow(sub)==0){ cat("No rows for construct == reduce\n"); quit(status=0) }; m <- glm(Outcome ~ MainFactorProc + UsageFrequency + Approvals + StudentTrue, family=binomial(link="logit"), data=sub); s <- summary(m); sink("/workspace/repro.txt"); cat("AIC=", AIC(m), "\n\n"); print(s$coefficients); sink()' 
