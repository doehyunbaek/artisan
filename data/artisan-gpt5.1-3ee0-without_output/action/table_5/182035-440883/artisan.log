p1 = get_percents(data_lines[1])
cost1 = get_cost(data_lines[0])

imp1_all, time1_all = p0
imp1_sub, time1_sub = p1

# Heuristic 2: Deactivate scheduled workflows during repository inactivity
p2 = get_percents(data_lines[2])
p3 = get_percents(data_lines[3])
cost2 = get_cost(data_lines[2])

imp2_all, time2_all = p2
imp2_sub, time2_sub = p3

# Heuristic 3: Run previously failed jobs first
p4 = get_percents(data_lines[4])
p5 = get_percents(data_lines[5])
cost3 = get_cost(data_lines[4])

imp3_all, time3_all = p4
imp3_sub, time3_sub = p5

# Heuristic 4: Project-specific timeouts
p6 = get_percents(data_lines[6])
cost4 = get_cost(data_lines[6])

imp4_all, time4_all = p6

table_lines = []
table_lines.append("**Table 5: Prevalence and impact of our suggested optimization techniques in paid tier (free tier).**")
table_lines.append("")
table_lines.append("| Optimization heuristic                                            |                                            Impacted runs * |                                                         Time saving * | Annual cost delta per repository in $ * |")
table_lines.append("| ----------------------------------------------------------------- | ---------------------------------------------------------: | --------------------------------------------------------------------: | --------------------------------------: |")
table_lines.append(f"| Deactivate scheduled workflows after k consecutive failures (k=3) | {imp1_all}<br>{imp1_sub} | {time1_all}<br>{time1_sub}  |                         {cost1} |")
table_lines.append(f"| Deactivate scheduled workflows during repository inactivity       | {imp2_all}<br>{imp2_sub} | {time2_all}<br>{time2_sub}   |                          {cost2} |")
table_lines.append(f"| Run previously failed jobs first                                  | {imp3_all}<br>{imp3_sub}    | {time3_all}<br>{time3_sub}    |                          {cost3} |")
table_lines.append(f"| Project-specific timeouts                                         | {imp4_all}                                   | {time4_all}                                         |                        {cost4} |")
table_lines.append("")
table_lines.append("* measurement for paid tier (measurement for free tier)")
table_lines.append("")

Path("/workspace/repro.txt").write_text("\n".join(table_lines), encoding="utf-8")
