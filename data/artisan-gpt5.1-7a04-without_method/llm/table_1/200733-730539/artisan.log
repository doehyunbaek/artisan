cat(\"| Adj. *R*²           | \", adj_prog_c,      \" | \", adj_time,        \" | \", adj_under_c,     \" | \", adj_prof_c,       \" | \", adj_stud_c,       \" |\\n\", sep = \"\")
cat(\"\\n\\n*Note: * p < 0.1; ** p < 0.05; *** p < 0.01.*\\n\")
RSCRIPT"
