import os, csv

# Define files and mapping to constructs
base = "ICSE2024-funcConstructs-Artifacts/ICSE2024-funcConstructs-Artifacts/working-results/inter-rater-RQ3-files"
files = {
    "lambda": os.path.join(base, "lambda.csv"),
    "comprehension": os.path.join(base, "comprehension.csv"),
    "mrf": os.path.join(base, "mrf.csv"),
    "procedural": os.path.join(base, "procedural.csv")
}

reasons = [
    ("Coding time", ["coding", "time"]),
    ("Ease of use", ["ease", "easy", "use"]),
    ("Maintainability", ["maintain", "maintainability"]),
    ("Performance", ["perform", "performance", "fast"]),
    ("Readability/Understandability", ["readab", "understand", "understandability"]),
    ("Size", ["size"]),
    ("Lack of knowledge", ["lack", "knowledge", "unknown"]),
    ("Project constraints", ["project", "constraint", "constraints"]),
    ("Simplify debugging", ["debug", "debugging", "simplif"])
]

# Initialize counts
counts = {k: {r[0]: 0 for r in reasons} for k in files.keys()}

def match_reason(text, keywords):
    t = text.lower()
    for kw in keywords:
        if kw in t:
            return True
    return False

for construct, path in files.items():
    if not os.path.exists(path):
        # skip missing files gracefully
        continue
    # read as tab-separated (as in R usage)
    with open(path, newline='', encoding='utf-8') as fh:
        # attempt to detect delimiter; files are tab-separated per README
        reader = csv.reader(fh, delimiter='\t')
        try:
            header = next(reader)
        except StopIteration:
            continue
        # find final classification column (case-insensitive substring 'final')
        final_idx = None
        for i, col in enumerate(header):
            if col and 'final' in col.lower():
                final_idx = i
                break
        if final_idx is None:
            # try some common alternatives
            for i, col in enumerate(header):
                if col and ('classification' in col.lower() or 'final classification' in col.lower()):
                    final_idx = i
                    break
        if final_idx is None:
            # if no header match, try to scan all columns
            for row in reader:
                for cell in row:
                    if cell:
                        for r, kws in reasons:
                            if match_reason(cell, kws):
                                counts[construct][r] += 1
                # continue scanning remaining rows
            continue
        # process rows
        for row in reader:
            if final_idx < len(row):
                cell = row[final_idx]
                if not cell:
                    continue
                for r, kws in reasons:
                    if match_reason(cell, kws):
                        counts[construct][r] += 1

# Write markdown table to /workspace/repro.txt
out_lines = []
out_lines.append("**Table 10: Reasons for using functional and procedural code (counts)**")
out_lines.append("")
out_lines.append("| Reason | Lambdas | Comp. | MRF | Proc. |")
out_lines.append("| --- | ---: | ---: | ---: | ---: |")
for r, _ in reasons:
    line = "| {} | {} | {} | {} | {} |".format(
        r,
        counts.get("lambda", {}).get(r, 0),
        counts.get("comprehension", {}).get(r, 0),
        counts.get("mrf", {}).get(r, 0),
        counts.get("procedural", {}).get(r, 0)
    )
    out_lines.append(line)

with open("/workspace/repro.txt", "w", encoding="utf-8") as out:
    out.write("\n".join(out_lines))

print("WROTE /workspace/repro.txt")
PY

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF

chmod +x /workspace/repro_pythonic_table_10.sh && artisan submit /workspace/repro_pythonic_table_10.sh
