python - << 'PY'
import csv
from pathlib import Path

csv_path = Path("/workspace/results.csv")
out_path = Path("/workspace/repro.txt")

# Map raw benchmark names from the artifact to the names (with * / **) used in Table 1.
name_map = {
    "binn-3.0": "binn-3.0**",
    "brotli-1.0.9": "brotli-1.0.9**",
    "compton": "compton*",
    "hiredis": "hiredis*",
    "minilisp": "minilisp*",
    "php-rdkafka": "php-rdkafka*",
    "pocketlang": "pocketlang*",
    "raygui": "raygui*",
    "shairport": "shairport*",
    "tinyproxy": "tinyproxy*",
    "twemproxy": "twemproxy*",
    "webdis": "webdis*",
}

rows = []
with csv_path.open(newline="") as f:
    reader = csv.reader(f)
    header = next(reader, None)  # skip header
    for row in reader:
        # Stop before the blank and "Sum" rows at the bottom.
        if not row or not row[0].strip():
            break
        rows.append(row)

total_unions = 0
total_candidates = 0
total_identified = 0

lines = []
lines.append("**Table 1: Benchmark programs**")
lines.append("")
lines.append("| Name | C LOC | Rust LOC | #Unions | #Candidates | #Identified |")
lines.append("| --- | --- | --- | --- | --- | --- |")

for r in rows:
    name = r[0].strip()
    display_name = name_map.get(name, name)
    c_loc = int(float(r[1])) if r[1] else 0
    r_loc = int(float(r[2])) if r[2] else 0
    unions = int(float(r[3])) if r[3] else 0
    candidates = int(float(r[4])) if r[4] else 0
    identified = int(float(r[5])) if r[5] else 0

    total_unions += unions
    total_candidates += candidates
    total_identified += identified

    lines.append(f"| {display_name} | {c_loc} | {r_loc} | {unions} | {candidates} | {identified} |")

# Append the totals row, computed from the artifact data.
lines.append(f"| Total |  |  | {total_unions} | {total_candidates} | {total_identified} |")

out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY

