years = total_start_ts / (12 * 30 * 24 * 3600)
saved_cost2 = calculate_costs(sum([s for s in saved_time if not np.isnan(s)]) / 60 / years)

optimizations["vm_timeout"] = {
    "paid": {
        "all_runs": impacted_runs1,
        "saved_time_all": saved_time1,
