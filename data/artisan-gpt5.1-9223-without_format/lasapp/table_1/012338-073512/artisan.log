function count_lines_of_code_in_file(filename)
    c = 0
    open(filename, "r") do f
        for line in split(read(f,String), "\n")
            if startswith(line, r"\s*#")
                # comments
                continue
            end
            if !contains(line, r"[^\s]+")
                # empty line
                continue
            end
            c += 1
        end
    end
