#!/usr/bin/env python3
from decimal import Decimal, ROUND_HALF_UP
import re

def read_lines(path):
    with open(path, 'r', encoding='utf-8') as f:
        return [l.rstrip('\n') for l in f]

expected_lines = read_lines("/workspace/expected.md")
comp_lines = read_lines("/workspace/repro.txt")

def table_rows(lines):
    rows = []
    in_table = False
    for ln in lines:
        if ln.strip().startswith("| Fuzzer"):
            in_table = True
            continue
        if in_table:
            if re.match(r"\|\s*-{3,}", ln):
                continue
            if ln.strip().startswith("|"):
                cells = ln.split("|")[1:-1]
                rows.append([c for c in cells])
            else:
                break
    return rows

exp_rows = table_rows(expected_lines)
comp_rows = table_rows(comp_lines)

def round_str(value_str, q_after):
    v = value_str.strip()
    if not v or v == "—" or v == "-":
        return None
    try:
        d = Decimal(v.replace(",",""))
    except Exception:
        return None
    if q_after > 0:
        quant = Decimal('1.' + ('0'*q_after))
        d = d.quantize(quant, rounding=ROUND_HALF_UP)
    else:
        d = d.quantize(Decimal('1'), rounding=ROUND_HALF_UP)
    s = format(d, 'f')
    if '.' in s:
        intp, frac = s.split('.',1)
    else:
        intp, frac = s, ''
    if q_after > 0:
        frac = (frac + '0'*q_after)[:q_after]
        s = intp + '.' + frac
    else:
        s = intp
    # Do NOT pad integer part (no leading zeros)
    return s

out_lines = []
data_idx = 0
for ln in expected_lines:
    if ln.strip().startswith("|") and not ln.strip().startswith("| Fuzzer") and not re.match(r"\|\s*-{3,}", ln):
        parts = ln.split("|")
        cells = parts[1:-1]
        filled = []
        comp_cells = comp_rows[data_idx] if data_idx < len(comp_rows) else None
        for i, cell in enumerate(cells):
            if '?' not in cell:
                filled.append(cell)
                continue
            comp_val = None
            if comp_cells and i < len(comp_cells):
                comp_val = comp_cells[i].strip()
            # count placeholders around decimal
            if '.' in cell:
                left,right = cell.split('.',1)
                q_before = left.count('?')
                q_after = right.count('?')
            else:
                q_before = cell.count('?')
                q_after = 0
            formatted = round_str(comp_val if comp_val is not None else "0", q_after)
            if formatted is None:
                # replace ? with em-dash behavior: keep em-dash if template had it; otherwise fill zeros
                # Here substitute each ? with '0'
                replaced = ''.join(('0' if ch=='?' else ch) for ch in cell)
                filled.append(replaced)
                continue
            # extract digits from formatted in order
            digits = [c for c in formatted if c.isdigit()]
            di = 0
            out_chars = []
            for ch in cell:
                if ch == '?':
                    if di < len(digits):
                        out_chars.append(digits[di])
                        di += 1
                    else:
                        out_chars.append('0')
                else:
                    out_chars.append(ch)
            filled.append("".join(out_chars))
        newln = "|" + "|".join(filled) + "|"
        out_lines.append(newln)
        data_idx += 1
    else:
        out_lines.append(ln)

with open("/workspace/repro_filled_fixed.txt","w",encoding='utf-8') as f:
    f.write("\n".join(out_lines) + "\n")
print("Wrote /workspace/repro_filled_fixed.txt")
