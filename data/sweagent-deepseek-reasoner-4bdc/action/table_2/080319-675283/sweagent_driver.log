import sys
sys.path.insert(0, '/workdir/src')
import time
import warnings
warnings.filterwarnings('ignore')
from runs_collector.dataset import RunsDataSet
from runs_analysis.resource_usage import get_tiers
from runs_analysis.name_based_analysis import simplify_and_map

print("Loading dataset...")
start = time.time()
workdir = "/workdir/"
data_set = RunsDataSet(None, None, from_checkpoint=True, checkpoint_dir="./")
end = time.time()
print(f"Time taken to load the dataset: {round(end - start, 0)} seconds")

repos_list_1, repos_list_2 = get_tiers(data_set)
print(f"Paid-tier repos: {len(repos_list_1)}, Free-tier repos: {len(repos_list_2)}")

# tasks defined in notebook
tasks = ["test", "build", "release", "analyze", "lint", "linux", "update", "integration", "deploy", "sync"]
all_jobs_1 = simplify_and_map(data_set, repos_list_1)
all_jobs_2 = simplify_and_map(data_set, repos_list_2)

all_jobs_1["up_time_min"] = all_jobs_1.up_time / 60
all_jobs_2["up_time_min"] = all_jobs_2.up_time / 60

sum_t1 = sum([all_jobs_1[all_jobs_1.sub_names==t].up_time.sum() for t in tasks])
sum_t2 = sum([all_jobs_2[all_jobs_2.sub_names==t].up_time.sum() for t in tasks])

total_runs_1 = all_jobs_1[all_jobs_1.sub_names.isin(tasks)].shape[0]
total_runs_2 = all_jobs_2[all_jobs_2.sub_names.isin(tasks)].shape[0]

def calc_costs_by_task(time, task):
    os_factor = 1.52
    return time * os_factor * 0.008

print("\nTable 2 Results:")
print("Task\tVM time % (Paid)\tVM time % (Free)\tRuns % (Paid)\tRuns % (Free)\tVM time per run, min (Paid)\tVM time per run, min (Free)\tVM cost per run, $ (Paid)\tVM cost per run, $ (Free)")
for t in tasks:
    vm_time_paid = round(all_jobs_1[all_jobs_1.sub_names==t].up_time.sum()/sum_t1*100, 1)
    vm_time_free = round(all_jobs_2[all_jobs_2.sub_names==t].up_time.sum()/sum_t2*100, 1)
    runs_paid = round(all_jobs_1[all_jobs_1.sub_names==t].shape[0]/total_runs_1*100, 1)
    runs_free = round(all_jobs_2[all_jobs_2.sub_names==t].shape[0]/total_runs_2*100, 1)
    avg_time_paid = round(all_jobs_1[all_jobs_1.sub_names==t].up_time_min.sum()/all_jobs_1[all_jobs_1.sub_names==t].shape[0], 1)
    avg_time_free = round(all_jobs_2[all_jobs_2.sub_names==t].up_time_min.sum()/all_jobs_2[all_jobs_2.sub_names==t].shape[0], 1)
    iqr_paid = round(all_jobs_1[all_jobs_1.sub_names==t].up_time_min.quantile(0.75) - all_jobs_1[all_jobs_1.sub_names==t].up_time_min.quantile(0.25), 1)
    iqr_free = round(all_jobs_2[all_jobs_2.sub_names==t].up_time_min.quantile(0.75) - all_jobs_2[all_jobs_2.sub_names==t].up_time_min.quantile(0.25), 1)
    cost_paid = round(calc_costs_by_task(avg_time_paid, t), 2)
    cost_free = round(calc_costs_by_task(avg_time_free, t), 2)
    print(f"{t}\t{vm_time_paid}\t{vm_time_free}\t{runs_paid}\t{runs_free}\t{avg_time_paid} ({iqr_paid})\t{avg_time_free} ({iqr_free})\t{cost_paid}\t{cost_free}")
EOF
