output_lines.append("| Subject | Linked HY | Linked IR | One Point HY | One Point IR | Two Point HY | Two Point IR |")
output_lines.append("| ------- | --------: | --------: | -----------: | -----------: | -----------: | -----------: |")

for subject in subjects:
    hy_row = hy_pivot.loc[subject]
    ir_row = ir_pivot.loc[subject]
    
    linked_hy = f"{hy_row['Linked']:.3f}" if not pd.isna(hy_row['Linked']) else "?"
    linked_ir = f"{ir_row['Linked']:.3f}" if not pd.isna(ir_row['Linked']) else "?"
    one_hy = f"{hy_row['One Point']:.3f}" if not pd.isna(hy_row['One Point']) else "?"
    one_ir = f"{ir_row['One Point']:.3f}" if not pd.isna(ir_row['One Point']) else "?"
    two_hy = f"{hy_row['Two Point']:.3f}" if not pd.isna(hy_row['Two Point']) else "?"
    two_ir = f"{ir_row['Two Point']:.3f}" if not pd.isna(ir_row['Two Point']) else "?"
    
    # Adjust subject name: Bcel -> BCEL
    display_subject = "BCEL" if subject == "Bcel" else subject
    output_lines.append(f"| {display_subject} | {linked_hy} | {linked_ir} | {one_hy} | {one_ir} | {two_hy} | {two_ir} |")

with open("/workspace/repro.txt", "w") as f:
    f.write("\n".join(output_lines))

print("Table written to /workspace/repro.txt")
