    next_milestone = milestone
    next_token = 1
    for run in runs:
        print("COLLECTING DATA FOR RUN:", i)
        i += 1
        if i == next_milestone:
            next_token = (next_token + 1) % len(tokens)
            next_milestone += milestone
        print("USING TOKEN WITH INDEX NUMBER:", next_token)
        data = run_to_tables(run, tokens[next_token])
        if data is None:
