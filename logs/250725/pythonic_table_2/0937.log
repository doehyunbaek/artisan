import pandas as pd
import numpy as np

# Load the data from the CSV files
rq1_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1.csv')
rq1paired_data = pd.read_csv('/data/working-results/RQ1-RQ2-files-for-statistical-analysis/RQ1Paired-RQ2.csv')

# Calculate the statistics for RQ1
lambda_stats = rq1_data[rq1_data['Section'] == 'lambda']['Outcome'].value_counts(normalize=True)
comp_stats = rq1_data[rq1_data['Section'] == 'comp']['Outcome'].value_counts(normalize=True)
mrf_stats = rq1_data[rq1_data['Section'] == 'mrf']['Outcome'].value_counts(normalize=True)

# Prepare the results table
results = {
    'Construct': ['Lambda', 'Comprehension', 'MRF'],
    'Functional Correct': [lambda_stats.get(True, 0), comp_stats.get(True, 0), mrf_stats.get(True, 0)],
    'Functional Wrong': [lambda_stats.get(False, 0), comp_stats.get(False, 0), mrf_stats.get(False, 0)],
    'Procedural Correct': [0, 0, 0],  # Placeholder for procedural stats
    'Procedural Wrong': [0, 0, 0]  # Placeholder for procedural stats
}
results_df = pd.DataFrame(results)

# Calculate percentages
results_df['% Corr.'] = (results_df['Functional Correct'] / (results_df['Functional Correct'] + results_df['Functional Wrong'])) * 100
results_df['% Corr.'] = results_df['% Corr.'].round(2)

# Display the results
results_df
