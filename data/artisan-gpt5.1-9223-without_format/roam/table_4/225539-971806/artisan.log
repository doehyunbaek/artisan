from pathlib import Path
import statistics as stats

def split_row(line):
    return line.strip().strip('|').split('|')

lines = Path("ROAM-Artifact/ROAM-Artifact/Evaluation/results.md").read_text().splitlines()

# Locate header
hdr_idx = None
for i, line in enumerate(lines):
    if line.startswith("|Col1|Col2|Col3|Col4|"):
        hdr_idx = i
        break
if hdr_idx is None:
    raise SystemExit("Header row not found")

group_hdr = split_row(lines[hdr_idx])
metric_hdr = split_row(lines[hdr_idx + 2])

# Find PRM / Event / Path indices and infer ROAM total
prm_idx = None
for idx, m in enumerate(metric_hdr):
    if "PRM<br>Construction<br>Time" in m:
        prm_idx = idx
        break
if prm_idx is None:
    raise SystemExit("PRM Construction column not found")

event_idx = prm_idx + 1
path_idx = prm_idx + 2
total_idx = prm_idx - 1  # ROAM total running time is just before PRM

# Find ReCDroid & Yakusu running time indices
recdroid_idx = yakusu_idx = None
for idx, (g, m) in enumerate(zip(group_hdr, metric_hdr)):
    if g.strip() == "ReCDroid" and "Running<br>Time" in m:
        recdroid_idx = idx
    if g.strip() == "Yakusu" and "Running<br>Time" in m:
        yakusu_idx = idx
if recdroid_idx is None or yakusu_idx is None:
    raise SystemExit(f"ReCDroid/Yakusu indices not found (ReCDroid={recdroid_idx}, Yakusu={yakusu_idx})")

max_idx = max(total_idx, prm_idx, event_idx, path_idx, recdroid_idx, yakusu_idx)

def parse_float(s):
    s = s.strip()
    if not s:
        return None
    try:
        return float(s)
    except ValueError:
        return None

vals = {
    "ROAM_total": [],
    "ROAM_prm": [],
    "ROAM_event": [],
    "ROAM_path": [],
    "ReCDroid": [],
    "Yakusu": [],
}

# Data rows start after header+3 (group, separator, metric), until table ends
for line in lines[hdr_idx + 3:]:
    if not line.startswith("|"):
        break
    cells = split_row(line)
    if len(cells) <= max_idx:
        continue
    # First column should be row index (1..72); skip non-data rows
    if not cells[0].strip().isdigit():
        continue

    t = parse_float(cells[total_idx])
    p = parse_float(cells[prm_idx])
    e = parse_float(cells[event_idx])
    pa = parse_float(cells[path_idx])
    r = parse_float(cells[recdroid_idx])
    y = parse_float(cells[yakusu_idx])

    if t is not None: vals["ROAM_total"].append(t)
    if p is not None: vals["ROAM_prm"].append(p)
    if e is not None: vals["ROAM_event"].append(e)
    if pa is not None: vals["ROAM_path"].append(pa)
    if r is not None: vals["ReCDroid"].append(r)
    if y is not None: vals["Yakusu"].append(y)

def summarize(name):
    v = vals[name]
    print(f"{name}: n={len(v)}, avg={stats.mean(v):.2f}, med={stats.median(v):.2f}")

print("Column indices:")
print(f"  ROAM_total={total_idx}, PRM={prm_idx}, Event={event_idx}, Path={path_idx}, ReCDroid={recdroid_idx}, Yakusu={yakusu_idx}")
print()
summarize("ROAM_prm")
summarize("ROAM_event")
summarize("ROAM_path")
summarize("ROAM_total")
summarize("ReCDroid")
summarize("Yakusu")
PY
