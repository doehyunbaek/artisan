<mini_swe_agent_bash>
python - << 'PY'
import csv, os

path = "/workspace/npedetection.csv"
if not os.path.exists(path):
    raise SystemExit(f"{path} not found; regenerate it with in2csv first.")

with open(path, newline="") as f:
    r = csv.reader(f)
    header = next(r)
    # Expect columns: a,b,c,d,e,evosuite,evosuite_def,npetest
    # a = suite (NPEX, BugSwarm, ...), evosuite & evosuite_def are reproduction rates
    idx_suite = header.index("a")
    idx_evo = header.index("evosuite")
    idx_evo_def = header.index("evosuite_def")

    suites = ["NPEX", "BugSwarm", "Defects4J", "Genesis", "Bears"]
    counts = {s: {"total": 0, "evo": 0, "evo_def": 0} for s in suites}

    for row in r:
        suite = row[idx_suite]
        if suite not in suites:
            continue
        try:
            evo = float(row[idx_evo])
            evo_def = float(row[idx_evo_def])
        except ValueError:
            continue
        c = counts[suite]
        c["total"] += 1
        if evo > 0:
            c["evo"] += 1
        if evo_def > 0:
            c["evo_def"] += 1

for s in suites:
    c = counts[s]
    if c["total"] == 0:
        continue
    evo_pct = 100.0 * c["evo"] / c["total"]
    evo_def_pct = 100.0 * c["evo_def"] / c["total"]
    print(f"{s}: EvoSuite={evo_pct:.3f}%, EvoSuite_Def={evo_def_pct:.3f}% (total NPEs={c['total']})")

# Also compute overall totals across all suites
total = {"total": 0, "evo": 0, "evo_def": 0}
for s in suites:
    c = counts[s]
    total["total"] += c["total"]
    total["evo"] += c["evo"]
    total["evo_def"] += c["evo_def"]

if total["total"] > 0:
    print("TOTAL:",
          f"EvoSuite={100.0*total['evo']/total['total']:.3f}%,",
          f"EvoSuite_Def={100.0*total['evo_def']/total['total']:.3f}% (total NPEs={total['total']})")
PY
</mini_swe_agent_bash>
