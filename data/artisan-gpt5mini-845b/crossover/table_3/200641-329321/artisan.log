import os, json, collections, sys, re

# Find campaigns base dir from likely locations
candidates = [
    "/workspace/campaigns/campaigns",
    "/workspace/campaigns",
    "campaigns/campaigns",
    "campaigns"
]
base = None
for c in candidates:
    if os.path.isdir(c):
        base = c
        break
if not base:
    print("ERROR: campaigns directory not found among candidates:", candidates, file=sys.stderr)
    sys.exit(1)

tc = collections.Counter()
fw = collections.Counter()
crossover = collections.Counter()
other_zeugma_opts = collections.Counter()
samples = []

for entry in sorted(os.listdir(base))[:10000]:
    d = os.path.join(base, entry)
    if not os.path.isdir(d):
        continue
    p = os.path.join(d, "summary.json")
    if not os.path.isfile(p):
        continue
    try:
        j = json.load(open(p))
    except Exception:
        continue
    cfg = j.get("configuration", {})
    tcname = cfg.get("testClassName")
    if tcname:
        tc[tcname] += 1
    fwname = j.get("frameworkClassName")
    if fwname:
        fw[fwname] += 1
    opts = cfg.get("javaOptions", []) or []
    for o in opts:
        # capture -Dzeugma.crossover=VALUE
        m = re.match(r"-Dzeugma\.crossover=(.+)", o)
        if m:
            crossover[m.group(1)] += 1
        m2 = re.match(r"-Dzeugma\.([^=]+)=(.+)", o)
        if m2 and m2.group(1) != "crossover":
            other_zeugma_opts[f"-Dzeugma.{m2.group(1)}={m2.group(2)}"] += 1
    # sample a few summary.json snippets for inspection
    if len(samples) < 5:
        samples.append({"path": p, "cfg_keys": list(cfg.keys())[:10], "javaOptions_len": len(opts), "testClassName": tcname, "framework": fwname})

print("CAMPAIGNS_BASE:", base)
print("\nTop testClassName values (count):")
for k,v in tc.most_common():
    print(f"  {v:5d}  {k}")
print("\nFrameworkClassName values (count):")
for k,v in fw.most_common():
    print(f"  {v:5d}  {k}")
print("\n-Dzeugma.crossover values (count):")
for k,v in crossover.most_common():
    print(f"  {v:5d}  {k}")
print("\nOther -Dzeugma.* javaOptions (sample counts):")
for k,v in other_zeugma_opts.most_common():
    print(f"  {v:5d}  {k}")
print("\nExample summary.json snippets (up to 5):")
for s in samples:
    print(" -", s["path"])
    print("    testClassName:", s["testClassName"])
    print("    framework:", s["framework"])
    print("    javaOptions length:", s["javaOptions_len"])
    print("    cfg keys (sample):", s["cfg_keys"])
PY
