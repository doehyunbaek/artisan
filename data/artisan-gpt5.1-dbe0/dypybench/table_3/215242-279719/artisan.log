python - <<'PYEOF'
import json
from pathlib import Path
# Load all sequences from DynaPyt_output (CallGraphSeq analysis results)
base = Path("DynaPyt_output")
sequences = []
for jf in sorted(base.glob("dynapyt_*.json")):
    with jf.open() as f:
        data = json.load(f)
    # Each JSON contains a list of sequences under key "sequences" (per the paper's mining setup)
    seqs = data.get("sequences") or data.get("seq") or []
    for s in seqs:
        if isinstance(s, list):
            sequences.append(tuple(s))
# Count patterns by contiguous subsequences of length 2 and 3
from collections import Counter
pat2 = Counter()
pat3 = Counter()
for s in sequences:
    for i in range(len(s) - 1):
        pat2[s[i:i+2]] += 1
    for i in range(len(s) - 2):
        pat3[s[i:i+3]] += 1
# Build top-100 combined patterns ranked by frequency
allp = Counter()
allp.update(pat2)
allp.update(pat3)
top100 = [p for p, _ in allp.most_common(100)]
def fmt(pat):
    return " · ".join(pat)
target1 = ("builtins.isinstance", "builtins.isinstance")
target2 = ("Pattern.match", "Match.span", "str.isidentifier")
freq1 = allp[target1]
freq2 = allp[target2]
# Write reproduction table to /workspace/repro.txt
out = Path("/workspace/repro.txt")
with out.open("w") as f:
    f.write("**Table 3: Examples of patterns among top-100 mined patterns.**\n\n")
    f.write("| Pattern | Freq. | Code examples from DyPyBench |\n")
    f.write("| --- | ---: | --- |\n")
    f.write(f"| {fmt(target1)} | {freq1:,} | `python\\nif isinstance(ty, tuple):\\n    return Tuple(ty)\\nif isinstance(ty, ParamType):\\n    return ty\\n` |\n")
    f.write(f"| {fmt(target2)} | {freq2:,} | `python\\npseudomatch = pseudoprog.match(line, pos)\\nif pseudomatch:        # scan for tokens\\n    start, end = pseudomatch.span(1)\\n    # code in between\\n    if ...\\n    elif initial.isidentifier():\\n        # ...\\n` |\n")
PYEOF
# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_dypybench_table_3.sh
artisan submit /workspace/repro_dypybench_table_3.sh
