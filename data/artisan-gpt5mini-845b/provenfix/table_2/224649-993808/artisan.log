import re, sys
path = '/workspace/repro.txt'
proj = 'Swoole'
results = []
try:
    with open(path, 'r', errors='ignore') as f:
        for line in f:
            line = line.rstrip('\n')
            m = re.match(r'^\s*====+\s*PROJECT:\s*(\S+)', line)
            if m:
                proj = m.group(1)
            if '[Failed Assert]' in line:
                m2 = re.search(r'([0-9]+)', line)
                num = m2.group(1) if m2 else 'NA'
                results.append((proj, num))
except FileNotFoundError:
    sys.exit("File /workspace/repro.txt not found")
if not results:
    print("No [Failed Assert] entries found in /workspace/repro.txt")
else:
    for p,n in results:
        print(f"{p} -> {n}")
PY
