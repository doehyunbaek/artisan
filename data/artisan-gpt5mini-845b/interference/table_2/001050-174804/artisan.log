  else
    echo "No analysis output found in $ART_DIR/data_analysis/out and no permutation_data.csv fallback; check run logs." > "$OUTFILE"
  fi
fi

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'

# Make script executable (for interactive use) and submit the script for evaluation
chmod +x /workspace/repro_interference_table_2.sh
artisan submit /workspace/repro_interference_table_2.sh
