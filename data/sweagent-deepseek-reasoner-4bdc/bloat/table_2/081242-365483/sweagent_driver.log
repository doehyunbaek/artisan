     1	import pandas as pd
     2	import argparse
     3	
     4	def parse_args():
     5	    parser = argparse.ArgumentParser(description='Produce statistics on the resolved and unresolved external calls during the stitching process (Table 2)')
     6	    parser.add_argument('-csv', '--csv', required=True, help='CSV with stitching metrics')
     7	    return parser.parse_args()
     8	
     9	
    10	def main():
    11	    args = parse_args()
    12	    df = pd.read_csv(args.csv)
    13	    total_unique_unresolved = df["unique_unresolved_count"].sum()
    14	    total_unique_resolved = df["unique_resolved_count"].sum()
    15	    total_calls = total_unique_resolved + total_unique_unresolved
    16	    resolved_proportion = total_unique_resolved / total_calls
    17	    unresolved_proportion = total_unique_unresolved / total_calls
    18	    resolved_average = total_unique_resolved / df["product"].count()
    19	    unresolved_average = total_unique_unresolved / df["product"].count()
    20	    resolved_median = df["unique_resolved_count"].median()
    21	    unresolved_median = df["unique_unresolved_count"].median()
    22	    print()
    23	    # Headers
    24	    headers = ["External Calls", "Aggregate count", "Proportion of total (%)", "Average (per project)", "Median (per project)"]
    25	    print("{:<15} {:<15} {:<25} {:<20} {:<20}".format(*headers))
    26	
    27	    # Data rows
    28	    print("{:<15} {:<15} {:<25.1f} {:<20.1f} {:<20.1f}".format("Resolved", total_unique_resolved, resolved_proportion * 100, resolved_average, resolved_median))
    29	    print("{:<15} {:<15} {:<25.1f} {:<20.1f} {:<20.1f}".format("Unresolved", total_unique_unresolved, unresolved_proportion * 100, unresolved_average, unresolved_median))
    30	
    31	if __name__ == "__main__":
    32	    main()
