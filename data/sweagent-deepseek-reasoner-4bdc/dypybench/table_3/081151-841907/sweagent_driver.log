    51	    "    ##      -- callee\n",
    52	    "    ##      -- callee ...\n",
    53	    "def split_by_callers(calls_sequence):\n",
    54	    "    counter = 1\n",
    55	    "    caller = calls_sequence[0].split(\"##\")[-1]\n",
    56	    "    splitted_sequences = []\n",
    57	    "    s_temp = []\n",
    58	    "    s_temp.append(calls_sequence[0])\n",
    59	    "    i = 1\n",
    60	    "    while True:\n",
    61	    "        if i == len(calls_sequence):\n",
    62	    "            splitted_sequences.append(s_temp)\n",
    63	    "            break\n",
    64	    "        c = calls_sequence[i]\n",
    65	    "        if c.startswith(\"#START#\"):\n",
    66	    "            if counter == 0 and c.split(\"##\")[-1] != caller:\n",
    67	    "                splitted_sequences.append(s_temp)\n",
    68	    "                s_temp = [c]\n",
    69	    "                if i == len(calls_sequence):\n",
    70	    "                    splitted_sequences.append(s_temp)\n",
    71	    "                    break\n",
    72	    "                else:\n",
    73	    "                    caller = c\n",
    74	    "            else:\n",
    75	    "                s_temp.append(c)\n",
    76	    "            counter += 1\n",
    77	    "        elif c.startswith(\"#END#\"):\n",
    78	    "            counter -= 1\n",
    79	    "            s_temp.append(c)\n",
    80	    "        i = i + 1\n",
    81	    "    return splitted_sequences\n",
    82	    "\n",
    83	    "splitted_seqs = split_by_callers(seq_calls)"
