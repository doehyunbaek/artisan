    try:
        ev = float(rowvals[3])
        evd = float(rowvals[4])
    except:
        # skip if not numeric
        continue
    data.append((parent, proj, cl, ev, evd))

# aggregate per parent
agg = defaultdict(list)
for parent,proj,cl,ev,evd in data:
    agg[parent].append((ev,evd))

import statistics
results={}
for parent,vals in agg.items():
    evs=[v[0] for v in vals]
    evds=[v[1] for v in vals]
    results[parent] = (statistics.mean(evs), statistics.mean(evds), len(vals))

# compute Total as mean across all entries
all_evs=[v[3] for v in data]
all_evds=[v[4] for v in data]
results['Total'] = (statistics.mean(all_evs), statistics.mean(all_evds), len(data))

for k in ['NPEX','BugSwarm','Defects4J','Genesis','Bears','Total']:
    if k in results:
        print(k, results[k])
    else:
        print('Missing', k)

# format percentages to 1 decimal
for k in ['NPEX','BugSwarm','Defects4J','Genesis','Bears','Total']:
    if k in results:
        ev,evd,n=results[k]
        print(k, f"EvoSuite: {ev:.1f}%, EvoSuite_Def: {evd:.1f}%, n={n}")
