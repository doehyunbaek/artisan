n_name": "Michael", "identifiers": [{"identifier": "0000-0003-1496-0531", "scheme": "orcid"}], "name": "Schr\u00f6der, Michael", "type": "personal"}, "role": {"id": "researcher", "title": {"de": "WissenschaftlerIn", "en": "Researcher"}}}, {"affiliations": [{"id": "04d836q62", "identifiers": [{"identifier": "04d836q62", "scheme": "ror"}, {"identifier": "grid.5329.d", "scheme": "grid"}, {"identifier": "0000 0004 1937 0669", "scheme": "isni"}], "name": "TU Wien"}], "person_or_org": {"family_name": "Cito", "given_name": "J\u00fcrgen", "identifiers": [{"identifier": "0000-0001-8619-1271", "scheme": "orcid"}], "name": "Cito, J\u00fcrgen", "type": "personal"}, "role": {"id": "supervisor", "title": {"de": "SupervisorIn", "en": "Supervisor"}}}], "creators": [{"affiliations": [{"id": "04d836q62", "identifiers": [{"identifier": "04d836q62", "scheme": "ror"}, {"identifier": "grid.5329.d", "scheme": "grid"}, {"identifier": "0000 0004 1937 0669", "scheme": "isni"}], "name": "TU Wien"}], "person_or_org": {"family_name": "B\u00f6ck", "given_name": "Markus", "identifiers": [{"identifier": "0009-0001-6704-5903", "scheme": "orcid"}], "name": "B\u00f6ck, Markus", "type": "personal"}, "role": {"id": "researcher", "title": {"de": "WissenschaftlerIn", "en": "Researcher"}}}], "dates": [{"date": "2024-08-06", "description": "ASE 2024: 39th IEEE/ACM International Conference on Automated Software Engineering", "type": {"id": "accepted", "title": {"de": "Angenommen", "en": "Accepted"}}}], "description": "\u003cp\u003eProbabilistic programming allows developers to focus on the modeling aspect in the Bayesian workflow by abstracting away the posterior inference machinery.\u003cbr\u003eIn practice, however, programming errors specific to the probabilistic environment are hard to fix without deep knowledge of the underlying systems.\u003cbr\u003eLike in classical software engineering, static program analysis methods could be employed to catch many of these errors.\u003cbr\u003eIn this work, we present the first framework to formulate static analyses for probabilistic programs in a language-agnostic manner: LASAPP.\u003cbr\u003eWhile prior work focused on specific languages, all analyses written with our framework can be readily applied to new languages by adding easy-to-implement API bindings.\u003cbr\u003eOur prototype supports five popular probabilistic programming languages out-of-the-box.\u003cbr\u003eWe demonstrate the effectiveness and expressiveness of the LASAPP framework by presenting four provably-correct language-agnostic probabilistic program analyses that address problems discussed in the literature and evaluate them on over 200 real-world programs.\u003c/p\u003e", "languages": [{"id": "eng", "title": {"en": "English"}}], "publication_date": "2025-07-10", "publisher": "Zenodo", "resource_type": {"id": "software", "title": {"de": "Software", "en": "Software"}}, "rights": [{"description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title": {"en": "Creative Commons Attribution 4.0 International"}}], "subjects": [{"subject": "probabilistic programming"}, {"subject": "program analysis"}, {"subject": "language-agnostic"}, {"subject": "static analysis"}], "title": "LASAPP: Language-Agnostic Static Analysis of Probabilistic Programs"}, "parent": {"access": {"owned_by": {"user": "1177338"}, "settings": {"accept_conditions_text": null, "allow_guest_requests": false, "allow_user_requests": false, "secret_link_expiration": 0}}, "communities": {}, "id": "13347681", "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.13347681", "provider": "datacite"}}}, "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.15857114", "provider": "datacite"}, "oai": {"identifier": "oai:zenodo