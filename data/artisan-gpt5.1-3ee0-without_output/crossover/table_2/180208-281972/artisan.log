        hy = hy_count / n if n else 0.0
        ir_vals = [float(r["inheritance_rate"]) for r in rows]
        ir = statistics.median(ir_vals) if ir_vals else 0.0
        fields.append(f"{hy:.3f}")
        fields.append(f"{ir:.3f}")
