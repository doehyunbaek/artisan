#!/usr/bin/bash
# Section 1: Expected table
cat > /workspace/expected.md <<'EOTABLE'
**Table 3: Summary of RUF impacts. The table shows how package versions are impacted by different types of RUF and through different dependencies.**

| RUF Type   | Direct Usage | Uncond Impact |  Cond Impact |        Total |
| ---------- | -----------: | ------------: | -----------: | -----------: |
| Accepted   |       ??,??? |        ??,??? |       ??,??? |       ??,??? |
| Active     |       ??,??? |        ??,??? |      ???,??? |      ???,??? |
| Incomplete |        ?,??? |         ?,??? |        ?,??? |       ??,??? |
| Removed    |       ??,??? |        ??,??? |       ??,??? |       ??,??? |
| Unknown    |       ??,??? |        ??,??? |       ??,??? |       ??,??? |

EOTABLE
# Section 2: Artifact download
artisan get https://zenodo.org/records/10496086
# Section 3: Reproduction commands (populate from reviewed steps)
# Use precomputed research result CSVs to aggregate counts per RUF status.
artifact_root="Cargo-Ecosystem-Monitor-ICSE/Cargo-Ecosystem-Monitor"
rr_dir="$artifact_root/data/Release-20220811/ResearchResults"

# Ensure raw data (including ResearchResults) is present; if not, fetch and unzip it once.
if [ ! -d "$rr_dir" ]; then
  (cd "$artifact_root" && make submodule && docker build -t cargo-ecosystem-monitor . >/dev/null 2>&1 && \
   cid=$(docker run -d --init --entrypoint bash -w /app --mount type=bind,src="$(pwd)",target=/app cargo-ecosystem-monitor -c 'sleep infinity') && \
   docker exec "$cid" /bin/bash --noprofile --norc -c "cd /app && make download_20220811_rawdata" && \
   docker stop "$cid" >/dev/null 2>&1)
fi

# Aggregate counts from CSVs using awk.
direct_csv="$rr_dir/Result2_RUFUsage.csv"
uncond_csv="$rr_dir/Result3_1UncondImpact.csv"
cond_csv="$rr_dir/Result3_1CondImpact.csv"
total_csv="$rr_dir/Result3_1TotalImpact.csv"

# Build a temporary summary with columns: status,Direct,Uncond,Cond,Total
tmp_summary="/workspace/tmp_table3_summary.tsv"
awk -F',' 'NR>1 {gsub(/"/,"",$1); gsub(/"/,"",$2); direct[$1]=$2} END{for (s in direct) print s"\t"direct[s]}' "$direct_csv" > "$tmp_summary"

awk -F',' 'NR>1 {gsub(/"/,"",$1); gsub(/"/,"",$2); uncond[$1]=$2} END{for (s in uncond) print s"\t"uncond[s]}' "$uncond_csv" | \
  awk 'NR==FNR{a[$1]=$2; next}{a[$1]=a[$1]"\t"$2} END{for (s in a) print s"\t"a[s]}' - "$tmp_summary" > "${tmp_summary}.u"

awk -F',' 'NR>1 {gsub(/"/,"",$1); gsub(/"/,"",$2); cond[$1]=$2} END{for (s in cond) print s"\t"cond[s]}' "$cond_csv" | \
  awk 'NR==FNR{a[$1]=$2; next}{a[$1]=a[$1]"\t"$2} END{for (s in a) print s"\t"a[s]}' - "${tmp_summary}.u" > "${tmp_summary}.uc"

awk -F',' 'NR>1 {gsub(/"/,"",$1); gsub(/"/,"",$2); total[$1]=$2} END{for (s in total) print s"\t"total[s]}' "$total_csv" | \
  awk 'NR==FNR{a[$1]=$2; next}{a[$1]=a[$1]"\t"$2} END{for (s in a) print s"\t"a[s]}' - "${tmp_summary}.uc" > "${tmp_summary}.uct"

# Order rows by RUF type to match the expected table and write markdown to repro.txt
{
  echo "**Table 3: Summary of RUF impacts. The table shows how package versions are impacted by different types of RUF and through different dependencies.**"
  echo
  echo "| RUF Type   | Direct Usage | Uncond Impact |  Cond Impact |        Total |"
  echo "| ---------- | -----------: | ------------: | -----------: | -----------: |"
  for status in Accepted Active Incomplete Removed Unknown; do
    line=$(grep -E "^${status}[[:space:]]" "${tmp_summary}.uct" || true)
    if [ -n "$line" ]; then
      s=$(echo "$line" | awk '{print $1}')
      d=$(echo "$line" | awk '{print $2}')
      u=$(echo "$line" | awk '{print $3}')
      c=$(echo "$line" | awk '{print $4}')
      t=$(echo "$line" | awk '{print $5}')
      printf "| %-9s | %11s | %12s | %11s | %11s |\n" "$s" "$d" "$u" "$c" "$t"
    fi
  done
} > /workspace/repro.txt

# Section 4: Formatting and submission block
echo '<artisan_submit>'
artisan format --expected /workspace/expected.md --repro /workspace/repro.txt
echo '</artisan_submit>'
EOF
chmod +x /workspace/repro_rust_table_3.sh
artisan submit /workspace/repro_rust_table_3.sh
