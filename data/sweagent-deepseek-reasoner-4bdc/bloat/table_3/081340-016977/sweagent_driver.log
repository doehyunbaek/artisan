     1	# Use Ubuntu 20.04 LTS as the base image
     2	FROM  ubuntu:20.04
     3	# Set the timezone environment variable
     4	ENV TZ=Europe/Zurich
     5	
     6	# Set the timezone and update the system packages
     7	RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
     8	    apt-get update -yqq && \
     9	    apt-get upgrade -yqq && \
    10	    apt-get install -yqq git python3-pip sudo wget unzip python3-venv
    11	
    12	# Install Python packages from requirements.txt
    13	# Ensure requirements.txt is in the same directory as the Dockerfile when building
    14	COPY requirements.txt /tmp/requirements.txt
    15	RUN pip3 install -r /tmp/requirements.txt
    16	RUN ln -s /usr/bin/python3 /usr/bin/python
    17	
    18	# Create a non-root user
    19	RUN useradd -ms /bin/bash user && \
    20	    echo user:user | chpasswd && \
    21	    cp /etc/sudoers /etc/sudoers.bak && \
    22	    echo 'user ALL=(ALL:ALL) NOPASSWD:ALL' >> /etc/sudoers
    23	
    24	# Switch to the user's home directory
    25	USER user
    26	WORKDIR /home/user
    27	
    28	# Set up the working environment
    29	COPY --chown=user:user requirements.txt ./
    30	RUN pip3 install --user -r requirements.txt


