import os, json

def split_by_callers(calls_sequence):
    counter = 1
    caller = calls_sequence[0].split("##")[-1]
    splitted_sequences = []
    s_temp = [calls_sequence[0]]
    i = 1
    while True:
        if i == len(calls_sequence):
            splitted_sequences.append(s_temp)
            break
        c = calls_sequence[i]
        if c.startswith("#START#"):
            if counter == 0 and c.split("##")[-1] != caller:
                splitted_sequences.append(s_temp)
                s_temp = [c]
                if i == len(calls_sequence):
                    splitted_sequences.append(s_temp)
                    break
                else:
                    caller = c
            else:
                s_temp.append(c)
            counter += 1
        elif c.startswith("#END#"):
            counter -= 1
            s_temp.append(c)
        i += 1
    return splitted_sequences

def generate_filtered_sequences(calls_seq):
    splitted_seqs = split_by_callers(calls_seq)
    final_list = []
    seq_calls = [calls_seq]
    while True:
        temp_seq = []
        for sc in seq_calls:
            temp_seq.extend(split_by_callers(sc))
        final_list.extend(temp_seq)
        seq_calls = []
        for s in temp_seq:
            if len(s) not in [0, 1, 2]:
                seq_calls.append(s[1:-1])
        if not seq_calls:
            break

    simple_final_list = []
    for l in final_list:
        simple_final_list.append([c.split("##")[0] for c in l])

    filtered_list = []
    for l in simple_final_list:
        if not l or l[0].startswith("#END#"):
            continue
        new_l = []
        c_old = l[0].split("#")[2]
        for c in l[1:]:
            if c.split("#")[2] == c_old:
                new_l.append(c_old)
            c_old = c.split("#")[2]
        filtered_list.append(new_l)

    filtered_list = [f for f in filtered_list if len(f) >= 2]
    return filtered_list

# Build capped & filtered dataset as in plots_sec4.3.ipynb
all_sequences = []
traces = sorted(os.listdir("callgraph_seq"))
CAP = 1893

for fname in traces:
    path = os.path.join("callgraph_seq", fname)
    try:
        with open(path) as f:
            seq_calls = json.load(f)
    except Exception as e:
        print("SKIP", fname, "error:", e)
        continue
    fs = generate_filtered_sequences(seq_calls)
    n_a_s = [e for e in fs if e.count('builtins.isinstance') <= 5]
    n_a_s = [s for s in n_a_s if len(s) < 100]
    if len(n_a_s) > CAP:
        n_a_s = n_a_s[:CAP]
    all_sequences.extend(n_a_s)

print("Total sequences used for mining:", len(all_sequences))

pattern1 = ['builtins.isinstance', 'builtins.isinstance']
pattern2 = ['Pattern.match', 'Match.span', 'str.isidentifier']

def support_and_occurrences(seq, pat):
    m, n = len(pat), len(seq)
    supp = False
    occ = 0
    if m <= n:
        for i in range(n - m + 1):
            if seq[i:i+m] == pat:
                occ += 1
                supp = True
    return int(supp), occ

def aggregate(pattern):
    supp_total = 0
    occ_total = 0
    for s in all_sequences:
        supp, occ = support_and_occurrences(s, pattern)
        supp_total += supp
        occ_total += occ
    return supp_total, occ_total

s1, o1 = aggregate(pattern1)
s2, o2 = aggregate(pattern2)

print("Pattern 1 (builtins.isinstance · builtins.isinstance):")
print("  support (sequences containing pattern):", s1)
print("  total occurrences across all sequences:", o1)

print("Pattern 2 (Pattern.match · Match.span · str.isidentifier):")
print("  support (sequences containing pattern):", s2)
print("  total occurrences across all sequences:", o2)
