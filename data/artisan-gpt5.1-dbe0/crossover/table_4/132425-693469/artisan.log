import csv, re
from collections import defaultdict

detections_path = "detections.csv"

fuzzers = [
    "BeDiv-Simple",
    "BeDiv-Struct",
    "RLCheck",
    "Zest",
    "Zeugma-X",
    "Zeugma-1PT",
    "Zeugma-2PT",
    "Zeugma-Link",
]
defects = ["B0","B1","C0","C1","N0","N1","N2","R0","R1","R2","R3","R4"]

time_re = re.compile(r"(\d+)\s+days\s+(\d+):(\d+):(\d+)(?:\.(\d+))?")
def parse_seconds(t):
    m = time_re.fullmatch(t)
    if not m:
        raise ValueError(f"bad time {t!r}")
    d,h,mn,s,frac = m.groups()
    total = int(d)*86400 + int(h)*3600 + int(mn)*60 + int(s)
    if frac:
        total += int(frac) / (10**len(frac))
    return total

THREE_HOURS = 3*60*60
FIVE_MIN = 5*60

stats = defaultdict(lambda: {"total":0,"det_5m":0,"det_3h":0})

with open(detections_path, newline="") as f:
    r = csv.DictReader(f)
    for row in r:
        fz = row["fuzzer"]
        df = row["defect"]
        if fz not in fuzzers or df not in defects:
            continue
        key = (fz, df)
        stats[key]["total"] += 1
        t = (row.get("time") or "").strip()
        if not t:
            continue
        secs = parse_seconds(t)
        if secs <= THREE_HOURS:
            stats[key]["det_3h"] += 1
        if secs <= FIVE_MIN:
            stats[key]["det_5m"] += 1

print("fuzzer,defect,total,det_5m,det_3h")
for fz in fuzzers:
    for df in defects:
        s = stats.get((fz,df))
        if not s:
            continue
        print(f"{fz},{df},{s['total']},{s['det_5m']},{s['det_3h']}")
PY
</mini_swe_agent_bash>
